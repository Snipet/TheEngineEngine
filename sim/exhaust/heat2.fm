// heat2.fm: the exhaust's heat over the chain as built (card G, the exhaust builder).
//
// The reference's soak() (sim/ref/engine.fm), over sections instead of its fixed five: the gas leaves the ports at
// tIn and cools along the system toward each section's wall, keeping exp(-NTU) of its excess through it (NTU from
// turbulent pipe flow's heat transfer, Dittus and Boelter's: 0.0135 L / (m^0.2 D^0.8) for exhaust gas, a branch
// carrying m kg/s; more in the pulsing headers and the mufflers' chambers). Each wall heats or cools toward where the
// gas inside and the air outside hold it (convection, more with the car's speed, and radiation), over tens of seconds
// to minutes. The pipes' lengths in samples follow each section's gas a third of a second behind (tUse), as the
// reference's do.
//
// The sections, in the gas's order: the primaries, the first collectors' pipes, the second merges' pipes, the main
// pipes, the pipes after a crossover or a resonator, the mufflers, the tails. A section the build does not have passes
// the gas on unchanged, so a build of the reference's topology soaks exactly as the reference. Each section stands for
// all its parallel branches (the sides alike, as the reference's do): its length the path's, its bore one branch's.
// What it leaves out: the two sides differing, and a resonator's or a bypass's gas (they take their section's).
#pragma once

enum
{
    XH_SECT = 7,
    XH_PRIM = 0,
    XH_COLL = 1,
    XH_COLL2 = 2,
    XH_MAIN = 3,
    XH_LINK = 4,
    XH_MUFF = 5,
    XH_TAIL = 6
};

module XHeat
{
    int on[XH_SECT];
    float len[XH_SECT];     // m, along the gas's path
    float dia[XH_SECT];     // m, one branch's
    float br[XH_SECT];      // parallel branches
    float enh[XH_SECT];     // the heat transfer's enhancement (pulsing flow, chambers)
    float shellK[XH_SECT];  // the outside's area over the inside's
    float heat[XH_SECT];    // J / (m^2 K) of the outside: the wall's steel
    float tGas[XH_SECT];    // K
    float tWall[XH_SECT];
    float tUse[XH_SECT];    // what the pipes are set to

    // A section's kind: its enhancement, shell and steel, the reference's (headers 1.5, 1, 9000; collectors 1.2, 1,
    // 6000; main 1, 1, 12000; muffler 2, 4, 10000; tail 1, 1, 5000)
    void kind(int i, float l, float d, float b)
    {
        const float en[XH_SECT] = {1.5f, 1.2f, 1.2f, 1.0f, 1.0f, 2.0f, 1.0f};
        const float sk[XH_SECT] = {1.0f, 1.0f, 1.0f, 1.0f, 1.0f, 4.0f, 1.0f};
        const float ht[XH_SECT] = {9000.0f, 6000.0f, 6000.0f, 12000.0f, 12000.0f, 10000.0f, 5000.0f};
        on[i] = 1;
        len[i] = l;
        dia[i] = d;
        br[i] = b;
        enh[i] = en[i];
        shellK[i] = sk[i];
        heat[i] = ht[i];
    }

    void soak(float tIn, float m, float dt, float tAmb, float vAir)
    {
        float t = tIn;
        for (int i = 0; i < XH_SECT; ++i)
        {
            if (on[i] == 0)
            {
                tGas[i] = t;
                continue;
            }
            const float mb = fmaxf(m / br[i], 2.0e-5f);
            const float ntu = 0.01352f * enh[i] * len[i] * expf(-0.2f * logf(mb) - 0.8f * logf(dia[i]));
            const float e = expf(-ntu);
            const float tw = tWall[i];
            tGas[i] = tw + (t - tw) * (1.0f - e) / ntu;
            t = tw + (t - tw) * e;
            const float sOut = 3.14159265f * dia[i] * len[i] * shellK[i];
            const float gIn = ntu * mb * 1150.0f;
            const float gOut = (20.0f + 4.0f * vAir + 4.536e-8f * (tw * tw + tAmb * tAmb) * (tw + tAmb)) * sOut;
            const float tEq = (gIn * tGas[i] + gOut * tAmb) / (gIn + gOut);
            tWall[i] = tw + (tEq - tw) * fminf(dt * (gIn + gOut) / (heat[i] * sOut), 1.0f);
        }
    }

    // At rest: the walls as warm as the engine is, the gas settled through them (the reference's configure, stopped)
    void rest(float tAmb, float warm, float m, float vAir)
    {
        for (int i = 0; i < XH_SECT; ++i)
            tWall[i] = tAmb + 120.0f * warm;
        for (int it = 0; it < 400; ++it)
            soak(tAmb + 350.0f * warm, m, 3.0f * warm, tAmb, vAir);
        for (int i = 0; i < XH_SECT; ++i)
            tUse[i] = tGas[i];
    }

    void follow(float kUse)
    {
        for (int i = 0; i < XH_SECT; ++i)
            tUse[i] += (tGas[i] - tUse[i]) * kUse;
    }

    // The speed of sound in a section's gas, as the pipes are set to it
    float cOf(int i)
    {
        return sqrtf(1.35f * 287.0f * tUse[i]);
    }
};
