// exhaust/exhaust.fm: the exhaust (module Exhaust). Owner: package G.
//
// Every pipe after a port, as waveguides (exhaust/duct.fm): each cylinder's header (a rotary's: one a rotor) into its
// bank's collector (or one for all), the collectors' pipes merging (topology 0: all into one pipe; 1: each bank its own
// collector, then one pipe; 2: two pipes with an H-pipe between them), the catalytic converter at each main pipe's head
// (a resistance in series, its monolith taking the highs), the muffler (a chamber, a perforated tube, a chamber: from a
// straight-through can to big packed chambers), the tail and its open end into the air (Silva et al.'s reflection, for
// its hot gas). Each junction loses what its change of area does (K 1/2 rho u|u|, quasi-steadily: node, lossHold), and
// makes the flow noise of its jet breaking up there; the tail's jet adds its own; a pop (exhaust/pop.fm) is a
// collector's own gas. The gas's temperature down the system and the pipes' walls follow the load over seconds to
// minutes (soak), and the pipes' lengths and losses follow the gas (pipes, every 16 samples). What leaves each tail is
// its radiation (outL, outR: the rate the flow out changes). The reference's explanations stand with each part below.
//
// Which runs, the reference's code or the builder: wanted() (exhaust.model 1, or the engine's boost.model 1 through
// `implied`: one decision, taken by the engine under its fade; card D as integrator, 24 Nov).
// What it leaves out: the waves' own steepening on the way back, the pipes' bends and their cross modes, the
// turbine's work on the waves (Boost's restriction stands for it), resonators and valves (package G's).
//
//   setup(rate, noise, layout, heat) in init; release() in end; clear() a new engine's pipes at rest
//   soak(tIn, m, dt, bore, vAir)       the system's heat over dt seconds (the gas tIn at the ports, m kg/s)
//   pipes(bore, asp, smTb, smTs, rate) the pipes' sizes for the layout and the dials, their lengths for the gas now
//   flowRate(), gas(d16), heatUp(d16, bore, vAir), flow16(), bands()   every 16 samples, in that order around Engine's
//                                      boost and cylinder updates (sim/README.md)
//   read()                             each sample, first
//   step(qe, np)                       each sample, after the cylinders: everything from the ports to the tails
// Its state read by others: prim[] (the cylinders' exhaust ends), tUse[0] (the headers' gas), outL, outR, shell[]
// (the headers' walls, for the engine bay), mdot, tPort; the cylinders add to eSum and mSum.
//
// spec.exhaust.model 1 (card G, docs/models/exhaust.md): the system is built from the Spec's description by the
// builder (slots.fm, XBuild b) out of the same parts. Every function above stays the entry point: with model 1 it
// forwards to the builder, and keeps what others read here true for it (prim[i].near and .z are the builder's ports'
// arriving waves and impedances after read(); tUse[0] its headers' gas; outL, outR, shell[] its outputs; nDuals the
// channels its ends make). The reference's code is untouched and runs alone with model 0 (the null test). A change of
// model, or of the builder's description while it runs, is made under this module's own fade (6 ms down, rebuilt, 12 ms
// up). Telemetry (tel.exhaust) and the Scope's exhaust arrays are written here.
#pragma once
#include "exhaust/duct.fm"
#include "exhaust/pop.fm"
#include "lib/biquad.fm"
#include "lib/onepole.fm"
#include "lib/noise.fm"
#include "spec/limits.fm"
#include "core/layouts.fm"
#include "core/heat.fm"
#include "spec/exhaust.fm"
#include "spec/telemetry.fm"
#include "spec/scope.fm"
#include "exhaust/slots.fm"
#include "boost/boost.fm"

module Exhaust
{
    float rate;
    Noise* noiseSrc;    // Engine's noise (the reference's one stream)
    Layout* lay;
    Heat* heat;
    Duct prim[MAX_PORTS];      // the headers (a rotary's: one a rotor)
    Duct sec[2];        // from each bank's collector
    Duct pipe[2];       // the main pipe (two, when dual)
    Duct ch1[2];        // the muffler: a chamber, a tube, a chamber
    Duct mid[2];
    Duct ch2[2];
    Duct tail[2];
    Duct cross;         // between the two pipes (an H-pipe), when dual
    DuctLanes lanes;    // (lanes) the pipes' trackers and walls, across the pipes
    int laneKind[32];   // (lanes) each lane's pipe: 0 prim, 1 sec, 2 pipe, 3 ch1, 4 mid, 5 ch2, 6 tail, 7 cross
    int laneIdx[32];
    Pop pop[2];
    float smMuf;
    float smHdr;
    float smPipe;
    float smXp;
    int nDuals;         // pipes after the collectors: 1 or 2
    int portBank[MAX_PORTS];   // each port's bank
    float tPort;        // the exhaust gas's temperature at the ports (smoothed), K
    float eSum;
    float mSum;
    float radPrev[2];
    Biquad endR[2];     // each tail's open end: the wave it sends back (Silva et al.'s reflection, for its hot gas)
    float outL;
    float outR;
    float noiseTrim;    // the flow's and the jet's noise against it (see configure)
    OnePole vnHp;       // the valves' jet noise: white noise, its lows taken out
    OnePole tnHp[2];    // the tail's jet: noise in a band
    OnePole tnLp[2];
    float mdot;         // the exhaust's mass flow, kg/s (smoothed)
    OnePole fnHp[8];
    OnePole fnLp[8];
    OnePole fnLp2[8];
    float fnN[8];       // each band's unit strength
    float fnG[8];       // this sample's noise in each band (0, 1: the collectors; 2, 3: the cones; 4, 5: the
    float flowK;
    float qHd[MAX_PORTS];      // the last sample's flows: each header into its collector, each main pipe away from its cone,
    float qPp[2];       // each muffler's inlet and outlet
    float qM1[2];
    float qM4[2];
    float kInM;         // the loss coefficients the noise goes by: the muffler's inlet, its outlet
    float kOutM;
    float tGas[5];
    float tWall[5];
    float tUse[5];
    float mdotSlow;     // the exhaust's mass flow over half a second
    float kUse;
    float kMdot;
    float shell[2];     // the headers' walls ringing (the collectors' pressure), for the engine bay
    OnePole shellHp[2];
    float jetK;
    float jetA;
    float qJet[2];      // the flow out of the tail, smoothed: the jet's speed
    float valveK;
    float kHin;         // a header's flow into its collector, and back out of it
    float kHout;
    float kSin;         // a collector's pipe into the merge, and back
    float kSout;
    float kXp;          // the H-pipe's ends
    float rCat;         // the converter at the main pipe's head: a resistance in series, Pa s / m^3
    float rPerf;        // the muffler's perforated tube or baffles, where the gas passes from chamber to tube and on
    float kMuf[8];      // the muffler's four changes of area (pipe to chamber, chamber to tube, tube to chamber, chamber
    float kExit[2];     // the tail's open end: the jet out (its momentum lost), the air drawn in
    float sHd[MAX_PORTS];      // each junction's drive, its slow part (the losses act on it: quasi-steady): the headers' ends,
    float sMg[2];       // the collectors' pipes at the merge, the H-pipe's ends, the muffler's four changes of area each
    float sXp[2];       // side, the tails' ends
    float sMf[8];
    float sEx[2];
    float xiWall;       // the pipes' friction factor
    float k16Flow;      // the flow's loss's smoothing, every 16 samples
    OnePole vnLp;       // (the valves' jet noise past hearing taken out)
    float jetN[2];      // what makes that band's noise of unit strength, whatever its width and the sample rate
    float nScale;       // white noise's strength for the same loudness at any sample rate
    // ---- card G: the builder (model 1) ----
    XBuild b;
    ExhaustSpec* spec;  // the Spec's exhaust section (Engine's)
    ExhaustTel* telOut; // the Telemetry's and the Scope's (Engine's)
    Scope* scopeOut;
    Boost* bo;          // card F's machine: the turbines' housings, downpipes and gates (sim/README.md)
    int hmapBuilt[4];   // the housings as last built
    int gatesBuilt;     // the external gates as last built
    float pPortSum;     // the ports' pressure over the air (2a + z q at each port), summed over ports and samples
    int pPortN;
    float pPortMean;    // its mean, smoothed over some 0.1 s (tel.exhaust.portPressure, absolute)
    float kPort;
    int fed;            // 1: the builder's collectors end in housings this build (Boost's stand-in is then not fed)
    int model;          // in use: 0 the reference's code, 1 the builder
    int implied;        // 1: the engine's boost.model 1 implies the builder (Engine sets it; see wanted())
    int seenRev;        // the section's rev as last looked at, and the builder's description built
    float seenSig;
    int want;           // 1: a change waits for the fade
    float fadeG;        // the fade's gain on what leaves (1: none)
    float fadeDn;
    float fadeUp;
    int needBuild;      // 1: configure cleared the pipes: the builder builds at the next pipes()
    int atRestBuild;    // 1: and the engine was stopped (soaked at rest)
    float boreNow;      // the last pipes()'s and heatUp()'s arguments
    int aspNow;
    float smTbNow;
    float smTsNow;
    float vAirNow;
    float rpmNow;
    float loadNow;
    int tick128;
    int seenSettle;     // spec.exhaust.heatSettle as last acted on
    float tPortNow;     // the ports' gas as the cylinders give it now (gas(), before its 0.8 s smoothing)
    // The ports' energy and mass flow over a cycle (gas()): two means in cascade, each over a four-stroke cycle at the
    // engine's speed, so the firing's pulses leave some 2.5 % of their swing; settleHeat's gas and flow (N1's finding,
    // 25 Nov: the last 16 samples caught a blowdown or the stroke's cool tail, 1128 to 1607 K point to point)
    float eCyc[2];
    float mCyc[2];
    float tCyc[2];      // the ports' gas over a cycle as the running tPort weights it: each 16 samples' alike (time)
    float tExit;        // the gas leaving the ports into the headers, after the port walls' cooling (portLoss()), K
    float qPort;        // the heat the port walls take from it, W (for the coolant's owner; telemetry)
    float qCool;        // the heat the port walls give the coolant, W
    float tWallPort;    // the port's wall (every port alike), K
    float capPort;      // the port walls' heat capacity, all ports, J/K
    // a thermocouple's reading (telemetry only): each port's local gas, and a bead's mean of it (thermocouple())
    float tLoc[MAX_PORTS];
    float tcW;
    float tcWT;
    float tcT;
    int tcN;
    float tcPort;       // the bead's reading at the port's exit, K (over some 0.5 s)
    float tcPlain;      // the plain time mean of the port's local gas, K
    float qSur[MAX_PORTS];  // stepLet: what each port's pipe has been given beyond what its valve let out (m^3/s),
    float kSur;             // followed over 20 ms
    float tLet;             // stepLet's target over what the valves let out, by volume: 1, or with the turbines fed, what
                            // makes the mass Boost books into its housings what the valves let out (bookLet)
    double houseSeen;       // bookLet's window: Boost's mass from the pipes at its start (kg), the valves' since (kg)
    double letSince;
    int letN;
    float bookRatio;
    float backBlk;          // the backflow's mass (kg, negative) since gas() last ran: Engine's mSum has only the outflow
    // stepLet's books (for D's): the volume the ports' pipes were given and what the valves let out, m^3 since the
    // last configure, summed in blocks of 1024 samples (a float sum of a million samples drifts a few per cent)
    float flowGiven;
    float flowLet;
    float blkGiven;
    float blkLet;
    int blkN;
    float tcU;          // the mean speed past the bead (|q| / the port's area), summed over a telemetry step, m/s
    float tcUMean;      // and its mean over some 0.5 s
    float kTc;
    float kStag;
    int prepared;       // 1: prepare() was called this sample (the turbines' seam), before step()

    void setup(float rateIn, Noise* noise, Layout* layIn, Heat* heatIn, ExhaustSpec* specIn, ExhaustTel* telIn,
               Scope* scopeIn, Boost* boostIn)
    {
        bo = boostIn;
        fed = 0;
        for (int i = 0; i < 4; ++i)
            hmapBuilt[i] = -1;
        gatesBuilt = 0;
        pPortSum = 0.0f;
        pPortN = 0;
        pPortMean = 0.0f;
        kPort = 1.0f - expf(-16.0f / (0.1f * rateIn));
        spec = specIn;
        telOut = telIn;
        scopeOut = scopeIn;
        b.follow(specIn);
        b.setup(rateIn);
        b.net.noiseSrc = noise;
        b.net.shared = 1;
        b.net.popExt = 1;
        model = wanted();
        seenRev = spec->rev;
        seenSig = sig();
        want = 0;
        fadeG = 1.0f;
        fadeDn = 1.0f / (0.006f * rateIn);
        fadeUp = 1.0f / (0.012f * rateIn);
        needBuild = 1;
        atRestBuild = 0;
        boreNow = 0.08f;
        aspNow = 0;
        smTbNow = 0.5f;
        smTsNow = 1.0f;
        vAirNow = 0.0f;
        rpmNow = 0.0f;
        for (int k = 0; k < 2; ++k)
        {
            eCyc[k] = 0.0f;
            mCyc[k] = 0.0f;
            tCyc[k] = 0.0f;
        }
        loadNow = 0.0f;
        tick128 = 0;
        prepared = 0;
        seenSettle = spec->heatSettle;
        tPortNow = 0.0f;
        tExit = 0.0f;
        qPort = 0.0f;
        qCool = 0.0f;
        tWallPort = 300.0f;
        capPort = 0.0f;
        for (int i = 0; i < MAX_PORTS; ++i)
            tLoc[i] = 300.0f;
        tcW = 0.0f;
        tcWT = 0.0f;
        tcT = 0.0f;
        tcN = 0;
        tcPort = 0.0f;
        tcPlain = 0.0f;
        tcU = 0.0f;
        tcUMean = 0.0f;
        for (int i = 0; i < MAX_PORTS; ++i)
            qSur[i] = 0.0f;
        kSur = 1.0f - expf(-1.0f / (0.02f * rateIn));
        tLet = 1.0f;
        houseSeen = -1.0;
        letSince = 0.0;
        letN = 0;
        backBlk = 0.0f;
        flowGiven = 0.0f;
        flowLet = 0.0f;
        blkGiven = 0.0f;
        blkLet = 0.0f;
        blkN = 0;
        tLet = 1.0f;
        houseSeen = -1.0;
        kTc = 1.0f - expf(-16.0f / (0.5f * rateIn));
        kStag = 1.0f - expf(-1.0f / (0.036f * rateIn));
        rate = rateIn;
        noiseSrc = noise;
        lay = layIn;
        heat = heatIn;
        // the longest each pipe could be, cold (330 m/s), at this rate
        const float k = rate / 300.0f;
        for (int i = 0; i < MAX_PORTS; ++i)
            prim[i].configure((int)(3.0f * k) + 16);
        for (int i = 0; i < 2; ++i)
        {
            sec[i].configure((int)(1.0f * k) + 16);
            pipe[i].configure((int)(4.6f * k) + 16);
            ch1[i].configure((int)(0.9f * k) + 16);
            mid[i].configure((int)(0.5f * k) + 16);
            ch2[i].configure((int)(0.7f * k) + 16);
            tail[i].configure((int)(1.0f * k) + 16);
            pop[i].rs = 1000 + 7777 * i;
        }
        cross.configure((int)(0.6f * k) + 16);
        for (int i = 0; i < 2; ++i)
            shellHp[i].set(500.0f, rate);
        vnHp.set(700.0f, rate);
        vnLp.set(20000.0f, rate);
        nScale = sqrtf(rate / 48000.0f);
        jetA = 1.0f - expf(-1.0f / (0.06f * rate));
        for (int i = 0; i < 2; ++i)
            jetBand(i, 300.0f);
        // (the free jet's own mixing noise is weak at a tailpipe's speeds: most of the roar is made inside, at the
        // junctions, and comes out shaped by the pipes; the two together as bright as the jet alone was)
        jetK = 0.005f;
        flowK = 0.017f;
        valveK = 0.15f;
        xiWall = 0.025f;
        k16Flow = 1.0f - expf(-16.0f / (0.06f * rate));
        kUse = 1.0f - expf(-16.0f / (0.3f * rate));
        kMdot = 1.0f - expf(-16.0f / (0.5f * rate));
    }

    void release()
    {
        b.release();
        for (int i = 0; i < MAX_PORTS; ++i)
            prim[i].release();
        for (int i = 0; i < 2; ++i)
        {
            sec[i].release();
            pipe[i].release();
            ch1[i].release();
            mid[i].release();
            ch2[i].release();
            tail[i].release();
        }
        cross.release();
    }

    // A new engine: every pipe and junction at rest
    void clear()
    {
        for (int i = 0; i < MAX_PORTS; ++i)
            qSur[i] = 0.0f;
        flowGiven = 0.0f;
        flowLet = 0.0f;
        blkGiven = 0.0f;
        blkLet = 0.0f;
        blkN = 0;
        // (a configure is under the engine's own fade: it takes the model the Spec asks for at once)
        model = wanted();
        seenRev = spec->rev;
        want = 0;
        needBuild = 1;
        atRestBuild = 0;
        for (int i = 0; i < MAX_PORTS; ++i)
        {
            prim[i].clear();
        }
        for (int i = 0; i < 2; ++i)
        {
            sec[i].clear();
            pipe[i].clear();
            ch1[i].clear();
            mid[i].clear();
            ch2[i].clear();
            tail[i].clear();
            radPrev[i] = 0.0f;
            endR[i].clear();
        }
        for (int i = 0; i < MAX_PORTS; ++i)
        {
            sHd[i] = 0.0f;
            qHd[i] = 0.0f;
        }
        for (int i = 0; i < 2; ++i)
        {
            qPp[i] = 0.0f;
            qM1[i] = 0.0f;
            qM4[i] = 0.0f;
        }
        for (int g = 0; g < 8; ++g)
        {
            fnG[g] = 0.0f;
            flowBand(g, 300.0f);
        }
        for (int i = 0; i < 8; ++i)
            sMf[i] = 0.0f;
        for (int i = 0; i < 2; ++i)
        {
            sMg[i] = 0.0f;
            sXp[i] = 0.0f;
            sEx[i] = 0.0f;
        }
        // each layout's loudness, measured: so they come out alike at speed
        cross.clear();
        lanes.clear();
    }

    // (lanes) the pipes in read()'s order, each given its lane's coefficients (after every sizing)
    Duct* laneDuct(int p)
    {
        const int k = laneKind[p];
        const int i = laneIdx[p];
        if (k == 0)
            return &prim[i];
        if (k == 1)
            return &sec[i];
        if (k == 2)
            return &pipe[i];
        if (k == 3)
            return &ch1[i];
        if (k == 4)
            return &mid[i];
        if (k == 5)
            return &ch2[i];
        if (k == 6)
            return &tail[i];
        return &cross;
    }

    void addLane(int k, int i)
    {
        laneKind[lanes.n] = k;
        laneIdx[lanes.n] = i;
        lanes.n += 1;
    }

    void syncLanes()
    {
        lanes.n = 0;
        for (int i = 0; i < lay->ports; ++i)
            addLane(0, i);
        const int nb = lay->topo == 0 ? 1 : 2;
        for (int k = 0; k < nb; ++k)
            addLane(1, k);
        for (int k = 0; k < nDuals; ++k)
        {
            addLane(2, k);
            addLane(3, k);
            addLane(4, k);
            addLane(5, k);
            addLane(6, k);
        }
        if (nDuals == 2)
            addLane(7, 0);
        for (int p = 0; p < lanes.n; ++p)
            lanes.take(p, laneDuct(p));
    }

    // The exhaust's heat (dt seconds on): the gas leaves the ports at tIn and cools along the system toward each part's
    // wall, keeping exp(-NTU) of its excess through a part (NTU from turbulent pipe flow's heat transfer, Dittus and
    // Boelter's: 0.0135 L / (m^0.2 D^0.8) for exhaust gas a branch carrying m kg/s; more in the pulsing headers and
    // the muffler's chambers). Each wall heats or cools toward where the gas inside and the air outside hold it
    // (convection, more with the car's speed, and radiation), over tens of seconds to minutes: its steel's heat over
    // what it exchanges. So the gas is hot near the engine and cooler down the system, much hotter at full throttle
    // than at idle, and the downstream parts take their time to follow.
    void soak(float tIn, float m, float dt, float bore, float vAir)
    {
        atRestBuild = 1;
        const float hk = expf(0.9808293f * (smHdr - 0.5f));
        const float pk = expf(1.3862944f * (smPipe - 0.5f));
        const float dHead = 0.46f * bore;
        const float dSec = lay->topo == 0 ? lay->pipeD : 0.922f * lay->pipeD;
        float len[5];
        float dia[5];
        float br[5];
        len[0] = lay->hdr * hk;
        len[1] = lay->bike > 0.5f ? 0.25f : 0.38f;
        len[2] = lay->mainLen * pk;
        len[3] = lay->muff * 1.6f + 0.12f + 0.08f * (1.0f - lay->bike);
        len[4] = lay->bike > 0.5f ? 0.10f : 0.40f;
        dia[0] = dHead;
        dia[1] = dSec;
        dia[2] = lay->pipeD;
        dia[3] = lay->pipeD;
        dia[4] = lay->tailD;
        br[0] = (float)lay->ports;
        br[1] = lay->topo == 0 ? 1.0f : 2.0f;
        br[2] = (float)nDuals;
        br[3] = (float)nDuals;
        br[4] = (float)nDuals;
        const float enh[5] = {1.5f, 1.2f, 1.0f, 2.0f, 1.0f};
        const float shellK[5] = {1.0f, 1.0f, 1.0f, 4.0f, 1.0f};      // the outside's area over the inside's
        const float hCap[5] = {9000.0f, 6000.0f, 12000.0f, 10000.0f, 5000.0f};  // J / (m^2 K) of the outside
        float t = tIn;
        for (int i = 0; i < 5; ++i)
        {
            const float mb = fmaxf(m / br[i], 2.0e-5f);
            const float ntu = 0.01352f * enh[i] * len[i] * expf(-0.2f * logf(mb) - 0.8f * logf(dia[i]));
            const float e = expf(-ntu);
            const float tw = tWall[i];
            tGas[i] = tw + (t - tw) * (1.0f - e) / ntu;
            t = tw + (t - tw) * e;
            const float sOut = 3.14159265f * dia[i] * len[i] * shellK[i];
            const float gIn = ntu * mb * 1150.0f;
            const float gOut = (20.0f + 4.0f * vAir + 4.536e-8f * (tw * tw + heat->tAmb * heat->tAmb) * (tw + heat->tAmb)) * sOut;
            const float tEq = (gIn * tGas[i] + gOut * heat->tAmb) / (gIn + gOut);
            tWall[i] = tw + (tEq - tw) * fminf(dt * (gIn + gOut) / (hCap[i] * sOut), 1.0f);
        }
    }

    // Where a muffler's scattering starts taking the highs (Hz): some 500 Hz, or in a short pipe half its own first
    // resonance (c / 2L), so that the delay its shelves add at the lows fits in its line (c: m/s, len: m)
    float backFc(float c, float len)
    {
        return fmaxf(500.0f, 0.25f * c / fmaxf(len, 0.01f));
    }

    // The pipes' sizes for the layout and the dials, and their lengths in samples at the gas's temperatures now
    void pipes(float bore, int aspUse, float smTb, float smTs, float rate)
    {
        boreNow = bore;
        aspNow = aspUse;
        smTbNow = smTb;
        smTsNow = smTs;
        const int configuring = needBuild;
        if (model != 0)
            builderPipes();
        else
        {
            refPipes(bore, aspUse, smTb, smTs, rate);
            // (at a configure the builder is built too, though it does no work a sample: its pipes then carry the
            // history the reference's carry, whose old timings a configure's clear keeps, so a later configure into
            // model 1 starts as the reference would)
            if (needBuild != 0)
                builderPipes();
        }
        // (a configure: the Telemetry true from the first block, before the first 16 samples have run)
        if (configuring != 0)
            writeTelemetry();
    }

    // The reference's pipes() (model 0)
    void refPipes(float bore, int aspUse, float smTb, float smTs, float rate)
    {
        const float hk = expf(0.9808293f * (smHdr - 0.5f));     // headers: 0.61 to 1.63 times
        const float pk = expf(1.3862944f * (smPipe - 0.5f));        // pipe: half to twice
        const float dHead = 0.46f * bore;
        const float aHead = 0.785398f * dHead * dHead;
        const float aPipe = 0.785398f * lay->pipeD * lay->pipeD;
        const float aTail = 0.785398f * lay->tailD * lay->tailD;
        const float aSec = lay->topo == 0 ? aPipe : 0.85f * aPipe;
        // the gas cools as it goes, and heats and cools with the load (soak): the pipes follow it slowly, so the
        // system's resonances move with the heat over seconds, never with the pulses
        const float tH = tUse[0];
        const float tS = tUse[1];
        const float tP = tUse[2];
        const float tM = tUse[3];
        const float tT = tUse[4];
        const float cH = sqrtf(1.35f * 287.0f * tH);
        const float cS = sqrtf(1.35f * 287.0f * tS);
        const float cP = sqrtf(1.35f * 287.0f * tP);
        const float cM = sqrtf(1.35f * 287.0f * tM);
        const float cT = sqrtf(1.35f * 287.0f * tT);
        // the muffler: from a straight-through tube (0) to big packed chambers (1)
        const float mu = smMuf;
        const float ratio1 = 1.0f + 15.0f * mu;
        const float ratio2 = 1.0f + 9.0f * mu;
        // below about a third it is a straight-through can (a perforated tube through a packed shell: the gas keeps to
        // the tube, so it loses little to its flow), above it chambers the gas expands into and out of (the losses of
        // those changes of area, and the back pressure they make); packed throughout, more with the dial. The packing
        // takes the highs (porous fill), less as the flow past the perforations grows (they choke with grazing flow).
        const float chamb = fminf(fmaxf((mu - 0.25f) / 0.35f, 0.0f), 1.0f);
        const float chambs = chamb * chamb * (3.0f - 2.0f * chamb);
        const float graze = 1.0f / (1.0f + 1.5f * ch1[0].mach);
        const float lk1 = (lay->muff / 0.45f) * graze;
        const float lk2 = 0.6f * lk1;
        const float dPipe = lay->pipeD;
        // what the model does not resolve takes a share of each pass, whatever the level: the converter's narrow
        // channels (their broadband absorption: some 2.3 dB a pass), the packing's lows, the bends, welds and slip
        // joints, the turbulent boundary layer's damping (some 1.1 dB through a header). Without it the system rings at
        // low flow as no real one does, and the losses that grow with the flow leave the level rising too little with
        // the revs.
        const float keepH = 0.878f;
        const float keepP = 0.769f;
        for (int i = 0; i < lay->ports; ++i)
        {
            // each header a little different, as real ones are; the second bank of an unequal-length boxer much longer
            const int b = portBank[i];
            const float own = 1.0f + 0.06f * (float)((i * 7) % 5 - 2) / 2.0f;
            const float len = lay->hdr * hk * own * (b == 1 ? lay->hdrBank1 : 1.0f);
            prim[i].set(len, dHead, aHead, cH, rate);
            prim[i].extra(0.0f, keepH, rate);
            prim[i].steep = 0.87f / 101325.0f;
        }
        // (a turbo's turbine sits at each collector: a restriction that smooths the pulses; one turbo for the engine is
        // the most of both, twins less, four between; a supercharger leaves the exhaust free)
        // (a smaller turbine than the match chokes more and smooths less: its housing's volume; as the root of its size)
        const float tb = aspUse >= 1 && aspUse <= 3 ? smTb : 0.0f;
        const float tsr = expf(-0.5f * logf(smTs));
        const float aS = aSec * fmaxf(1.0f - (aspUse == 2 ? 0.45f : (aspUse == 3 ? 0.5f : 0.55f)) * tb * tsr, 0.15f);
        const float tbHz = tb > 0.001f ? (1320.0f + 22680.0f * (1.0f - tb) * (1.0f - tb) * (1.0f - tb)) * (aspUse == 2 ? 1.25f : (aspUse == 3 ? 1.1f : 1.0f)) * tsr : 0.0f;
        for (int k = 0; k < 2; ++k)
        {
            sec[k].set(lay->bike > 0.5f ? 0.25f : 0.38f, sqrtf(aS * 1.2732395f), aS, cS, rate);
            sec[k].extra(tbHz, 1.0f, rate);
            sec[k].steep = 0.87f / 101325.0f;
            const float pl = lay->mainLen * pk;
            pipe[k].set(pl, dPipe, aPipe, cP, rate);
            pipe[k].extra(0.0f, keepP, rate);
            // (the converter's monolith: its narrow channels' walls take the highs, about as the root of the frequency:
            // some 2.5 dB at 1 kHz, 5 at 4 kHz, 7.5 at the top each way)
            pipe[k].pack(700.0f, 2.5f, 4000.0f, 5.0f, rate);
            pipe[k].steep = 0.87f / 101325.0f;
            ch1[k].set(lay->muff, dPipe * sqrtf(ratio1), aPipe * ratio1, cM, rate);
            ch1[k].extra(0.0f, expf(0.8f * logf(0.92f - 0.25f * mu)), rate);
            ch1[k].pack(1100.0f, (1.5f + 5.0f * mu) * lk1, 5000.0f, (3.0f + 14.0f * mu) * lk1, rate);
            mid[k].set(0.12f + 0.08f * (1.0f - lay->bike), dPipe, aPipe, cM, rate);
            mid[k].extra(0.0f, 0.935f, rate);
            ch2[k].set(0.6f * lay->muff, dPipe * sqrtf(ratio2), aPipe * ratio2, cM, rate);
            ch2[k].extra(0.0f, expf(0.8f * logf(0.93f - 0.20f * mu)), rate);
            ch2[k].pack(1100.0f, (1.5f + 5.0f * mu) * lk2, 5000.0f, (3.0f + 14.0f * mu) * lk2, rate);
            tail[k].set(lay->bike > 0.5f ? 0.10f : 0.40f, lay->tailD, aTail, cT, rate);
            tail[k].extra(0.0f, 0.960f, rate);
            // what the muffler sends back loses its highs: above some 500 Hz its reflections scatter into its chambers'
            // cross modes and the packing takes them (up to 40 dB a pass, as strongly as its changes of area reflect),
            // so its chambers, its tube, the tail and the pipe before it no longer ring there as a comb. Their lows
            // ring as they did. (A short pipe's from higher up, where its own first resonances are.)
            const float sc1 = 40.0f * (1.0f - 1.0f / ratio1);
            const float sc2 = 40.0f * (1.0f - 1.0f / ratio2);
            pipe[k].back(backFc(pipe[k].c, pipe[k].len), sc1, rate);
            ch1[k].back(backFc(ch1[k].c, ch1[k].len), sc1, rate);
            mid[k].back(backFc(mid[k].c, mid[k].len), sc2, rate);
            ch2[k].back(backFc(ch2[k].c, ch2[k].len), sc2, rate);
            tail[k].back(backFc(tail[k].c, tail[k].len), sc2, rate);
        }
        const float xa = fmaxf(smXp, 0.001f);
        cross.set(0.25f, dPipe * sqrtf(xa), xa * aPipe, cP, rate);
        cross.extra(0.0f, 0.960f, rate);
        // the junctions' losses: a header merging into its collector (and the flow pushed back into it), the collectors'
        // pipes merging, the H-pipe's sharp-edged ends, the muffler's sudden expansions ((1 - a/A)^2 on the narrow side's
        // speed) and contractions (about half of 1 - a/A), the tail's jet
        const float rhoH = prim[0].rho;
        const float rhoS = sec[0].rho;
        const float rhoM = ch1[0].rho;
        kHin = lossKap(0.25f, rhoH, aHead);
        kHout = lossKap(0.45f, rhoH, aHead);
        kSin = lossKap(0.15f, rhoS, aS);
        kSout = lossKap(0.30f, rhoS, aS);
        kXp = lossKap(0.5f, sec[0].rho, xa * aPipe);
        const float e1 = 1.0f - 1.0f / ratio1;
        const float e2 = 1.0f - 1.0f / ratio2;
        const float aCh2 = aPipe * ratio2;
        const float e3 = 1.0f - fminf(aTail / aCh2, 1.0f);
        kMuf[0] = lossKap(chambs * e1 * e1, rhoM, aPipe);   // pipe into the first chamber: an expansion
        kMuf[1] = lossKap(chambs * 0.5f * e1, rhoM, aPipe); // and back: a contraction
        kMuf[2] = lossKap(chambs * 0.5f * e1, rhoM, aPipe); // the first chamber into the tube
        kMuf[3] = lossKap(chambs * e1 * e1, rhoM, aPipe);
        kMuf[4] = lossKap(chambs * e2 * e2, rhoM, aPipe);   // the tube into the second chamber
        kMuf[5] = lossKap(chambs * 0.5f * e2, rhoM, aPipe);
        kMuf[6] = lossKap(0.5f * e3, rhoM, aTail);          // the second chamber into the tail
        kMuf[7] = lossKap(e3 * e3, rhoM, aTail);
        kInM = fmaxf(chambs * e1 * e1, 0.1f);           // (a straight-through's perforates still hiss)
        kOutM = fmaxf(0.5f * e3, 0.1f);
        kExit[0] = lossKap(1.0f, tail[0].rho, aTail);
        kExit[1] = lossKap(0.5f, tail[0].rho, aTail);
        // the muffler's perforations: the gas passes through them between the chambers and the tube, a resistance of
        // a twentieth to a fifth of the gas's rho c (more holes' worth of resistance in a more restrictive can)
        rPerf = (0.05f + 0.15f * mu) * ch1[0].rho * cM / aPipe;
        // the converter: a monolith's flow resistance (some 60 Pa s/m across it at 700 K with its cones, growing with
        // the gas's viscosity: a few kPa at full power), over the pipe's area
        rCat = 60.0f * expf(0.7f * logf(tP / 700.0f)) / aPipe;
        // the open end's reflection: Silva et al.'s fit to an unflanged pipe's (within 8 % to ka = 2), R = -(1 + 0.167
        // ts) / (1 + 1.393 ts + 0.457 t^2 s^2), t = a / c in the air outside, for the hot gas inside: the air's rho c
        // over the gas's (kEnd, about 1.6 at 750 K) multiplies the radiation's impedance z, so the end holds more of the
        // cold air's mass (a longer end correction) and lets more out: R = (kEnd z - 1) / (kEnd z + 1), z from the fit.
        // By the bilinear transform.
        const float aEnd = 0.5f * lay->tailD;
        const float tau = aEnd / 347.2f;
        const float kEnd = 1.018f * sqrtf(tT / heat->tAmb);
        const float nb1 = (0.613f * kEnd - 0.78f) * tau;
        const float nb2 = 0.2285f * (kEnd - 1.0f) * tau * tau;
        const float da1 = (0.613f * kEnd + 0.78f) * tau;
        const float da2 = 0.2285f * (kEnd + 1.0f) * tau * tau;
        const float kb = 2.0f * rate;
        const float kb2 = kb * kb;
        for (int k = 0; k < 2; ++k)
            endR[k].design(-1.0f + nb1 * kb + nb2 * kb2, -2.0f - 2.0f * nb2 * kb2, -1.0f - nb1 * kb + nb2 * kb2,
                           1.0f + da1 * kb + da2 * kb2, 2.0f - 2.0f * da2 * kb2, 1.0f - da1 * kb + da2 * kb2);
        syncLanes();
    }

    // The converter's cone's (and the merging's) flow noise for main pipe k: K 0.6 on the pipe's own speed
    float coneNoise(int k)
    {
        const float u = qPp[k] / pipe[k].area;
        return flowK * noiseTrim * 0.6f * 0.5f * pipe[k].rho * u * u * fnG[2 + k];
    }

    // A node where n pipe ends meet (a merge, a collector): a[i] the waves arriving there, z[i] each branch's impedance
    // (with any resistance in series), kf[i] and kr[i] its loss for flow into the node and out of it (lossKap), sl[i]
    // its drive's slow part and al[i] that part's smoothing, src a volume flow the node makes itself (a pop's gas).
    // The losses act on the slow part (quasi-steady, as separated flow does below a Strouhal number of about 0.2), from
    // the last sample's, so the node solves in one pass and stays passive. Leaves each branch's flow into the node in
    // q[i] (and its slow part updated in sl[i]); returns the node's pressure.
    float node(int n, float* a, float* z, float* kf, float* kr, float* sl, float* al, float* q, float src)
    {
        float sy = 0.0f;
        float sa = src;
        float h[MAX_PORTS + 2];
        for (int i = 0; i < n; ++i)
        {
            const float x = sl[i];
            h[i] = lossHold(x, z[i], x >= 0.0f ? kf[i] : kr[i]);
            sy += 1.0f / z[i];
            sa += 2.0f * a[i] / z[i] - h[i];
        }
        const float p = sa / sy;
        for (int i = 0; i < n; ++i)
        {
            const float d = 2.0f * a[i] - p;
            q[i] = d / z[i] - h[i];
            sl[i] += al[i] * (d - sl[i]);
        }
        return p;
    }

    // A flow noise's band about fPeak (from half of it; falling 12 dB an octave above twice it, as turbulence's
    // spectrum does), at unit strength (its equivalent bandwidth 1.005 fPeak)
    void flowBand(int g, float fPeak)
    {
        const float f = fminf(fmaxf(fPeak, 80.0f), 3000.0f);
        fnHp[g].set(0.5f * f, rate);
        fnLp[g].set(2.0f * f, rate);
        fnLp2[g].set(2.0f * f, rate);
        fnN[g] = sqrtf(rate / (0.67f * f));
    }

    // The tail's jet noise in a band about fPeak: from half of it up to three times it (one-pole slopes beyond), at unit
    // strength (the band's noise power: 2/3 / rate a Hz of white noise, over 4.04 fPeak of bandwidth)

    void jetBand(int k, float fPeak)
    {
        const float f = fminf(fmaxf(fPeak, 60.0f), 2500.0f);
        tnHp[k].set(0.5f * f, rate);
        tnLp[k].set(3.0f * f, rate);
        jetN[k] = sqrtf(rate / (2.693f * f));
    }

    // Every 16 samples: the exhaust's mass flow (from the ports' since the last time), for the turbo
    void flowRate()
    {
        mdot += (mSum / 16.0f - mdot) * 0.15f;         // (mSum: 16 samples of kg/s)
    }

    // Every 16 samples: the gas's temperature at the ports
    void gas(float d16)
    {
        // (exhaust.bang: the builder sets the account's switch each sample; the reference's exhaust clears it, so a switch
        // back to model 0 leaves the account on its own path)
        if (model == 0)
        {
            pop[0].burnPipe = 0;
            pop[1].burnPipe = 0;
            pop[0].nEv = 0;
            pop[1].nEv = 0;
        }
        // the exhaust's temperature: what the ports let out, slowly
        if (mSum > 1.0e-9f)
        {
            const float tNew = eSum / mSum;
            tPortNow = tNew;
            tPort += (tNew - tPort) * (1.0f - expf(-d16 / 0.8f));
        }
        else
            tPort += (heat->tAmb - tPort) * (1.0f - expf(-d16 / 4.0f));
        {
            const float cyc = fminf(fmaxf(120.0f / fmaxf(rpmNow, 1.0f), 0.01f), 0.25f);
            const float kc = 1.0f - expf(-d16 / cyc);
            eCyc[0] += kc * (eSum / 16.0f - eCyc[0]);
            mCyc[0] += kc * (mSum / 16.0f - mCyc[0]);
            eCyc[1] += kc * (eCyc[0] - eCyc[1]);
            mCyc[1] += kc * (mCyc[0] - mCyc[1]);
            if (mSum > 1.0e-9f)
            {
                const float tc = eSum / mSum;
                if (tCyc[1] <= 0.0f)
                {
                    tCyc[0] = tc;
                    tCyc[1] = tc;
                }
                tCyc[0] += kc * (tc - tCyc[0]);
                tCyc[1] += kc * (tCyc[0] - tCyc[1]);
            }
        }
        bookLet(mSum / rate + backBlk);
        backBlk = 0.0f;
        eSum = 0.0f;
        mSum = 0.0f;
        portLoss(d16);
    }

    // The exhaust port's walls (model 1, spec.exhaust.portHeat 1): the gas from the valve to the header's flange gives
    // heat to the head's port wall, and the wall to the coolant.
    // The gas side: Caton and Heywood's exhaust-port correlation (Heywood, ICE Fundamentals, ch. 12): Nu = 0.0483
    // Re^0.783 on the port's diameter, Re from each port's mean mass flow (their fit is of time-averaged heat transfer
    // against time-averaged Re: the blowdown's high-speed spurt is inside it, and applied per sample the same law would
    // give less, Re^0.783 being concave); times the entrance region's (Mills, abrupt entrance: Nu_L / Nu = 1 + 2.4254
    // (L/D)^-0.676; a port is a short duct entered through the valve's jet: 2.77 at L 1.6 D). The burned gas: viscosity
    // 3.3e-7 T^0.7 Pa s, cp 1150 J/kg K, Pr 0.7. The port: its diameter the primary's (0.46 of the bore), its length 1.6
    // diameters (judgement: some 75 mm on a 100 mm bore). The gas leaves at tW + (tPort - tW) exp(-NTU).
    // The wall: cast iron 6 mm to the water jacket (k 50 W/m K), the jacket's side 10 kW/m^2 K (forced convection with
    // local boiling: judgement), so G = 1 / (t / k A + 1 / h A) to the coolant; its heat capacity 7200 kg/m^3 x 460 J/kg K
    // over that area and thickness. It warms by what the gas gives less what the coolant takes: the energy accounted
    // (qPort = the walls' gain + qCool). d16 0: the wall where it would settle (card C's settle).
    // tPort stays the gas at the valve (tel.exhaust.portTemperature); tExit feeds the headers (headerTemperature).
    void portLoss(float d16)
    {
        tExit = tPort;
        qPort = 0.0f;
        const float tC = heat->tCool;
        if (model == 0 || spec->portHeat == 0 || lay->ports < 1)
        {
            tWallPort = tC;
            qCool = 0.0f;
            return;
        }
        const float np = (float)lay->ports;
        const float dP = 0.46f * boreNow;
        const float area = 3.14159265f * dP * 1.6f * dP;
        const float g = 1.0f / (0.006f / (50.0f * area) + 1.0f / (10000.0f * area));
        const float cap = 7200.0f * 460.0f * area * 0.006f;
        capPort = np * cap;
        float hA = 0.0f;
        const float m1 = mdotSlow / np;
        if (m1 > 1.0e-6f)
        {
            const float mu = 3.3e-7f * expf(0.7f * logf(fmaxf(tPort, 300.0f)));
            const float re = 4.0f * m1 / (3.14159265f * dP * mu);
            const float nu = 0.0483f * expf(0.783f * logf(fmaxf(re, 1.0f))) * (1.0f + 2.4254f * expf(-0.676f * logf(1.6f)));
            hA = nu * (mu * 1150.0f / 0.7f) / dP * area;
        }
        if (d16 <= 0.0f && hA > 0.0f)
        {
            // settled: the wall where the gas's heat in equals the coolant's out (a few passes: the gas's side is
            // exponential in NTU)
            for (int it = 0; it < 20; ++it)
            {
                const float ex = expf(-hA / (m1 * 1150.0f));
                const float q1 = m1 * 1150.0f * (tPort - tWallPort) * (1.0f - ex);
                tWallPort = tC + fmaxf(q1, 0.0f) / g;
            }
        }
        if (hA > 0.0f)
        {
            tExit = tWallPort + (tPort - tWallPort) * expf(-hA / (m1 * 1150.0f));
            qPort = mdotSlow * 1150.0f * (tPort - tExit);
        }
        qCool = np * g * (tWallPort - tC);
        if (d16 > 0.0f)
            tWallPort += (qPort / np - g * (tWallPort - tC)) * d16 / cap;
    }

    // What a thermocouple at the port's exit reads, against the enthalpy means above (portTemperature: the mass mean of
    // the gas the valves pass; portExitTemperature and headerTemperature follow it). The blowdown is most of the mass in
    // little of the time, so a bead, which sits in the port all the time, reads less. A first form (judgement throughout):
    // each port's gas a mixing cup of the port's volume (0.46 bore across, 1.6 of that long); what the valve passes
    // replaces it at the gas's temperature now less the port's mean drop, a backflow at the port's exit gas; between
    // the pulses it cools toward the port's wall (some 36 ms: hot gas still in a 47 mm duct). The bead's mean weights
    // that local temperature by its heat transfer, sqrt(u + 2 m/s) (a sphere's h as Re^0.5; 2 m/s for the stirring
    // left between pulses), no radiation, no lag beyond the mean (some 0.5 s); tcPlain the plain time mean.
    void thermocouple(float* qe, int np) [[clang::nonblocking]]
    {
        const float tF = mSum > 1.0e-9f ? eSum / mSum : tPort;
        const float tX = exitTemperature();
        const float drop = tPort - tX;
        const float dP = 0.46f * boreNow;
        const float aP = 0.785398f * dP * dP;
        const float vP = aP * 1.6f * dP;
        const float dts = 1.0f / rate;
        for (int i = 0; i < np; ++i)
        {
            const float q = qe[i];
            float tl = tLoc[i];
            if (q > 0.0f)
                tl += (tF - drop - tl) * fminf(q * dts / vP, 1.0f);
            else if (q < 0.0f)
                tl += (tX - tl) * fminf(-q * dts / vP, 1.0f);
            tl += (tWallPort - tl) * kStag;
            tLoc[i] = tl;
            const float w = sqrtf(fabsf(q) / aP + 2.0f);
            tcW += w;
            tcWT += w * tl;
            tcT += tl;
            tcU += fabsf(q) / aP;
            tcN += 1;
        }
    }

    // A thermocouple's bead in a stream of gas at tg inside a wall at tw reads below the gas by its radiation to the wall:
    // h (tg - tb) = eps sigma (tb^4 - tw^4) (the radiation error: Mills, Heat Transfer; Incropera's thermocouple
    // example). h from Ranz and Marshall's sphere, Nu = 2 + 0.6 Re^0.5 Pr^(1/3), at the mean speed past it (tcUMean);
    // the bead a 1.5 mm sheathed junction, its emissivity 0.8 (an oxidised sheath): judgement, an instrument's. The gas's
    // properties as the port's (viscosity 3.3e-7 T^0.7, cp 1150, Pr 0.7) at the mean pressure there.
    float bead(float tg, float tw)
    {
        const float d = 0.0015f;
        const float mu = 3.3e-7f * expf(0.7f * logf(fmaxf(tg, 300.0f)));
        const float rho = (101325.0f + pPortMean) / (287.0f * fmaxf(tg, 300.0f));
        const float re = rho * fmaxf(tcUMean, 0.0f) * d / mu;
        const float nu = 2.0f + 0.6f * sqrtf(re) * 0.8879f;
        const float h = nu * (mu * 1150.0f / 0.7f) / d;
        const float es = 0.8f * 5.670e-8f;
        // (the bead lies between the wall and the gas: bisection there, 24 halvings, about 1e-4 K on a 1000 K span. A
        // Newton step from the gas overshot below zero where radiation outweighs a slow stream's convection, and its
        // slope then vanished: the soak's fuzz found it non-finite, 24 Nov)
        if (!(tg > 0.0f && tg < 1.0e5f) || !(tw > 0.0f && tw < 1.0e5f) || !(h > 0.0f && h < 1.0e9f))
            return tg > 0.0f && tg < 1.0e5f ? tg : exitTemperature();
        float lo = fminf(tg, tw);
        float hi = fmaxf(tg, tw);
        for (int it = 0; it < 24; ++it)
        {
            const float tb = 0.5f * (lo + hi);
            const float f = h * (tg - tb) - es * (tb * tb * tb * tb - tw * tw * tw * tw);
            if (f > 0.0f)
                lo = tb;
            else
                hi = tb;
        }
        return 0.5f * (lo + hi);
    }

    // The gas as it leaves the ports for the headers and the turbine (after the port's walls): card F's turbine's
    // energy goes by it. Until portLoss() has run once (a stopped engine configured before its first rendered block),
    // the port's gas (integrator D, 26 Nov, with G's agreement: the Telemetry true from the first block)
    float exitTemperature()
    {
        return model != 0 && spec->portHeat != 0 && tExit > 0.0f ? tExit : tPort;
    }

    // Every 16 samples: the system's heat (soak) and what the pipes are set to (vAir: the car's speed past them)
    // (rpm and load: the engine's speed, rpm, and the throttle, 0 to 1: the bypass valve's rule goes by them)
    void heatUp(float d16, float bore, float vAir, float rpm, float load)
    {
        vAirNow = vAir;
        rpmNow = rpm;
        loadNow = load;
        mdotSlow += (mdot - mdotSlow) * kMdot;
        if (model != 0)
        {
            fillEngine();
            b.heatStep(d16);
            tUse[0] = b.heat.tUse[XH_PRIM];
            return;
        }
        soak(tPort, mdotSlow, d16, bore, vAir);
        atRestBuild = 0;
        for (int i = 0; i < 5; ++i)
            tUse[i] += (tGas[i] - tUse[i]) * kUse;
    }

    // Every 16 samples, after pipes: the flow losses
    void flow16()
    {
        checkSpec();
        if (model != 0)
        {
            b.flowStep();
            return;
        }
        // the pipes' flow losses, from the mean speed of the gas through each since the last time
        for (int i = 0; i < lay->ports; ++i)
        {
            prim[i].flow16(xiWall, k16Flow);
        }
        for (int k = 0; k < 2; ++k)
        {
            sec[k].flow16(xiWall, k16Flow);
            pipe[k].flow16(xiWall, k16Flow);
            ch1[k].flow16(xiWall, k16Flow);
            mid[k].flow16(xiWall, k16Flow);
            ch2[k].flow16(xiWall, k16Flow);
            tail[k].flow16(xiWall, k16Flow);
        }
        cross.flow16(xiWall, k16Flow);
    }

    // Every 16 samples: the jet's and the flow noise's bands
    void bands()
    {
        if (model == 0)
            refBands();
        else
            b.bandStep();
        writeTelemetry();
    }

    // The reference's bands() (model 0)
    void refBands()
    {
        // the jet's noise peaks where its Strouhal number is about 0.3 (0.3 times its speed over the pipe's width, as a
        // jet's mixing noise does; no higher than 2.5 kHz)
        for (int k = 0; k < nDuals; ++k)
        {
            const float u = fmaxf(qJet[k], 0.0f) / tail[k].area;
            jetBand(k, 0.3f * u / sqrtf(tail[k].area * 1.2732395f));
        }
        // the flow noise's bands: a Strouhal number of 0.4 on each flow's mean speed over its width, no higher than
        // 3 kHz (above it, the plane waves the pipes carry are no longer all the noise makes: it roars, it does not
        // hiss)
        const int nb = lay->topo == 0 ? 1 : 2;
        for (int k = 0; k < nb; ++k)
            flowBand(k, 0.4f * prim[0].mach * prim[0].c / prim[0].diam);
        for (int k = 0; k < nDuals; ++k)
        {
            flowBand(2 + k, 0.4f * pipe[k].mach * pipe[k].c / pipe[k].diam);
            flowBand(4 + k, 0.4f * pipe[k].mach * pipe[k].c / pipe[k].diam);
            flowBand(6 + k, 0.4f * tail[k].mach * tail[k].c / tail[k].diam);
        }
    }

    // Each sample, first: the waves arriving at every end
    void read()
    {
        if (model != 0)
        {
            b.read();
            prepared = 0;
            for (int i = 0; i < lay->ports; ++i)
            {
                prim[i].near = b.net.portWave(i);
                prim[i].z = b.net.portZ(i);
            }
            return;
        }
        const int np = lay->ports;
        const int nb = lay->topo == 0 ? 1 : 2;
        int n = 0;
        for (int i = 0; i < np; ++i)
        {
            prim[i].readRaw();
            lanes.fr[n] = prim[i].rawF;
            lanes.br[n] = prim[i].rawB;
            n += 1;
        }
        for (int k = 0; k < nb; ++k)
        {
            sec[k].readRaw();
            lanes.fr[n] = sec[k].rawF;
            lanes.br[n] = sec[k].rawB;
            n += 1;
        }
        for (int k = 0; k < nDuals; ++k)
        {
            pipe[k].readRaw();
            lanes.fr[n] = pipe[k].rawF;
            lanes.br[n] = pipe[k].rawB;
            ch1[k].readRaw();
            lanes.fr[n + 1] = ch1[k].rawF;
            lanes.br[n + 1] = ch1[k].rawB;
            mid[k].readRaw();
            lanes.fr[n + 2] = mid[k].rawF;
            lanes.br[n + 2] = mid[k].rawB;
            ch2[k].readRaw();
            lanes.fr[n + 3] = ch2[k].rawF;
            lanes.br[n + 3] = ch2[k].rawB;
            tail[k].readRaw();
            lanes.fr[n + 4] = tail[k].rawF;
            lanes.br[n + 4] = tail[k].rawB;
            n += 5;
        }
        if (nDuals == 2)
        {
            cross.readRaw();
            lanes.fr[n] = cross.rawF;
            lanes.br[n] = cross.rawB;
        }
        lanes.run();
        n = 0;
        for (int i = 0; i < np; ++i)
        {
            prim[i].finishRead(lanes.fo[n], lanes.bo[n], lanes.mF[n], lanes.mB[n]);
            n += 1;
        }
        for (int k = 0; k < nb; ++k)
        {
            sec[k].finishRead(lanes.fo[n], lanes.bo[n], lanes.mF[n], lanes.mB[n]);
            n += 1;
        }
        for (int k = 0; k < nDuals; ++k)
        {
            pipe[k].finishRead(lanes.fo[n], lanes.bo[n], lanes.mF[n], lanes.mB[n]);
            ch1[k].finishRead(lanes.fo[n + 1], lanes.bo[n + 1], lanes.mF[n + 1], lanes.mB[n + 1]);
            mid[k].finishRead(lanes.fo[n + 2], lanes.bo[n + 2], lanes.mF[n + 2], lanes.mB[n + 2]);
            ch2[k].finishRead(lanes.fo[n + 3], lanes.bo[n + 3], lanes.mF[n + 3], lanes.mB[n + 3]);
            tail[k].finishRead(lanes.fo[n + 4], lanes.bo[n + 4], lanes.mF[n + 4], lanes.mB[n + 4]);
            n += 5;
        }
        if (nDuals == 2)
            cross.finishRead(lanes.fo[n], lanes.bo[n], lanes.mF[n], lanes.mB[n]);
    }

    // Each sample, after the cylinders (qe: each port's volume flow into its header): the ports' waves in, the collectors,
    // the merge, the converter, the muffler, the tails' radiation out (outL, outR), every pipe written
    // Each sample, with what the valves let out beside what they give the pipes (the lead's ruling, 24 Nov): the valve
    // gives its pipe g q, not q (duct.fm, Valve: the simple wave's stiffening, g = 1 + (gamma + 1)/4 u/c), and over a
    // cycle g q is not q: the blowdown's fast gas carries its square term out, so the pipes were given 14 to 20 % more
    // than the cylinders let out at full load (5 % at idle; measured: the big-block V8, the 2.0 turbo four), mass made in
    // the exhaust, 3 to 5 kPa of back pressure on an NA V8 and 10 to 14 at a turbine's inlet. Model 1: each port's
    // surplus (qe - qeLet) followed over 20 ms (as the intake's plenum does, intake.fm, mStiff) and taken off what its
    // pipe is given: the pulse keeps its gain (its pressure is the stiffening's physics), its mean is what was let
    // out. Model 0, or spec.exhaust.flowClose 0: qe as given (the reference, to the bit). qeLet: each port's sum of the
    // cylinders' qE.
    void stepLet(float* qe, float* qeLet, int np)
    {
        if (model == 0 || spec->flowClose == 0)
        {
            stepPipes(qe, np);
            return;
        }
        // (with the turbines fed: the volume that puts the let-out mass into the housings, tLet: bookLet)
        const float r = tLet;
        // (the backflow's mass as the cylinder reckons it: at the port's pressure now, 101325 + 2 a + z q, and the
        // primaries' gas, tUse[0], Engine's tH)
        const float rtBack = 287.0f * fmaxf(tUse[0], 300.0f);
        float qc[MAX_PORTS];
        for (int i = 0; i < np; ++i)
        {
            if (qeLet[i] < 0.0f)
                backBlk += qeLet[i] * fmaxf(101325.0f + 2.0f * prim[i].near + prim[i].z * qe[i], 8000.0f) / rtBack / rate;
            qSur[i] += (qe[i] - qeLet[i] * r - qSur[i]) * kSur;
            qc[i] = qe[i] - qSur[i];
            blkGiven += qc[i];
            blkLet += qeLet[i] * r;
        }
        blkN += 1;
        if (blkN >= 1024)
        {
            flowGiven += blkGiven / rate;
            flowLet += blkLet / rate;
            blkGiven = 0.0f;
            blkLet = 0.0f;
            blkN = 0;
        }
        stepPipes(qc, np);
    }

    // With the turbines fed (every 16 samples, from gas()): the pipes carry volume, linearly, and mass is volume times
    // the local pressure over R T. The gas cools from the valve to the collectors, and the valves' mass is reckoned at
    // the port's pressure in the blowdown while a housing books its own at its own: so the valves' volume, delivered,
    // put 1.13 to 1.14 of their mass into the turbo four's housing at 3050 rpm (N3's books, 24 Nov; the cooling alone
    // 1.148) and some 0.87 into the twin-turbo V8's split housings once scaled by the cooling. So the target is closed
    // by mass where it is booked: every 50 ms, tLet moves by a fifth of Boost's mass from the pipes over the
    // valves' (mach.sumMPipes against Engine's mE) less one, a slow integral loop (some 0.25 s), bounded 0.3 to 1.5 (the
    // error itself, not its log: a window's ratio is noisy, and the log's mean zero leaves the ratio's mean high). The books
    // then close to the housings' mass; the pulse keeps its shape.
    void bookLet(float mBlock)
    {
        if (model == 0 || spec->flowClose == 0 || fed == 0)
        {
            tLet = 1.0f;
            houseSeen = -1.0;
            return;
        }
        if (houseSeen < 0.0)
        {
            houseSeen = bo->mach.sumMPipes;
            letSince = 0.0;
            letN = 0;
            return;
        }
        letSince += (double)mBlock;
        letN += 16;
        if ((float)letN >= 0.05f * rate)
        {
            const double inHouse = bo->mach.sumMPipes - houseSeen;
            if (letSince > 1.0e-7)
                bookRatio = (float)(inHouse / letSince);
            if (letSince > 1.0e-7 && inHouse > 1.0e-7)
                tLet = fminf(fmaxf(tLet * (1.0f - 0.2f * fminf(fmaxf((float)(inHouse / letSince) - 1.0f, -1.0f), 1.0f)), 0.3f), 1.5f);
            houseSeen = bo->mach.sumMPipes;
            letSince = 0.0;
            letN = 0;
        }
    }

    // (stepLet's: the pipes given qe, each sample)
    void stepPipes(float* qe, int np)
    {
        // (the ports' pressure for the telemetry: the waves arriving there as read() left them, and the flows put in)
        for (int i = 0; i < np; ++i)
            pPortSum += 2.0f * prim[i].near + prim[i].z * qe[i];
        pPortN += np;
        thermocouple(qe, np);
        if (model != 0)
            builderStep(qe);
        else
            refStep(qe, np);
        if (want != 0 || fadeG < 1.0f)
            fade();
    }

    // The reference's step() (model 0)
    void refStep(float* qe, int np)
    {
        const int nb = lay->topo == 0 ? 1 : 2;
        // the ports send their waves into the headers
        float hNear[MAX_PORTS];
        const float wn = nScale * vnLp.lowpass(vnHp.highpass(noiseSrc->rnd()));
        for (int i = 0; i < np; ++i)
        {
            // the gas through the valve is a jet: a hiss in proportion to the flow, the louder the faster
            const float jet = prim[i].z * qe[i];
            hNear[i] = prim[i].near + jet * (1.0f + valveK * wn * fminf(fabsf(jet) * 0.00004f, 1.0f));
        }
        // the collectors: each bank's headers merge into its pipe, losing as they merge (pipes.fm, lossFlow); a pop is
        // the node's own gas
        float hFar[MAX_PORTS];
        float sNear[2];
        float na[MAX_PORTS + 2];
        float nz[MAX_PORTS + 2];
        float nkf[MAX_PORTS + 2];
        float nkr[MAX_PORTS + 2];
        float nq[MAX_PORTS + 2];
        float ns[MAX_PORTS + 2];
        float nal[MAX_PORTS + 2];
        int ni[MAX_PORTS + 2];
        for (int k = 0; k < nb; ++k)
            fnG[k] = fnN[k] * fnLp2[k].lowpass(fnLp[k].lowpass(fnHp[k].highpass(noiseSrc->rnd())));
        for (int k = 0; k < nDuals; ++k)
        {
            fnG[2 + k] = fnN[2 + k] * fnLp2[2 + k].lowpass(fnLp[2 + k].lowpass(fnHp[2 + k].highpass(noiseSrc->rnd())));
            fnG[4 + k] = fnN[4 + k] * fnLp2[4 + k].lowpass(fnLp[4 + k].lowpass(fnHp[4 + k].highpass(noiseSrc->rnd())));
            fnG[6 + k] = fnN[6 + k] * fnLp2[6 + k].lowpass(fnLp[6 + k].lowpass(fnHp[6 + k].highpass(noiseSrc->rnd())));
        }
        for (int k = 0; k < nb; ++k)
        {
            int m = 0;
            for (int i = 0; i < np; ++i)
            {
                if (portBank[i] == k || lay->topo == 0)
                {
                    // (the header's jet's noise: a pressure in series with it, half on each side of the drive)
                    const float uh = qHd[i] / prim[i].area;
                    const float eh = flowK * noiseTrim * (uh >= 0.0f ? 0.25f : 0.45f) * 0.5f * prim[i].rho * uh * uh * fnG[k];
                    na[m] = prim[i].far - 0.5f * eh;
                    nz[m] = prim[i].z;
                    nkf[m] = kHin;
                    nkr[m] = kHout;
                    ns[m] = sHd[i];
                    nal[m] = prim[i].qsA;
                    ni[m] = i;
                    m += 1;
                }
            }
            na[m] = sec[k].near;
            nz[m] = sec[k].z;
            nkf[m] = 0.0f;
            nkr[m] = 0.0f;
            ns[m] = 0.0f;
            nal[m] = 0.0f;
            float sy = 0.0f;
            for (int j = 0; j <= m; ++j)
                sy += 1.0f / nz[j];
            const float pj = node(m + 1, na, nz, nkf, nkr, ns, nal, nq, pop[k].tick() * sy);
            shell[k] = shellHp[k].highpass(pj);
            for (int j = 0; j < m; ++j)
            {
                hFar[ni[j]] = prim[ni[j]].far - prim[ni[j]].z * nq[j];
                sHd[ni[j]] = ns[j];
                qHd[ni[j]] = nq[j];
            }
            sNear[k] = sec[k].near - sec[k].z * nq[m];
        }
        // after the collectors: one pipe (topo 0, 1) or two with an H-pipe between them (topo 2); the catalytic converter
        // at the head of each pipe (a resistance in series)
        float sFar[2];
        float pNear[2];
        float xNear = 0.0f;
        float xFar = 0.0f;
        if (lay->topo == 0)
        {
            na[0] = sec[0].far;
            nz[0] = sec[0].z;
            nkf[0] = kSin;
            nkr[0] = kSout;
            ns[0] = sMg[0];
            nal[0] = sec[0].qsA;
            na[1] = pipe[0].near - 0.5f * coneNoise(0);
            nz[1] = pipe[0].z + rCat;
            nkf[1] = 0.0f;
            nkr[1] = 0.0f;
            ns[1] = 0.0f;
            nal[1] = 0.0f;
            node(2, na, nz, nkf, nkr, ns, nal, nq, 0.0f);
            sMg[0] = ns[0];
            sFar[0] = sec[0].far - sec[0].z * nq[0];
            pNear[0] = pipe[0].near - pipe[0].z * nq[1];
            qPp[0] = -nq[1];
        }
        else if (lay->topo == 1)
        {
            for (int k = 0; k < 2; ++k)
            {
                na[k] = sec[k].far;
                nz[k] = sec[k].z;
                nkf[k] = kSin;
                nkr[k] = kSout;
                ns[k] = sMg[k];
                nal[k] = sec[k].qsA;
            }
            na[2] = pipe[0].near - 0.5f * coneNoise(0);
            nz[2] = pipe[0].z + rCat;
            nkf[2] = 0.0f;
            nkr[2] = 0.0f;
            ns[2] = 0.0f;
            nal[2] = 0.0f;
            node(3, na, nz, nkf, nkr, ns, nal, nq, 0.0f);
            sMg[0] = ns[0];
            sMg[1] = ns[1];
            sFar[0] = sec[0].far - sec[0].z * nq[0];
            sFar[1] = sec[1].far - sec[1].z * nq[1];
            pNear[0] = pipe[0].near - pipe[0].z * nq[2];
            qPp[0] = -nq[2];
        }
        else
        {
            for (int k = 0; k < 2; ++k)
            {
                na[0] = sec[k].far;
                nz[0] = sec[k].z;
                nkf[0] = kSin;
                nkr[0] = kSout;
                ns[0] = sMg[k];
                nal[0] = sec[k].qsA;
                na[1] = pipe[k].near - 0.5f * coneNoise(k);
                nz[1] = pipe[k].z + rCat;
                nkf[1] = 0.0f;
                nkr[1] = 0.0f;
                ns[1] = 0.0f;
                nal[1] = 0.0f;
                na[2] = k == 0 ? cross.near : cross.far;
                nz[2] = cross.z;
                nkf[2] = kXp;
                nkr[2] = kXp;
                ns[2] = sXp[k];
                nal[2] = cross.qsA;
                node(3, na, nz, nkf, nkr, ns, nal, nq, 0.0f);
                sMg[k] = ns[0];
                sXp[k] = ns[2];
                sFar[k] = sec[k].far - sec[k].z * nq[0];
                pNear[k] = pipe[k].near - pipe[k].z * nq[1];
                qPp[k] = -nq[1];
                if (k == 0)
                    xNear = cross.near - cross.z * nq[2];
                else
                    xFar = cross.far - cross.z * nq[2];
            }
        }
        // the pipes on to the muffler and out of the tail, each change of area losing what it does
        for (int k = 0; k < nDuals; ++k)
        {
            // (each: the lossless flow less what the loss holds back, from the drive's slow part)
            const int j = 4 * k;
            const float z1 = pipe[k].z + ch1[k].z;
            const float d1 = 2.0f * (pipe[k].far - ch1[k].near);
            const float u1 = qM1[k] / pipe[k].area;
            const float e1n = flowK * noiseTrim * kInM * 0.5f * ch1[k].rho * u1 * u1 * fnG[4 + k];
            const float q1 = (d1 - e1n) / z1 - lossHold(sMf[j], z1, sMf[j] >= 0.0f ? kMuf[0] : kMuf[1]);
            qM1[k] = q1;
            sMf[j] += pipe[k].qsA * (d1 - sMf[j]);
            const float z2 = ch1[k].z + mid[k].z + rPerf;
            const float d2 = 2.0f * (ch1[k].far - mid[k].near);
            const float q2 = d2 / z2 - lossHold(sMf[j + 1], z2, sMf[j + 1] >= 0.0f ? kMuf[2] : kMuf[3]);
            sMf[j + 1] += mid[k].qsA * (d2 - sMf[j + 1]);
            const float z3 = mid[k].z + ch2[k].z + rPerf;
            const float d3 = 2.0f * (mid[k].far - ch2[k].near);
            const float q3 = d3 / z3 - lossHold(sMf[j + 2], z3, sMf[j + 2] >= 0.0f ? kMuf[4] : kMuf[5]);
            sMf[j + 2] += mid[k].qsA * (d3 - sMf[j + 2]);
            const float z4 = ch2[k].z + tail[k].z;
            const float d4 = 2.0f * (ch2[k].far - tail[k].near);
            const float u4 = qM4[k] / tail[k].area;
            const float e4n = flowK * noiseTrim * kOutM * 0.5f * tail[k].rho * u4 * u4 * fnG[6 + k];
            const float q4 = (d4 - e4n) / z4 - lossHold(sMf[j + 3], z4, sMf[j + 3] >= 0.0f ? kMuf[6] : kMuf[7]);
            qM4[k] = q4;
            sMf[j + 3] += tail[k].qsA * (d4 - sMf[j + 3]);
            // the open end: the lows come back inverted, the highs go out; the jet leaving loses its momentum
            const float a = tail[k].far;
            const float dq = a - endR[k].tick(a);
            const float q = dq / tail[k].z - lossHold(sEx[k], tail[k].z, sEx[k] >= 0.0f ? kExit[0] : kExit[1]);
            sEx[k] += tail[k].qsA * (dq - sEx[k]);
            const float b = a - tail[k].z * q;
            float rad = (q - radPrev[k]) * rate;
            radPrev[k] = q;
            // the jet out of the tail: its speed is the mean flow out (what the engine pushes through), puffing with
            // each pulse; turbulence that grows steeply with that speed
            qJet[k] += jetA * (q - qJet[k]);
            const float qm = fmaxf(qJet[k], 1.0e-5f);
            const float un = fminf(qm / tail[k].area * 0.025f, 4.0f);
            const float puff = fminf(fmaxf(q / (2.0f * qm), 0.0f), 1.6f);
            const float noise = jetN[k] * tnLp[k].lowpass(tnHp[k].highpass(noiseSrc->rnd()));
            rad += jetK * noiseTrim * un * un * un * puff * noise * 14400.0f * tail[k].area;
            if (k == 0)
                outL = rad;
            else
                outR = rad;
            pipe[k].write(pNear[k], pipe[k].far - pipe[k].z * q1);
            ch1[k].write(ch1[k].near + ch1[k].z * q1, ch1[k].far - ch1[k].z * q2);
            mid[k].write(mid[k].near + mid[k].z * q2, mid[k].far - mid[k].z * q3);
            ch2[k].write(ch2[k].near + ch2[k].z * q3, ch2[k].far - ch2[k].z * q4);
            tail[k].write(tail[k].near + tail[k].z * q4, b);
        }
        if (nDuals == 1)
            outR = outL;
        else
            cross.write(xNear, xFar);
        for (int k = 0; k < nb; ++k)
            sec[k].write(sNear[k], sFar[k]);
        for (int i = 0; i < np; ++i)
            prim[i].write(hNear[i], hFar[i]);
    }

    // ---- card G: the builder's side (model 1) ----

    // What the builder knows of the engine: the layout's sizes (as configure scaled them), the dials as glided, the
    // turbo, the air, the gas at the ports
    void fillEngine()
    {
        XEngine* e = &b.eng;
        e->ports = lay->ports;
        for (int i = 0; i < XS_PORTS; ++i)
            e->bank[i] = portBank[i];
        e->topo = lay->topo;
        e->bore = boreNow;
        e->hdr = lay->hdr;
        e->hdrBank1 = lay->hdrBank1;
        e->mainLen = lay->mainLen;
        e->pipeD = lay->pipeD;
        e->tailD = lay->tailD;
        e->muff = lay->muff;
        e->bike = lay->bike;
        e->smHdr = smHdr;
        e->smPipe = smPipe;
        e->smXp = smXp;
        e->smMuf = smMuf;
        e->aspUse = aspNow;
        e->smTb = smTbNow;
        e->smTs = smTsNow;
        e->tAmb = heat->tAmb;
        e->vAir = vAirNow;
        e->tPort = exitTemperature();
        e->mdotSlow = mdotSlow;
        e->rpm = rpmNow;
        e->load = loadNow;
        // card F's turbines (boost.model 1): the housing each bank's collectors end in; none: -1, and the reference's
        // restriction stands for a turbo (aspUse, which the engine gives 0 with boost.model 1). External gates: one pipe
        // each (Boost::externalGates, turbo t's gate solved by Boost::gatePipe at its near end), to the air at the front
        // (a screamer pipe; F has no recirculated choice yet). First the exhaust's side count, as resolve() will take
        // it, so every turbo's outlet goes to a downpipe that exists (Boost::exhaustSides: one side, all onto side 0)
        if (model != 0)
            bo->exhaustSides(spec->sides > 0 ? (spec->sides > 2 ? 2 : spec->sides) : (lay->topo == 2 ? 2 : 1));
        int banks = 1;
        for (int i = 0; i < lay->ports; ++i)
        {
            if (portBank[i] == 1)
                banks = 2;
        }
        for (int bk = 0; bk < 2; ++bk)
        {
            for (int g = 0; g < 2; ++g)
                e->hmap[bk * 2 + g] = bo->housingOf(bk, g, banks);
        }
        e->useHousings = 1;
        e->gates = bo->externalGates();
    }

    // Has the housings' map moved since the last build (card F's machine rebuilt)?
    int housingsMoved()
    {
        for (int i = 0; i < 4; ++i)
        {
            if (b.eng.hmap[i] != hmapBuilt[i])
                return 1;
        }
        return b.eng.gates != gatesBuilt ? 1 : 0;
    }

    void builtWith()
    {
        for (int i = 0; i < 4; ++i)
            hmapBuilt[i] = b.eng.hmap[i];
        gatesBuilt = b.eng.gates;
        fed = 0;
        for (int h = 0; h < 8; ++h)
        {
            if (b.jHouse[h] >= 0)
                fed = 1;
        }
    }

    // Each sample, model 1, after prepare(): each housing's pressure, each downpipe's and gate's, from card F
    void turbines()
    {
        if (fed == 0)
            return;
        for (int h = 0; h < 8; ++h)
        {
            if (b.jHouse[h] >= 0)
                b.setHouse(h, bo->housing(h, b.houseDrive(h), b.houseAdmit(h), b.houseT(h)));
        }
        for (int s = 0; s < 2; ++s)
        {
            if (b.jDown[s] >= 0)
                b.setDown(s, bo->downpipe(s, b.downWave(s), b.downZ(s)));
        }
        for (int t = 0; t < b.nGates; ++t)
            b.setGate(t, bo->gatePipe(t, b.gateWave(t), b.gateZ(t)));
    }

    // 1 while the builder's network feeds card F's housings (the engine then gives Boost no stand-in gas)
    // The model the builder runs by: exhaust.model 1, or boost.model 1 (implied: the turbines' housings are the
    // builder's, and a turbo whose cylinders exhaust into pipes that never feel it is known-wrong physics; the lead's
    // ruling, 24 Nov, wired by card D as integrator). At exhaust.model 1's defaults the builder is the reference's
    // exhaust to the bit
    int wanted()
    {
        return spec->model != 0 || implied != 0 ? 1 : 0;
    }

    int turbinesFed()
    {
        return model != 0 && fed != 0 ? 1 : 0;
    }

    // The exhaust flap (card D2's brake drives it, every 16 samples): 0 open, 1 shut. It acts only where one is fitted:
    // flapFitted() 1 (the builder running, spec.exhaust.flapKind a butterfly); else the brake keeps its own stand-in.
    void setFlap(float want)
    {
        b.fCmd = fminf(fmaxf(want, 0.0f), 1.0f);
    }

    int flapFitted()
    {
        return model != 0 && spec->flapKind != 0 ? 1 : 0;
    }

    // The builder's noise as the reference's, from Engine's stream
    void noiseLike()
    {
        b.net.flowK = flowK;
        b.net.valveK = valveK;
        b.net.jetK = jetK;
        b.net.noiseTrim = noiseTrim;
    }

    // model 1's pipes(): the engine's configure built nothing yet: build it (as the reference starts its pipes: not
    // settled, so that model 1 at its defaults is the reference); else the sizes follow in heatUp's control
    void builderPipes()
    {
        fillEngine();
        noiseLike();
        if (needBuild != 0)
        {
            b.build(atRestBuild, heat->warm, 0);
            builtWith();
            needBuild = 0;
            seenSig = sig();
            nDuals = b.channels();
            tUse[0] = b.heat.tUse[XH_PRIM];
        }
        else
        {
            if (model != 0 && housingsMoved() != 0)
                want = 1;
            b.shape();
        }
    }

    // Each sample, model 1: the bangs (the pops Combustion fires, ticked as the reference ticks them), the turbines'
    // seam if nobody has prepared it, every junction, what leaves
    void builderStep(float* qe)
    {
        for (int c = 0; c < XN_POPS; ++c)
            b.net.popIn[c] = 0.0f;
        const int nb = lay->topo == 0 ? 1 : 2;
        // exhaust.bang 1: the account's burns (premixed: a bang; unmixed: left out of the sound, docs/models/exhaust.md)
        for (int k = 0; k < 2; ++k)
        {
            pop[k].burnPipe = b.bangOn;
            for (int e = 0; e < pop[k].nEv; ++e)
                if (pop[k].evKind[e] == BURN_PREMIXED)
                    b.bangIn(k < nb ? k : 0, pop[k].evHeat[e], pop[k].evMass[e], pop[k].evT[e], pop[k].evPhi[e],
                             pop[k].evXb[e], pop[k].evOwn[e]);
            pop[k].nEv = 0;
        }
        for (int k = 0; k < nb; ++k)
        {
            const float pv = pop[k].tick();
            if (b.bankCol[k] >= 0)
                b.net.popIn[b.bankCol[k]] += pv;
        }
        if (prepared == 0)
            b.prepare();
        turbines();
        b.step(qe);
        outL = b.net.outL;
        outR = b.net.outR;
        for (int k = 0; k < 2; ++k)
        {
            const int c = b.bankCol[k] >= 0 ? b.bankCol[k] : 0;
            shell[k] = b.jCol[c] >= 0 ? shellHp[k].highpass(b.net.jP[b.jCol[c]]) : 0.0f;
        }
    }

    // The turbines' seam (sim/README.md): after read() and the cylinders, before step()
    void prepare()
    {
        if (model != 0)
        {
            b.prepare();
            prepared = 1;
        }
    }

    // A signature of the builder's description: what rebuilds under the fade. The kinds and the tables, and of each
    // size only whether it is its own or the layout's (0; for the muffler's size, -1; a collector's volume and the
    // primaries' step: whether there is one): the sizes themselves glide (XBuild::glide). Not the valve's rule, which
    // it follows as it goes.
    float on(float v)
    {
        return v > 0.0f ? 1.0f : 0.0f;
    }

    float sig()
    {
        const ExhaustSpec* p = spec;
        float h = 0.0f;
        float w = 1.0f;
        for (int i = 0; i < MAX_PORTS; ++i)
        {
            h += w * ((float)p->primaryTo[i] + 3.1f * on(p->primLen[i]) + 7.3f * on(p->primD[i]));
            w *= 1.0173f;
        }
        for (int c = 0; c < MAX_COLLECTORS; ++c)
        {
            h += w * ((float)p->collectorTo[c] + 3.1f * on(p->colLen[c]) + 7.3f * on(p->colD[c])
                      + 1000.0f * (p->colVol[c] > 1.0e-6f ? 1.0f : 0.0f));
            w *= 1.0173f;
        }
        for (int s = 0; s < MAX_SIDES; ++s)
        {
            h += w * (on(p->mainLen[s]) + 3.7f * on(p->mainD[s]) + 5.1f * (float)p->converter[s]
                      + 7.9f * (float)p->resonator[s] + 2.3f * on(p->resD[s]) + 11.3f * (float)p->mufKind[s]
                      + 0.7f * (p->mufSize[s] >= 0.0f ? 1.0f : 0.0f) + 2.9f * on(p->mufLen[s])
                      + 13.7f * (float)p->bypass[s] + 1.3f * on(p->tailLen[s]) + 4.1f * on(p->tailD[s])
                      + 17.1f * (float)p->tips[s] + 19.3f * (float)p->exitAt[s]);
            w *= 1.0173f;
        }
        h += w * (2.0f * (p->primStepAt > 0.01f ? 1.0f : 0.0f) + 5.0f * (float)p->sides + 7.0f * (float)p->crossKind
                  + 11.0f * (float)p->crossAt + 13.0f * on(p->crossD) + 29.0f * on(p->bypassD));
        return h;
    }

    // Every 16 samples: has the description moved? A change of model, or of the builder's description while it runs,
    // waits for the fade
    void checkSpec()
    {
        if (spec->heatSettle != seenSettle)
        {
            seenSettle = spec->heatSettle;
            settleHeat();
        }
        if (spec->rev == seenRev && wanted() == model)
            return;
        seenRev = spec->rev;
        const int m = wanted();
        if (m != model)
            want = 1;
        else if (m != 0 && sig() != seenSig)
            want = 1;
    }

    // The fade around a change: down, the change at its quiet, up
    void fade()
    {
        if (want != 0)
        {
            fadeG -= fadeDn;
            if (fadeG <= 0.0f)
            {
                fadeG = 0.0f;
                apply();
                want = 0;
            }
        }
        else
            fadeG = fminf(fadeG + fadeUp, 1.0f);
        outL *= fadeG;
        outR *= fadeG;
        shell[0] *= fadeG;
        shell[1] *= fadeG;
    }

    // The change, at the fade's quiet: the model the Spec asks for, its system built from rest (the heat kept)
    void apply()
    {
        model = wanted();
        for (int i = 0; i < MAX_PORTS; ++i)
            qSur[i] = 0.0f;
        if (model != 0)
        {
            fillEngine();
            noiseLike();
            b.build(0, heat->warm, 1);
            builtWith();
            seenSig = sig();
            nDuals = b.channels();
            tUse[0] = b.heat.tUse[XH_PRIM];
        }
        else
        {
            clear();
            needBuild = 1;
            nDuals = lay->topo == 2 ? 2 : 1;
            refPipes(boreNow, aspNow, smTbNow, smTsNow, rate);
        }
    }

    // Card C's settle (spec.exhaust.heatSettle): the gas at the ports where the cylinders now put it, the mass flow at
    // its present mean, and every wall of the exhaust where that gas and the air outside hold it (the soak run on over
    // some 20 minutes in 3 s steps), the pipes then set to the gas: what a long run at this load leaves. Either model.
    void settleHeat()
    {
        if (mCyc[1] > 1.0e-7f)
        {
            tPort = tCyc[1] > 0.0f ? tCyc[1] : eCyc[1] / mCyc[1];
            mdotSlow = mCyc[1];
        }
        else
        {
            if (tPortNow > 0.0f)
                tPort = tPortNow;
            mdotSlow = mdot;
        }
        portLoss(0.0f);
        if (model != 0)
        {
            fillEngine();
            for (int it = 0; it < 400; ++it)
                b.heat.soak(exitTemperature(), mdotSlow, 3.0f, heat->tAmb, vAirNow);
            for (int i = 0; i < XH_SECT; ++i)
                b.heat.tUse[i] = b.heat.tGas[i];
            tUse[0] = b.heat.tUse[XH_PRIM];
            b.shape();
            return;
        }
        for (int it = 0; it < 400; ++it)
            soak(tPort, mdotSlow, 3.0f, boreNow, vAirNow);
        atRestBuild = 0;
        for (int i = 0; i < 5; ++i)
            tUse[i] = tGas[i];
        refPipes(boreNow, aspNow, smTbNow, smTsNow, rate);
    }

    // Card H: the gas's temperature where a bank's bangs light (K)
    float gasTemperature(int bank)
    {
        return model != 0 ? b.gasTemperature(bank) : tGas[1];
    }

    // Every 16 samples: tel.exhaust's fields, and every 128 samples the Scope's exhaust arrays
    void writeTelemetry()
    {
        ExhaustTel* t = telOut;
        t->model = model;
        t->headerTemperature = model != 0 ? b.heat.tGas[XH_PRIM] : tGas[0];
        if (pPortN > 0)
        {
            pPortMean += (pPortSum / (float)pPortN - pPortMean) * kPort;
            pPortSum = 0.0f;
            pPortN = 0;
        }
        t->portPressure = 101325.0f + pPortMean;
        t->portHeat = qPort;
        if (tcN > 0)
        {
            const float tb = tcWT / fmaxf(tcW, 1.0e-9f);
            const float tp = tcT / (float)tcN;
            tcPort = tcPort > 0.0f ? tcPort + (tb - tcPort) * kTc : tb;
            tcPlain = tcPlain > 0.0f ? tcPlain + (tp - tcPlain) * kTc : tp;
            tcUMean += (tcU / (float)tcN - tcUMean) * kTc;
            tcU = 0.0f;
            tcW = 0.0f;
            tcWT = 0.0f;
            tcT = 0.0f;
            tcN = 0;
        }
        // (before the bead's mean has had a sample, the gas's own: physical from the first block)
        const float tcNow = tcPort > 0.0f ? tcPort : exitTemperature();
        t->portThermocouple = bead(tcNow, tWallPort);
        // the system as built, element by element (the builder is built at every configure, in model 0 too, as the
        // reference's topology): for what it costs (docs/models/exhaust.md, "What the network costs, by element")
        int nNode = 0;
        int nPair = 0;
        int nEnd = 0;
        for (int j = 0; j < b.net.nj; ++j)
        {
            if (b.net.jKind[j] == XJ_NODE)
                nNode += 1;
            else if (b.net.jKind[j] == XJ_PAIR)
                nPair += 1;
            else if (b.net.jKind[j] == XJ_OPEN)
                nEnd += 1;
        }
        t->pipes = b.net.nUsed;
        t->nodes = nNode;
        t->pairs = nPair;
        t->openEnds = nEnd;
        t->headerThermocouple = bead(tcNow + (t->headerTemperature - exitTemperature()),
                                     model != 0 ? b.heat.tWall[XH_PRIM] : tWall[0]);
        t->portCoolantHeat = qCool;
        t->portWallTemperature = tWallPort;
        t->portExitTemperature = exitTemperature();
        t->flap = flapFitted() != 0 ? b.fEff[0] : 0.0f;
        t->pFlap = flapFitted() != 0 ? b.pFl[0] : 0.0f;
        {
            int nRaised = 0;
            t->boreRaised = model != 0 ? b.boresRaised(&nRaised) : 0;
            t->boresRaised = model != 0 ? nRaised : 0;
        }
        const int bangs = model != 0 && b.bangOn != 0 ? 1 : 0;
        t->bangHeat = bangs != 0 ? b.bangRate : 0.0f;
        t->bangTime = bangs != 0 ? b.bangTau : 0.0f;
        t->bangEnergy = bangs != 0 ? b.bangHeat : 0.0f;
        const int secOfRef[7] = {0, 1, -1, 2, -1, 3, 4};
        for (int i = 0; i < 7; ++i)
        {
            if (model != 0)
            {
                t->gasTemperature[i] = b.heat.on[i] != 0 ? b.heat.tGas[i] : 0.0f;
                t->wallTemperature[i] = b.heat.on[i] != 0 ? b.heat.tWall[i] : 0.0f;
                t->mach[i] = b.mach[i];
            }
            else
            {
                const int r = secOfRef[i];
                t->gasTemperature[i] = r >= 0 ? tGas[r] : 0.0f;
                t->wallTemperature[i] = r >= 0 ? tWall[r] : 0.0f;
                t->mach[i] = 0.0f;
            }
        }
        if (model == 0)
        {
            t->mach[0] = prim[0].mach;
            t->mach[1] = sec[0].mach;
            t->mach[3] = pipe[0].mach;
            t->mach[5] = ch1[0].mach;
            t->mach[6] = tail[0].mach;
            t->pTurbine = 0.0f;
            t->ends = nDuals;
            for (int s = 0; s < 2; ++s)
            {
                t->pConverter[s] = 0.0f;
                t->pMuffler[s] = 0.0f;
                t->valve[s] = 0.0f;
            }
            for (int e = 0; e < 24; ++e)
            {
                t->endLevel[e] = 0.0f;
                t->endTag[e] = nDuals == 2 ? (e == 0 ? XTAG_REAR_L : XTAG_REAR_R) : XTAG_REAR_C;
                t->endSlot[e] = -1;
            }
            t->flame = 0;
            return;
        }
        t->pTurbine = b.pTurb;
        for (int s = 0; s < 2; ++s)
        {
            t->pConverter[s] = b.pConv[s];
            t->pMuffler[s] = b.pMuf[s];
            t->valve[s] = b.vPos[s];
        }
        t->ends = b.net.ne;
        for (int e = 0; e < 24; ++e)
        {
            if (e < b.net.ne)
            {
                t->endLevel[e] = 4.3429448f * logf(fmaxf(b.net.ends[e].lev, 1.0e-12f));
                t->endTag[e] = b.net.ends[e].tag;
                t->endSlot[e] = b.net.ends[e].duct;
            }
            else
            {
                t->endLevel[e] = -120.0f;
                t->endTag[e] = 0;
                t->endSlot[e] = -1;
            }
        }
        // a bang burns near a tail when a pop is crackling and the tail's gas is hot
        // (Burned in the pipe draws no crackle: a burn in the collectors is its flame)
        const int burning = (pop[0].crackle > 1.0f || pop[1].crackle > 1.0f || (model != 0 && b.bangRate > 0.0f)) ? 1 : 0;
        t->flame = burning != 0 && b.heat.tGas[XH_TAIL] > 700.0f ? 1 : 0;
        tick128 += 1;
        if (tick128 >= 8)
        {
            tick128 = 0;
            writeScope();
        }
    }

    void writeScope()
    {
        Scope* o = scopeOut;
        b.scope();
        o->exhaustPoints = XB_SCOPE;
        for (int n = 0; n < XB_SCOPE; ++n)
        {
            o->exhaustX[n] = b.scopeX[n];
            o->exhaustPressure[n] = b.scopeP[n];
        }
        for (int i = 0; i < XN_DUCTS; ++i)
        {
            const Duct* d = &b.net.d[i];
            o->ductUsed[i] = b.net.dUse[i];
            o->ductLength[i] = b.net.dUse[i] != 0 ? d->len : 0.0f;
            o->ductNear[i] = b.net.dUse[i] != 0 ? d->near + b.net.nearIn[i] : 0.0f;
            o->ductFar[i] = b.net.dUse[i] != 0 ? d->far + b.net.farIn[i] : 0.0f;
            // the middle: the outgoing wave written half the delay ago plus the returning one written half its delay ago
            float pm = 0.0f;
            if (b.net.dUse[i] != 0)
            {
                int jf = d->w - 1 - d->di / 2;
                int jb = d->w - 1 - d->bdi / 2;
                if (jf < 0)
                    jf += d->cap;
                if (jb < 0)
                    jb += d->cap;
                pm = d->fw[jf] + d->bw[jb];
            }
            o->ductMid[i] = pm;
        }
        o->exhaustRefreshes += 1;
    }

    // ---- the integrator's hooks (sim/README.md) ----
    // A bang of unburned fuel in a bank's collector, its amplitude (Pa, as Pop::fire's): the bank's Pop, which both
    // models tick at that bank's collector
    void popAt(int bank, float amplitude)
    {
        const int k = bank <= 0 ? 0 : 1;
        pop[k].fire(amplitude, rate, 99 + k);
    }
};
