// exhaust/exhaust.fm: the exhaust (module Exhaust). Owner: package G.
//
// Every pipe after a port, as waveguides (exhaust/duct.fm): each cylinder's header (a rotary's: one a rotor) into its
// bank's collector (or one for all), the collectors' pipes merging (topology 0: all into one pipe; 1: each bank its own
// collector, then one pipe; 2: two pipes with an H-pipe between them), the catalytic converter at each main pipe's head
// (a resistance in series, its monolith taking the highs), the muffler (a chamber, a perforated tube, a chamber: from a
// straight-through can to big packed chambers), the tail and its open end into the air (Silva et al.'s reflection, for
// its hot gas). Each junction loses what its change of area does (K 1/2 rho u|u|, quasi-steadily: node, lossHold), and
// makes the flow noise of its jet breaking up there; the tail's jet adds its own; a pop (exhaust/pop.fm) is a
// collector's own gas. The gas's temperature down the system and the pipes' walls follow the load over seconds to
// minutes (soak), and the pipes' lengths and losses follow the gas (pipes, every 16 samples). What leaves each tail is
// its radiation (outL, outR: the rate the flow out changes). The reference's explanations stand with each part below.
// What it leaves out: the waves' own steepening on the way back, the pipes' bends and their cross modes, the
// turbine's work on the waves (Boost's restriction stands for it), resonators and valves (package G's).
//
//   setup(rate, noise, layout, heat) in init; release() in end; clear() a new engine's pipes at rest
//   soak(tIn, m, dt, bore, vAir)       the system's heat over dt seconds (the gas tIn at the ports, m kg/s)
//   pipes(bore, asp, smTb, smTs, rate) the pipes' sizes for the layout and the dials, their lengths for the gas now
//   flowRate(), gas(d16), heatUp(d16, bore, vAir), flow16(), bands()   every 16 samples, in that order around Engine's
//                                      boost and cylinder updates (sim/README.md)
//   read()                             each sample, first
//   step(qe, np)                       each sample, after the cylinders: everything from the ports to the tails
// Its state read by others: prim[] (the cylinders' exhaust ends), tUse[0] (the headers' gas), outL, outR, shell[]
// (the headers' walls, for the engine bay), mdot, tPort; the cylinders add to eSum and mSum.
#pragma once
#include "exhaust/duct.fm"
#include "exhaust/pop.fm"
#include "lib/biquad.fm"
#include "lib/onepole.fm"
#include "lib/noise.fm"
#include "core/layouts.fm"
#include "core/heat.fm"

module Exhaust
{
    float rate;
    Noise* noiseSrc;    // Engine's noise (the reference's one stream)
    Layout* lay;
    Heat* heat;
    Duct prim[12];      // the headers (a rotary's: one a rotor)
    Duct sec[2];        // from each bank's collector
    Duct pipe[2];       // the main pipe (two, when dual)
    Duct ch1[2];        // the muffler: a chamber, a tube, a chamber
    Duct mid[2];
    Duct ch2[2];
    Duct tail[2];
    Duct cross;         // between the two pipes (an H-pipe), when dual
    Pop pop[2];
    float smMuf;
    float smHdr;
    float smPipe;
    float smXp;
    int nDuals;         // pipes after the collectors: 1 or 2
    int portBank[12];   // each port's bank
    float tPort;        // the exhaust gas's temperature at the ports (smoothed), K
    float eSum;
    float mSum;
    float radPrev[2];
    Biquad endR[2];     // each tail's open end: the wave it sends back (Silva et al.'s reflection, for its hot gas)
    float outL;
    float outR;
    float noiseTrim;    // the flow's and the jet's noise against it (see configure)
    OnePole vnHp;       // the valves' jet noise: white noise, its lows taken out
    OnePole tnHp[2];    // the tail's jet: noise in a band
    OnePole tnLp[2];
    float mdot;         // the exhaust's mass flow, kg/s (smoothed)
    OnePole fnHp[8];
    OnePole fnLp[8];
    OnePole fnLp2[8];
    float fnN[8];       // each band's unit strength
    float fnG[8];       // this sample's noise in each band (0, 1: the collectors; 2, 3: the cones; 4, 5: the
    float flowK;
    float qHd[12];      // the last sample's flows: each header into its collector, each main pipe away from its cone,
    float qPp[2];       // each muffler's inlet and outlet
    float qM1[2];
    float qM4[2];
    float kInM;         // the loss coefficients the noise goes by: the muffler's inlet, its outlet
    float kOutM;
    float tGas[5];
    float tWall[5];
    float tUse[5];
    float mdotSlow;     // the exhaust's mass flow over half a second
    float kUse;
    float kMdot;
    float shell[2];     // the headers' walls ringing (the collectors' pressure), for the engine bay
    OnePole shellHp[2];
    float jetK;
    float jetA;
    float qJet[2];      // the flow out of the tail, smoothed: the jet's speed
    float valveK;
    float kHin;         // a header's flow into its collector, and back out of it
    float kHout;
    float kSin;         // a collector's pipe into the merge, and back
    float kSout;
    float kXp;          // the H-pipe's ends
    float rCat;         // the converter at the main pipe's head: a resistance in series, Pa s / m^3
    float rPerf;        // the muffler's perforated tube or baffles, where the gas passes from chamber to tube and on
    float kMuf[8];      // the muffler's four changes of area (pipe to chamber, chamber to tube, tube to chamber, chamber
    float kExit[2];     // the tail's open end: the jet out (its momentum lost), the air drawn in
    float sHd[12];      // each junction's drive, its slow part (the losses act on it: quasi-steady): the headers' ends,
    float sMg[2];       // the collectors' pipes at the merge, the H-pipe's ends, the muffler's four changes of area each
    float sXp[2];       // side, the tails' ends
    float sMf[8];
    float sEx[2];
    float xiWall;       // the pipes' friction factor
    float k16Flow;      // the flow's loss's smoothing, every 16 samples
    OnePole vnLp;       // (the valves' jet noise past hearing taken out)
    float jetN[2];      // what makes that band's noise of unit strength, whatever its width and the sample rate
    float nScale;       // white noise's strength for the same loudness at any sample rate

    void setup(float rateIn, Noise* noise, Layout* layIn, Heat* heatIn)
    {
        rate = rateIn;
        noiseSrc = noise;
        lay = layIn;
        heat = heatIn;
        // the longest each pipe could be, cold (330 m/s), at this rate
        const float k = rate / 300.0f;
        for (int i = 0; i < 12; ++i)
            prim[i].configure((int)(3.0f * k) + 16);
        for (int i = 0; i < 2; ++i)
        {
            sec[i].configure((int)(1.0f * k) + 16);
            pipe[i].configure((int)(4.6f * k) + 16);
            ch1[i].configure((int)(0.9f * k) + 16);
            mid[i].configure((int)(0.5f * k) + 16);
            ch2[i].configure((int)(0.7f * k) + 16);
            tail[i].configure((int)(1.0f * k) + 16);
            pop[i].rs = 1000 + 7777 * i;
        }
        cross.configure((int)(0.6f * k) + 16);
        for (int i = 0; i < 2; ++i)
            shellHp[i].set(500.0f, rate);
        vnHp.set(700.0f, rate);
        vnLp.set(20000.0f, rate);
        nScale = sqrtf(rate / 48000.0f);
        jetA = 1.0f - expf(-1.0f / (0.06f * rate));
        for (int i = 0; i < 2; ++i)
            jetBand(i, 300.0f);
        // (the free jet's own mixing noise is weak at a tailpipe's speeds: most of the roar is made inside, at the
        // junctions, and comes out shaped by the pipes; the two together as bright as the jet alone was)
        jetK = 0.005f;
        flowK = 0.017f;
        valveK = 0.15f;
        xiWall = 0.025f;
        k16Flow = 1.0f - expf(-16.0f / (0.06f * rate));
        kUse = 1.0f - expf(-16.0f / (0.3f * rate));
        kMdot = 1.0f - expf(-16.0f / (0.5f * rate));
    }

    void release()
    {
        for (int i = 0; i < 12; ++i)
            prim[i].release();
        for (int i = 0; i < 2; ++i)
        {
            sec[i].release();
            pipe[i].release();
            ch1[i].release();
            mid[i].release();
            ch2[i].release();
            tail[i].release();
        }
        cross.release();
    }

    // A new engine: every pipe and junction at rest
    void clear()
    {
        for (int i = 0; i < 12; ++i)
        {
            prim[i].clear();
        }
        for (int i = 0; i < 2; ++i)
        {
            sec[i].clear();
            pipe[i].clear();
            ch1[i].clear();
            mid[i].clear();
            ch2[i].clear();
            tail[i].clear();
            radPrev[i] = 0.0f;
            endR[i].clear();
        }
        for (int i = 0; i < 12; ++i)
        {
            sHd[i] = 0.0f;
            qHd[i] = 0.0f;
        }
        for (int i = 0; i < 2; ++i)
        {
            qPp[i] = 0.0f;
            qM1[i] = 0.0f;
            qM4[i] = 0.0f;
        }
        for (int g = 0; g < 8; ++g)
        {
            fnG[g] = 0.0f;
            flowBand(g, 300.0f);
        }
        for (int i = 0; i < 8; ++i)
            sMf[i] = 0.0f;
        for (int i = 0; i < 2; ++i)
        {
            sMg[i] = 0.0f;
            sXp[i] = 0.0f;
            sEx[i] = 0.0f;
        }
        // each layout's loudness, measured: so they come out alike at speed
        cross.clear();
    }

    // The exhaust's heat (dt seconds on): the gas leaves the ports at tIn and cools along the system toward each part's
    // wall, keeping exp(-NTU) of its excess through a part (NTU from turbulent pipe flow's heat transfer, Dittus and
    // Boelter's: 0.0135 L / (m^0.2 D^0.8) for exhaust gas a branch carrying m kg/s; more in the pulsing headers and
    // the muffler's chambers). Each wall heats or cools toward where the gas inside and the air outside hold it
    // (convection, more with the car's speed, and radiation), over tens of seconds to minutes: its steel's heat over
    // what it exchanges. So the gas is hot near the engine and cooler down the system, much hotter at full throttle
    // than at idle, and the downstream parts take their time to follow.
    void soak(float tIn, float m, float dt, float bore, float vAir)
    {
        const float hk = expf(0.9808293f * (smHdr - 0.5f));
        const float pk = expf(1.3862944f * (smPipe - 0.5f));
        const float dHead = 0.46f * bore;
        const float dSec = lay->topo == 0 ? lay->pipeD : 0.922f * lay->pipeD;
        float len[5];
        float dia[5];
        float br[5];
        len[0] = lay->hdr * hk;
        len[1] = lay->bike > 0.5f ? 0.25f : 0.38f;
        len[2] = lay->mainLen * pk;
        len[3] = lay->muff * 1.6f + 0.12f + 0.08f * (1.0f - lay->bike);
        len[4] = lay->bike > 0.5f ? 0.10f : 0.40f;
        dia[0] = dHead;
        dia[1] = dSec;
        dia[2] = lay->pipeD;
        dia[3] = lay->pipeD;
        dia[4] = lay->tailD;
        br[0] = (float)lay->ports;
        br[1] = lay->topo == 0 ? 1.0f : 2.0f;
        br[2] = (float)nDuals;
        br[3] = (float)nDuals;
        br[4] = (float)nDuals;
        const float enh[5] = {1.5f, 1.2f, 1.0f, 2.0f, 1.0f};
        const float shellK[5] = {1.0f, 1.0f, 1.0f, 4.0f, 1.0f};      // the outside's area over the inside's
        const float hCap[5] = {9000.0f, 6000.0f, 12000.0f, 10000.0f, 5000.0f};  // J / (m^2 K) of the outside
        float t = tIn;
        for (int i = 0; i < 5; ++i)
        {
            const float mb = fmaxf(m / br[i], 2.0e-5f);
            const float ntu = 0.01352f * enh[i] * len[i] * expf(-0.2f * logf(mb) - 0.8f * logf(dia[i]));
            const float e = expf(-ntu);
            const float tw = tWall[i];
            tGas[i] = tw + (t - tw) * (1.0f - e) / ntu;
            t = tw + (t - tw) * e;
            const float sOut = 3.14159265f * dia[i] * len[i] * shellK[i];
            const float gIn = ntu * mb * 1150.0f;
            const float gOut = (20.0f + 4.0f * vAir + 4.536e-8f * (tw * tw + heat->tAmb * heat->tAmb) * (tw + heat->tAmb)) * sOut;
            const float tEq = (gIn * tGas[i] + gOut * heat->tAmb) / (gIn + gOut);
            tWall[i] = tw + (tEq - tw) * fminf(dt * (gIn + gOut) / (hCap[i] * sOut), 1.0f);
        }
    }

    // Where a muffler's scattering starts taking the highs (Hz): some 500 Hz, or in a short pipe half its own first
    // resonance (c / 2L), so that the delay its shelves add at the lows fits in its line (c: m/s, len: m)
    float backFc(float c, float len)
    {
        return fmaxf(500.0f, 0.25f * c / fmaxf(len, 0.01f));
    }

    // The pipes' sizes for the layout and the dials, and their lengths in samples at the gas's temperatures now
    void pipes(float bore, int aspUse, float smTb, float smTs, float rate)
    {
        const float hk = expf(0.9808293f * (smHdr - 0.5f));     // headers: 0.61 to 1.63 times
        const float pk = expf(1.3862944f * (smPipe - 0.5f));        // pipe: half to twice
        const float dHead = 0.46f * bore;
        const float aHead = 0.785398f * dHead * dHead;
        const float aPipe = 0.785398f * lay->pipeD * lay->pipeD;
        const float aTail = 0.785398f * lay->tailD * lay->tailD;
        const float aSec = lay->topo == 0 ? aPipe : 0.85f * aPipe;
        // the gas cools as it goes, and heats and cools with the load (soak): the pipes follow it slowly, so the
        // system's resonances move with the heat over seconds, never with the pulses
        const float tH = tUse[0];
        const float tS = tUse[1];
        const float tP = tUse[2];
        const float tM = tUse[3];
        const float tT = tUse[4];
        const float cH = sqrtf(1.35f * 287.0f * tH);
        const float cS = sqrtf(1.35f * 287.0f * tS);
        const float cP = sqrtf(1.35f * 287.0f * tP);
        const float cM = sqrtf(1.35f * 287.0f * tM);
        const float cT = sqrtf(1.35f * 287.0f * tT);
        // the muffler: from a straight-through tube (0) to big packed chambers (1)
        const float mu = smMuf;
        const float ratio1 = 1.0f + 15.0f * mu;
        const float ratio2 = 1.0f + 9.0f * mu;
        // below about a third it is a straight-through can (a perforated tube through a packed shell: the gas keeps to
        // the tube, so it loses little to its flow), above it chambers the gas expands into and out of (the losses of
        // those changes of area, and the back pressure they make); packed throughout, more with the dial. The packing
        // takes the highs (porous fill), less as the flow past the perforations grows (they choke with grazing flow).
        const float chamb = fminf(fmaxf((mu - 0.25f) / 0.35f, 0.0f), 1.0f);
        const float chambs = chamb * chamb * (3.0f - 2.0f * chamb);
        const float graze = 1.0f / (1.0f + 1.5f * ch1[0].mach);
        const float lk1 = (lay->muff / 0.45f) * graze;
        const float lk2 = 0.6f * lk1;
        const float dPipe = lay->pipeD;
        // what the model does not resolve takes a share of each pass, whatever the level: the converter's narrow
        // channels (their broadband absorption: some 2.3 dB a pass), the packing's lows, the bends, welds and slip
        // joints, the turbulent boundary layer's damping (some 1.1 dB through a header). Without it the system rings at
        // low flow as no real one does, and the losses that grow with the flow leave the level rising too little with
        // the revs.
        const float keepH = 0.878f;
        const float keepP = 0.769f;
        for (int i = 0; i < lay->ports; ++i)
        {
            // each header a little different, as real ones are; the second bank of an unequal-length boxer much longer
            const int b = portBank[i];
            const float own = 1.0f + 0.06f * (float)((i * 7) % 5 - 2) / 2.0f;
            const float len = lay->hdr * hk * own * (b == 1 ? lay->hdrBank1 : 1.0f);
            prim[i].set(len, dHead, aHead, cH, rate);
            prim[i].extra(0.0f, keepH, rate);
            prim[i].steep = 0.87f / 101325.0f;
        }
        // (a turbo's turbine sits at each collector: a restriction that smooths the pulses; one turbo for the engine is
        // the most of both, twins less, four between; a supercharger leaves the exhaust free)
        // (a smaller turbine than the match chokes more and smooths less: its housing's volume; as the root of its size)
        const float tb = aspUse >= 1 && aspUse <= 3 ? smTb : 0.0f;
        const float tsr = expf(-0.5f * logf(smTs));
        const float aS = aSec * fmaxf(1.0f - (aspUse == 2 ? 0.45f : (aspUse == 3 ? 0.5f : 0.55f)) * tb * tsr, 0.15f);
        const float tbHz = tb > 0.001f ? (1320.0f + 22680.0f * (1.0f - tb) * (1.0f - tb) * (1.0f - tb)) * (aspUse == 2 ? 1.25f : (aspUse == 3 ? 1.1f : 1.0f)) * tsr : 0.0f;
        for (int k = 0; k < 2; ++k)
        {
            sec[k].set(lay->bike > 0.5f ? 0.25f : 0.38f, sqrtf(aS * 1.2732395f), aS, cS, rate);
            sec[k].extra(tbHz, 1.0f, rate);
            sec[k].steep = 0.87f / 101325.0f;
            const float pl = lay->mainLen * pk;
            pipe[k].set(pl, dPipe, aPipe, cP, rate);
            pipe[k].extra(0.0f, keepP, rate);
            // (the converter's monolith: its narrow channels' walls take the highs, about as the root of the frequency:
            // some 2.5 dB at 1 kHz, 5 at 4 kHz, 7.5 at the top each way)
            pipe[k].pack(700.0f, 2.5f, 4000.0f, 5.0f, rate);
            pipe[k].steep = 0.87f / 101325.0f;
            ch1[k].set(lay->muff, dPipe * sqrtf(ratio1), aPipe * ratio1, cM, rate);
            ch1[k].extra(0.0f, expf(0.8f * logf(0.92f - 0.25f * mu)), rate);
            ch1[k].pack(1100.0f, (1.5f + 5.0f * mu) * lk1, 5000.0f, (3.0f + 14.0f * mu) * lk1, rate);
            mid[k].set(0.12f + 0.08f * (1.0f - lay->bike), dPipe, aPipe, cM, rate);
            mid[k].extra(0.0f, 0.935f, rate);
            ch2[k].set(0.6f * lay->muff, dPipe * sqrtf(ratio2), aPipe * ratio2, cM, rate);
            ch2[k].extra(0.0f, expf(0.8f * logf(0.93f - 0.20f * mu)), rate);
            ch2[k].pack(1100.0f, (1.5f + 5.0f * mu) * lk2, 5000.0f, (3.0f + 14.0f * mu) * lk2, rate);
            tail[k].set(lay->bike > 0.5f ? 0.10f : 0.40f, lay->tailD, aTail, cT, rate);
            tail[k].extra(0.0f, 0.960f, rate);
            // what the muffler sends back loses its highs: above some 500 Hz its reflections scatter into its chambers'
            // cross modes and the packing takes them (up to 40 dB a pass, as strongly as its changes of area reflect),
            // so its chambers, its tube, the tail and the pipe before it no longer ring there as a comb. Their lows
            // ring as they did. (A short pipe's from higher up, where its own first resonances are.)
            const float sc1 = 40.0f * (1.0f - 1.0f / ratio1);
            const float sc2 = 40.0f * (1.0f - 1.0f / ratio2);
            pipe[k].back(backFc(pipe[k].c, pipe[k].len), sc1, rate);
            ch1[k].back(backFc(ch1[k].c, ch1[k].len), sc1, rate);
            mid[k].back(backFc(mid[k].c, mid[k].len), sc2, rate);
            ch2[k].back(backFc(ch2[k].c, ch2[k].len), sc2, rate);
            tail[k].back(backFc(tail[k].c, tail[k].len), sc2, rate);
        }
        const float xa = fmaxf(smXp, 0.001f);
        cross.set(0.25f, dPipe * sqrtf(xa), xa * aPipe, cP, rate);
        cross.extra(0.0f, 0.960f, rate);
        // the junctions' losses: a header merging into its collector (and the flow pushed back into it), the collectors'
        // pipes merging, the H-pipe's sharp-edged ends, the muffler's sudden expansions ((1 - a/A)^2 on the narrow side's
        // speed) and contractions (about half of 1 - a/A), the tail's jet
        const float rhoH = prim[0].rho;
        const float rhoS = sec[0].rho;
        const float rhoM = ch1[0].rho;
        kHin = lossKap(0.25f, rhoH, aHead);
        kHout = lossKap(0.45f, rhoH, aHead);
        kSin = lossKap(0.15f, rhoS, aS);
        kSout = lossKap(0.30f, rhoS, aS);
        kXp = lossKap(0.5f, sec[0].rho, xa * aPipe);
        const float e1 = 1.0f - 1.0f / ratio1;
        const float e2 = 1.0f - 1.0f / ratio2;
        const float aCh2 = aPipe * ratio2;
        const float e3 = 1.0f - fminf(aTail / aCh2, 1.0f);
        kMuf[0] = lossKap(chambs * e1 * e1, rhoM, aPipe);   // pipe into the first chamber: an expansion
        kMuf[1] = lossKap(chambs * 0.5f * e1, rhoM, aPipe); // and back: a contraction
        kMuf[2] = lossKap(chambs * 0.5f * e1, rhoM, aPipe); // the first chamber into the tube
        kMuf[3] = lossKap(chambs * e1 * e1, rhoM, aPipe);
        kMuf[4] = lossKap(chambs * e2 * e2, rhoM, aPipe);   // the tube into the second chamber
        kMuf[5] = lossKap(chambs * 0.5f * e2, rhoM, aPipe);
        kMuf[6] = lossKap(0.5f * e3, rhoM, aTail);          // the second chamber into the tail
        kMuf[7] = lossKap(e3 * e3, rhoM, aTail);
        kInM = fmaxf(chambs * e1 * e1, 0.1f);           // (a straight-through's perforates still hiss)
        kOutM = fmaxf(0.5f * e3, 0.1f);
        kExit[0] = lossKap(1.0f, tail[0].rho, aTail);
        kExit[1] = lossKap(0.5f, tail[0].rho, aTail);
        // the muffler's perforations: the gas passes through them between the chambers and the tube, a resistance of
        // a twentieth to a fifth of the gas's rho c (more holes' worth of resistance in a more restrictive can)
        rPerf = (0.05f + 0.15f * mu) * ch1[0].rho * cM / aPipe;
        // the converter: a monolith's flow resistance (some 60 Pa s/m across it at 700 K with its cones, growing with
        // the gas's viscosity: a few kPa at full power), over the pipe's area
        rCat = 60.0f * expf(0.7f * logf(tP / 700.0f)) / aPipe;
        // the open end's reflection: Silva et al.'s fit to an unflanged pipe's (within 8 % to ka = 2), R = -(1 + 0.167
        // ts) / (1 + 1.393 ts + 0.457 t^2 s^2), t = a / c in the air outside, for the hot gas inside: the air's rho c
        // over the gas's (kEnd, about 1.6 at 750 K) multiplies the radiation's impedance z, so the end holds more of the
        // cold air's mass (a longer end correction) and lets more out: R = (kEnd z - 1) / (kEnd z + 1), z from the fit.
        // By the bilinear transform.
        const float aEnd = 0.5f * lay->tailD;
        const float tau = aEnd / 347.2f;
        const float kEnd = 1.018f * sqrtf(tT / heat->tAmb);
        const float nb1 = (0.613f * kEnd - 0.78f) * tau;
        const float nb2 = 0.2285f * (kEnd - 1.0f) * tau * tau;
        const float da1 = (0.613f * kEnd + 0.78f) * tau;
        const float da2 = 0.2285f * (kEnd + 1.0f) * tau * tau;
        const float kb = 2.0f * rate;
        const float kb2 = kb * kb;
        for (int k = 0; k < 2; ++k)
            endR[k].design(-1.0f + nb1 * kb + nb2 * kb2, -2.0f - 2.0f * nb2 * kb2, -1.0f - nb1 * kb + nb2 * kb2,
                           1.0f + da1 * kb + da2 * kb2, 2.0f - 2.0f * da2 * kb2, 1.0f - da1 * kb + da2 * kb2);
    }

    // The converter's cone's (and the merging's) flow noise for main pipe k: K 0.6 on the pipe's own speed
    float coneNoise(int k)
    {
        const float u = qPp[k] / pipe[k].area;
        return flowK * noiseTrim * 0.6f * 0.5f * pipe[k].rho * u * u * fnG[2 + k];
    }

    // A node where n pipe ends meet (a merge, a collector): a[i] the waves arriving there, z[i] each branch's impedance
    // (with any resistance in series), kf[i] and kr[i] its loss for flow into the node and out of it (lossKap), sl[i]
    // its drive's slow part and al[i] that part's smoothing, src a volume flow the node makes itself (a pop's gas).
    // The losses act on the slow part (quasi-steady, as separated flow does below a Strouhal number of about 0.2), from
    // the last sample's, so the node solves in one pass and stays passive. Leaves each branch's flow into the node in
    // q[i] (and its slow part updated in sl[i]); returns the node's pressure.
    float node(int n, float* a, float* z, float* kf, float* kr, float* sl, float* al, float* q, float src)
    {
        float sy = 0.0f;
        float sa = src;
        float h[14];
        for (int i = 0; i < n; ++i)
        {
            const float x = sl[i];
            h[i] = lossHold(x, z[i], x >= 0.0f ? kf[i] : kr[i]);
            sy += 1.0f / z[i];
            sa += 2.0f * a[i] / z[i] - h[i];
        }
        const float p = sa / sy;
        for (int i = 0; i < n; ++i)
        {
            const float d = 2.0f * a[i] - p;
            q[i] = d / z[i] - h[i];
            sl[i] += al[i] * (d - sl[i]);
        }
        return p;
    }

    // A flow noise's band about fPeak (from half of it; falling 12 dB an octave above twice it, as turbulence's
    // spectrum does), at unit strength (its equivalent bandwidth 1.005 fPeak)
    void flowBand(int g, float fPeak)
    {
        const float f = fminf(fmaxf(fPeak, 80.0f), 3000.0f);
        fnHp[g].set(0.5f * f, rate);
        fnLp[g].set(2.0f * f, rate);
        fnLp2[g].set(2.0f * f, rate);
        fnN[g] = sqrtf(rate / (0.67f * f));
    }

    // The tail's jet noise in a band about fPeak: from half of it up to three times it (one-pole slopes beyond), at unit
    // strength (the band's noise power: 2/3 / rate a Hz of white noise, over 4.04 fPeak of bandwidth)

    void jetBand(int k, float fPeak)
    {
        const float f = fminf(fmaxf(fPeak, 60.0f), 2500.0f);
        tnHp[k].set(0.5f * f, rate);
        tnLp[k].set(3.0f * f, rate);
        jetN[k] = sqrtf(rate / (2.693f * f));
    }

    // Every 16 samples: the exhaust's mass flow (from the ports' since the last time), for the turbo
    void flowRate()
    {
        mdot += (mSum / 16.0f - mdot) * 0.15f;         // (mSum: 16 samples of kg/s)
    }

    // Every 16 samples: the gas's temperature at the ports
    void gas(float d16)
    {
        // the exhaust's temperature: what the ports let out, slowly
        if (mSum > 1.0e-9f)
        {
            const float tNew = eSum / mSum;
            tPort += (tNew - tPort) * (1.0f - expf(-d16 / 0.8f));
        }
        else
            tPort += (heat->tAmb - tPort) * (1.0f - expf(-d16 / 4.0f));
        eSum = 0.0f;
        mSum = 0.0f;
    }

    // Every 16 samples: the system's heat (soak) and what the pipes are set to (vAir: the car's speed past them)
    void heatUp(float d16, float bore, float vAir)
    {
        mdotSlow += (mdot - mdotSlow) * kMdot;
        soak(tPort, mdotSlow, d16, bore, vAir);
        for (int i = 0; i < 5; ++i)
            tUse[i] += (tGas[i] - tUse[i]) * kUse;
    }

    // Every 16 samples, after pipes: the flow losses
    void flow16()
    {
        // the pipes' flow losses, from the mean speed of the gas through each since the last time
        for (int i = 0; i < lay->ports; ++i)
        {
            prim[i].flow16(xiWall, k16Flow);
        }
        for (int k = 0; k < 2; ++k)
        {
            sec[k].flow16(xiWall, k16Flow);
            pipe[k].flow16(xiWall, k16Flow);
            ch1[k].flow16(xiWall, k16Flow);
            mid[k].flow16(xiWall, k16Flow);
            ch2[k].flow16(xiWall, k16Flow);
            tail[k].flow16(xiWall, k16Flow);
        }
        cross.flow16(xiWall, k16Flow);
    }

    // Every 16 samples: the jet's and the flow noise's bands
    void bands()
    {
        // the jet's noise peaks where its Strouhal number is about 0.3 (0.3 times its speed over the pipe's width, as a
        // jet's mixing noise does; no higher than 2.5 kHz)
        for (int k = 0; k < nDuals; ++k)
        {
            const float u = fmaxf(qJet[k], 0.0f) / tail[k].area;
            jetBand(k, 0.3f * u / sqrtf(tail[k].area * 1.2732395f));
        }
        // the flow noise's bands: a Strouhal number of 0.4 on each flow's mean speed over its width, no higher than
        // 3 kHz (above it, the plane waves the pipes carry are no longer all the noise makes: it roars, it does not
        // hiss)
        const int nb = lay->topo == 0 ? 1 : 2;
        for (int k = 0; k < nb; ++k)
            flowBand(k, 0.4f * prim[0].mach * prim[0].c / prim[0].diam);
        for (int k = 0; k < nDuals; ++k)
        {
            flowBand(2 + k, 0.4f * pipe[k].mach * pipe[k].c / pipe[k].diam);
            flowBand(4 + k, 0.4f * pipe[k].mach * pipe[k].c / pipe[k].diam);
            flowBand(6 + k, 0.4f * tail[k].mach * tail[k].c / tail[k].diam);
        }
    }

    // Each sample, first: the waves arriving at every end
    void read()
    {
        const int np = lay->ports;
        const int nb = lay->topo == 0 ? 1 : 2;
        for (int i = 0; i < np; ++i)
        {
            prim[i].read();
        }
        for (int k = 0; k < nb; ++k)
            sec[k].read();
        for (int k = 0; k < nDuals; ++k)
        {
            pipe[k].read();
            ch1[k].read();
            mid[k].read();
            ch2[k].read();
            tail[k].read();
        }
        if (nDuals == 2)
            cross.read();
    }

    // Each sample, after the cylinders (qe: each port's volume flow into its header): the ports' waves in, the collectors,
    // the merge, the converter, the muffler, the tails' radiation out (outL, outR), every pipe written
    void step(float* qe, int np)
    {
        const int nb = lay->topo == 0 ? 1 : 2;
        // the ports send their waves into the headers
        float hNear[12];
        const float wn = nScale * vnLp.lowpass(vnHp.highpass(noiseSrc->rnd()));
        for (int i = 0; i < np; ++i)
        {
            // the gas through the valve is a jet: a hiss in proportion to the flow, the louder the faster
            const float jet = prim[i].z * qe[i];
            hNear[i] = prim[i].near + jet * (1.0f + valveK * wn * fminf(fabsf(jet) * 0.00004f, 1.0f));
        }
        // the collectors: each bank's headers merge into its pipe, losing as they merge (pipes.fm, lossFlow); a pop is
        // the node's own gas
        float hFar[12];
        float sNear[2];
        float na[14];
        float nz[14];
        float nkf[14];
        float nkr[14];
        float nq[14];
        float ns[14];
        float nal[14];
        int ni[14];
        for (int k = 0; k < nb; ++k)
            fnG[k] = fnN[k] * fnLp2[k].lowpass(fnLp[k].lowpass(fnHp[k].highpass(noiseSrc->rnd())));
        for (int k = 0; k < nDuals; ++k)
        {
            fnG[2 + k] = fnN[2 + k] * fnLp2[2 + k].lowpass(fnLp[2 + k].lowpass(fnHp[2 + k].highpass(noiseSrc->rnd())));
            fnG[4 + k] = fnN[4 + k] * fnLp2[4 + k].lowpass(fnLp[4 + k].lowpass(fnHp[4 + k].highpass(noiseSrc->rnd())));
            fnG[6 + k] = fnN[6 + k] * fnLp2[6 + k].lowpass(fnLp[6 + k].lowpass(fnHp[6 + k].highpass(noiseSrc->rnd())));
        }
        for (int k = 0; k < nb; ++k)
        {
            int m = 0;
            for (int i = 0; i < np; ++i)
            {
                if (portBank[i] == k || lay->topo == 0)
                {
                    // (the header's jet's noise: a pressure in series with it, half on each side of the drive)
                    const float uh = qHd[i] / prim[i].area;
                    const float eh = flowK * noiseTrim * (uh >= 0.0f ? 0.25f : 0.45f) * 0.5f * prim[i].rho * uh * uh * fnG[k];
                    na[m] = prim[i].far - 0.5f * eh;
                    nz[m] = prim[i].z;
                    nkf[m] = kHin;
                    nkr[m] = kHout;
                    ns[m] = sHd[i];
                    nal[m] = prim[i].qsA;
                    ni[m] = i;
                    m += 1;
                }
            }
            na[m] = sec[k].near;
            nz[m] = sec[k].z;
            nkf[m] = 0.0f;
            nkr[m] = 0.0f;
            ns[m] = 0.0f;
            nal[m] = 0.0f;
            float sy = 0.0f;
            for (int j = 0; j <= m; ++j)
                sy += 1.0f / nz[j];
            const float pj = node(m + 1, na, nz, nkf, nkr, ns, nal, nq, pop[k].tick() * sy);
            shell[k] = shellHp[k].highpass(pj);
            for (int j = 0; j < m; ++j)
            {
                hFar[ni[j]] = prim[ni[j]].far - prim[ni[j]].z * nq[j];
                sHd[ni[j]] = ns[j];
                qHd[ni[j]] = nq[j];
            }
            sNear[k] = sec[k].near - sec[k].z * nq[m];
        }
        // after the collectors: one pipe (topo 0, 1) or two with an H-pipe between them (topo 2); the catalytic converter
        // at the head of each pipe (a resistance in series)
        float sFar[2];
        float pNear[2];
        float xNear = 0.0f;
        float xFar = 0.0f;
        if (lay->topo == 0)
        {
            na[0] = sec[0].far;
            nz[0] = sec[0].z;
            nkf[0] = kSin;
            nkr[0] = kSout;
            ns[0] = sMg[0];
            nal[0] = sec[0].qsA;
            na[1] = pipe[0].near - 0.5f * coneNoise(0);
            nz[1] = pipe[0].z + rCat;
            nkf[1] = 0.0f;
            nkr[1] = 0.0f;
            ns[1] = 0.0f;
            nal[1] = 0.0f;
            node(2, na, nz, nkf, nkr, ns, nal, nq, 0.0f);
            sMg[0] = ns[0];
            sFar[0] = sec[0].far - sec[0].z * nq[0];
            pNear[0] = pipe[0].near - pipe[0].z * nq[1];
            qPp[0] = -nq[1];
        }
        else if (lay->topo == 1)
        {
            for (int k = 0; k < 2; ++k)
            {
                na[k] = sec[k].far;
                nz[k] = sec[k].z;
                nkf[k] = kSin;
                nkr[k] = kSout;
                ns[k] = sMg[k];
                nal[k] = sec[k].qsA;
            }
            na[2] = pipe[0].near - 0.5f * coneNoise(0);
            nz[2] = pipe[0].z + rCat;
            nkf[2] = 0.0f;
            nkr[2] = 0.0f;
            ns[2] = 0.0f;
            nal[2] = 0.0f;
            node(3, na, nz, nkf, nkr, ns, nal, nq, 0.0f);
            sMg[0] = ns[0];
            sMg[1] = ns[1];
            sFar[0] = sec[0].far - sec[0].z * nq[0];
            sFar[1] = sec[1].far - sec[1].z * nq[1];
            pNear[0] = pipe[0].near - pipe[0].z * nq[2];
            qPp[0] = -nq[2];
        }
        else
        {
            for (int k = 0; k < 2; ++k)
            {
                na[0] = sec[k].far;
                nz[0] = sec[k].z;
                nkf[0] = kSin;
                nkr[0] = kSout;
                ns[0] = sMg[k];
                nal[0] = sec[k].qsA;
                na[1] = pipe[k].near - 0.5f * coneNoise(k);
                nz[1] = pipe[k].z + rCat;
                nkf[1] = 0.0f;
                nkr[1] = 0.0f;
                ns[1] = 0.0f;
                nal[1] = 0.0f;
                na[2] = k == 0 ? cross.near : cross.far;
                nz[2] = cross.z;
                nkf[2] = kXp;
                nkr[2] = kXp;
                ns[2] = sXp[k];
                nal[2] = cross.qsA;
                node(3, na, nz, nkf, nkr, ns, nal, nq, 0.0f);
                sMg[k] = ns[0];
                sXp[k] = ns[2];
                sFar[k] = sec[k].far - sec[k].z * nq[0];
                pNear[k] = pipe[k].near - pipe[k].z * nq[1];
                qPp[k] = -nq[1];
                if (k == 0)
                    xNear = cross.near - cross.z * nq[2];
                else
                    xFar = cross.far - cross.z * nq[2];
            }
        }
        // the pipes on to the muffler and out of the tail, each change of area losing what it does
        for (int k = 0; k < nDuals; ++k)
        {
            // (each: the lossless flow less what the loss holds back, from the drive's slow part)
            const int j = 4 * k;
            const float z1 = pipe[k].z + ch1[k].z;
            const float d1 = 2.0f * (pipe[k].far - ch1[k].near);
            const float u1 = qM1[k] / pipe[k].area;
            const float e1n = flowK * noiseTrim * kInM * 0.5f * ch1[k].rho * u1 * u1 * fnG[4 + k];
            const float q1 = (d1 - e1n) / z1 - lossHold(sMf[j], z1, sMf[j] >= 0.0f ? kMuf[0] : kMuf[1]);
            qM1[k] = q1;
            sMf[j] += pipe[k].qsA * (d1 - sMf[j]);
            const float z2 = ch1[k].z + mid[k].z + rPerf;
            const float d2 = 2.0f * (ch1[k].far - mid[k].near);
            const float q2 = d2 / z2 - lossHold(sMf[j + 1], z2, sMf[j + 1] >= 0.0f ? kMuf[2] : kMuf[3]);
            sMf[j + 1] += mid[k].qsA * (d2 - sMf[j + 1]);
            const float z3 = mid[k].z + ch2[k].z + rPerf;
            const float d3 = 2.0f * (mid[k].far - ch2[k].near);
            const float q3 = d3 / z3 - lossHold(sMf[j + 2], z3, sMf[j + 2] >= 0.0f ? kMuf[4] : kMuf[5]);
            sMf[j + 2] += mid[k].qsA * (d3 - sMf[j + 2]);
            const float z4 = ch2[k].z + tail[k].z;
            const float d4 = 2.0f * (ch2[k].far - tail[k].near);
            const float u4 = qM4[k] / tail[k].area;
            const float e4n = flowK * noiseTrim * kOutM * 0.5f * tail[k].rho * u4 * u4 * fnG[6 + k];
            const float q4 = (d4 - e4n) / z4 - lossHold(sMf[j + 3], z4, sMf[j + 3] >= 0.0f ? kMuf[6] : kMuf[7]);
            qM4[k] = q4;
            sMf[j + 3] += tail[k].qsA * (d4 - sMf[j + 3]);
            // the open end: the lows come back inverted, the highs go out; the jet leaving loses its momentum
            const float a = tail[k].far;
            const float dq = a - endR[k].tick(a);
            const float q = dq / tail[k].z - lossHold(sEx[k], tail[k].z, sEx[k] >= 0.0f ? kExit[0] : kExit[1]);
            sEx[k] += tail[k].qsA * (dq - sEx[k]);
            const float b = a - tail[k].z * q;
            float rad = (q - radPrev[k]) * rate;
            radPrev[k] = q;
            // the jet out of the tail: its speed is the mean flow out (what the engine pushes through), puffing with
            // each pulse; turbulence that grows steeply with that speed
            qJet[k] += jetA * (q - qJet[k]);
            const float qm = fmaxf(qJet[k], 1.0e-5f);
            const float un = fminf(qm / tail[k].area * 0.025f, 4.0f);
            const float puff = fminf(fmaxf(q / (2.0f * qm), 0.0f), 1.6f);
            const float noise = jetN[k] * tnLp[k].lowpass(tnHp[k].highpass(noiseSrc->rnd()));
            rad += jetK * noiseTrim * un * un * un * puff * noise * 14400.0f * tail[k].area;
            if (k == 0)
                outL = rad;
            else
                outR = rad;
            pipe[k].write(pNear[k], pipe[k].far - pipe[k].z * q1);
            ch1[k].write(ch1[k].near + ch1[k].z * q1, ch1[k].far - ch1[k].z * q2);
            mid[k].write(mid[k].near + mid[k].z * q2, mid[k].far - mid[k].z * q3);
            ch2[k].write(ch2[k].near + ch2[k].z * q3, ch2[k].far - ch2[k].z * q4);
            tail[k].write(tail[k].near + tail[k].z * q4, b);
        }
        if (nDuals == 1)
            outR = outL;
        else
            cross.write(xNear, xFar);
        for (int k = 0; k < nb; ++k)
            sec[k].write(sNear[k], sFar[k]);
        for (int i = 0; i < np; ++i)
            prim[i].write(hNear[i], hFar[i]);
    }
};
