// buildspec.fm: what an exhaust is, as data (card G, the exhaust builder), and what the builder needs to know of the
// engine it is fitted to.
//
// The description itself is the builder's part of the Spec's exhaust section (ExhaustSpec, sim/spec/exhaust.fm), which
// the builder reads through a pointer. Defaults are the reference: `model` 0 is the
// reference's own code, bit for bit; `model` 1 with every other field at its default is the reference's topology and
// sizes built by the builder (tests/sim/exhaust: the reference-topology test). A 0 in a size means "the layout's", as
// the reference sizes it; -2 and -1 in the tables likewise.
// Which changes are glided and which are made under the exhaust's fade: sim/spec/exhaust.fm's header.
#pragma once
#include "../spec/exhaust.fm"

enum
{
    XS_PORTS = 16,      // MAX_PORTS
    XS_COLL = 8,        // MAX_COLLECTORS
    XS_SIDES = 2        // MAX_SIDES
};


// What the builder knows of the engine (filled by the exhaust's owner each control step: the layout's sizes, the
// reference's four dials as smoothed, the turbo's state, the air): the reference's names, so its pipes() reads alike.
module XEngine
{
    int ports;
    int bank[XS_PORTS];
    int topo;           // the layout's: 0 all into one, 1 a collector a bank then one pipe, 2 dual
    float bore;         // m
    float hdr;          // the layout's header length, m
    float hdrBank1;     // the second bank's headers, times
    float mainLen;
    float pipeD;
    float tailD;
    float muff;
    float bike;
    float smHdr;        // the HEADERS, PIPE, X-PIPE and MUFFLER dials, smoothed (0 to 1)
    float smPipe;
    float smXp;
    float smMuf;
    int aspUse;         // 0 natural, 1 to 3 turbos, 4 a supercharger
    float smTb;         // the turbo's level and size (the reference's TURBO and TURBO SIZE, smoothed)
    float smTs;
    float tAmb;         // K
    float vAir;         // the car's speed, m/s (the walls' cooling)
    float tPort;        // the gas at the ports, K
    float mdotSlow;     // the exhaust's mass flow over half a second, kg/s
    float rpm;
    float load;         // 0 to 1: what the bypass valve's rule goes by
    float ecuValve;     // 0 to 1: the ECU's word on the valve
    // card F's turbines (its model on): the housing each collector's pipe ends in (Boost::housingOf; -1: none, the
    // pipe goes on to its side as the reference's does), and how many external wastegates have a pipe of their own.
    // With these in use the reference's restriction (aspUse, smTb) is left at 0 by the owner.
    int housing[XS_COLL];
    int gates;
};
