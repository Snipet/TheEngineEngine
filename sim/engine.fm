// engine.fm: the simulator's one main module, Engine: what the host sees of it (02-contracts.md, section 1).
//
// The host writes `spec` (what the machine is) between calls, adding one to a section's `rev` after it writes any of
// its fields; writes `ctl` (what the driver does) before each call; reads `tel` (what the machine does) after each call,
// and `scope` (the taps) when someone looks. It calls init once off the audio thread, process on it, end off it.
//
// Inside, the reference's engine (sim/ref/engine.fm's Shared) carved into its parts (K3b): Engine keeps what Shared did
// besides them: the rates, the order of the work each sample and every 16 samples, the fade under which a new engine or
// view is taken, and configure, which makes the engine for its layout and size. The Spec reaches the parts through
// `set` (Dials: the reference's dials as the engine has taken them, readSpec), the Controls through readControls and
// ignition, which drive the reference's key and pedals as its Voice did. sim/README.md has every part, its functions and
// when each is called, and how the null test plays the reference from the same inputs.
#pragma once
#include "spec/spec.fm"
#include "spec/controls.fm"
#include "spec/telemetry.fm"
#include "spec/scope.fm"
#include "exhaust/duct.fm"
#include "core/cylinder.fm"
#include "core/layouts.fm"
#include "lib/noise.fm"
#include "core/heat.fm"
#include "core/crank.fm"
#include "core/mechanics.fm"
#include "ecu/ecu.fm"
#include "exhaust/exhaust.fm"
#include "intake/intake.fm"
#include "valvetrain/valvetrain.fm"
#include "exhaust/pop.fm"
#include "combustion/combustion.fm"
#include "lib/onepole.fm"
#include "lib/biquad.fm"
#include "sound/extras.fm"
#include "boost/boost.fm"
#include "listen/listen.fm"
#include "vehicle/car.fm"
#include "core/layout.fm"
#include "core/inertia.fm"
#include "core/shake.fm"
#include "core/friction.fm"
#include "core/work.fm"
#include "core/dyno.fm"
#include "core/wallheat.fm"
#include "core/mathx.fm"
#include "combustion/heavy.fm"
#include "core/twostroke/twostroke.fm"

// The reference's dials, in its units, as Engine has taken them from the Spec and the Controls (readSpec,
// readControls): what the carved modules are handed
module Dials
{
    int layout;
    float size;
    float idle;
    float redline;
    float cam;
    float inertia;
    float load;
    float headers;
    float muffler;
    float pipe;
    float xpipe;
    float pops;
    float rough;
    float turbo;        // how much boost the forced induction makes, 0 to 1 (BOOST)
    float tsize;        // the turbos' size over ones matched to the engine (TURBO SIZE: 0.5 to 2; 1)
    int asp;            // the aspiration: 0 natural, 1 a turbo, 2 twin turbos, 3 quad turbos, 4 a supercharger
    int fuel;           // 0 gasoline, 1 diesel
    float comp;         // the compression ratio
    float bs;           // the bore over the stroke (BORE/STROKE: 0.5 to 2; 1 square)
    float ambF;         // the air outside, degrees F (AMBIENT: -40 to 120; 80.33 is 300 K)
    float timing;       // the spark's (a diesel's injection's) advance over its map, degrees (TIMING: -20 to 20)
    float bov;
    float intake;
    float mech;
    int view;
    float distance;
    float room;
    float level;
    int keys;           // 1: the keys play the firing's pitch (DRIVE PITCH)
    float bendRange;    // the pitch wheel's reach, semitones (12)
    int starter;
    float hold;
    float bend;
    float modwheel;
    float pressure;
    int drive;          // 0 the keys (DRIVE KEYS or PITCH: keys says which), 1 CAR, 2 TRUCK
    float mass;
    float gas;          // the wheel's pedals (0 up to 1 down), its shifter (-1 R, 0 N, 1 to 7) and its buttons
    float brake;
    float clutch;
    int lever;
    int buttons;
};

enum
{
    SPEC_SECTIONS = 10,    // engine, valve, intake, boost, exhaust, fuel, ecu, car, env, sound: their revs' slots
    START_NOTE = 36,       // the reference's start key (C2: the idle speed, so the key's driver asks for nothing)
};

module Engine
{
    Spec spec [[ui::label("Build")]];
    Controls ctl [[ui::label("Controls")]];
    Telemetry tel [[ui::label("Telemetry")]];
    Scope scope [[ui::label("Scope")]];
    // the adapter's own state
    int revSeen [[ui::hidden]] [SPEC_SECTIONS];   // each section's rev as last applied
    int fresh [[ui::hidden]];                     // 1 until the first call has applied every section
    int held [[ui::hidden]];                      // the start key is down (ignition at start)
    int sounding [[ui::hidden]];                  // the engine renders: from a start until it is silent with no key held
    int ghost [[ui::hidden]];                     // holdSpeed's key is down (its driver aims at the speed)
    int upSeen [[ui::hidden]];                    // the paddles' presses acted on, and each one's pulse on its button:
    int downSeen [[ui::hidden]];                  // 0 none, 1 down (until Car's shift logic has seen it), 2 up again
    int upPulse [[ui::hidden]];                   // (until it has seen that)
    int downPulse [[ui::hidden]];
    // the Scope's cycle being written (scopeTap): cylinder 1's pressure, volume and lifts by degree, the last degree
    // written and the angle it was at
    float scP [[ui::hidden]] [SCOPE_DEGREES];
    float scV [[ui::hidden]] [SCOPE_DEGREES];
    float scE [[ui::hidden]] [SCOPE_DEGREES];
    float scI [[ui::hidden]] [SCOPE_DEGREES];
    float scPi [[ui::hidden]] [SCOPE_DEGREES];
    float scPe [[ui::hidden]] [SCOPE_DEGREES];
    float scIo [[ui::hidden]] [SCOPE_DEGREES];   // (card T: a two-stroke's inlet open share)
    int scDeg [[ui::hidden]];
    float scAng [[ui::hidden]];

    Dials set;          // the reference's dials as the engine has taken them: readSpec and readControls fill it
    Layout lay;
    Cylinder cyl[MAX_CYL];
    float rate;         // the engine's own: 96 kHz whatever the host's (render resamples)
    float dt;
    int ready;
    Noise noise;        // the engine's white noise: the cylinders' spread, the burns' scatter, the flows' and jets' noise
    // what the layout and the dials made
    int lastLayout;
    float lastSize;
    // the dials that shape the pipes and the cams, smoothed (80 ms): a pipe's length or bore, the muffler's chambers or
    // the cams' timing that jumped would jolt the flow the system holds, a loud click
    float kDial;
    float smCR;         // the compression ratio, smoothed, and as the cylinders were last set
    float lastCR;
    float smBs;         // the bore over the stroke, smoothed, and as the bore was last set
    float lastBs;
    float strokeK;      // the stroke over a square engine's of this size: the pistons' speed at the same revs
    float burnK;        // the burn's degrees over a square engine's (the flame's path across the bore)
    float crBs;         // the compression the end gas takes before it knocks, moved with the flame's path
    int fuelUse;        // the fuel and the aspiration heard (a change waits for the fade, as a new layout's does)
    int aspUse;
    // what the sound cannot follow smoothly (another layout or size, another view) changes under a quick fade: 6 ms
    // down, the change, 12 ms back up (80 for a new engine; the room rings on through it); the size waits for its
    // dial to rest 0.15 s
    float cutG;
    float cutDn;
    float cutUp;
    int cutWant;        // 1: configure, 2: the view
    float sizeSeen;
    float sizeRest;
    int vUse;           // the view heard
    float vTotal;       // displacement, m^3
    float bore;
    float boreSq;       // a square cylinder's bore for this size (bore: the BORE/STROKE dial's)
    float idleBase;     // the idle and the redline before the dials: the layout's (a diesel's: by its pistons' speed)
    float redBase;
    // the engine's state
    int tick16;
    // the keys
    // what comes out
    float gainNorm;
    float exTrim;       // the exhaust's level for the layout, besides the whole's
    Ecu ecu;            // the engine's state, the driver, the idle, the limiter, the cuts (ecu/fm)
    Combustion comb;    // the charge at intake closing: fuel, spark, burn, knock (combustion/combustion.fm)
    Valvetrain vt;      // each cylinder's valve events and areas (valvetrain/valvetrain.fm)
    Intake intk;        // the runners, the plenum, the throttle (intake/intake.fm)
    Exhaust exh;        // every pipe after a port, the junctions, the pops, the tails (exhaust/exhaust.fm)
    Crank crank;        // the crank's angle and speed (core/fm)
    Mechanics mech;     // friction, the bench's load, the starter, the inertia (core/mechanics.fm)
    Heat heat;          // the coolant, the oil, the chamber's walls (core/fm)
    // card D: a custom engine (spec.engine.custom) and what every engine reports of its mechanics
    LayoutGeom geo;     // the layout as geometry: firing angles derived (core/layout.fm)
    MovingMasses mm;    // the reciprocating masses: inertia torque, J(theta), the crank's energy-exact step (core/inertia.fm)
    ShakeByOrder shake; // shaking forces and moments by order (core/shake.fm)
    FrictionModel fric; // friction by part (core/friction.fm)
    CycleWork work;     // p dV per cylinder per cycle: IMEP, PMEP, peak pressure, VE (core/work.fm); every engine
    Dyno dyno;          // MODE_DYNO_ENGINE's absorber (core/dyno.fm); every engine
    double airThrottle; // running totals (kg), for the books (tests, N1's ledger): the air through the throttle, the net
    double airValves;   // mass in through the intake valves, the net mass in through the exhaust valves
    double gasExhaust;
    double airTrapped;  // and the unburned gas the cylinders hold at their intakes' closing
    WallHeat wall;      // Woschni's wall heat, with spec.engine.wallHeat 1 (core/wallheat.fm)
    HeavyDiesel hd;     // card D2: a diesel's governor, compression and exhaust brakes (combustion/heavy.fm); hd.on 0 at the defaults
    TwoStroke two;      // card T: a two-stroke's cylinders, crankcases and pipes (core/twostroke/), with spec.engine.cycle 1
    int cycleUse;       // 1: the engine configured as a two-stroke (spec.engine.cycle 1 on a custom engine)
    float tsSig;        // the two-stroke's fields made under the fade, as configured (TwoStroke::signature)
    int customUse;      // 1: the engine configured from spec.engine's custom fields
    int modelUse[11];    // each package's model switch in use (valve, intake, boost, exhaust, fuel, ecu, car, voices; the wall
    int modelWant[11];  // heat; the listener; the engine's cycle, card T's), and the one the host asked for: a change waits
    int modelRev[11];    // for the fade (holdModel); each one's section's rev as holdModel last saw it
    int faults;         // the crank's state found absurd and the engine put at rest afresh (guard), since init
    int faultNow;       // in this call
    int lastIgn;        // ctl.ignition at the last call (voices.model 1: its rise from off renders the key's sounds)
    int layoutRefused;  // 1: its geometry was refused (cylinders firing together), the layout dial's table runs
    float rodRatio;     // the rod over the crank's radius the cylinders are set up with (the reference's 3.3)
    float strokeUse;    // m: the stroke (piston speed, the inertia)
    float jFly;         // a custom engine's crank and flywheel (kg m^2), before the bench's load
    int dynoOn;         // the absorber holds the crank (MODE_DYNO_ENGINE, on the bench)
    float tqAbs;        // its torque this sample (N m)
    float tqFric;       // this sample's friction and a supercharger's drag (N m), for the brake torque
    float tqBrake;      // the gas's torque less friction and drag, its mean over some 0.1 s (N m)
    float omMin;        // the crank's speed's least and most over the current cycle, and the last cycle's spread
    float omMax;
    float ripple;
    float ripTh;        // the crank angle the cycle's spread was started at
    float geoSig;       // a custom engine's geometry as read (geometry()), and as configured: a change is made under the fade
    float geoUsed;
    float hostRateSeen; // the host's rate, as init was given it
    float clickRpm;     // the speed the valves' click amplitude was last worked out at, and that amplitude
    float clickAmpC;
    float oilK;         // the oil's thickness factor on the friction (the reference's: its 0.15th power, at most 3)
    Extras ex;
    Boost boost;        // turbos or a supercharger: their shafts, boost, valves and sounds (boost/boost.fm)
    Listen listen;      // where it is heard from, the room, the level, the resampler (listen/listen.fm)
    // flow noise made where the gas's jets break up inside the system: the headers' jets into each collector, the
    // collectors' gas into the converter's cone, the muffler's inlet and its outlet into the tail. Each is a pressure
    // across its junction (a dipole: the turbulence's force on the gas), flowK times the junction's loss coefficient
    // times 1/2 rho u^2 (so its power grows as the speed's fourth power, as in-duct flow noise does below the pipe's
    // cross modes), gated by each pulse's own speed, in a band about a Strouhal number of 0.4 on the jet's width. The
    // pipes then shape it like everything else.
                        // mufflers' inlets; 6, 7: their outlets)
    // the exhaust's heat: the gas's temperature (K) in each part of the system (the headers, the collectors' pipes, the
    // main pipe, the muffler, the tail), each part's wall, and what the pipes are set to (the gas's, a third of a second
    // behind)
    float quiet;
    // the junctions' losses (pipes.fm, lossKap: K rho / 2A^2 for each direction) and the catalytic converter
                        // to tail), each for flow onward and back
    // the car (DRIVE CAR)
    Car car;
    // what the panel shows (its displays read these whether a key sounds or not)
    float showRpm;      // the crank's speed, rpm
    float showRed;      // the redline, rpm
    float showGear;     // driven: -1 R, 0 N, 1 to 6; -2 played from the keys
    float showKmh;      // driven: the car's speed, km/h
    float showThr;      // the throttle plate, 0 to 1
    float showMap;      // the manifold against the air outside, bar: vacuum below 0, boost above
    float showLamps;    // the state (0 off, 1 cranking, 2 running, 3 running down) + 4 limiter + 8 fuel cut + 16 driven,
                        // + 32 times the coolant's temperature (F + 60) + 16384 times the oil's pressure (psi) + 2097152
                        // driven as a truck: the dash's
    float showPedals;   // driven: the brake (0 to 100) + 1000 times the clutch (0 to 100)
    float showCycle;    // a slowed copy of the crank's cycle, 0 to 1: the layout's drawing fires in its order by it
    float showBoost;    // the turbo's boost, bar
    float showAir;      // the forced induction, for the panel: its kind (1 to 4) plus the boost it is set for (0 none),
                        // and ten times BORE/STROKE's 1 to 100 (0.5 to 2; 0, before the sound starts: square)
    float showPipes;    // the HEADERS, PIPE and X-PIPE dials as heard, for the panel: each 0 to 99, packed (headers *
                        // 10000 + pipe * 100 + X-pipe)

    // The reference's Shared::init: every part made, at rest, at the reference's Init dials
    void setupAll(float rateIn)
    {
        releaseAll();
        // (the engine's own rate: 96 kHz; card C's prediction service compiles a copy at 48 kHz, half the cost, with
        // TEE_ENGINE_RATE_48000 defined: never the application's engine nor the null test's)
#ifdef TEE_ENGINE_RATE_48000
        rate = 48000.0f;
#else
        rate = 96000.0f;
#endif
        listen.setup(rate, rateIn);
        dt = 1.0f / rate;
        noise.rs = 123456789;
        intk.setup(rate);
        // the longest each pipe could be, cold (330 m/s), at this rate
        exh.setup(rate, &noise, &lay, &heat, &spec.exhaust, &tel.exhaust, &scope, &boost);
        ex.setup(rate, 90.0f, &spec.voices);
        boost.setup(rate, &ex.noise);
        two.setup(rate);
        cycleUse = 0;
        tsSig = 0.0f;
        quiet = 1.0e9f;
        gainNorm = 1.0f;
        cutG = 1.0f;
        cutDn = 1.0f / (0.006f * rate);
        cutUp = 1.0f / (0.012f * rate);
        cutWant = 0;
        vUse = 0;
        kDial = 1.0f - expf(-16.0f / (0.08f * rate));
        intk.pBox = 101325.0f;
        set.layout = 12;
        set.size = 5.76f;
        set.idle = 0.0f;
        set.redline = 0.0f;
        set.cam = 0.35f;
        set.inertia = 0.5f;
        set.load = 0.0f;
        set.headers = 0.5f;
        set.muffler = 0.5f;
        set.pipe = 0.5f;
        set.xpipe = 0.0f;
        set.pops = 0.3f;
        set.rough = 0.3f;
        set.turbo = 0.5f;
        set.tsize = 1.0f;
        set.asp = 0;
        set.fuel = 0;
        set.comp = 10.0f;
        set.bs = 1.0f;
        set.ambF = 80.33f;
        set.timing = 0.0f;
        comb.setup(rate, &noise, &ecu, &heat, &lay, &exh.pop[0], &spec.fuel, &spec.engine);
        comb.oxygen = 1.0f;
        physicalCylinder();
        hd.setup(rate, &spec.ecu, &spec.valve);                                             // card D2
        ecu.setup(16.0f / rate, &spec.ecu, &spec.fuel, &ctl, &tel.ecu, &scope, &heat);     // card H's model 1
        set.bov = 0.7f;
        set.intake = 0.5f;
        set.mech = 0.4f;
        set.view = 0;
        set.distance = 0.3f;
        set.room = 0.15f;
        set.level = 0.0f;
        set.keys = 0;
        set.bendRange = 12.0f;
        set.starter = 1;
        set.hold = 10.0f;
        heat.setup();
        lastLayout = -1;
        ecu.state = 0;
        crank.omega = 0.0f;
        crank.theta = 0.0f;
        ecu.keyCount = 0;
        ecu.tokenCounter = 0;
        ecu.rendering = 0;
        tick16 = 0;
        // (the free jet's own mixing noise is weak at a tailpipe's speeds: most of the roar is made inside, at the
        // junctions, and comes out shaped by the pipes; the two together as bright as the jet alone was)
        ecu.gK = 0.15f;
        ecu.gTau = 0.15f;
        ecu.gTrim = 2.5f;
        ecu.gI = 0.8f;
        car.setup(rate, &spec.car, &spec.env, &ctl, &tel.car);
        set.drive = 0;
        set.mass = 1400.0f;
        configure();
        showGear = -2.0f;
        ready = 1;
    }

    void releaseAll()
    {
        if (ready != 0)
        {
            exh.release();
            intk.release();
            listen.release();
            two.release();
        }
        ready = 0;
    }

    // The engine for the layout and the size dial: its cylinders, valves and pipes. Everything starts at rest.
    void configure()
    {
        applyModels();
        lay.load(set.layout);
        customUse = spec.engine.custom ? 1 : 0;
        layoutRefused = 0;
        geoUsed = geometry();
        geoSig = geoUsed;
        if (customUse != 0)
            customLayout();
        lastLayout = set.layout;
        fuelUse = set.fuel;
        aspUse = set.asp < 0 ? 0 : (set.asp > 4 ? 4 : set.asp);
        // (stopped, with AMBIENT moved: it has stood in that air, as cold or as warm as it is)
        heat.stood(ecu.state, set.ambF);
        heat.control(0.0f, set.ambF, vTotal, ecu.state, crank.rpm, crank.omega);
        for (int c = 0; c < lay.n; ++c)
            cyl[c].tw = heat.tSurf;
        ecu.kRet = 0.0f;
        lastSize = set.size;
        vt.lastCam = set.cam;
        exh.smMuf = set.muffler;
        exh.smHdr = set.headers;
        exh.smPipe = set.pipe;
        exh.smXp = set.xpipe;
        boost.smTb = set.turbo;
        boost.smTs = boost.tsOf(set.tsize);
        vt.smCam = set.cam;
        sizeSeen = set.size;
        sizeRest = 0.0f;
        // the size dial: the engine's displacement in litres (a rotary's: its two rotors' chambers), each cylinder kept
        // between 30 cc and 5 litres
        const float litres = fminf(fmaxf(set.size, 0.05f), 30.0f);
        float swept = fminf(fmaxf(litres * 0.001f / (lay.rotary != 0 ? 2.0f : (float)lay.n), 3.0e-5f), 5.0e-3f);
        if (customUse != 0 && lay.rotary == 0 && spec.engine.bore > 0.0f && spec.engine.stroke > 0.0f)
            swept = fminf(fmaxf(0.78539816f * spec.engine.bore * spec.engine.bore * spec.engine.stroke, 3.0e-5f), 5.0e-3f);
        const float scale = swept / lay.swept;
        vTotal = swept * (lay.rotary != 0 ? 2.0f : (float)lay.n);
        // a bigger engine than the layout's own breathes out through bigger pipes: their diameters as the 0.45th power
        // of its size over the layout's (its flow's area: a 6.7 L six's 86 mm, a 15 L truck's 124, as theirs are some
        // 100 and 127; through the layout's 60 mm its gas ran at near half the speed of sound, a hiss)
        const float kPipe = expf(0.45f * logf(fmaxf(scale, 1.0f)));
        lay.pipeD *= kPipe;
        lay.tailD *= kPipe;
        smCR = fminf(fmaxf(set.comp, 6.0f), 25.0f);
        lastCR = smCR;
        // the torque the car's gears are chosen for: the full load's, for this engine (peakTorque's, at its new size; a
        // diesel's about half a gasoline engine's of its size here, its full fuel lean)
        {
            const float bg = aspUse == 0 ? 0.0f : (aspUse == 4 ? 0.25f + 0.75f * set.turbo : 0.35f + 1.05f * set.turbo);
            gearTq = (fuelUse != 0 ? 0.5f : 1.0f) * 1.6f * 0.6f * 1.0e6f * vTotal * 0.0795775f * (1.0f + 0.8f * bg);
        }
        // the bore and the stroke: a square cylinder's bore, moved by BORE/STROKE (the same swept volume: an
        // oversquare engine's bore wider, its stroke shorter; a rotary has neither)
        boreSq = lay.rotary != 0 ? 0.09f : expf(0.33333333f * logf(1.2732395f * swept));
        smBs = bsOf();
        boreStroke();
        // the rod: the reference's 3.3 crank radii, or a custom engine's own
        rodRatio = 3.3f;
        if (customUse != 0 && lay.rotary == 0 && spec.engine.rodLength > 0.0f)
            rodRatio = fminf(fmaxf(spec.engine.rodLength / (0.5f * strokeUse), 2.2f), 6.0f);
        // (a big cam's overlap dilutes the idle more the slower it turns: its tune idles it higher, as real ones are)
        ecu.idleRpm = fmaxf(idleBase + set.idle + 350.0f * fmaxf(set.cam - 0.35f, 0.0f) / 0.65f + heat.coldIdle(fuelUse), 350.0f);
        ecu.redRpm = fmaxf(redBase + set.redline, ecu.idleRpm + 1500.0f);
        exh.nDuals = lay.topo == 2 ? 2 : 1;
        // the throttle and the plenum go with the engine's size
        intk.aThrottle = 0.0028f * sqrtf(vTotal / 0.002f) * (lay.bike > 0.5f ? 1.25f : 1.0f);
        intk.aBypass = 0.045f * intk.aThrottle;
        intk.vPlenum = fmaxf(0.8f * vTotal, 0.0004f);
        // (a diesel's crank and flywheel are heavier, for its pressures: twice a gasoline engine's of the layout's size,
        // and more the bigger it is: some 0.85 kg m^2 for a 6.7 L six, 2.2 for a 15 L truck's)
        clatSize = expf(0.33333333f * logf(swept / 0.0005f));
        mech.jBase = fuelUse != 0 ? 2.0f * lay.inertia * expf(1.2f * logf(scale)) : lay.inertia * expf(0.6f * logf(scale));
        for (int c = 0; c < lay.n; ++c)
        {
            Cylinder* cy = &cyl[c];
            cy->setup(swept, smCR, rodRatio, lay.rotary, lay.cyc);
            cy->tw = heat.tSurf;
            cy->diesel = fuelUse;
            cy->bias = 0.025f * noise.rnd();
            const float a0 = wrapCycle(crank.theta + lay.fire[c], lay.cyc);
            cy->reset(a0);
            cy->t = heat.tAmb + 30.0f * heat.warm;
            cy->m = cy->p * cy->v / (287.0f * cy->t);
        }
        for (int i = 0; i < MAX_PORTS; ++i)
            exh.portBank[i] = 0;
        for (int c = 0; c < lay.n; ++c)
            exh.portBank[lay.port[c]] = lay.bank[c];
        valves();
        if (ecu.state != 0)
        {
            // running (a new layout or size under the fade): each cylinder's charge from where it stands (a fresh one at
            // the air outside would bang): the air's with its exhaust open (the pipes start at rest), else the plenum's
            for (int c = 0; c < lay.n; ++c)
            {
                Cylinder* cy = &cyl[c];
                float e = cy->ang - cy->evo;
                if (e < 0.0f)
                    e += cy->cyc;
                cy->p = e < cy->edur ? 101325.0f : intk.pPlenum;
                cy->m = cy->p * cy->v / (287.0f * cy->t);
            }
        }
        exh.clear();
        intk.clear();
        listen.resetPaths();
        ex.pumpOn = fuelUse != 0 ? 0.6f : (lay.bike < 0.5f && lay.rotary == 0 ? 0.3f : 0.0f);
        ex.setClatter(fuelUse, cyl[0].vd);
        const float norm[17] = {1.087f, 1.643f, 1.694f, 1.577f, 4.627f, 1.644f, 1.154f, 1.292f, 1.466f, 2.569f, 2.069f, 1.412f, 2.658f, 1.738f, 2.634f, 3.367f, 0.608f};
        // and the exhaust's own share, measured over full throttle from a third of the redline to near it, so the
        // physical pipes come out as loud there as the earlier model's did, the engine bay's sounds unchanged
        const float exT[17] = {0.923f, 1.249f, 1.388f, 1.815f, 3.380f, 3.990f, 4.603f, 1.741f, 5.346f, 5.230f, 5.831f, 3.722f, 8.169f, 3.613f, 4.332f, 5.947f, 1.226f};
        gainNorm = 0.5f * norm[set.layout < 0 ? 0 : (set.layout > 16 ? 16 : set.layout)];
        exTrim = exT[set.layout < 0 ? 0 : (set.layout > 16 ? 16 : set.layout)];
        // (the flow's and the jet's noise were tuned to the trims before the per-pass loss raised them: made at the
        // junctions and the tail, past most of that loss, they rise with them only a quarter as much in dB)
        const float exT1[17] = {0.288f, 0.348f, 0.402f, 0.400f, 0.884f, 0.995f, 0.999f, 0.439f, 1.527f, 1.113f, 1.609f, 0.501f, 1.415f, 0.853f, 0.837f, 1.123f, 0.401f};
        exh.noiseTrim = sqrtf(sqrtf(exT1[set.layout < 0 ? 0 : (set.layout > 16 ? 16 : set.layout)] / exTrim));
        showRed = ecu.redRpm;
        // stopped, the walls as warm as the engine is (warm: where a long idle leaves them; cold: at the air outside);
        // running (a new layout or size under the fade), the plenum, the throttle, the controllers and the heat go on as
        // they were
        if (ecu.state == 0)
        {
            intk.pPlenum = 101325.0f;
            intk.tAir = heat.tAmb + 5.0f * heat.warm;
            exh.tPort = heat.tAmb + 20.0f * heat.warm;
            ecu.throttle = 0.0f;
            ecu.bypass = 0.3f;
            ecu.idleInt = 0.15f;
            ecu.trim = 1.0f;
            ecu.govInt = 0.0f;
            exh.mdotSlow = 0.36f * vTotal * ecu.idleRpm / 120.0f;
            for (int i = 0; i < 5; ++i)
                exh.tWall[i] = heat.tAmb + 120.0f * heat.warm;
            for (int it = 0; it < 400; ++it)
                exh.soak(heat.tAmb + 350.0f * heat.warm, exh.mdotSlow, 3.0f * heat.warm, bore, set.drive != 0 ? fabsf(car.v) : 0.0f);
            for (int i = 0; i < 5; ++i)
                exh.tUse[i] = exh.tGas[i];
        }
        intk.mPlenum = intk.pPlenum * intk.vPlenum / (287.0f * intk.tAir);
        pipes();
        cycleUse = spec.engine.cycle != 0 && customUse != 0 && lay.rotary == 0 ? 1 : 0;    // (card T's, set before the mechanics)
        mechanicsSetup();
        // (card F: boost.model 1's machine sized to this engine, at rest, on its four-stroke-equivalent displacement: a
        // rotary's faces fire once a shaft turn and a two-stroke's cylinders once a turn, twice vTotal; nothing in model 0)
        boost.applyMachine(&spec.boost, vTotal * (lay.rotary != 0 || (spec.engine.cycle != 0 && customUse != 0) ? 2.0f : 1.0f), ecu.redRpm, 101325.0f, heat.tAmb);
        ecu.overBoostRef = boost.overBoostLevel();     // (N2: the machine's own over-boost level for ecu.model 1's cut)
        // (card T: a two-stroke, on a custom engine's geometry and mechanics: its cylinders and pipes at rest where the
        // crank stands; the four-stroke's cylinders, valves and pipes above stay configured, unused)
        for (int d = 0; d < SCOPE_DEGREES; ++d)
        {
            scIo[d] = 0.0f;
            scope.inletOpen[d] = 0.0f;
        }
        tsSig = two.signature(&spec.engine);
        if (cycleUse != 0)
        {
            two.configure(&spec.engine, bore, strokeUse, 0.5f * rodRatio * strokeUse, smCR, crank.theta, 101325.0f, heat.tAmb);
            // (a 360-degree engine for the mechanics, the Scope and the telemetry: its cylinders as TwoStroke fires them)
            lay.n = two.n;
            lay.cyc = 360.0f;
            for (int c = 0; c < two.n; ++c)
                lay.fire[c] = c == 0 ? 0.0f : 360.0f - two.offset[c];
            mechanicsSetup();
        }
    }

    // ---- card D: the mechanics (docs/models/mechanics.md) ----

    // The friction by part (Chen and Flynn's, core/friction.fm) for a custom engine and whenever card H's combustion
    // (fuel.model 1) is on: the new combustion implies the physical cylinder, its walls (Woschni) and its friction
    // together; the reference's one curve, fitted to its V8, only under the reference's models
    bool physicalFriction()
    {
        return customUse != 0 || spec.fuel.model != 0;
    }

    // Whose walls take the burn's heat: Woschni's (core/wallheat.fm) with spec.engine.wallHeat 1 or fuel.model 1, else
    // the reference's. One decision, from the two switches as the fade has made them (applyModels), read by the walls
    // here and handed to Combustion (comb.walls), whose share of the fuel's heat follows it: the walls' loss counted once
    bool woschniWalls()
    {
        return spec.engine.wallHeat == 1 || spec.fuel.model != 0;
    }

    // The one decision handed on: Combustion's share of the fuel's heat (comb.walls) and the cylinders' intake backflow
    // conserved (Cylinder::conserve): both with Woschni's walls, the physical cylinder, and neither under the reference's
    void physicalCylinder()
    {
        const int w = woschniWalls() ? 1 : 0;
        comb.walls = w;
        for (int c = 0; c < MAX_CYL; ++c)
            cyl[c].conserve = w;
    }

    // A sum of what makes a custom engine (spec.engine's custom fields, each with its own weight), to see it changed: 0
    // while custom is off, whatever the fields hold
    float geometry()
    {
        const EngineSpec* s = &spec.engine;
        if (!s->custom)
            return 0.0f;
        float g = 1.0f + 3.0f * (float)s->cylinders + 5.0f * (float)s->rotors + 7.0f * s->bore + 11.0f * s->stroke
                  + 13.0f * s->rodLength + 17.0f * s->pistonMass + 19.0f * s->rodMass + 23.0f * s->rodRecip
                  + 29.0f * s->flywheelInertia + 31.0f * s->portExOpen + 37.0f * s->portExDur + 41.0f * s->portInOpen
                  + 43.0f * s->portInDur;
        for (int b = 0; b < ENGINE_MAX_BANKS; ++b)
            g += (0.37f + 0.11f * (float)b) * s->bankAngle[b];
        for (int c = 0; c < MAX_CYL; ++c)
        {
            const float k = 1.0f + 0.173f * (float)c;
            g += k * (0.31f * (float)s->bank[c] + 0.0137f * s->pin[c] + 0.59f * (float)s->fireRev[c] + 0.83f * s->place[c]);
        }
        return g;
    }

    // A custom engine's layout from its geometry (spec.engine's banks, pins, revolutions, places; or its rotors), over
    // the layout dial's (whose pipes, idle and sizes it keeps). Engine's cylinders sit at crank.theta + fire[c] in their
    // cycles, so a larger fire fires sooner: fire is the cycle less the derived angle, and the cylinders fire in the
    // order the geometry gives (the reference's tables run their orders the other way round: the same engine, mirrored).
    void customLayout()
    {
        geo.derive(&spec.engine);
        // a geometry that cannot run (two cylinders firing together: the Spec's own defaults, every pin 0, are one) is
        // refused: the layout dial's table runs, with the custom engine's sizes, masses and friction (X-001)
        layoutRefused = geo.ok == 0 ? 1 : 0;
        if (layoutRefused != 0)
        {
            geo.fromTable(lay.n, lay.cyc, lay.rotary, &lay.fire[0]);
            return;
        }
        lay.n = geo.n;
        lay.cyc = geo.cyc;
        lay.rotary = geo.rotary > 0 ? 1 : 0;
        int twoBanks = 0;
        for (int c = 0; c < geo.n; ++c)
        {
            lay.fire[c] = geo.fire[c] > 0.0f ? geo.cyc - geo.fire[c] : 0.0f;
            lay.bank[c] = geo.rotary > 0 ? 0 : spec.engine.bank[c] % 2;
            lay.port[c] = geo.rotary > 0 ? c / 3 : c;
            twoBanks |= lay.bank[c];
        }
        lay.ports = geo.rotary > 0 ? geo.rotary : geo.n;
        // the exhaust: one bank's cylinders into one pipe; two banks, each its own (dual)
        lay.topo = twoBanks != 0 ? (lay.topo == 0 ? 2 : lay.topo) : 0;
    }

    // What the mechanics need once the engine is configured: the moving masses (a custom engine's own, or the
    // reference's sizes for the reports), the friction, the shaking, the work integral, the dyno's inertia
    void mechanicsSetup()
    {
        const float rodLen = rodRatio * 0.5f * strokeUse;
        jFly = customUse != 0 && spec.engine.flywheelInertia > 0.0f ? spec.engine.flywheelInertia
                                                                    : mech.jBase * expf(1.6094379f * (set.inertia - 0.5f));
        // (the shaking is every engine's: card L's cabin hears it. A reference layout's cylinders are taken upright, its
        // table giving no bank angles: an inline engine's shaking is right, a V's or a boxer's an approximation; a custom
        // engine's is its own geometry's. Its moving masses step the crank only when custom is on)
        // (a two-stroke: its own cylinders from its firing, unless the custom geometry has as many: then that one's banks
        // and places stand)
        if (customUse == 0 || layoutRefused != 0 || (cycleUse != 0 && geo.n != lay.n))
            geo.fromTable(lay.n, lay.cyc, lay.rotary, &lay.fire[0]);
        mm.setup(&spec.engine, &geo, bore, strokeUse, rodLen, smCR, jFly);
        shake.setup(&spec.engine, &geo, mm.mRec, mm.sc.r, mm.sc.lam);
        fric.setup(&spec.engine, cycleUse != 0 ? (float)lay.n * two.vd : vTotal, strokeUse, lay.rotary);
        work.setup(lay.n, cycleUse != 0 ? two.vd : cyl[0].vd, lay.cyc);
        wall.setup(bore, cyl[0].vd);
        if (lay.rotary != 0)
            wall.setupRotary(cyl[0].vd);
        dyno.setup(customUse != 0 ? mm.jMean : jFly);
        dynoOn = 0;
        tqAbs = 0.0f;
        tqFric = 0.0f;
        oilK = fminf(expf(0.15f * logf(heat.viscK)), 3.0f);
        omMin = crank.omega;
        omMax = crank.omega;
        ripTh = crank.theta;
    }

    // A custom rotary's ports, where its fields give them (degrees of the eccentric shaft), over the cam dial's
    void customPorts()
    {
        for (int k = 0; k < lay.n; ++k)
        {
            Cylinder* cy = &cyl[k];
            if (spec.engine.portExDur > 0.0f)
            {
                cy->evo = spec.engine.portExOpen;
                cy->edur = spec.engine.portExDur;
            }
            if (spec.engine.portInDur > 0.0f)
            {
                cy->ivo = spec.engine.portInOpen;
                cy->idur = spec.engine.portInDur;
            }
        }
    }

    // The BORE/STROKE dial as the engine takes it: 0.5 to 2 (a rotary, or the dial unset: 1, square)
    float bsOf()
    {
        if (customUse != 0 && lay.rotary == 0 && spec.engine.bore > 0.0f && spec.engine.stroke > 0.0f)
            return fminf(fmaxf(spec.engine.bore / spec.engine.stroke, 0.3f), 3.0f);
        if (lay.rotary != 0 || set.bs <= 0.0f)
            return 1.0f;
        return fminf(fmaxf(set.bs, 0.5f), 2.0f);
    }

    // The bore and what goes with the bore over the stroke (smBs). At the same displacement the bore goes as its cube
    // root, the stroke as its cube root's inverse square: the valves, the ports and the headers go with the bore
    // (valves, pipes), the pistons' speed with the stroke (1.6 times a square engine's at the same revs at 0.5, 0.63
    // times at 2: their rubbing with it), the burn's degrees with the flame's path across the bore over the gas's
    // churn, which the pistons' speed makes (as its 0.35th power: 27 % longer at 2, 22 % shorter at 0.5; the spark
    // leads it by half that), and the end gas, longer waiting for the flame, knocks at a lower compression (some 1
    // less at 2, 1 more at 0.5)
    void boreStroke()
    {
        const float lb = logf(smBs);
        bore = boreSq * expf(0.33333333f * lb);
        strokeK = expf(-0.66666667f * lb);
        burnK = expf(0.35f * lb);
        crBs = -1.5f * lb;
        lastBs = smBs;
        // a diesel turns at most what keeps its pistons under some 13.5 m/s (a 6.7 L six of 107 by 124 mm: 3270 rpm, a
        // 15 L of 137 by 169: 2400), at most six tenths of the layout's redline, and idles at a quarter of that (a 15 L
        // truck's 650); a gasoline engine keeps its layout's
        const float stroke = lay.rotary != 0 ? 0.01f : bore / smBs;
        strokeUse = lay.rotary != 0 ? 0.07f : stroke;
        redBase = fuelUse != 0 ? fminf(0.6f * lay.redRpm, 405.0f / fmaxf(stroke, 0.01f)) : lay.redRpm;
        idleBase = fuelUse != 0 ? fminf(lay.idleRpm, 0.27f * redBase) : lay.idleRpm;
        // a custom engine's: its field, or what keeps its pistons under 25 m/s (a diesel's 13.5): core/kinematics.fm
        if (customUse != 0)
        {
            if (spec.engine.redlineSpeed > 0.0f)
                redBase = spec.engine.redlineSpeed * 9.5492966f;
            else if (lay.rotary == 0)
                redBase = fminf((fuelUse != 0 ? 13.5f : 25.0f) * 30.0f / fmaxf(stroke, 0.01f), 20000.0f);
            idleBase = fminf(idleBase, 0.3f * redBase);
        }
    }

    // The valves of every cylinder, for the cam as heard, the bore and the layout (valvetrain/valvetrain.fm)
    void valves()
    {
        vt.events(&cyl[0], lay.n, lay.rotary, lay.cyc, bore, vTotal);
        if (customUse != 0 && lay.rotary != 0)
            customPorts();
    }

    // The pipes' sizes for the layout and the dials, and their lengths at the gas's temperatures now
    void pipes()
    {
        exh.pipes(bore, spec.boost.model != 0 ? 0 : aspUse, boost.smTb, boost.smTs, rate);   // (model 1: the machine's turbine)
        intk.runners(lay.ports, lay.bike, bore, rate);
    }

    // ---- the keys ----

    int keyDown(float note, float vel)
    {
        // (stopped, a new layout or size is taken at once; running, under the fade: control16)
        if (ecu.state == 0 && (set.layout != lastLayout || set.fuel != fuelUse || set.asp != aspUse || geoSig != geoUsed || fabsf(set.size - lastSize) > 0.001f
                           || fabsf(set.ambF - heat.ambSeen) > 0.25f))
            configure();
        if (ecu.keyCount >= 16)
        {
            // full: the oldest key gives way, so the newest always drives
            for (int j = 0; j < 15; ++j)
            {
                ecu.keyNote[j] = ecu.keyNote[j + 1];
                ecu.keyVel[j] = ecu.keyVel[j + 1];
            }
            ecu.keyCount = 15;
        }
        ecu.keyNote[ecu.keyCount] = note;
        ecu.keyVel[ecu.keyCount] = vel;
        ecu.keyCount += 1;
        ecu.tokenCounter += 1;
        ecu.rendering = ecu.tokenCounter;
        // (driven, a key that goes down while it runs may switch it off: held a second)
        if (ecu.state == 2)
            ecu.offArmed = true;
        if (set.drive != 0)
            car.followLever(set.drive, set.lever);
        // driven, in gear it cranks only with the clutch's pedal down (as a car's clutch switch has it)
        const bool may = set.drive == 0 || car.gear == 0 || set.clutch > 0.75f;
        if ((ecu.state == 0 || ecu.state == 3) && may)
        {
            if (set.starter != 0 && crank.omega < 60.0f)
                ecu.state = 1;
            else
            {
                ecu.state = 2;
                if (crank.omega < 0.6f * ecu.idleRpm * 0.10471976f)
                {
                    crank.omega = ecu.idleRpm * 0.10471976f;
                    ecu.rpmAvg = ecu.idleRpm;
                    crank.rpm = ecu.idleRpm;
                    ecu.fuelCut = false;
                    // each cylinder between its intake closing and its spark fires on this pass
                    for (int c = 0; c < lay.n; ++c)
                    {
                        Cylinder* cy = &cyl[c];
                        const float ivc = cy->ivo + cy->idur >= lay.cyc ? cy->ivo + cy->idur - lay.cyc : cy->ivo + cy->idur;
                        if (cy->ang > ivc && cy->ang < cy->sparkAt)
                            comb.charge(&cyl[c], c, fuelUse, intk.pPlenum, crank.rpm, smCR, crBs, burnK, set.pops, set.rough, set.timing);
                    }
                }
            }
        }
        ecu.holdLeft = set.hold;
        return ecu.tokenCounter;
    }

    void keyUp(float note)
    {
        for (int i = 0; i < ecu.keyCount; ++i)
        {
            if (ecu.keyNote[i] == note)
            {
                for (int j = i; j < ecu.keyCount - 1; ++j)
                {
                    ecu.keyNote[j] = ecu.keyNote[j + 1];
                    ecu.keyVel[j] = ecu.keyVel[j + 1];
                }
                ecu.keyCount -= 1;
                break;
            }
        }
        if (ecu.keyCount == 0)
            ecu.holdLeft = set.hold;
    }

    // ---- every 16 samples: the driver, the idle valve, the ECU, the pipes' temperatures ----

    void control16()
    {
        const float d16 = 16.0f * dt;
        crank.sense();
        heat.control(d16, set.ambF, vTotal, ecu.state, crank.rpm, crank.omega);
        for (int c = 0; c < lay.n; ++c)
            cyl[c].tw = heat.tSurf;
        ecu.sense(d16, crank.rpm, idleBase, set.idle, set.cam, heat.coldIdle(fuelUse), redBase, set.redline);
        // a new layout, or a new size once its dial rests, under the fade (renderAt makes it at the fade's quiet)
        if (fabsf(set.size - sizeSeen) > 0.0005f)
        {
            sizeSeen = set.size;
            sizeRest = 0.0f;
        }
        else
            sizeRest += d16;
        if (set.layout != lastLayout || set.fuel != fuelUse || set.asp != aspUse || geoSig != geoUsed || (fabsf(set.size - lastSize) > 0.001f && sizeRest > 0.15f)
            || (ecu.state == 0 && fabsf(set.ambF - heat.ambSeen) > 0.25f))
            cutWant |= 1;
        // the dials that shape the pipes and the cams, smoothed
        exh.smMuf += (set.muffler - exh.smMuf) * kDial;
        exh.smHdr += (set.headers - exh.smHdr) * kDial;
        exh.smPipe += (set.pipe - exh.smPipe) * kDial;
        exh.smXp += (set.xpipe - exh.smXp) * kDial;
        boost.glide(set.turbo, set.tsize, kDial);
        vt.smCam += (set.cam - vt.smCam) * kDial;
        if (fabsf(vt.smCam - vt.lastCam) > 0.0005f)
            valves();
        // the compression: the cylinders' clearance follows it (the gas in them takes the change as the piston's)
        smCR += (fminf(fmaxf(set.comp, 6.0f), 25.0f) - smCR) * kDial;
        if (fabsf(smCR - lastCR) > 0.005f)
        {
            for (int c = 0; c < lay.n; ++c)
                cyl[c].setup(cyl[c].vd, smCR, rodRatio, lay.rotary, lay.cyc);
            lastCR = smCR;
        }
        // the bore over the stroke: the bore, the valves (the pipes follow it, pipes())
        smBs += (bsOf() - smBs) * kDial;
        if (fabsf(smBs - lastBs) > 0.0005f)
        {
            boreStroke();
            valves();
        }
        // (card T: the two-stroke's power valve, pipes' gas and flows' losses; its fields made under the fade, as the
        // layout is)
        if (cycleUse != 0)
            two.control16(&spec.engine, crank.omega, d16, heat.tSurf, heat.tAmb);
        if ((spec.engine.cycle != 0 && customUse != 0 ? 1 : 0) != cycleUse || (cycleUse != 0 && two.signature(&spec.engine) != tsSig))
            cutWant |= 1;
        float ped = ecu.driver(d16, set.drive, set.bend, set.bendRange, set.keys, lay.rotary, lay.n);
        if (set.drive != 0)
            ped = car.drive16(set.drive, d16, mech.jBase * expf(1.6094379f * (set.inertia - 0.5f)), peakTorque(), gearTq, set.mass,
                              ecu.redRpm, lay.bike, set.clutch, set.brake, set.lever, set.buttons, set.gas, crank.rpm, ecu.idleRpm, ecu.rpmAvg);
        else
            car.lastDrive = 0;
        if (ecu.control(d16, ped, set.drive, set.modwheel, set.pressure, crank.rpm, fuelUse, heat.warm, car.shiftCut, car.gear,
                        set.clutch, crank.omega, intk.pPlenum, set.drive != 0 ? fabsf(car.v) : 0.0f, exh.gasTemperature(0)))
            crank.omega = 0.0f;
        // card D2: a diesel's governor and brakes (nothing at the defaults: hd.on 0, the lever the reference's)
        hd.control16(d16, fuelUse, ecu.state, ecu.throttle, crank.omega, ecu.idleRpm, ecu.redRpm, ecu.sinceStart,
                     set.drive != 0 ? set.clutch : 0.0f, exh.mdot, exh.tPort, boost.boost, vTotal, lay.n, bore, heat.tAmb, ctl.buttons);
        hd.feed(&comb.diesel);
        if (hd.on != 0)
        {
            hd.flapReal = exh.flapFitted();          // (card G's butterfly, where fitted, makes the exhaust brake's back pressure)
            exh.setFlap(hd.flapCommand());
        }
        // the exhaust's mass flow and its power, for the turbo
        exh.flowRate();
        // (the reference turbo's flow scale: a four-stroke's air, vTotal rpm / 120, for every engine; for a rotary, whose
        // faces fire once a shaft turn, it is half its flow. Known and kept: model 0 is the reference to the bit; boost.model
        // 1 is matched on the four-stroke-equivalent displacement, below)
        const float mRef = 1.2f * vTotal * ecu.redRpm / 120.0f * 0.9f;
        boost.control(aspUse, boost.smTb, exh.mdot * exh.tPort / 1100.0f / fmaxf(mRef, 1.0e-6f), fuelUse != 0 ? 1.0f : ecu.throttle, ecu.throttle,
                   set.bov, crank.rpm / ecu.redRpm, crank.rpm * 0.016666667f, boost.smTs, d16);
        if (spec.boost.model != 0)
        {
            // (card F: its machine's air at the throttle, toward the ECU's target; card H's)
            boost.airSpeed(set.drive != 0 ? fabsf(car.v) : 0.0f);
            if (hd.on != 0)
                boost.vanesAndPurge(hd.vaneCommand(), 0);   // (card D2: a VGT's brake position while a brake is on; -1 its own loop)
            boost.control16(d16, ecu.boostTarget(), ecu.antiLag(), ecu.nitrous());
            intk.pBox = boost.pressure();
            intk.tAir = boost.temperature();
        }
        else
        {
            intk.pBox = 101325.0f + 100000.0f * boost.boost;
            intk.tAir = heat.tAmb + 5.0f * heat.warm + 25.0f * boost.boost;
        }
        intk.control(d16, crank.omega, vTotal, 120.0f / fmaxf(crank.rpm, 60.0f));      // (card E; nothing at intake.model 0)
        exh.gas(d16);
        // the walls' heat: Woschni's with spec.engine.wallHeat 1 or fuel.model 1 (each cylinder from where it stands:
        // core/wallheat.fm), else the reference's (by speed alone, the same through the cycle)
        if (woschniWalls() && lay.rotary != 0)
        {
            // (a rotary's faces: the chamber's own walls and the gas's speed along them, core/wallheat.fm; with fuel.model
            // 1, the seals' leakage, cylinder.fm)
            for (int c = 0; c < lay.n; ++c)
            {
                Cylinder* cy = &cyl[c];
                const float a = cy->ang;
                const int burning = a >= cy->sparkAt || a < cy->evo ? 1 : 0;
                cy->hA = wall.coefficientRotary(c, cy->p, cy->t, cy->v, crank.omega, burning);
                cy->leakA = spec.fuel.model != 0 ? wall.leakArea() : 0.0f;
            }
        }
        else if (woschniWalls())
        {
            const float sp = strokeUse * crank.omega * 0.31830989f;
            for (int c = 0; c < lay.n; ++c)
            {
                Cylinder* cy = &cyl[c];
                const float a = cy->ang;
                const int burning = a >= cy->sparkAt || a < cy->evo ? 1 : 0;
                const int exchanging = cy->areaAt(a, cy->evo, cy->edur) > 0.0f || cy->areaAt(a, cy->ivo, cy->idur) > 0.0f ? 1 : 0;
                cy->hA = wall.coefficient(c, a, cy->p, cy->t, cy->v, sp, burning, exchanging);
            }
        }
        else
        {
            const float surf = 0.022f * expf(0.6666667f * logf(cyl[0].vd / 0.0005f));
            for (int c = 0; c < lay.n; ++c)
            {
                cyl[c].hA = 260.0f * surf * (0.6f + crank.rpm / 2500.0f);
                cyl[c].leakA = 0.0f;
            }
        }
        exh.heatUp(d16, bore, set.drive != 0 ? fabsf(car.v) : 0.0f, crank.rpm, ecu.throttle);
        pipes();
        exh.flow16();
        intk.flow16(lay.ports, exh.xiWall, exh.k16Flow);
        exh.bands();
        // the packages' hooks every 16 samples, each only with its model 1 (sim/README.md, "The hooks")
        if (spec.valve.model != 0)
        {
            vt.oil(heat.oilPressure(), heat.oilTemperature());
            vt.control16(d16, crank.omega, ecu.redRpm * 0.10471976f, ecu.throttle, crank.theta, &lay.fire[0], ecu.camTarget(0),
                         ecu.camTarget(1), ecu.liftCommand());
        }
        if (spec.ecu.model != 0 && set.drive != 0)
            ecu.vehicle(car.drivenSlip(), car.speedNow(), car.gearNow(), car.upshifts(), car.cutRequest(), car.blipRequest());
        // the charge's oxygen (nitrous: Boost's, card F) for Combustion's charge (card H); exactly 1 with boost.model 0
        comb.oxygen = boost.oxygenShare();
        mechanics16();
        // package M's mechanical voices (spec.voices.model 1; with model 0 it returns at once): their inputs, the car's
        // gearbox as either car model keeps it, the reference turbo's gate as open when its boost reaches its most
        if (spec.voices.model != 0 || ex.voOn != 0)
        {
            const int m1 = spec.car.model != 0 ? 1 : 0;
            const float bShare = boost.boost / fmaxf(boost.maxB, 0.01f);
            // (boost.model 1: card F's gates, the most open of them, and its kind; else the reference turbo's, open as its
            // boost reaches its most)
            const int bm1 = spec.boost.model != 0 && boost.mach.active != 0 ? 1 : 0;
            const float gateNow = bm1 != 0 ? fmaxf(fmaxf(boost.mach.telGate[0], boost.mach.telGate[1]), fmaxf(boost.mach.telGate[2], boost.mach.telGate[3]))
                                           : fminf(fmaxf((bShare - 0.95f) * 20.0f, 0.0f), 1.0f);
            // (card B2's motorcycle: its own sequential box, its input and ratio from Car; the chain is its final drive, so
            // the final drive's whine gets no speed)
            const int bk = car.model == 1 && car.bikeOn != 0 ? 1 : 0;
            ex.control16(d16, ctl.ignition, ecu.state, crank.omega * 0.15915494f, heat.tCool, set.drive != 0 ? 1 : 0,
                         bk != 0 ? 1 : (m1 != 0 ? spec.car.gearbox : 0), car.truck, bk != 0 ? car.gearNow() : car.gear,
                         bk != 0 ? car.bikeGearboxInput() : (m1 != 0 ? crank.omega - car.m1.slipC : car.wG),
                         bk != 0 ? car.bikeGearboxRatio() : (m1 != 0 ? car.m1.box.ratioOf(car.gear) : car.ratioOf(car.gear)),
                         bk != 0 ? 1.0f : (m1 != 0 ? car.m1.box.fd : car.finalDrive),
                         bk != 0 ? 0.0f : (m1 != 0 ? (float)car.m1.v / fmaxf(car.m1.radius, 0.05f) * car.m1.box.fd : car.wW * car.finalDrive),
                         tqBrake, peakTorque(), bk != 0 ? 1.0f - set.clutch : (m1 != 0 ? car.m1.engage * car.m1.box.robot : car.engage * car.robot),
                         aspUse, bShare, gateNow, bm1 != 0 ? spec.boost.gate : 0, exh.mdot / fmaxf(mRef, 1.0e-6f),
                         lay.n, lay.cyc, vt.clatter, vTotal, fuelUse, bk, car.sprocketSpeed(),
                         spec.car.frontSprocket, spec.car.clutchDry ? 1 : 0, spec.car.primaryRatio, 1.0f - set.clutch);
        }
    }

    // Every 16 samples, last: the mechanics' slow part. The cycle's speed spread; a custom engine's inertia with the
    // bench's load (the reference's 1 + 5 load) and its oil factor; the shaking at this speed. Nothing here touches the
    // reference's engine.
    void mechanics16()
    {
        float sinceRip = crank.theta - ripTh;
        if (sinceRip < 0.0f)
            sinceRip += 2160.0f;
        if (sinceRip >= lay.cyc)
        {
            ripple = omMax - omMin;
            omMin = crank.omega;
            omMax = crank.omega;
            ripTh = crank.theta;
        }
        if (physicalFriction())
            oilK = fminf(expf(0.15f * logf(heat.viscK)), 3.0f);
        if (customUse != 0)
        {
            mm.j0 = jFly * (dynoOn != 0 ? 1.0f : 1.0f + 5.0f * set.load) + (float)mm.n * mm.mRot * mm.sc.r * mm.sc.r;
        }
        shake.update((crank.theta + geo.tdc[0]) * 0.01745329252f, crank.omega);
        if (dynoOn == 0 && dyno.on != 0)
            dyno.stop();
    }

    // ---- driven (DRIVE CAR) ----

    float gearTq;       // the full-load torque the car's gearing was chosen for (at the layout's or size's change)
    float clatSize;     // a diesel's clatter for its cylinders' size: their panels' area (a cube root of the volume)

    // About the most torque this engine gives (the turbo's boost with it), for the clutch's capacity
    float peakTorque()
    {
        const float b = aspUse == 0 ? 0.0f : (aspUse == 4 ? 0.25f + 0.75f * set.turbo : 0.35f + 1.05f * set.turbo);
        return 1.6f * mech.idleTq * (1.0f + 0.8f * b);
    }

    // While ctl.scopeOn is set, each sample after the cylinders: cylinder 1's pressure, volume and its valves' lifts
    // at each whole degree of its cycle as it passes, and, when its cycle comes round, that whole cycle into the Scope
    // (with the pressures along the first bank's pipes as they stand). It reads and never writes the model's state:
    // the sound is the same with it on or off (the null test runs with it on in "views")
    void scopeTap()
    {
        Cylinder* c1 = &cyl[0];
        const float a = c1->ang;
        if (a < scAng)
        {
            const int n = (int)lay.cyc;
            for (int d = 0; d < n; ++d)
            {
                scope.pressure[d] = scP[d];
                scope.volume[d] = scV[d];
                scope.liftExhaust[d] = scE[d];
                scope.liftIntake[d] = scI[d];
                scope.portIntake[d] = scPi[d];
                scope.portExhaust[d] = scPe[d];
            }
            scope.degrees = n;
            scope.cycles += 1;
            scope.pipePoints = 8;
            scope.pipePressure[0] = 101325.0f + exh.prim[0].near + exh.prim[0].far;
            scope.pipePressure[1] = 101325.0f + exh.sec[0].near + exh.sec[0].far;
            scope.pipePressure[2] = 101325.0f + exh.pipe[0].near + exh.pipe[0].far;
            scope.pipePressure[3] = 101325.0f + exh.ch1[0].near + exh.ch1[0].far;
            scope.pipePressure[4] = 101325.0f + exh.mid[0].near + exh.mid[0].far;
            scope.pipePressure[5] = 101325.0f + exh.ch2[0].near + exh.ch2[0].far;
            scope.pipePressure[6] = 101325.0f + exh.tail[0].near + exh.tail[0].far;
            scope.pipePressure[7] = intk.pPlenum;
        }
        scAng = a;
        const int d = (int)a;
        if (d != scDeg && d >= 0 && d < SCOPE_DEGREES)
        {
            scDeg = d;
            scP[d] = c1->p;
            scV[d] = c1->v;
            scE[d] = vt.liftEx(0, a);
            scI[d] = vt.liftIn(0, a);
            // (the pressure at each port: the wave arriving and the one leaving, over the air's)
            const int pt = lay.port[0];
            scPi[d] = 101325.0f + 2.0f * intk.run[pt].near + intk.run[pt].z * c1->qIa;
            scPe[d] = 101325.0f + 2.0f * exh.prim[pt].near + exh.prim[pt].z * c1->qEa;
        }
    }

    // ---- one sample ----

    // ---- card T: a two-stroke's sample (spec.engine.cycle 1), in place of the cylinders, valves, intake and exhaust ----

    void twoStrokeTick(float dDeg)
    {
        // the carburettors' slides: the throttle, with the idle valve as a slide carburettor's idle stop (at most 12 % of
        // the bore, judgement; the reference's plenum gives its idle valve 4.5 %, too little for a two-stroke to idle)
        const float thr = fminf(ecu.throttle + 0.12f * ecu.bypass, 1.0f);
        const float torque = two.step(&spec.engine, crank.theta, dDeg, dt, crank.omega, thr, ecu.fuelCut ? 0 : 1, 101325.0f, heat.tAmb);
        if (ctl.scopeOn != 0)
            scopeTwo();
        intk.qThr = two.mIn / 1.18f;
        mech.torques(crank.rpm, crank.omega, strokeK, heat.viscK, fuelUse, smCR, vTotal, set.load, ecu.redRpm, heat.tAmb, ecu.starterOn,
                     two.vd);
        const float tf = fric.torque(&spec.engine, crank.omega, fmaxf(two.peak, 3.0e6f), oilK);
        heat.fricJ += tf * crank.omega * dt;
        tqAbs = dynoOn != 0 ? dyno.step(crank.omega, ctl.dynoSpeed, ctl.dynoRate, dt) : 0.0f;
        const float th = (crank.theta + geo.tdc[0]) * 0.01745329252f;
        const float sn = sinf(th);
        const float cs = cosf(th);
        if (set.drive == 0)
            crank.omega = mm.advance(crank.omega, torque - tf - (dynoOn != 0 ? tqAbs : mech.tl) + mech.ts, dt, sn, cs);
        else
            crank.omega = car.step(crank.omega, torque + mm.torque(sn, cs, crank.omega) - tf + mech.ts, dt,
                                   mm.jNow);         // (the crank's inertia at this angle, as the four-stroke's step below)
        crank.ripple(torque);
        tqBrake += (torque - tf - tqBrake) * 1.0e-4f;
        omMin = fminf(omMin, crank.omega);
        omMax = fmaxf(omMax, crank.omega);
        ex.tick(intk.qThr, 0.0f, crank.omega * 0.15915494f, 0.0f, 0, 0.0f, car.lashStrike());
        boost.sound(crank.omega * 0.15915494f, two.mdot, set.bov);
        ex.tickStarter(crank.omega * 0.15915494f, ecu.starterOn);
    }

    // The Scope for a two-stroke: cylinder 1's cycle of 360 degrees; the exhaust and transfer ports' open shares in
    // place of the valves' lifts; the port's pressure; along the pipe, its sections' pressures (header, the diffuser's
    // middle, the belly, the baffle's middle, the stinger) and the crankcase's
    void scopeTwo()
    {
        const float a = two.angleOf(0, crank.theta);
        if (a < scAng)
        {
            for (int d = 0; d < 360; ++d)
            {
                scope.pressure[d] = scP[d];
                scope.volume[d] = scV[d];
                scope.liftExhaust[d] = scE[d];
                scope.liftIntake[d] = scI[d];
                scope.portIntake[d] = scPi[d];
                scope.portExhaust[d] = scPe[d];
                scope.inletOpen[d] = scIo[d];
            }
            scope.degrees = 360;
            scope.cycles += 1;
            ExpansionChamber* pc = &two.ch[0];
            const int last = pc->n - 1;
            scope.pipePoints = 7;
            for (int k = 0; k < 6; ++k)
            {
                const int i = (k * last) / 5;
                scope.pipePressure[k] = 101325.0f + pc->seg[i].near + pc->seg[i].far;
            }
            scope.pipePressure[6] = two.cy[0].pc;
        }
        scAng = a;
        const int d = (int)a;
        if (d != scDeg && d >= 0 && d < 360)
        {
            scDeg = d;
            scP[d] = two.cy[0].p;
            scV[d] = two.cy[0].v;
            scE[d] = two.openExhaust(0);
            scI[d] = two.openTransfer(0);
            scPi[d] = two.cy[0].pc;                              // (the crankcase: what feeds the transfers)
            scPe[d] = 101325.0f + two.pPort[0];
            scIo[d] = two.cy[0].inletOpen;
        }
    }

    void sampleTick()
    {
        const int np = lay.ports;
        exh.read();
        intk.read(np);
        // the crank
        const float dDeg = crank.advance(dt);
        if (cycleUse != 0)
        {
            twoStrokeTick(dDeg);
            return;
        }
        // the cylinders
        float qe[MAX_PORTS];
        float qi[MAX_PORTS];
        for (int i = 0; i < np; ++i)
        {
            qe[i] = 0.0f;
            qi[i] = 0.0f;
        }
        float torque = 0.0f;
        float dps = 0.0f;
        // (its expf and logf only when the speed they follow has moved: crank.rpm changes every 16 samples, and at a start)
        if (crank.rpm != clickRpm)
        {
            clickRpm = crank.rpm;
            clickAmpC = 0.15f + 0.5f * expf(0.8f * logf(fmaxf(fminf(crank.rpm / 4000.0f, 1.6f), 0.01f)));
        }
        const float clickAmp = clickAmpC;
        // (a piston's slap: its skirt hits the bore as the side thrust changes sides at the top, harder with the gas's
        // pressure there and the piston's speed)
        const float slapAmp = 0.4f + 0.6f * fminf(crank.rpm / 3000.0f, 2.0f);
        const float tH = exh.tUse[0];
        // faces that share a port (a rotary's) are solved together: each sees the pipe as the others' flows leave it
        float eShare[MAX_PORTS];
        float iShare[MAX_PORTS];
        float qE0[MAX_CYL];
        float qI0[MAX_CYL];
        if (np < lay.n)
        {
            for (int i = 0; i < np; ++i)
            {
                eShare[i] = 0.0f;
                iShare[i] = 0.0f;
            }
            for (int c = 0; c < lay.n; ++c)
            {
                const float a = wrapCycle(crank.theta + lay.fire[c], lay.cyc);
                const int pi = lay.port[c];
                if (spec.valve.model != 0)
                {
                    qE0[c] = cyl[c].exhaustFlowArea(vt.areaEx(&cyl[c], c, a), exh.prim[pi].near, exh.prim[pi].z, tH);
                    qI0[c] = cyl[c].intakeFlowArea(vt.areaIn(&cyl[c], c, a), intk.run[pi].near, intk.run[pi].z, intk.tAir);
                }
                else
                {
                    qE0[c] = cyl[c].exhaustFlowAt(a, exh.prim[pi].near, exh.prim[pi].z, tH);
                    qI0[c] = cyl[c].intakeFlowAt(a, intk.run[pi].near, intk.run[pi].z, intk.tAir);
                }
                eShare[pi] += qE0[c];
                iShare[pi] += qI0[c];
            }
        }
        const float exM0 = exh.mSum;      // (card F, model 1: this sample's exhaust gas, for the turbine's stand-in)
        const float exE0 = exh.eSum;
        for (int c = 0; c < lay.n; ++c)
        {
            Cylinder* cy = &cyl[c];
            const float a = wrapCycle(crank.theta + lay.fire[c], lay.cyc);
            const int pi = lay.port[c];
            float bE = exh.prim[pi].near;
            float bI = intk.run[pi].near;
            if (np < lay.n)
            {
                bE += 0.5f * exh.prim[pi].z * (eShare[pi] - qE0[c]);
                bI += 0.5f * intk.run[pi].z * (iShare[pi] - qI0[c]);
            }
            // (valve.model 1: the valvetrain gives the valves' areas; card E)
            if (hd.on != 0)
            {
                // (card D2: the compression brake's lobe added to the exhaust valve's area; the exhaust brake's back pressure)
                cy->stepAreas(a, dDeg, dt, vt.areaEx(cy, c, a) + hd.brakeArea(c, a), vt.areaIn(cy, c, a), bE + hd.back, exh.prim[pi].z, tH,
                              bI, intk.run[pi].z, intk.tAir);
                hd.sample(cy, c, a);
            }
            else if (spec.valve.model != 0)
                cy->stepAreas(a, dDeg, dt, vt.areaEx(cy, c, a), vt.areaIn(cy, c, a), bE, exh.prim[pi].z, tH, bI, intk.run[pi].z, intk.tAir);
            else
                cy->step(a, dDeg, dt, bE, exh.prim[pi].z, tH, bI, intk.run[pi].z, intk.tAir);
            work.sample(c, a, cy->p, cy->v);
            comb.sample(cy, c, dt);                     // card H: nothing under fuel.model 0 and ecu.model 0
            qe[pi] += cy->qEa;
            qi[pi] += cy->qIa;
            airValves -= (double)(cy->mI * dt);
            gasExhaust -= (double)(cy->mE * dt);
            torque += cy->tq;
            if (cy->mE > 0.0f)
            {
                exh.eSum += cy->mE * cy->t;
                exh.mSum += cy->mE;
            }
            if (cy->ivcNow)
            {
                work.trapped(c, fmaxf(cy->m - cy->mInert, 0.0f), cy->t, intk.pPlenum, intk.tAir, 101325.0f, heat.tAmb);
                airTrapped += (double)fmaxf(cy->m - cy->mInert, 0.0f);
                wall.ivc(c, cy->p, cy->v, cy->t);
                if (vt.active(c))
                    comb.charge(&cyl[c], c, fuelUse, intk.pPlenum, crank.rpm, smCR, crBs, burnK, set.pops, set.rough, set.timing);
                ex.valveClick(clickAmp * (1.0f + 2.0f * vt.clatter), 1);
            }
            if (cy->evcNow)
            {
                ex.valveClick(clickAmp * (1.0f + 2.0f * vt.clatter), 0);
                if (fuelUse == 0)
                    ex.injectorClick(0.3f);
            }
            if (fuelUse != 0 && cy->sparkNow && cy->qTot > 0.0f)
            {
                ex.injectorClick(1.0f);
                // (its premixed burn starts: how fast it raises the pressure, Pa/s, over an idling diesel's 5 bar a
                // millisecond, as its 0.55th power: the combustion noise some 12 dB up at full load at 2500 rpm)
                const float rise = 0.3f * cy->beta * cy->qTot / cy->vc * 6.0f * fmaxf(crank.rpm, 100.0f) / cy->burnDur;
                ex.clatterClick(expf(0.55f * logf(fmaxf(rise * 2.0e-9f, 1.0e-6f))) * clatSize);
            }
            if (cy->knockNow)
                ex.knockClick(cy->knock);
            if (cy->slapNow)
                ex.slapClick(slapAmp * sqrtf(fmaxf(cy->p - 101325.0f, 0.0f) / 5.0e6f));
            if (cy->burnAt >= 0.0f && cy->dpdt > 0.0f)
                dps += cy->dpdt;
        }
        if (ctl.scopeOn != 0)
            scopeTap();
        exh.step(qe, np);
        // (card F, model 1: unless card G's network ends its collectors in the turbine's housings (exhaust.model 1, whose
        // step calls the housings), the cylinders' gas this sample feeds them as a flow, and the downpipes are open
        // ends of the collector pipe's impedance)
        if (spec.boost.model != 0 && exh.turbinesFed() == 0)
            boost.exhaustStandIn(exh.mSum - exM0, exh.eSum - exE0, exh.sec[0].z);
        float rNear[MAX_PORTS];
        for (int i = 0; i < np; ++i)
            rNear[i] = intk.run[i].near + intk.run[i].z * qi[i];
        intk.plenum(np, rNear, fuelUse, vt.plateOpen() != 0 ? 1.0f : ecu.throttle, ecu.bypass, dt);
        airThrottle += (double)(intk.qThr * intk.pBox / (287.0f * intk.tAir) * dt);
        mech.torques(crank.rpm, crank.omega, strokeK, heat.viscK, fuelUse, smCR, vTotal, set.load, ecu.redRpm, heat.tAmb, ecu.starterOn,
                     cyl[0].vd);
        // (a custom engine's friction by part: core/friction.fm, on the last cycle's peak pressure)
        const float tf = physicalFriction() ? fric.torque(&spec.engine, crank.omega, fmaxf(work.peakMax, 3.0e6f), oilK) : mech.tf;
        heat.fricJ += tf * crank.omega * dt;
        // (boost.model 1: the boost machinery's own step, and the torque it takes from the crank; card F)
        if (spec.boost.model != 0)
        {
            boost.draw(intk.qThr * intk.pBox / (287.0f * intk.tAir));
            boost.tick(crank.omega, intk.pPlenum);
        }
        const float tsc = spec.boost.model != 0 ? boost.crankTorque : boost.drag(aspUse, vTotal, crank.omega);
        // the engine dyno's absorber (MODE_DYNO_ENGINE): its torque taken from the crank, the load in place of the bench's
        // (whose load dial, and the inertia it adds, rest while the dyno holds the crank)
        tqAbs = dynoOn != 0 ? dyno.step(crank.omega, ctl.dynoSpeed, ctl.dynoRate, dt) : 0.0f;
        if (customUse != 0)
        {
            // the moving masses: the inertia torque and the varying inertia, the crank's energy stepped exactly
            const float th = (crank.theta + geo.tdc[0]) * 0.01745329252f;
            const float sn = sinf(th);
            const float cs = cosf(th);
            if (set.drive == 0)
                crank.omega = mm.advance(crank.omega, torque - tf - tsc - (dynoOn != 0 ? tqAbs : mech.tl) + mech.ts, dt, sn, cs);
            else
                crank.omega = car.step(crank.omega, torque + mm.torque(sn, cs, crank.omega) - tf - tsc + mech.ts, dt,
                                       mm.jNow);     // (the crank's inertia at this angle, this sample's or the last's)
        }
        else if (set.drive == 0)
            crank.bench(torque, tf, tsc, dynoOn != 0 ? tqAbs : mech.tl, mech.ts, dynoOn != 0 ? jFly : mech.inertia(set.inertia, set.load), dt);
        else
            crank.omega = car.step(crank.omega, torque - tf - tsc + mech.ts, dt, 0.0f);   // (the car is the load: the load dial rests)
        crank.ripple(torque);
        // what it reports (no effect on the sound): the brake torque's mean, the speed's spread over a cycle
        tqBrake += (torque - tf - tsc - tqBrake) * 1.0e-4f;
        omMin = fminf(omMin, crank.omega);
        omMax = fmaxf(omMax, crank.omega);
        const float drop = fminf(fmaxf(1.0f - intk.pPlenum / intk.pBox, 0.0f), 1.0f);
        ex.tick(intk.qThr, drop, crank.omega * 0.15915494f, dps, spec.intake.model, intk.sound, car.lashStrike());
        boost.sound(crank.omega * 0.15915494f, exh.mdot, set.bov);
        ex.tickStarter(crank.omega * 0.15915494f, ecu.starterOn);
    }

    // n of the host's samples, added into left and right: the engine's own when the host runs at its rate (96 kHz),
    // else its output resampled
    void render(float* left, float* right, int n)
    {
        if (ready == 0)
            return;
        if (listen.rsOn == 0)
        {
            renderAt(left, right, n);
            return;
        }
        for (int i = 0; i < n; ++i)
        {
            while (listen.needs())
            {
                renderAt(listen.rsBl, listen.rsBr, 16);
                listen.pushPart();
            }
            listen.resampled(left, right, i);
        }
    }

    // n of the engine's own samples, added into left and right
    void renderAt(float* left, float* right, int n)
    {
        mech.idleTq = 0.6f * 1.0e6f * vTotal * 0.0795775f;     // about the torque at full load, for the load and the starter
        int at = 0;
        while (at < n)
        {
            const int m = n - at < 16 ? n - at : 16;
            // every 16 samples, the view and the dials as heard: another view (or layout, or size: control16) is taken
            // at the fade's quiet
            const int vw = set.view < 0 ? 0 : (set.view > 4 ? 4 : set.view);
            if (vw != vUse)
                cutWant |= 2;
            if (cutWant != 0 && cutG <= 0.0f)
            {
                // (a new engine fills its pipes over a few firings: it comes back slower, over 80 ms)
                cutUp = 1.0f / (((cutWant & 1) != 0 ? 0.08f : 0.012f) * rate);
                if ((cutWant & 1) != 0)
                    configure();
                vUse = vw;
                cutWant = 0;
            }
            const int v = vUse;
            listen.block(v, set.intake, set.mech, set.distance, set.room, set.level, aspUse, exTrim, gainNorm, exh.nDuals,
                         lay.bike, lay.tailD, &spec.sound, &tel.sound, car.speedNow(), set.drive != 0 ? 1 : 0, vTotal, lay.n,
                         customUse != 0 ? shake.fx : 0.0f, customUse != 0 ? shake.fy : 0.0f,
                         customUse != 0 ? shake.mx : 0.0f, customUse != 0 ? shake.my : 0.0f, lay.fire, lay.cyc, lay.rotary,
                         spec.car.kind == 2 && spec.car.model == 1 ? 1 : 0, spec.car.wheelbase, spec.car.tuck,
                         tel.car.liftAngle);
            for (int i = 0; i < m; ++i)
            {
                if (tick16 == 0)
                    control16();
                tick16 += 1;
                if (tick16 == 16)
                    tick16 = 0;
                sampleTick();
                // the sources, as they are heard from here
                const float rd = set.drive != 0 ? car.road(v == 4 ? 0.45f : 1.0f) : 0.0f;
                // (the fade's gain eased: a smooth step)
                cutG = cutWant != 0 ? fmaxf(cutG - cutDn, 0.0f) : fminf(cutG + cutUp, 1.0f);
                listen.mix(i, cycleUse != 0 ? two.outL * TS_LEVEL : exh.outL, cycleUse != 0 ? two.outR * TS_LEVEL : exh.outR, ex.intake, crank.tqNow, ex.mech, ex.block, boost.turbo, ex.starter, ex.comb, exh.shell[0],
                           lay.topo == 0 ? exh.shell[0] : exh.shell[1], set.drive, rd, cutG,
                           spec.voices.model != 0 ? ex.vo.gearbox : 0.0f, spec.voices.model != 0 ? ex.vo.axle : 0.0f,
                           spec.voices.model != 0 ? ex.vo.front : 0.0f, spec.voices.model != 0 ? ex.vo.head : 0.0f,
                           spec.voices.model != 0 ? ex.vo.tank : 0.0f, spec.voices.model != 0 ? ex.vo.gateOut : 0.0f,
                           spec.voices.model != 0 ? ex.vo.all : 0.0f, ex.mouth, spec.voices.model != 0 ? ex.vo.chain : 0.0f,
                           spec.voices.model != 0 ? ex.vo.clutch : 0.0f);
            }
            listen.finish(left, right, at, m);
            at += m;
        }
        if (ecu.state != 0)
            quiet = 0.0f;
        else
            quiet += (float)n;
        // the panel's
        showRpm = crank.rpm;
        showRed = ecu.redRpm;
        showGear = set.drive != 0 ? (float)car.gear : -2.0f;
        showKmh = set.drive != 0 ? car.kmh() : 0.0f;
        showThr = ecu.throttle;
        showMap = (intk.pPlenum - 101325.0f) * 0.00001f;
        showLamps = (float)ecu.state + (ecu.limiting || comb.droop < 0.95f ? 4.0f : 0.0f) + (ecu.fuelCut && ecu.state == 2 ? 8.0f : 0.0f) + (set.drive != 0 ? 16.0f : 0.0f)
                    + 32.0f * floorf(fminf(fmaxf((heat.tCool - 273.15f) * 1.8f + 92.0f, 0.0f), 511.0f) + 0.5f)
                    + 16384.0f * floorf(fminf(heat.pOil / 6894.76f, 127.0f) + 0.5f) + (set.drive == 2 ? 2097152.0f : 0.0f);
        showPedals = 0.0f;
        if (set.drive != 0)
            showPedals = floorf(100.0f * fminf(fmaxf(set.brake, 0.0f), 1.0f) + 0.5f) + 1000.0f * floorf(100.0f * fminf(fmaxf(set.clutch, 0.0f), 1.0f) + 0.5f);
        // the cycle as it turns, eased toward a few a second at speed so the eye can follow the order
        const float cycHz = crank.rpm / 60.0f * 360.0f / lay.cyc;
        const float visHz = cycHz < 2.4f ? cycHz : fminf(2.4f * expf(0.25f * logf(cycHz / 2.4f)), 4.0f);
        showCycle += visHz * (float)n * dt;
        showCycle -= floorf(showCycle);
        showBoost = boost.boost;
        showAir = (aspUse != 0 ? (float)aspUse + fminf(boost.smTb, 0.99f) : 0.0f)
                  + 10.0f * (floorf(66.0f * (smBs - 0.5f) + 0.5f) + 1.0f);
        showPipes = floorf(99.0f * fminf(fmaxf(exh.smHdr, 0.0f), 1.0f) + 0.5f) * 10000.0f
                    + floorf(99.0f * fminf(fmaxf(exh.smPipe, 0.0f), 1.0f) + 0.5f) * 100.0f
                    + floorf(99.0f * fminf(fmaxf(exh.smXp, 0.0f), 1.0f) + 0.5f);
    }

    // Still sounding: the engine runs, or the room still rings after it stopped (or, driven, the car still rolls)
    bool audible()
    {
        return ecu.state != 0 || quiet < (0.4f + 2.2f * set.room + 0.3f) * rate || (set.drive != 0 && car.moving())
               || (spec.voices.model != 0 && ex.busy());
    }

    void init(float hostRate)
    {
        clickRpm = -1.0f;
        faults = 0;
        faultNow = 0;
        modelUse[0] = spec.valve.model;
        modelUse[1] = spec.intake.model;
        modelUse[2] = spec.boost.model;
        modelUse[3] = spec.exhaust.model;
        modelUse[4] = spec.fuel.model;
        modelUse[5] = spec.ecu.model;
        modelUse[6] = spec.car.model;
        modelUse[7] = spec.voices.model;
        modelUse[8] = spec.engine.wallHeat;
        modelUse[9] = spec.sound.model;
        modelUse[10] = spec.engine.cycle;
        for (int k = 0; k < 11; ++k)
        {
            modelWant[k] = modelUse[k];
            modelRev[k] = -1;
        }
        lastIgn = IGN_OFF;
        hostRateSeen = hostRate;
        setupAll(hostRate);
        for (int k = 0; k < SPEC_SECTIONS; ++k)
            revSeen[k] = 0;
        fresh = 1;
        held = 0;
        sounding = 0;
        ghost = 0;
        upSeen = ctl.shiftUp;
        downSeen = ctl.shiftDown;
        upPulse = 0;
        downPulse = 0;
    }

    void end()
    {
        releaseAll();
    }

    // Whether section k's rev has moved since it was last applied (and now it has been)
    bool moved(int k, int rev)
    {
        if (fresh == 0 && revSeen[k] == rev)
            return false;
        revSeen[k] = rev;
        return true;
    }

    // The Spec into the Dials: each section whose rev moved, units converted back to the reference's dials'
    void readSpec()
    {
        Dials* s = &set;
        if (moved(0, spec.engine.rev))
        {
            geoSig = geometry();
            s->layout = spec.engine.layout;
            s->size = spec.engine.displacement * 1000.0f;                  // m^3 to litres
            s->bs = spec.engine.boreStroke;
            s->comp = spec.engine.compression;
            s->inertia = spec.engine.flywheel;
            s->idle = spec.engine.idleTrim;
            s->redline = spec.engine.redlineTrim;
            s->rough = spec.engine.rough;
            s->load = spec.engine.benchLoad;
        }
        if (moved(1, spec.valve.rev))
        {
            s->cam = spec.valve.cam;
            vt.apply(&spec.valve);
        }
        if (moved(2, spec.intake.rev))
            intk.apply(&spec.intake);
        if (moved(3, spec.boost.rev))
        {
            s->asp = spec.boost.kind;
            s->turbo = spec.boost.level;
            s->tsize = spec.boost.size;
            s->bov = spec.boost.blowOff;
            boost.applyMachine(&spec.boost, vTotal * (lay.rotary != 0 || (spec.engine.cycle != 0 && customUse != 0) ? 2.0f : 1.0f), ecu.redRpm, 101325.0f, heat.tAmb);
            ecu.overBoostRef = boost.overBoostLevel();     // (N2: the machine's own over-boost level for ecu.model 1's cut)
        }
        if (moved(4, spec.exhaust.rev))
        {
            s->headers = spec.exhaust.headers;
            s->pipe = spec.exhaust.pipe;
            s->xpipe = spec.exhaust.crossover;
            s->muffler = spec.exhaust.muffler;
        }
        if (moved(5, spec.fuel.rev))
            s->fuel = spec.fuel.kind;
        if (moved(6, spec.ecu.rev))
        {
            s->timing = spec.ecu.timing;
            s->pops = spec.ecu.pops;
            s->starter = spec.ecu.starter ? 1 : 0;
        }
        if (moved(7, spec.car.rev))
            s->mass = spec.car.mass;
        if (moved(8, spec.env.rev))
            s->ambF = (spec.env.temperature - 300.0f) * 1.8f + 80.33f;    // K to the reference's F (80.33 F its 300 K)
        if (moved(9, spec.sound.rev))
        {
            s->view = spec.sound.view;
            s->distance = spec.sound.distance;
            s->room = spec.sound.room;
            s->level = spec.sound.level;
            s->intake = spec.sound.intake;
            s->mech = spec.sound.mechanical;
        }
        fresh = 0;
        // every package's model switch (and the wall heat's) under the fade, one rule for all: running, a change is held
        // back (the Spec keeps its old value) and made at the fade's quiet, by configure (applyModels)
        holdModel(0, &spec.valve.model, &spec.valve.rev);
        holdModel(1, &spec.intake.model, &spec.intake.rev);
        holdModel(2, &spec.boost.model, &spec.boost.rev);
        holdModel(3, &spec.exhaust.model, &spec.exhaust.rev);
        holdModel(4, &spec.fuel.model, &spec.fuel.rev);
        holdModel(5, &spec.ecu.model, &spec.ecu.rev);
        holdModel(6, &spec.car.model, &spec.car.rev);
        holdModel(7, &spec.voices.model, &spec.voices.rev);
        holdModel(8, &spec.engine.wallHeat, &spec.engine.rev);
        holdModel(9, &spec.sound.model, &spec.sound.rev);
        holdModel(10, &spec.engine.cycle, &spec.engine.rev);
    }

    // Section k's model switch as the host wrote it: stopped, taken at once; running, a change held until the fade's
    // quiet (the field put back to the value in use, the one wanted kept, the fade asked for)
    void holdModel(int k, int* field, int* rev)
    {
        // (only when the host has written the section: its rev moved since this was last here)
        if (*rev == modelRev[k])
            return;
        modelRev[k] = *rev;
        modelWant[k] = *field;
        if (*field == modelUse[k])
            return;
        if (ecu.state == 0)
        {
            modelUse[k] = *field;
            modelWant[k] = *field;
            return;
        }
        *field = modelUse[k];
        cutWant |= 1;
    }

    // At configure: section k's held switch made (its rev moved, so a package that caches its section reads it again)
    int applyModel(int k, int* field, int* rev)
    {
        if (modelWant[k] != *field)
        {
            *field = modelWant[k];
            *rev += 1;
        }
        modelRev[k] = *rev;
        return *field;
    }

    void applyModels()
    {
        modelUse[0] = applyModel(0, &spec.valve.model, &spec.valve.rev);
        modelUse[1] = applyModel(1, &spec.intake.model, &spec.intake.rev);
        modelUse[2] = applyModel(2, &spec.boost.model, &spec.boost.rev);
        modelUse[3] = applyModel(3, &spec.exhaust.model, &spec.exhaust.rev);
        modelUse[4] = applyModel(4, &spec.fuel.model, &spec.fuel.rev);
        modelUse[5] = applyModel(5, &spec.ecu.model, &spec.ecu.rev);
        modelUse[6] = applyModel(6, &spec.car.model, &spec.car.rev);
        modelUse[7] = applyModel(7, &spec.voices.model, &spec.voices.rev);
        modelUse[8] = applyModel(8, &spec.engine.wallHeat, &spec.engine.rev);
        modelUse[9] = applyModel(9, &spec.sound.model, &spec.sound.rev);
        modelUse[10] = applyModel(10, &spec.engine.cycle, &spec.engine.rev);
        physicalCylinder();
    }

    // A paddle's press as the reference's wheel made it: its button down until Car's shift logic (drive16) has seen
    // it, then up until it has seen that; a press counted meanwhile waits its turn
    int paddle(int pulse, int bit)
    {
        if (pulse == 1 && (car.lastButtons & bit) != 0)
            return 2;
        if (pulse == 2 && (car.lastButtons & bit) == 0)
            return 0;
        return pulse;
    }

    // ctl into the Dials, and the key the reference's player would hold
    void readControls()
    {
        Dials* s = &set;
        // (the chassis dyno is the vehicle's: driven, as on the road)
        const bool driven = ctl.mode == MODE_DRIVE || ctl.mode == MODE_DYNO_CHASSIS;
        s->drive = driven ? (spec.car.kind == 1 ? 2 : 1) : 0;
        s->hold = 1.0e9f;            // it never switches itself off (the reference's HOLD idled it out)
        s->bendRange = 12.0f;
        s->bend = 0.0f;
        s->pressure = 0.0f;
        s->modwheel = driven ? 0.0f : ctl.throttle;   // MODE_BENCH: the throttle by hand (the mod wheel's path)
        s->gas = driven ? ctl.throttle : 0.0f;
        s->brake = ctl.brake;
        s->clutch = ctl.clutch;
        s->lever = ctl.lever;
        // the paddles: a press is a counter's increase
        if (driven)
        {
            upPulse = paddle(upPulse, 16);
            downPulse = paddle(downPulse, 32);
            if (upPulse == 0 && ctl.shiftUp != upSeen)
            {
                upSeen += 1;
                upPulse = 1;
            }
            if (downPulse == 0 && ctl.shiftDown != downSeen)
            {
                downSeen += 1;
                downPulse = 1;
            }
        }
        else
        {
            upSeen = ctl.shiftUp;
            downSeen = ctl.shiftDown;
            upPulse = 0;
            downPulse = 0;
        }
        s->buttons = (upPulse == 1 ? 16 : 0) + (downPulse == 1 ? 32 : 0);
        // holdSpeed (MODE_BENCH, running): the reference's key driver aimed at it, by a key of the pitch whose firing
        // that speed is (its DRIVE PITCH), held as the newest key
        const bool aim = !driven && ctl.holdSpeed > 0.0f && ecu.state == 2;
        if (aim)
        {
            const float perRev = lay.rotary != 0 ? 2.0f : 0.5f * (float)lay.n;
            const float hz = ctl.holdSpeed * 0.15915494f * perRev;
            const float note = 69.0f + logf(fmaxf(hz, 1.0f) / 440.0f) / 0.0577622650f;
            if (ghost == 0)
            {
                if (ecu.keyCount >= 16)
                    ecu.keyCount = 15;
                ecu.keyCount += 1;
                ghost = 1;
            }
            ecu.keyNote[ecu.keyCount - 1] = note;
            ecu.keyVel[ecu.keyCount - 1] = 1.0f;
        }
        else if (ghost != 0)
        {
            ecu.keyCount = ecu.keyCount > 0 ? ecu.keyCount - 1 : 0;
            ghost = 0;
        }
        s->keys = ghost;
        // the engine dyno: on the bench (a mode of its own), its absorber holds or sweeps the crank
        dynoOn = ctl.mode == MODE_DYNO_ENGINE && ecu.state == 2 ? 1 : 0;
    }

    // The ignition as the reference's start key: start, held while the engine is not running, is the key down (it
    // cranks; without a starter it runs at once); let go while it still cranks, the starter stops; off runs it down
    void ignition()
    {
        const int ign = ctl.ignition;
        // (mechanical voices, voices.model 1: the key turned on is heard before a start: the fuel pump's prime)
        if (spec.voices.model != 0 && ign != IGN_OFF && lastIgn == IGN_OFF)
            sounding = 1;
        lastIgn = ign;
        if (ign == IGN_START)
        {
            if (ecu.state == 0 || ecu.state == 3)
            {
                if (held != 0)
                    keyUp((float)START_NOTE);
                keyDown((float)START_NOTE, 1.0f);
                held = 1;
                sounding = 1;
            }
            return;
        }
        if (held != 0)
        {
            keyUp((float)START_NOTE);
            held = 0;
            if (ecu.state == 1)
                ecu.state = 0;
        }
        if (ign == IGN_OFF && (ecu.state == 1 || ecu.state == 2))
        {
            ecu.state = 3;
            ecu.stallT = 0.0f;
            ecu.offArmed = false;
        }
    }

    // What the machine did, (the reference's show* fields, unpacked into SI)
    void writeTelemetry(float peak)
    {
        const bool driven = set.drive != 0;
        tel.engine.state = ecu.state;
        tel.engine.speed = crank.rpm * 0.10471976f;
        tel.engine.redline = ecu.redRpm * 0.10471976f;
        tel.engine.idle = ecu.idleRpm * 0.10471976f;
        tel.engine.throttle = ecu.throttle;
        tel.engine.manifold = intk.pPlenum;
        tel.engine.coolant = heat.tCool;
        tel.engine.oilPressure = heat.pOil;
        tel.engine.flags = (ecu.limiting || comb.droop < 0.95f ? FLAG_LIMITER : 0)
                           + (ecu.fuelCut && ecu.state == 2 ? FLAG_FUEL_CUT : 0) + (faultNow != 0 ? FLAG_FAULT : 0);
        tel.engine.cycle = showCycle;
        tel.engine.crank = crank.theta;
        mechanicsTelemetry();
        tel.boost.pressure = boost.boost * 100000.0f;
        boost.telemetry(&tel.boost, intk.tAir);
        if (ctl.scopeOn != 0)
            boost.scope(&scope);
        tel.exhaust.portTemperature = exh.tPort;
        tel.ecu.knockRetard = ecu.kRet;
        // (degrees before the top; a spark after it, retarded past the top, negative, not a cycle less a little: X-011)
        tel.ecu.advance = lay.cyc - cyl[0].sparkAt > 0.5f * lay.cyc ? -cyl[0].sparkAt : lay.cyc - cyl[0].sparkAt;
        tel.sound.rate = hostRateSeen;
        tel.car.speed = driven ? fabsf(car.v) : 0.0f;
        tel.car.gear = driven ? car.gear : 0;
        tel.car.brake = fminf(fmaxf(set.brake, 0.0f), 1.0f);
        tel.car.clutch = fminf(fmaxf(set.clutch, 0.0f), 1.0f);
        tel.sound.peak = peak;
        vt.telemetry(&tel.valve);
        intk.telemetry(&tel.intake);
        hd.telemetry(&tel.ecu, &comb.diesel, fuelUse, spec.fuel.model);      // card D2: the smoke number, the diesel's measures
    }

    // card D's part of tel.engine
    void mechanicsTelemetry()
    {
        EngineTel* e = &tel.engine;
        e->torque = dynoOn != 0 ? dyno.tqMean : tqBrake;
        e->gasTorque = crank.tqMean;
        e->firing = crank.omega * 0.15915494f * (float)lay.n * 360.0f / lay.cyc;
        e->power = e->torque * crank.omega;
        e->imep = work.imepGross;
        e->pmep = work.pmep;
        e->fmep = physicalFriction() ? fric.fmep : mech.tf * 12.566371f / fmaxf(vTotal, 1.0e-6f) / fmaxf(fminf(crank.omega / 5.0f, 1.0f), 1.0e-3f);
        e->bmep = work.bmep(e->torque);
        e->veManifold = work.veManifold;
        e->veAir = work.veAir;
        e->chargeTemperature = work.tTrapMean;
        e->trappedMass = work.trappedMean;
        e->peakPressure = work.peakMax;
        e->pistonSpeed = strokeUse * crank.omega * 0.31830989f;     // 2 stroke rpm / 60
        e->ripple = ripple;
        e->dynoTorque = dyno.tqMean;
        e->dynoSpeed = dynoOn != 0 ? (float)dyno.ref : 0.0f;
        e->inertiaTorque = customUse != 0 ? mm.tqNow : 0.0f;
        e->shake1 = shake.force1;
        e->shake2 = shake.force2;
        e->rock1 = shake.moment1;
        e->rock2 = shake.moment2;
        e->cylinders = lay.n;
        e->layoutRefused = layoutRefused;
        e->oilTemperature = heat.tOil;
        // (card T: a two-stroke's)
        e->tsPurity = cycleUse != 0 ? two.purity : 0.0f;
        e->tsDelivery = cycleUse != 0 ? two.delivery : 0.0f;
        e->tsTrapping = cycleUse != 0 ? two.trapping : 0.0f;
        e->tsPowerValve = cycleUse != 0 ? two.valve : 0.0f;
        e->tsPipeTemperature = cycleUse != 0 ? two.tPipe : heat.tAmb;      // (no two-stroke pipe: the air's)
        e->tsCrankcase = cycleUse != 0 ? two.cy[0].pc : 101325.0f;          // (no two-stroke crankcase: the air's)
        e->tsReed = cycleUse != 0 ? two.cy[0].reed : 0.0f;
        if (cycleUse != 0)
            e->peakPressure = two.peak;
        for (int c = 0; c < MAX_CYL; ++c)
        {
            // (the angle after cylinder 1's at which each fires: the cycle less where it stands at cylinder 1's firing)
            e->firingAngle[c] = c < lay.n ? (lay.fire[c] > 0.0f ? lay.cyc - lay.fire[c] : 0.0f) : 0.0f;
            e->cylPeak[c] = c < lay.n ? work.w[c].peak : 0.0f;
            e->cylPeakAngle[c] = c < lay.n ? work.w[c].peakAt : 0.0f;
        }
    }

    // Once a call: a crank whose speed or angle is not finite, or is absurd (past five times the redline, and at least
    // 3000 rad/s: some model upstream has diverged, X-007), is put at rest and the engine made afresh, at rest, its
    // pipes and paths cleared, so nothing downstream runs on a non-finite state; FLAG_FAULT tells the host. Never in
    // normal running (the null test unchanged).
    void guard()
    {
        const float bound = fmaxf(5.0f * ecu.redRpm * 0.10471976f, 3000.0f);
        if (crank.omega >= 0.0f && crank.omega < bound && crank.theta >= 0.0f && crank.theta < 1.0e6f)
            return;
        recover();
    }

    // The engine put at rest and made afresh, its pipes and paths cleared; the call flagged
    void recover()
    {
        faults += 1;
        faultNow = 1;
        crank.omega = 0.0f;
        crank.theta = 0.0f;
        crank.rpm = 0.0f;
        crank.tqMean = 0.0f;
        crank.tqNow = 0.0f;
        ecu.state = 0;
        ecu.starterOn = 0.0f;
        car.reset();
        configure();
    }

    // n samples at the host's rate into left and right (whatever they held): the engine's sound, within +-1
    void process(float* restrict left, float* restrict right, int n) [[clang::nonblocking]]
    {
        for (int i = 0; i < n; ++i)
        {
            left[i] = 0.0f;
            right[i] = 0.0f;
        }
        readSpec();
        readControls();
        ignition();
        float peak = 0.0f;
        faultNow = 0;
        guard();
        if (sounding != 0 && n > 0)
        {
            render(left, right, n);
            guard();
            // (a sample not finite, from wherever it was born: the call silenced, the engine made afresh, the fault told)
            bool finite = true;
            for (int i = 0; i < n; ++i)
                finite = finite && left[i] - left[i] == 0.0f && right[i] - right[i] == 0.0f;
            if (!finite)
            {
                for (int i = 0; i < n; ++i)
                {
                    left[i] = 0.0f;
                    right[i] = 0.0f;
                }
                recover();
            }
            sounding = held != 0 || audible() ? 1 : 0;
            for (int i = 0; i < n; ++i)
                peak = fmaxf(peak, fmaxf(fabsf(left[i]), fabsf(right[i])));
        }
        writeTelemetry(peak);
    }
};
