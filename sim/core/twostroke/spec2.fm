// spec2.fm: a two-stroke engine's settings (card T), as they will be appended to spec.engine (the cylinder, ports,
// crankcase, intake valve, power valve) and to the exhaust's section (the expansion chamber) once the split has landed.
//
// Until then this module stands in for those fields, so the two-stroke can be built and tested on its own. Defaults are
// a 125 cc racing single of the kind karts and road racers used: 54 by 54.5 mm, an exhaust port open for 192 degrees
// and transfers for 130, a reed valve, a crankcase compression of 1.4, a pipe tuned near 11500 rpm. (Judgement from
// published tuning practice, Jennings's and Blair's books: none of it a particular engine's drawing.)
//
// Made under the fade: the cylinder's geometry, the ports' timings and widths, the crankcase, the pipe's sections.
// Glided: the power valve's speeds, the spark, the throttle (a control), the pipe's gas temperature (the engine's own).
#pragma once

enum
{
    TS_MAX_STEPS = 16       // stepped ducts a cone may be cut into
};

module TwoStrokeSpec
{
    int rev [[ui::hidden]];
    // ---- the cylinder ----
    float bore [[fminus::range(0.03, 0.12)]] [[fminus::default(0.054)]] [[ui::label("Bore")]] [[ui::quantity("length")]]
        [[ui::group("Two-stroke cylinder")]];
    float stroke [[fminus::range(0.03, 0.12)]] [[fminus::default(0.0545)]] [[ui::label("Stroke")]] [[ui::quantity("length")]];
    float rodLength [[fminus::range(0.06, 0.3)]] [[fminus::default(0.110)]] [[ui::label("Rod length")]] [[ui::quantity("length")]];
    float compression [[fminus::range(5, 20)]] [[fminus::default(13.5)]] [[ui::label("Compression (geometric)")]]
        [[ui::quantity("ratio")]];
    // ---- the ports: each opens when the piston uncovers its top edge, open for its duration about bottom dead centre;
    //      its width is the bore's share its windows span (the bridges between them left out) ----
    float exhaustDur [[fminus::range(140, 220)]] [[fminus::default(192)]] [[ui::label("Exhaust port open")]] [[ui::unit("deg")]]
        [[ui::group("Ports")]];
    float exhaustWidth [[fminus::range(0.3, 1.0)]] [[fminus::default(0.70)]] [[ui::label("Exhaust port width")]]
        [[ui::quantity("fraction")]] [[ui::help("Over the bore.")]];
    float transferDur [[fminus::range(100, 150)]] [[fminus::default(130)]] [[ui::label("Transfer ports open")]] [[ui::unit("deg")]];
    float transferWidth [[fminus::range(0.3, 1.6)]] [[fminus::default(1.10)]] [[ui::label("Transfer ports' width")]]
        [[ui::quantity("fraction")]] [[ui::help("All the transfers' windows together, over the bore.")]];
    float portCd [[fminus::range(0.4, 0.9)]] [[fminus::default(0.70)]] [[ui::label("Ports' discharge coefficient")]];
    // ---- the power valve: the exhaust port's top edge lowered at low speed (a shorter duration), raised above ----
    float valveDur [[fminus::range(0, 220)]] [[fminus::default(0)]] [[ui::label("Power valve closed: exhaust open")]]
        [[ui::unit("deg")]] [[ui::group("Power valve")]] [[ui::help("0: no power valve.")]];
    float valveFrom [[fminus::range(0, 2000)]] [[fminus::default(900)]] [[ui::label("Opens from")]] [[ui::quantity("rotation")]];
    float valveTo [[fminus::range(0, 2000)]] [[fminus::default(1150)]] [[ui::label("Fully open at")]] [[ui::quantity("rotation")]];
    // ---- the crankcase and its valve ----
    float crankcaseRatio [[fminus::range(1.1, 2.0)]] [[fminus::default(1.40)]] [[ui::label("Crankcase compression")]]
        [[ui::quantity("ratio")]] [[ui::group("Crankcase")]];
    int inletKind [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Inlet")]] [[ui::choices("Reed valve", "Rotary disc")]];
    float inletArea [[fminus::range(0.0001, 0.003)]] [[fminus::default(0.0008)]] [[ui::label("Inlet's open area")]]
        [[ui::quantity("area")]];
    float reedFull [[fminus::range(1000, 50000)]] [[fminus::default(15000)]] [[ui::label("Reed fully open at")]]
        [[ui::quantity("pressure")]] [[ui::help("The drop across the reed that opens it fully.")]];
    float reedTime [[fminus::range(0.0001, 0.002)]] [[fminus::default(0.0004)]] [[ui::label("Reed's response")]]
        [[ui::quantity("time")]];
    float discOpen [[fminus::range(0, 360)]] [[fminus::default(130)]] [[ui::label("Disc opens")]] [[ui::unit("deg")]]
        [[ui::help("Crank degrees after top dead centre.")]];
    float discDur [[fminus::range(90, 250)]] [[fminus::default(200)]] [[ui::label("Disc open for")]] [[ui::unit("deg")]];
    float carbArea [[fminus::range(0.0001, 0.003)]] [[fminus::default(0.00057)]] [[ui::label("Carburettor bore's area")]]
        [[ui::quantity("area")]];
    // ---- scavenging ----
    float mixing [[fminus::range(0, 1)]] [[fminus::default(0.55)]] [[ui::label("Scavenging: mixing")]]
        [[ui::quantity("fraction")]] [[ui::group("Scavenging")]]
        [[ui::help("0: the fresh charge displaces the burned gas; 1: it mixes with it at once.")]];
    float shortCircuit [[fminus::range(0, 0.5)]] [[fminus::default(0.10)]] [[ui::label("Short-circuited share")]]
        [[ui::quantity("fraction")]] [[ui::help("Of what the transfers deliver, what goes straight out of the exhaust.")]];
    // ---- the burn ----
    float spark [[fminus::range(0, 40)]] [[fminus::default(18)]] [[ui::label("Spark")]] [[ui::unit("deg")]]
        [[ui::group("Burn")]] [[ui::help("Crank degrees before top dead centre.")]];
    float burnDur [[fminus::range(20, 90)]] [[fminus::default(45)]] [[ui::label("Burn's duration")]] [[ui::unit("deg")]];
    float afr [[fminus::range(10, 16)]] [[fminus::default(12.8)]] [[ui::label("Air-fuel ratio")]] [[ui::quantity("ratio")]];
    // ---- the expansion chamber: header, diffuser, belly, baffle cone, stinger ----
    float headerLen [[fminus::range(0.02, 0.6)]] [[fminus::default(0.16)]] [[ui::label("Header")]] [[ui::quantity("length")]]
        [[ui::group("Expansion chamber")]];
    float diffuserLen [[fminus::range(0.05, 0.8)]] [[fminus::default(0.33)]] [[ui::label("Diffuser")]] [[ui::quantity("length")]];
    float bellyLen [[fminus::range(0.0, 0.5)]] [[fminus::default(0.12)]] [[ui::label("Belly")]] [[ui::quantity("length")]];
    float baffleLen [[fminus::range(0.05, 0.5)]] [[fminus::default(0.24)]] [[ui::label("Baffle cone")]] [[ui::quantity("length")]];
    float stingerLen [[fminus::range(0.05, 0.5)]] [[fminus::default(0.22)]] [[ui::label("Stinger")]] [[ui::quantity("length")]];
    float headerDiam [[fminus::range(0.015, 0.08)]] [[fminus::default(0.038)]] [[ui::label("Header's bore")]] [[ui::quantity("length")]];
    float bellyDiam [[fminus::range(0.03, 0.2)]] [[fminus::default(0.115)]] [[ui::label("Belly's bore")]] [[ui::quantity("length")]];
    float stingerDiam [[fminus::range(0.01, 0.05)]] [[fminus::default(0.022)]] [[ui::label("Stinger's bore")]] [[ui::quantity("length")]];
    int coneSteps [[fminus::range(1, 16)]] [[fminus::default(8)]] [[ui::label("Steps a cone")]]
        [[ui::help("Each cone as this many short ducts of stepped bore.")]];
    int chamber [[fminus::range(0, 1)]] [[fminus::default(1)]] [[ui::label("Pipe")]]
        [[ui::choices("Straight pipe", "Expansion chamber")]];
};
