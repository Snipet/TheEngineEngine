// cylinder2.fm: one cylinder of a crankcase-scavenged two-stroke engine, as its gas and its crankcase's.
//
// The cycle is one turn of the crank (360 degrees, 0 at top dead centre). The piston itself is the valve: on its way
// down it uncovers the exhaust port (its top edge highest: it opens first, `exhaustDur` degrees about bottom dead
// centre) and then the transfer ports (`transferDur`), whose windows' areas are their widths times how far below their
// top edges the piston's crown has gone (windows with rounded top corners, tabulated by depth; a power valve's blade
// lowers the exhaust's top edge straight across). Under the piston the crankcase is a second volume, pumped by the piston's
// underside: as the piston rises it draws the fresh mixture (air with its fuel and oil, from the carburettor) in through
// a reed valve (sprung petals a pressure drop opens, each ringing at its own frequency), a rotary disc (open over a
// window of crank angle) or a piston port (the skirt uncovers the inlet about top dead centre);
// as it falls it compresses it (the crankcase's compression ratio, `crankcaseRatio`, its largest volume over its
// smallest), and once the transfers open the mixture flows up through them into the cylinder and pushes the burned
// gas out of the exhaust: the scavenging.
//
// Scavenging is a blend of its two limits: perfect displacement (the fresh charge pushes the burned gas out ahead of it
// and none of it leaves until the burned gas has) and perfect mixing (it mixes at once, and what leaves is the mixture),
// in proportion `mixing`; and a share of what the transfers deliver, `shortCircuit`, goes straight across to the exhaust
// port and out, first. What leaves through the exhaust is remembered with its fresh share (as the reference's cylinder
// remembers its burned share), so what a returning wave from the pipe pushes back in before the port closes is that
// mixture: the expansion chamber's "plugging" pulse recovering the charge that had run into the header. The charge
// trapped when the exhaust port closes, and its purity (the fresh share of it), set the burn: the reference's Wiebe
// curve after the spark, of the fuel in the trapped fresh charge, all of it if the purity is good and less and less as
// the burned share passes the reference's limit of dilution: an engine at light load, poorly scavenged, misfires, keeps its unburned charge,
// fires the next turn: four-stroking, from the model, not scripted.
//
// The gas's energy is the reference's filling-and-emptying bookkeeping (sim/ref/cylinder.fm): each flow carries its
// own gas's enthalpy at its own ratio of specific heats, the walls take heat (the reference's coefficient), and the
// pressure follows from the energy and the volume. The exhaust port's flow is solved with its pipe at once (the
// exhaust's Valve, sim/exhaust/duct.fm, the reference's own); the transfers and the inlet are compressible orifices between volumes, choked
// below the critical ratio. The torque on the crank is the cylinder's pressure less the crankcase's, on the piston.
//
// What it leaves out: the transfers' own duct (their gas's inertia), the scavenging's dependence on the ports' angles
// (it is the two fields), the fuel's evaporation and the oil, the crankcase's heat, the piston's rings' leakage.
#pragma once
#include "exhaust/duct.fm"
#include "core/kinematics.fm"
#include "spec/engine.fm"

module TwoStrokeCylinder
{
    SliderCrank sc;
    Valve vE;
    // geometry
    float xE;           // the piston's travel from top dead centre at which each port's top edge is uncovered (m); the
    float xT;           // exhaust's own (xE0) and as a power valve's blade lowers it (xE)
    float xE0;
    float xI;           // a piston port's: the travel above which the skirt uncovers the inlet
    float aTabE[65];    // each port's open area (m^2, the discharge coefficient in it) by how far below its top edge the
    float aTabT[65];    // crown is, 64 steps to bottom dead centre: rectangles with rounded top corners
    float dE;           // (the steps' depths, m)
    float dT;
    float aCutE;        // what the power valve's blade covers of the exhaust's window (m^2)
    float wE;           // each port's width (m)
    float wT;
    float cd;
    float vccMax;       // the crankcase's largest volume (piston at the top) and its smallest
    float vccMin;
    float hA0;          // the walls' heat coefficient's area part (W/K before the speed's factor)
    float lhv;          // J/kg of the fuel
    float tWall;        // the walls' temperature (K): a warm engine's 450 (the reference's)
    // state: the cylinder
    float p;
    float t;
    float m;
    float v;
    float fresh;        // the fresh charge in it (kg): air with its fuel
    float scRes;        // the short-circuited part of it, on its way across to the exhaust port
    float exOut;        // this exhaust event's gas out, and its fresh part
    float exFresh;
    float lastMass;     // the gas that left last, by the port (kg, at most `lastCap`), and its fresh share: what the
    float lastFresh;    // pipe pushes back first (the last out is the first back, as a column of gas in the header is)
    float lastCap;
    float freshSpark;   // the fresh charge when the spark lit it
    // state: the crankcase
    float pc;
    float tc;
    float mc;
    float vc;
    float mcBurned;     // the burned gas in it (what came back down the transfers)
    float reed;         // the reed's petal: its opening (0 shut on its seat, 1 on its stop) and its speed (1/s)
    float reedV;
    float inletOpen;    // the inlet's open share now (reed, disc or piston port), 0 to 1
    // the burn
    float burnAt;       // degrees since the spark (negative: not burning)
    float xPrev;
    float qTot;
    float cBurn;
    float ang;
    // the last exhaust port's closing: what it trapped
    float trapped;      // kg
    float trappedFresh;
    float purity;
    float delivered;    // the fresh charge the transfers delivered over the last cycle (kg), and so far this one
    float deliveredNow;
    int misfires;       // cycles whose charge mostly did not burn (counted)
    int cycles;
    // this sample
    float qE;           // the exhaust's volume flow into the header (m^3/s), and what the header is given for it
    float qEa;
    float mE;           // mass flows (kg/s): out of the exhaust, through the transfers (up), through the inlet (in)
    float mT;
    float mI;
    float tq;           // torque on the crank (N m)
    // what crossed the system's boundary since reset (kg): in through the inlet, out through the exhaust
    double massIn;
    double massOut;
    // and the energy (J): the enthalpy in through the inlet and out through the exhaust, the burn's heat, the walls'
    // heat, the work done on the piston (both faces)
    double eIn;
    double eOut;
    double eBurn;
    double eWall;
    double eWork;

    // psi(r) of a compressible orifice: the table's psi / sqrt(1 - r) times sqrt(1 - r), flat below the critical ratio
    float psi(float r, int ex)
    {
        const float rc = ex != 0 ? 0.5457f : 0.5300f;
        if (r <= rc)
            return ex != 0 ? 0.66726f * sqrtf(1.0f - rc) : 0.68304f * sqrtf(1.0f - rc);
        return vE.tOf(r, ex) * sqrtf(fmaxf(1.0f - r, 0.0f));
    }

    // Mass flow (kg/s) through an effective area from a volume at (pa, ta) to one at (pb, tb); negative: from b to a
    float orifice(float pa, float ta, float pb, float tb, float area, int ex)
    {
        if (area <= 1.0e-10f)
            return 0.0f;
        if (pa >= pb)
            return area * pa / sqrtf(287.0f * ta) * psi(pb / pa, ex);
        return -area * pb / sqrtf(287.0f * tb) * psi(pa / pb, ex);
    }

    // An orifice's mass flow between two volumes, stepped implicitly. The flow goes as the square root of the drop dp
    // (qExp: what the drop now drives through it), whose slope is unbounded at 0: stepped explicitly, two volumes on an
    // orifice overshoot each other by a step and chatter for ever (some grams a second through the transfers of an
    // engine at rest). So the flow is the one that leaves the drop after the step driving it: q^2 = C^2 (dp - K q dt),
    // C^2 = qExp^2 / dp, K the drop's fall per kilogram moved (the two volumes' gamma p / m, adiabatic): the whole
    // orifice flow for a large drop, and no more than evens the volumes for a small one.
    float implicitFlow(float qExp, float dp, float kDrop, float dt)
    {
        const float ad = fabsf(dp);
        if (ad < 1.0e-6f || fabsf(qExp) < 1.0e-12f)
            return 0.0f;
        const float c2 = qExp * qExp / ad;
        const float a = c2 * kDrop * dt;
        const float q = 0.5f * (sqrtf(a * a + 4.0f * c2 * ad) - a);
        return qExp >= 0.0f ? q : -q;
    }

    // The gas's internal energy now, cylinder and crankcase (J)
    float energy()
    {
        return p * v / (gammaAt(t) - 1.0f) + pc * vc / (gammaAt(tc) - 1.0f);
    }

    // The temperature at which m kg of the gas holds u J: u = m R t / (gamma(t) - 1) with gamma's line below, solved
    // for t in closed form (so the energy is kept exactly as gamma moves with the temperature; taking gamma at the old
    // temperature, as the reference does, let some 4 % of the burn's heat go unaccounted)
    float tOfEnergy(float u, float mass)
    {
        const float uu = fmaxf(u, 1.0e-9f);
        const float tk = uu * 0.4125f / (mass * 287.0f + uu * 7.5e-5f);
        if (tk < 166.67f)
            return uu * 0.4f / (mass * 287.0f);         // (gamma held at 1.40 below)
        if (tk > 2300.0f)
            return uu * 0.24f / (mass * 287.0f);        // (and at 1.24 above)
        return tk;
    }

    float gammaAt(float tk)
    {
        return fminf(fmaxf(1.39f - 7.5e-5f * (tk - 300.0f), 1.24f), 1.40f);
    }

    float cpAt(float tk)
    {
        const float g = gammaAt(tk);
        return 287.0f * g / (g - 1.0f);
    }

    // The exhaust port's duration at a speed (rad/s): its own, or, with a power valve, the valve's shorter one below
    // `valveFrom`, rising smoothly to the port's own at `valveTo`
    float exhaustDurAt(const EngineSpec* s, float omega)
    {
        if (s->tsValveDur <= 0.0f)
            return s->tsExhaustDur;
        const float k = fminf(fmaxf((omega - s->tsValveFrom) / fmaxf(s->tsValveTo - s->tsValveFrom, 1.0f), 0.0f), 1.0f);
        return s->tsValveDur + (s->tsExhaustDur - s->tsValveDur) * k * k * (3.0f - 2.0f * k);
    }

    // A window's area uncovered to a depth h (m) below its top edge: width w, its two top corners rounded to radius r
    // (what each corner's quarter circle leaves out of the rectangle, summed in thin strips: a table's worth, at setup)
    float windowArea(float h, float w, float r)
    {
        float a = w * h;
        if (r > 1.0e-6f)
        {
            const float hc = fminf(h, r);
            float cut = 0.0f;
            const int k = 16;
            for (int i = 0; i < k; ++i)
            {
                const float y = (((float)i + 0.5f) / (float)k) * hc;   // depth of the strip below the top edge
                const float u = r - y;
                cut += (r - sqrtf(fmaxf(r * r - u * u, 0.0f))) * (hc / (float)k);
            }
            a -= 2.0f * cut;
        }
        return a;
    }

    void windowTable(float* tab, float depth, float w, float r)
    {
        for (int i = 0; i <= 64; ++i)
            tab[i] = cd * windowArea(depth * (float)i / 64.0f, w, fminf(r, 0.5f * w));
    }

    // A table's area at depth h (m), steps of d
    float tableAt(const float* tab, float h, float d)
    {
        if (h <= 0.0f)
            return 0.0f;
        const float x = fminf(h / d, 64.0f);
        int i = (int)x;     // lint: index-ok: h > 0 returned above; fminf caps a NaN at 64
        if (i > 63)
            i = 63;
        return tab[i] + (tab[i + 1] - tab[i]) * (x - (float)i);
    }

    // The exhaust's top edge for a duration: a power valve's blade, straight across, lowers it from the port's own
    void exhaustEdge(float dur)
    {
        sc.atDeg(180.0f - 0.5f * dur);
        xE = fmaxf(sc.x, xE0);
        aCutE = tableAt(aTabE, xE - xE0, dE);
    }

    // The cylinder for the spec and its geometry (m; the geometric compression ratio)
    void setup(const EngineSpec* s, float boreIn, float strokeIn, float rodIn, float compressionIn)
    {
        sc.setup(boreIn, strokeIn, rodIn, compressionIn);
        sc.atDeg(180.0f - 0.5f * s->tsExhaustDur);
        xE0 = sc.x;
        sc.atDeg(180.0f - 0.5f * s->tsTransferDur);
        xT = sc.x;
        sc.atDeg(360.0f - 0.5f * s->tsPistonDur);
        xI = sc.x;
        wE = s->tsExhaustWidth * boreIn;
        wT = s->tsTransferWidth * boreIn;
        cd = s->tsPortCd;
        dE = fmaxf(2.0f * sc.r - xE0, 1.0e-4f) / 64.0f;
        dT = fmaxf(2.0f * sc.r - xT, 1.0e-4f) / 64.0f;
        windowTable(aTabE, 64.0f * dE, wE, s->tsExhaustRadius * wE);
        windowTable(aTabT, 64.0f * dT, wT, s->tsTransferRadius * wT);
        exhaustEdge(s->tsExhaustDur);
        vccMin = sc.vd / (s->tsCrankcaseRatio - 1.0f);
        vccMax = vccMin + sc.vd;
        hA0 = 260.0f * (2.0f * sc.area + 3.14159265f * boreIn * 0.5f * strokeIn);
        lhv = 43.0e6f;
        tWall = 450.0f;
        // (the column by the port that goes back first: the gas of a tenth of the swept volume at the air's density)
        lastCap = 0.1f * sc.vd * 1.18f;
    }

    // At rest, everything at the air outside, the cylinder full of fresh air
    void reset(float a, float pAir, float tAir)
    {
        ang = a;
        sc.atDeg(a);
        v = sc.vol;
        p = pAir;
        t = tAir;
        m = p * v / (287.0f * t);
        fresh = m;
        scRes = 0.0f;
        exOut = 0.0f;
        exFresh = 0.0f;
        lastMass = 0.0f;
        lastFresh = 0.0f;
        freshSpark = 0.0f;
        vc = vccMax - sc.area * sc.x;
        pc = pAir;
        tc = tAir;
        mc = pc * vc / (287.0f * tc);
        mcBurned = 0.0f;
        reed = 0.0f;
        reedV = 0.0f;
        inletOpen = 0.0f;
        burnAt = -1.0f;
        xPrev = 0.0f;
        qTot = 0.0f;
        cBurn = 1.0f;
        trapped = m;
        trappedFresh = m;
        purity = 1.0f;
        delivered = 0.0f;
        deliveredNow = 0.0f;
        misfires = 0;
        cycles = 0;
        qE = 0.0f;
        qEa = 0.0f;
        mE = 0.0f;
        mT = 0.0f;
        mI = 0.0f;
        tq = 0.0f;
        massIn = 0.0;
        massOut = 0.0;
        eIn = 0.0;
        eOut = 0.0;
        eBurn = 0.0;
        eWall = 0.0;
        eWork = 0.0;
    }

    bool passed(float before, float now, float ev)
    {
        if (now >= before)
            return before < ev && ev <= now;
        return before < ev || ev <= now;
    }

    // One sample. a: the crank's angle now (degrees from top dead centre, 0 to 360); dDeg: what it turned; dt: s; rpm;
    // the header's arriving wave (Pa over the air), impedance and gas temperature; the air's pressure and temperature
    // at the carburettor; the throttle (0 to 1); the exhaust's duration now (the power valve's); fire: 0 when the
    // ignition is cut (the spark does not come: the charge stays, unburned)
    void step(const EngineSpec* s, float a, float dDeg, float dt, float rpm, float bE, float zE, float tPipe,
              float pAir, float tAir, float throttle, float exDur, int fire)
    {
        const float before = ang;
        ang = a;
        // the events: the exhaust port's closing traps the charge; the spark lights it
        const float epc = 180.0f + 0.5f * exDur;
        const float sparkAt = 360.0f - s->tsSpark;
        if (passed(before, a, epc))
        {
            trapped = m;
            trappedFresh = fresh;
            purity = fresh / fmaxf(m, 1.0e-9f);
            scRes = 0.0f;
        }
        if (passed(before, a, 180.0f - 0.5f * exDur))
        {
            exOut = 0.0f;
            exFresh = 0.0f;
            lastMass = 0.0f;
            lastFresh = 0.0f;
        }
        if (passed(before, a, 180.0f - 0.5f * s->tsTransferDur))
        {
            delivered = deliveredNow;
            deliveredNow = 0.0f;
            cycles += 1;
        }
        if (passed(before, a, sparkAt))
        {
            // the burn's share: the reference's law of dilution (sim/ref/engine.fm, charge): the flame takes all of a
            // charge whose burned share is under some 0.45, half of one at 0.56, little past 0.65 (without the
            // reference's scatter from cycle to cycle: here the irregularity comes from the recursion alone)
            const float dil = 1.0f - fresh / fmaxf(m, 1.0e-9f);
            cBurn = fire != 0 ? 1.0f / (1.0f + expf((dil - 0.56f) / 0.035f)) : 0.0f;
            qTot = cBurn * fresh / (1.0f + s->tsAfr) * lhv * 0.9f;
            freshSpark = fresh;
            if (cBurn < 0.5f)
                misfires += 1;
            burnAt = qTot > 0.0f ? 0.0f : -1.0f;
            xPrev = 0.0f;
        }
        // the volumes
        sc.atDeg(a);
        const float vNew = sc.vol;
        const float dv = vNew - v;
        const float vcNew = vccMax - sc.area * sc.x;
        const float dvc = vcNew - vc;
        const float x = sc.x;
        // the ports' open areas (the exhaust's less what a power valve's blade covers)
        const float aE = x > xE ? tableAt(aTabE, x - xE0, dE) - aCutE : 0.0f;
        const float aT = tableAt(aTabT, x - xT, dT);
        // the inlet: the carburettor's throttle and the reed (or disc) in series
        const float aCarb = s->tsCarbArea * (0.03f + 0.97f * fminf(fmaxf(throttle, 0.0f), 1.0f));
        float aValve = 0.0f;
        if (s->tsInletKind == 0)
        {
            // the reed: a sprung petal the drop across it pushes off its seat (fully open at reedFull, held there by
            // its stop), with its own ring and damping; it lands on its seat and its stop without bouncing
            const float w0 = 6.2831853f * s->tsReedHz;
            const float drive = (pAir - pc) / s->tsReedFull;
            reedV += dt * (w0 * w0 * (drive - reed) - 2.0f * s->tsReedDamping * w0 * reedV);
            reed += dt * reedV;
            if (reed < 0.0f)
            {
                reed = 0.0f;
                reedV = fmaxf(reedV, 0.0f);
            }
            if (reed > 1.0f)
            {
                reed = 1.0f;
                reedV = fminf(reedV, 0.0f);
            }
            aValve = s->tsInletArea * reed;
        }
        else if (s->tsInletKind == 2)
        {
            // a piston port: the skirt uncovers the inlet as the piston rises past xI (a window a quarter of the
            // stroke tall, judgement)
            aValve = s->tsInletArea * fminf(fmaxf((xI - x) / (0.25f * 2.0f * sc.r), 0.0f), 1.0f);
        }
        else
        {
            float u = a - s->tsDiscOpen;
            if (u < 0.0f)
                u += 360.0f;
            if (u < s->tsDiscDur)
            {
                const float f = u / s->tsDiscDur;
                aValve = s->tsInletArea * fminf(fminf(f, 1.0f - f) * 6.0f, 1.0f);
            }
        }
        inletOpen = aValve / s->tsInletArea;
        const float aIn = aValve > 1.0e-10f ? 0.85f / sqrtf(1.0f / (aCarb * aCarb) + 1.0f / (aValve * aValve)) : 0.0f;
        // the flows
        qE = aE > 0.0f ? vE.flow(p, t, bE, zE, aE, tPipe, 1) : 0.0f;
        qEa = aE > 0.0f ? qE * vE.g : 0.0f;
        const float ppE = fmaxf(101325.0f + 2.0f * bE + zE * qEa, 8000.0f);
        mE = qE >= 0.0f ? qE * ppE / (287.0f * t) : qE * ppE / (287.0f * tPipe);
        const float kCyl = gammaAt(t) * p / m;
        const float kCc = gammaAt(tc) * pc / mc;
        mT = implicitFlow(orifice(pc, tc, p, t, aT, 0), pc - p, kCc + kCyl, dt);
        mI = implicitFlow(orifice(pAir, tAir, pc, tc, aIn, 0), pAir - pc, kCc, dt);
        if (s->tsInletKind == 0)
            mI = fmaxf(mI, 0.0f);          // (a reed shuts against a flow back)
        // the mixture's composition
        const float fcc = 1.0f - fminf(mcBurned / fmaxf(mc, 1.0e-9f), 1.0f);     // the crankcase's fresh share
        const float dmT = mT * dt;
        const float dmE = mE * dt;
        float dFresh = 0.0f;
        float dBurnedCc = 0.0f;
        if (dmT >= 0.0f)
        {
            const float fin = dmT * fcc;
            dFresh += fin;
            scRes += s->tsShortCircuit * fin;
            deliveredNow += fin;
            dBurnedCc -= dmT * (1.0f - fcc);
        }
        else
        {
            // back down the transfers: the cylinder's gas, its own fresh share
            const float fcy = fresh / fmaxf(m, 1.0e-9f);
            dFresh += dmT * fcy;
            dBurnedCc -= dmT * (1.0f - fcy);
        }
        if (dmE >= 0.0f)
        {
            // out of the exhaust: the short-circuited charge first, then the blend of displacement and mixing
            float rest = dmE;
            const float sOut = fminf(scRes, rest);
            scRes -= sOut;
            rest -= sOut;
            const float bulk = fmaxf(m - scRes, 1.0e-9f);
            const float burned = fmaxf(m - fresh, 0.0f);
            const float fMix = (fresh - scRes) / bulk;
            float fOut = s->tsMixing * fMix;
            // (displacement sends the burned gas first; once there is none, what leaves is fresh)
            if (rest * (1.0f - fOut) > burned)
                fOut = 1.0f - burned / fmaxf(rest, 1.0e-12f);
            const float outFresh = sOut + rest * fminf(fmaxf(fOut, 0.0f), 1.0f);
            dFresh -= outFresh;
            exOut += dmE;
            exFresh += outFresh;
            // the column by the port: this sample's gas on top
            const float f = dmE > 1.0e-15f ? outFresh / dmE : 0.0f;
            const float mNew = lastMass + dmE;
            lastFresh = (lastFresh * lastMass + f * dmE) / fmaxf(mNew, 1.0e-15f);
            lastMass = fminf(mNew, lastCap);
        }
        else
        {
            // back in from the header: the column by the port first, then what went out this event on average
            const float back = -dmE;
            const float fromLast = fminf(back, lastMass);
            const float ff = exOut > 1.0e-12f ? fminf(exFresh / exOut, 1.0f) : 0.0f;
            dFresh += fromLast * lastFresh + (back - fromLast) * ff;
            lastMass -= fromLast;
        }
        // the inlet brings fresh mixture into the crankcase (or, a disc's, takes the crankcase's out)
        if (mI < 0.0f)
            dBurnedCc += mI * dt * (1.0f - fcc);
        // the burn
        float dq = 0.0f;
        if (burnAt >= 0.0f)
        {
            burnAt += dDeg;
            const float f = burnAt / s->tsBurnDur;
            const float xb = 1.0f - expf(-5.0f * f * f * f);
            dq = qTot * (xb - xPrev);
            // what burns is no longer fresh
            dFresh -= (xb - xPrev) * cBurn * freshSpark;
            xPrev = xb;
            if (f > 1.6f)
            {
                burnAt = -1.0f;
                qTot = 0.0f;
            }
        }
        // the energy: the cylinder
        const float hA = hA0 * (0.6f + rpm / 2500.0f);
        const float dWall = hA * (t - tWall) * dt;
        eBurn += (double)dq;
        eWall += (double)dWall;
        dq -= dWall;
        float hNet = 0.0f;                       // enthalpy into the cylinder this sample (J)
        hNet += dmT >= 0.0f ? cpAt(tc) * tc * dmT : cpAt(t) * t * dmT;
        const float hE = dmE >= 0.0f ? cpAt(t) * t * dmE : cpAt(tPipe) * tPipe * dmE;
        hNet -= hE;
        eOut += (double)hE;
        eWork += (double)(p * dv);
        const float u = p * v / (gammaAt(t) - 1.0f) + dq - p * dv + hNet;
        m = fmaxf(m + dmT - dmE, 1.0e-8f);
        fresh = fminf(fmaxf(fresh + dFresh, 0.0f), m);
        scRes = fminf(fmaxf(scRes, 0.0f), fresh);
        v = vNew;
        t = fminf(fmaxf(tOfEnergy(u, m), 250.0f), 3200.0f);
        p = m * 287.0f * t / v;
        // the energy: the crankcase (adiabatic)
        const float dmI = mI * dt;
        float hc = 0.0f;
        hc += dmI >= 0.0f ? cpAt(tAir) * tAir * dmI : cpAt(tc) * tc * dmI;
        hc -= dmT >= 0.0f ? cpAt(tc) * tc * dmT : cpAt(t) * t * dmT;
        const float uc = pc * vc / (gammaAt(tc) - 1.0f) - pc * dvc + hc;
        eIn += (double)(dmI >= 0.0f ? cpAt(tAir) * tAir * dmI : cpAt(tc) * tc * dmI);
        eWork += (double)(pc * dvc);
        mc = fmaxf(mc + dmI - dmT, 1.0e-8f);
        mcBurned = fminf(fmaxf(mcBurned + dBurnedCc, 0.0f), mc);
        vc = vcNew;
        tc = fminf(fmaxf(tOfEnergy(uc, mc), 220.0f), 1500.0f);
        pc = mc * 287.0f * tc / vc;
        massIn += (double)dmI;
        massOut += (double)dmE;
        tq = (p - pc) * sc.dvol;
    }
};
