// sounds.fm: what an engine sounds like besides its exhaust: the intake, the valvetrain and injectors, the block, the
// turbos and their blow-off valve or a supercharger, the starter. Each is driven by what the engine model does (flows,
// pressures, events), not by a clock of its own, so it follows the engine wherever it goes.
#pragma once
#include "biquad.fm"
#include "onepole.fm"

module Extras
{
    float rate;
    int rs;
    float nScale;       // white noise's strength for the same loudness at any sample rate
    // the intake: the air box's resonance between the throttle and the snorkel; the throttle's hiss
    Biquad box;
    Biquad hiss;
    float qBoxPrev;
    // the valvetrain and the injectors: clicks ringing in the head, the cam cover and the injector bodies
    Biquad vres[3];
    Biquad ires[2];
    float vKick;
    float iKick;
    // the block: the combustion's sharpness rings its walls
    Biquad bres[2];
    // the pistons' slap at each top dead centre, near 1.5 kHz in the block (Lyon et al.); a direct-injection engine's
    // high-pressure pump, ticking three strokes a turn of its cam
    Biquad sres;
    float sKick;
    // knock: the end gas lighting on its own rings the cylinder's gas at its first circumferential modes (some 6 and
    // 10 kHz in a car's bore): the ping
    Biquad kres[2];
    float kKick;
    // a diesel's clatter: its premixed burn's sudden pressure rise strikes the head and the block, ringing their panels'
    // modes (some 0.9 to 4.8 kHz in a car's, lower in a truck's), each a little differently each time, with a rattle
    Biquad cres[6];
    float cKick;
    float cKw[6];
    Biquad cnoise;
    float cEnv;
    float cDecay;
    int cOn;
    Biquad pres;
    float pumpPh;
    float pumpOn;       // the pump's tick (0: none), set with the layout
    // the timing chain's whine
    float chainPh;
    // the forced induction: one turbo, two or four (each whistling a little apart), or a supercharger
    int kind;           // 0 none, 1 a turbo, 2 twin turbos, 3 quad turbos, 4 a supercharger
    float tbSize;       // how much boost it is set for, 0 to 1
    float spool;        // shaft speed, 0 to 1 (a supercharger's rotors: with the crank)
    float boost;        // bar above the air outside
    float maxB;         // the most it makes
    float bov;          // the blow-off valve's breath, 0 to 1
    float flutter;      // the compressor surging against a shut throttle (no blow-off valve)
    float flPh;
    float whPh[4];
    float scRatio;      // a supercharger's drive: its rotors' turns a turn of the crank (its pulley's)
    float tsK;          // the turbos' size over the match: their whistle's pitch and their rush's band go with it
    float scW[6];       // its whine's harmonics: how strong each comes out (every 16 samples)
    Biquad tnoise;
    Biquad bovf;
    float lastThrottle;
    float thrSlow;      // the throttle a tenth of a second behind
    // the starter
    float stPh;
    Biquad stres;
    // what came out this sample
    float intake;
    float mech;
    float block;
    float comb;         // the combustion's own noise: the knock, a diesel's clatter
    float turbo;
    float starter;

    float rnd()
    {
        const int hi = rs / 127773;
        const int lo = rs % 127773;
        rs = 16807 * lo - 2836 * hi;
        if (rs <= 0)
            rs += 2147483647;
        return 2.0f * ((float)rs / 2147483647.0f) - 1.0f;
    }

    void setup(float rateIn, float boxHz)
    {
        rate = rateIn;
        rs = 424242;
        nScale = sqrtf(rate / 48000.0f);
        box.setLowpass(boxHz, 2.2f, rate);
        hiss.setBandpass(2600.0f, 0.7f, rate);
        vres[0].setBandpass(2300.0f, 14.0f, rate);
        vres[1].setBandpass(3900.0f, 18.0f, rate);
        vres[2].setBandpass(6400.0f, 22.0f, rate);
        ires[0].setBandpass(7200.0f, 25.0f, rate);
        ires[1].setBandpass(10500.0f, 30.0f, rate);
        bres[0].setBandpass(1100.0f, 6.0f, rate);
        bres[1].setBandpass(2600.0f, 8.0f, rate);
        sres.setBandpass(1500.0f, 5.0f, rate);
        kres[0].setBandpass(6200.0f, 30.0f, rate);
        kres[1].setBandpass(9600.0f, 25.0f, rate);
        pres.setBandpass(3400.0f, 16.0f, rate);
        sKick = 0.0f;
        pumpPh = 0.0f;
        tnoise.setBandpass(5000.0f, 2.5f, rate);
        bovf.setBandpass(3200.0f, 0.9f, rate);
        stres.setBandpass(420.0f, 3.0f, rate);
        qBoxPrev = 0.0f;
        spool = 0.0f;
        boost = 0.0f;
        bov = 0.0f;
        flutter = 0.0f;
    }

    void clear()
    {
        box.clear();
        hiss.clear();
        for (int i = 0; i < 3; ++i)
            vres[i].clear();
        ires[0].clear();
        ires[1].clear();
        bres[0].clear();
        bres[1].clear();
        sres.clear();
        kres[0].clear();
        kres[1].clear();
        for (int j = 0; j < 6; ++j)
            cres[j].clear();
        cnoise.clear();
        cKick = 0.0f;
        cEnv = 0.0f;
        pres.clear();
        tnoise.clear();
        bovf.clear();
        stres.clear();
        spool = 0.0f;
        boost = 0.0f;
        bov = 0.0f;
        flutter = 0.0f;
    }

    // A valve came down on its seat (amp 0 to 1), an injector opened
    void valveClick(float amp)
    {
        vKick += amp * (0.7f + 0.3f * rnd());
    }

    void injectorClick(float amp)
    {
        iKick += amp;
    }

    // The end gas knocked (amp: how hard)
    void knockClick(float amp)
    {
        kKick += amp;
    }

    // The engine: a diesel's or not, and its cylinders' size (m^3): its clatter's modes, lower in a bigger engine
    void setClatter(int diesel, float swept)
    {
        cOn = diesel;
        const float fs = expf(0.16666667f * logf(0.0005f / fmaxf(swept, 3.0e-5f)));
        const float cf[6] = {900.0f, 1350.0f, 1900.0f, 2600.0f, 3500.0f, 4800.0f};
        const float cq[6] = {8.0f, 9.0f, 10.0f, 10.0f, 12.0f, 12.0f};
        for (int j = 0; j < 6; ++j)
            cres[j].setBandpass(cf[j] * fs, cq[j], rate);
        cnoise.setBandpass(2400.0f * fs, 0.9f, rate);
        cDecay = expf(-1.0f / (0.0016f * rate));
    }

    // A diesel's premixed burn began (amp: how sharply its pressure rises)
    void clatterClick(float amp)
    {
        cKick += amp;
        for (int j = 0; j < 6; ++j)
            cKw[j] = 0.55f + 0.45f * fabsf(rnd());
    }

    // A piston slapped its bore (amp: how hard)
    void slapClick(float amp)
    {
        sKick += amp;
    }

    // Every 16 samples: the forced induction (kindIn: 0 none, 1 a turbo, 2 twin turbos, 3 quad turbos, 4 a
    // supercharger; size 0 to 1: how much boost). A turbo's shaft spins up on the exhaust's energy, with lag (two
    // smaller ones sooner, four sooner still: sequential pairs), the wastegate holds the boost, the blow-off valve
    // opens when the throttle shuts on boost (falling some 0.15 under where it was a tenth of a second before). A
    // supercharger's rotors turn with the crank (rpmFrac: the revs over the redline): a twin-screw's boost comes with
    // the revs at once, most of it by a third of the redline, and its bypass valve lets it go as the load (the
    // throttle; a diesel's fuel) falls. Its pulley turns the rotors 2 to 2.8 times the crank with the boost it is
    // set for (a smaller pulley: more boost, a higher whine); two rotors of three lobes let six pockets of air through
    // a turn of the rotors, each meeting the boost as it opens to the outlet: a pulse, sharper with more boost (its
    // harmonics fall off less), its harmonics ringing the case and the outlet near 2.6 kHz on their way out (the
    // whine's colour changes as it rises through there).
    void turbo16(int kindIn, float size, float exhaustPower, float throttle, float load, float bovLevel, float rpmFrac,
                 float crankHz, float tsz, float d16)
    {
        kind = kindIn;
        tbSize = size;
        tsK = tsz;
        if (kind == 0 || size <= 0.001f)
        {
            spool = 0.0f;
            boost = 0.0f;
            bov = 0.0f;
            flutter = 0.0f;
            lastThrottle = throttle;
            return;
        }
        if (kind == 4)
        {
            spool += (fminf(fmaxf(rpmFrac, 0.0f), 1.25f) - spool) * (1.0f - expf(-d16 / 0.03f));
            maxB = 0.25f + 0.75f * size;
            const float sp = fminf(spool / 0.35f, 1.0f);
            const float bs = maxB * expf(0.6f * logf(fmaxf(sp, 1.0e-4f))) * (0.1f + 0.9f * load * load);
            bov = 0.0f;
            flutter = 0.0f;
            lastThrottle = throttle;
            boost += (bs - boost) * (1.0f - expf(-d16 / 0.05f));
            scRatio = 2.0f + 0.8f * size;
            const float f0 = 6.0f * scRatio * fmaxf(crankHz, 1.0f);
            const float slope = 1.5f - 0.7f * fminf(boost / fmaxf(maxB, 0.05f), 1.0f);
            for (int k = 0; k < 6; ++k)
            {
                const float fk = (float)(k + 1) * f0;
                const float x = fk / 2600.0f - 2600.0f / fk;
                const float res = 1.0f / sqrtf(1.0f + 6.0f * x * x);
                const float top = fminf(fmaxf((18000.0f - fk) / 4000.0f, 0.0f), 1.0f);  // (faded out by 18 kHz)
                scW[k] = top * expf(-slope * logf((float)(k + 1))) * (0.5f + 0.5f * res);
            }
            return;
        }
        const float kz = kind == 1 ? 1.0f : (kind == 2 ? 0.72f : 0.55f);
        // (its size, tsz, over the match: a small one spins nearer its top on the same exhaust, as the size's -0.6th
        // power, its lag as the 1.3th; past its flow it lets the boost go: near the redline for one half the size)
        const float lts = logf(tsz);
        const float target = fminf(sqrtf(fmaxf(exhaustPower, 0.0f)) * (1.25f - 0.45f * size) * expf(-0.6f * lts), 1.0f);
        const float tauUp = (0.35f + 1.5f * size) * kz * expf(1.3f * lts);
        const float tau = target > spool ? tauUp : 1.2f;
        spool += (target - spool) * (1.0f - expf(-d16 / tau));
        const float maxBoost = 0.35f + 1.05f * size;
        maxB = maxBoost;
        float b = maxBoost * spool * spool * 1.6f;
        if (b > maxBoost)
            b = maxBoost;                                   // the wastegate opens
        b = fminf(b, maxBoost * fminf(1.3f * expf(1.5f * lts) / fmaxf(rpmFrac, 0.01f), 1.0f));   // (a small one chokes)
        // the throttle shut on boost: the blow-off valve (or, without one, the compressor surges)
        thrSlow += (throttle - thrSlow) * (1.0f - expf(-d16 / 0.1f));
        if (throttle < thrSlow - 0.15f && boost > 0.25f)
        {
            if (bovLevel > 0.15f)
                bov = fmaxf(bov, fminf(boost / maxBoost, 1.0f));
            else
                flutter = fmaxf(flutter, fminf(boost / maxBoost, 1.0f));
        }
        lastThrottle = throttle;
        bov *= expf(-d16 / 0.28f);
        flutter *= expf(-d16 / 0.45f);
        if (bov > 0.05f || flutter > 0.05f)
        {
            b *= 0.5f;                                      // the boost vents
            spool *= expf(-d16 / 0.9f);
        }
        boost += (b - boost) * (1.0f - expf(-d16 / 0.08f));
    }

    // One sample of all of it. qThrottle: the volume flow through the throttle (m^3/s); dropRatio: how much of the
    // pressure the throttle drops (0 wide open, near 1 shut at speed); crankHz: the crank's turns a second; dpdt: the
    // cylinders' pressure rise this sample (Pa); starterOn: 1 while it cranks; level dials.
    void tick(float qThrottle, float dropRatio, float crankHz, float dpdt, float starterOn, float bovLevel, float massFlow)
    {
        // the intake: the air box rings between the throttle and the snorkel; what the snorkel lets out is its sound
        const float qb = box.tick(qThrottle);
        intake = (qb - qBoxPrev) * rate * 0.02f;
        qBoxPrev = qb;
        intake += 0.9f * qThrottle * dropRatio * dropRatio * hiss.tick(nScale * rnd());
        // the valvetrain and the injectors
        float v = 0.0f;
        if (vKick != 0.0f)
        {
            v = vKick;
            vKick = 0.0f;
        }
        float ij = 0.0f;
        if (iKick != 0.0f)
        {
            ij = iKick;
            iKick = 0.0f;
        }
        mech = vres[0].tick(v) + 0.8f * vres[1].tick(v) + 0.5f * vres[2].tick(v) + 0.6f * (ires[0].tick(ij) + 0.7f * ires[1].tick(ij));
        // the timing chain: a faint whine at the sprocket's teeth (21 a turn of the crank)
        chainPh += 21.0f * crankHz / rate;
        if (chainPh >= 1.0f)
            chainPh -= floorf(chainPh);
        const float cr = fminf(crankHz / 100.0f, 1.0f);
        mech += 0.004f * cr * cr * sinf(6.28318531f * chainPh);
        // the block: the burn's pressure rise knocks on its walls
        const float k = dpdt * 2.0e-6f;
        block = bres[0].tick(k) + 0.6f * bres[1].tick(k);
        float sk = 0.0f;
        if (sKick != 0.0f)
        {
            sk = sKick;
            sKick = 0.0f;
        }
        block += 0.38f * sres.tick(sk);
        float kk = 0.0f;
        if (kKick != 0.0f)
        {
            kk = kKick;
            kKick = 0.0f;
        }
        // (the ping, some 15 dB over the block's own ring: heard over the bonnet, faintly behind the car)
        comb = 9.0f * (kres[0].tick(kk) + 0.5f * kres[1].tick(kk));
        if (cOn != 0)
        {
            float ck = 0.0f;
            if (cKick != 0.0f)
            {
                ck = cKick;
                cKick = 0.0f;
                cEnv = fmaxf(cEnv, ck);
            }
            float cs = 0.0f;
            for (int j = 0; j < 6; ++j)
                cs += cres[j].tick(ck * cKw[j]);
            cEnv *= cDecay;
            comb += 2.5f * (cs + 0.004f * cEnv * cnoise.tick(nScale * rnd()));
        }
        // the pump: 1.5 strokes a turn of the crank, a click at each
        pumpPh += 1.5f * crankHz / rate;
        float pk = 0.0f;
        if (pumpPh >= 1.0f)
        {
            pumpPh -= floorf(pumpPh);
            pk = pumpOn;
        }
        mech += 0.6f * pres.tick(pk);
        // the turbos: each one's whistle at its compressor's blades (smaller ones higher, each a little apart from the
        // others), the rush of air, the blow-off valve, the surge
        turbo = 0.0f;
        if (kind == 4 && tbSize > 0.001f)
        {
            // a supercharger: its rotors whine at their pockets' passing (six a turn of the rotors: turbo16 sets
            // their harmonics), louder with the speed and the boost (off the boost, its bypass open, the rotors still
            // turn: some 30 % of it), a little uneven over a turn of the rotors (their lobes are not quite alike); the
            // air rushing through them
            whPh[0] += 6.0f * scRatio * crankHz / rate;
            if (whPh[0] >= 1.0f)
                whPh[0] -= floorf(whPh[0]);
            whPh[1] += scRatio * crankHz / rate;
            if (whPh[1] >= 1.0f)
                whPh[1] -= floorf(whPh[1]);
            const float sp = fminf(crankHz / 100.0f, 1.0f);
            const float ld = fminf(boost / fmaxf(maxB, 0.05f), 1.0f);
            const float ph = 6.28318531f * whPh[0];
            // (the harmonics' sines by the recurrence sin (k + 1) x = 2 cos x sin k x - sin (k - 1) x)
            const float c1 = cosf(ph);
            float s0 = 0.0f;
            float s1 = sinf(ph);
            float w = scW[0] * s1;
            for (int k = 1; k < 6; ++k)
            {
                const float s2 = 2.0f * c1 * s1 - s0;
                w += scW[k] * s2;
                s0 = s1;
                s1 = s2;
            }
            turbo = 0.15f * sp * (0.3f + 0.7f * ld) * (1.0f + 0.12f * sinf(6.28318531f * whPh[1])) * w;
            tnoise.setBandpass(1200.0f + 3000.0f * sp, 1.5f, rate);
            turbo += 0.09f * sp * ld * tnoise.tick(nScale * rnd());
        }
        else if (kind != 0 && tbSize > 0.001f)
        {
            const int nv = kind == 1 ? 1 : (kind == 2 ? 2 : 4);
            const float fw = (900.0f + 7200.0f * spool) * (kind == 1 ? 1.0f : (kind == 2 ? 1.2f : 1.4f)) * expf(-0.8f * logf(tsK));
            const float det[4] = {1.0f, 1.012f, 0.991f, 1.021f};
            float ws = 0.0f;
            for (int j = 0; j < nv; ++j)
            {
                whPh[j] += fw * det[j] / rate;
                if (whPh[j] >= 1.0f)
                    whPh[j] -= floorf(whPh[j]);
                ws += sinf(6.28318531f * whPh[j]) + 0.25f * sinf(12.5663706f * whPh[j]);
            }
            const float s2 = spool * spool;
            turbo = 0.09f * s2 * ws / sqrtf((float)nv);
            tnoise.setBandpass((1500.0f + 5500.0f * spool) * expf(-0.5f * logf(tsK)), 2.5f, rate);
            turbo += 0.15f * s2 * fminf(massFlow * 8.0f, 1.0f) * tnoise.tick(nScale * rnd());
            if (bov > 0.001f)
                turbo += 0.35f * bovLevel * bov * bov * bovf.tick(nScale * rnd());
            if (flutter > 0.001f)
            {
                flPh += (16.0f + 6.0f * flutter) / rate;
                if (flPh >= 1.0f)
                    flPh -= 1.0f;
                const float pulse = fmaxf(sinf(6.28318531f * flPh), 0.0f);
                turbo += 0.25f * flutter * pulse * pulse * pulse * bovf.tick(nScale * rnd());
            }
        }
        // the starter: its motor's buzz and its pinion's teeth on the ring gear
        starter = 0.0f;
        if (starterOn > 0.0f)
        {
            const float fa = fmaxf(crankHz, 1.0f) * 11.0f;            // the armature, through the reduction
            stPh += fa / rate;
            if (stPh >= 1.0f)
                stPh -= floorf(stPh);
            const float saw = 2.0f * stPh - 1.0f;
            starter = 0.05f * (saw - saw * saw * saw) + 0.02f * stres.tick(nScale * rnd()) + 0.03f * sinf(6.28318531f * 9.0f * stPh);
        }
    }
};
