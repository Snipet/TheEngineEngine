// engine.fm: the engine, as one thing every key plays (module Shared).
//
// The crank turns at the speed its torque, friction, load and inertia give it. Each cylinder (cylinder.fm) breathes
// through its intake runner from a plenum that the throttle fills from the air box, burns what it trapped, and blows
// down through its exhaust valve into its header (pipes.fm). The headers meet in a collector (a bank's, or one for
// all), the collector goes into the pipe, the pipe into the muffler's two chambers and out of the tailpipe into the air:
// what comes out of the tail is the exhaust's sound (the rate the flow changes there). A driver works the throttle to
// take the engine to the speed the key asks for; an idle valve holds it at idle; the ECU cuts the fuel at the redline and
// when the throttle shuts at speed (where, with the pops dial, it lets some fuel through to bang in the hot pipes).
// Driven as a car or a semi truck (DRIVE CAR, TRUCK), the pedals work the throttle and the clutch, and the crank turns
// the vehicle (car.fm) through the clutch and the gearbox instead of against the load dial.
#pragma once
#include "pipes.fm"
#include "cylinder.fm"
#include "layouts.fm"
#include "lib/noise.fm"
#include "heat.fm"
#include "ecu/ecu.fm"
#include "exhaust/pop.fm"
#include "combustion/combustion.fm"
#include "lib/onepole.fm"
#include "lib/biquad.fm"
#include "sound/extras.fm"
#include "boost/boost.fm"
#include "listen/listen.fm"
#include "vehicle/car.fm"

module Set
{
    int layout;
    float size;
    float idle;
    float redline;
    float cam;
    float inertia;
    float load;
    float headers;
    float muffler;
    float pipe;
    float xpipe;
    float pops;
    float rough;
    float turbo;        // how much boost the forced induction makes, 0 to 1 (BOOST)
    float tsize;        // the turbos' size over ones matched to the engine (TURBO SIZE: 0.5 to 2; 1)
    int asp;            // the aspiration: 0 natural, 1 a turbo, 2 twin turbos, 3 quad turbos, 4 a supercharger
    int fuel;           // 0 gasoline, 1 diesel
    float comp;         // the compression ratio
    float bs;           // the bore over the stroke (BORE/STROKE: 0.5 to 2; 1 square)
    float ambF;         // the air outside, degrees F (AMBIENT: -40 to 120; 80.33 is 300 K)
    float timing;       // the spark's (a diesel's injection's) advance over its map, degrees (TIMING: -20 to 20)
    float bov;
    float intake;
    float mech;
    int view;
    float distance;
    float room;
    float level;
    int keys;           // 1: the keys play the firing's pitch (DRIVE PITCH)
    float bendRange;    // the pitch wheel's reach, semitones (12)
    int starter;
    float hold;
    float bend;
    float modwheel;
    float pressure;
    int drive;          // 0 the keys (DRIVE KEYS or PITCH: keys says which), 1 CAR, 2 TRUCK
    float mass;
    float gas;          // the wheel's pedals (0 up to 1 down), its shifter (-1 R, 0 N, 1 to 7) and its buttons
    float brake;
    float clutch;
    int lever;
    int buttons;
};

module Shared
{
    Set set;
    Layout lay;
    Cylinder cyl[12];
    Duct prim[12];      // the headers (a rotary's: one a rotor)
    Duct run[12];       // the intake runners
    Duct sec[2];        // from each bank's collector
    Duct pipe[2];       // the main pipe (two, when dual)
    Duct ch1[2];        // the muffler: a chamber, a tube, a chamber
    Duct mid[2];
    Duct ch2[2];
    Duct tail[2];
    Duct cross;         // between the two pipes (an H-pipe), when dual
    Pop pop[2];
    float rate;         // the engine's own: 96 kHz whatever the host's (render resamples)
    float dt;
    int ready;
    Noise noise;        // the engine's white noise: the cylinders' spread, the burns' scatter, the flows' and jets' noise
    // what the layout and the dials made
    int lastLayout;
    float lastSize;
    float lastCam;
    // the dials that shape the pipes and the cams, smoothed (80 ms): a pipe's length or bore, the muffler's chambers or
    // the cams' timing that jumped would jolt the flow the system holds, a loud click
    float smMuf;
    float smHdr;
    float smPipe;
    float smXp;
    float smCam;
    float kDial;
    float smCR;         // the compression ratio, smoothed, and as the cylinders were last set
    float lastCR;
    float smBs;         // the bore over the stroke, smoothed, and as the bore was last set
    float lastBs;
    float strokeK;      // the stroke over a square engine's of this size: the pistons' speed at the same revs
    float burnK;        // the burn's degrees over a square engine's (the flame's path across the bore)
    float crBs;         // the compression the end gas takes before it knocks, moved with the flame's path
    int fuelUse;        // the fuel and the aspiration heard (a change waits for the fade, as a new layout's does)
    int aspUse;
    // what the sound cannot follow smoothly (another layout or size, another view) changes under a quick fade: 6 ms
    // down, the change, 12 ms back up (80 for a new engine; the room rings on through it); the size waits for its
    // dial to rest 0.15 s
    float cutG;
    float cutDn;
    float cutUp;
    int cutWant;        // 1: configure, 2: the view
    float sizeSeen;
    float sizeRest;
    int vUse;           // the view heard
    int nDuals;         // pipes after the collectors: 1 or 2
    int portBank[12];   // each port's bank
    float vTotal;       // displacement, m^3
    float bore;
    float boreSq;       // a square cylinder's bore for this size (bore: the BORE/STROKE dial's)
    float aThrottle;    // the ecu.throttle's area wide open, m^2
    float aBypass;      // the idle valve's
    float vPlenum;
    float jBase;
    float idleBase;     // the idle and the redline before the dials: the layout's (a diesel's: by its pistons' speed)
    float redBase;
    float idleTq;
    // the engine's ecu.state
    float omega;        // rad/s
    float theta;        // crank degrees, 0 to 2160 (a common cycle for four-strokes and the rotary)
    float rpm;
    float pPlenum;      // Pa absolute
    float mPlenum;
    float tAir;
    float tPort;        // the exhaust gas's temperature at the ports (smoothed), K
    float eSum;
    float mSum;
    int tick16;
    // the keys
    // what comes out
    float radPrev[2];
    Biquad endR[2];     // each tail's open end: the wave it sends back (Silva et al.'s reflection, for its hot gas)
    Biquad endRun[12];  // each intake runner's end in the plenum: the same, in the air of the plenum
    float outL;
    float outR;
    float gainNorm;
    float exTrim;       // the exhaust's level for the layout, besides the whole's
    float noiseTrim;    // the flow's and the jet's noise against it (see configure)
    OnePole vnHp;       // the valves' jet noise: white noise, its lows taken out
    OnePole tnHp[2];    // the tail's jet: noise in a band
    OnePole tnLp[2];
    Ecu ecu;            // the engine's state, the driver, the idle, the limiter, the cuts (ecu/ecu.fm)
    Combustion comb;    // the charge at intake closing: fuel, spark, burn, knock (combustion/combustion.fm)
    Heat heat;          // the coolant, the oil, the chamber's walls (core/heat.fm)
    Extras ex;
    Boost boost;        // turbos or a supercharger: their shafts, boost, valves and sounds (boost/boost.fm)
    Listen listen;      // where it is heard from, the room, the level, the resampler (listen/listen.fm)
    float pBox;         // the air box (with the turbo's boost), Pa
    float qThr;         // the volume flow through the ecu.throttle, m^3/s
    float mdot;         // the exhaust's mass flow, kg/s (smoothed)
    // flow noise made where the gas's jets break up inside the system: the headers' jets into each collector, the
    // collectors' gas into the converter's cone, the muffler's inlet and its outlet into the tail. Each is a pressure
    // across its junction (a dipole: the turbulence's force on the gas), flowK times the junction's loss coefficient
    // times 1/2 rho u^2 (so its power grows as the speed's fourth power, as in-duct flow noise does below the pipe's
    // cross modes), gated by each pulse's own speed, in a band about a Strouhal number of 0.4 on the jet's width. The
    // pipes then shape it like everything else.
    OnePole fnHp[8];
    OnePole fnLp[8];
    OnePole fnLp2[8];
    float fnN[8];       // each band's unit strength
    float fnG[8];       // this sample's noise in each band (0, 1: the collectors; 2, 3: the cones; 4, 5: the
                        // mufflers' inlets; 6, 7: their outlets)
    float flowK;
    float qHd[12];      // the last sample's flows: each header into its collector, each main pipe away from its cone,
    float qPp[2];       // each muffler's inlet and outlet
    float qM1[2];
    float qM4[2];
    float kInM;         // the loss coefficients the noise goes by: the muffler's inlet, its outlet
    float kOutM;
    // the exhaust's heat: the gas's temperature (K) in each part of the system (the headers, the collectors' pipes, the
    // main pipe, the muffler, the tail), each part's wall, and what the pipes are set to (the gas's, a third of a second
    // behind)
    float tGas[5];
    float tWall[5];
    float tUse[5];
    float mdotSlow;     // the exhaust's mass flow over half a second
    float kUse;
    float kMdot;
    float shell[2];     // the headers' walls ringing (the collectors' pressure), for the engine bay
    OnePole shellHp[2];
    float tqMean;
    float tqNow;
    float quiet;
    float jetK;
    float jetA;
    float qJet[2];      // the flow out of the tail, smoothed: the jet's speed
    float valveK;
    // the junctions' losses (pipes.fm, lossKap: K rho / 2A^2 for each direction) and the catalytic converter
    float kHin;         // a header's flow into its collector, and back out of it
    float kHout;
    float kSin;         // a collector's pipe into the merge, and back
    float kSout;
    float kXp;          // the H-pipe's ends
    float rCat;         // the converter at the main pipe's head: a resistance in series, Pa s / m^3
    float rPerf;        // the muffler's perforated tube or baffles, where the gas passes from chamber to tube and on
    float kMuf[8];      // the muffler's four changes of area (pipe to chamber, chamber to tube, tube to chamber, chamber
                        // to tail), each for flow onward and back
    float kExit[2];     // the tail's open end: the jet out (its momentum lost), the air drawn in
    float sHd[12];      // each junction's drive, its slow part (the losses act on it: quasi-steady): the headers' ends,
    float sMg[2];       // the collectors' pipes at the merge, the H-pipe's ends, the muffler's four changes of area each
    float sXp[2];       // side, the tails' ends
    float sMf[8];
    float sEx[2];
    float xiWall;       // the pipes' friction factor
    float k16Flow;      // the flow's loss's smoothing, every 16 samples
    // the car (DRIVE CAR)
    Car car;
    // what the panel shows (its displays read these whether a key sounds or not)
    float showRpm;      // the crank's speed, rpm
    float showRed;      // the redline, rpm
    float showGear;     // driven: -1 R, 0 N, 1 to 6; -2 played from the keys
    float showKmh;      // driven: the car's speed, km/h
    float showThr;      // the ecu.throttle plate, 0 to 1
    float showMap;      // the manifold against the air outside, bar: vacuum below 0, boost above
    float showLamps;    // the ecu.state (0 off, 1 cranking, 2 running, 3 running down) + 4 limiter + 8 fuel cut + 16 driven,
                        // + 32 times the coolant's temperature (F + 60) + 16384 times the oil's pressure (psi) + 2097152
                        // driven as a truck: the dash's
    float showPedals;   // driven: the brake (0 to 100) + 1000 times the clutch (0 to 100)
    float showCycle;    // a slowed copy of the crank's cycle, 0 to 1: the layout's drawing fires in its order by it
    float showBoost;    // the turbo's boost, bar
    float showAir;      // the forced induction, for the panel: its kind (1 to 4) plus the boost it is set for (0 none),
                        // and ten times BORE/STROKE's 1 to 100 (0.5 to 2; 0, before the sound starts: square)
    float showPipes;    // the HEADERS, PIPE and X-PIPE dials as heard, for the panel: each 0 to 99, packed (headers *
                        // 10000 + pipe * 100 + X-pipe)

    void init(float rateIn)
    {
        end();
        rate = 96000.0f;
        listen.setup(rate, rateIn);
        dt = 1.0f / rate;
        noise.rs = 123456789;
        // the longest each pipe could be, cold (330 m/s), at this rate
        const float k = rate / 300.0f;
        for (int i = 0; i < 12; ++i)
        {
            prim[i].configure((int)(3.0f * k) + 16);
            run[i].configure((int)(0.8f * k) + 16);
        }
        for (int i = 0; i < 2; ++i)
        {
            sec[i].configure((int)(1.0f * k) + 16);
            pipe[i].configure((int)(4.6f * k) + 16);
            ch1[i].configure((int)(0.9f * k) + 16);
            mid[i].configure((int)(0.5f * k) + 16);
            ch2[i].configure((int)(0.7f * k) + 16);
            tail[i].configure((int)(1.0f * k) + 16);
            pop[i].rs = 1000 + 7777 * i;
        }
        cross.configure((int)(0.6f * k) + 16);
        ex.setup(rate, 90.0f);
        boost.setup(rate, &ex.noise);
        for (int i = 0; i < 2; ++i)
            shellHp[i].set(500.0f, rate);
        quiet = 1.0e9f;
        gainNorm = 1.0f;
        cutG = 1.0f;
        cutDn = 1.0f / (0.006f * rate);
        cutUp = 1.0f / (0.012f * rate);
        cutWant = 0;
        vUse = 0;
        kDial = 1.0f - expf(-16.0f / (0.08f * rate));
        pBox = 101325.0f;
        vnHp.set(700.0f, rate);
        vnLp.set(20000.0f, rate);
        nScale = sqrtf(rate / 48000.0f);
        jetA = 1.0f - expf(-1.0f / (0.06f * rate));
        for (int i = 0; i < 2; ++i)
            jetBand(i, 300.0f);
        set.layout = 12;
        set.size = 5.76f;
        set.idle = 0.0f;
        set.redline = 0.0f;
        set.cam = 0.35f;
        set.inertia = 0.5f;
        set.load = 0.0f;
        set.headers = 0.5f;
        set.muffler = 0.5f;
        set.pipe = 0.5f;
        set.xpipe = 0.0f;
        set.pops = 0.3f;
        set.rough = 0.3f;
        set.turbo = 0.5f;
        set.tsize = 1.0f;
        set.asp = 0;
        set.fuel = 0;
        set.comp = 10.0f;
        set.bs = 1.0f;
        set.ambF = 80.33f;
        set.timing = 0.0f;
        comb.setup(rate, &noise, &ecu, &heat, &lay, &pop[0]);
        set.bov = 0.7f;
        set.intake = 0.5f;
        set.mech = 0.4f;
        set.view = 0;
        set.distance = 0.3f;
        set.room = 0.15f;
        set.level = 0.0f;
        set.keys = 0;
        set.bendRange = 12.0f;
        set.starter = 1;
        set.hold = 10.0f;
        heat.setup();
        lastLayout = -1;
        ecu.state = 0;
        omega = 0.0f;
        theta = 0.0f;
        ecu.keyCount = 0;
        ecu.tokenCounter = 0;
        ecu.rendering = 0;
        tick16 = 0;
        // (the free jet's own mixing noise is weak at a tailpipe's speeds: most of the roar is made inside, at the
        // junctions, and comes out shaped by the pipes; the two together as bright as the jet alone was)
        jetK = 0.005f;
        flowK = 0.017f;
        valveK = 0.15f;
        xiWall = 0.025f;
        k16Flow = 1.0f - expf(-16.0f / (0.06f * rate));
        kUse = 1.0f - expf(-16.0f / (0.3f * rate));
        kMdot = 1.0f - expf(-16.0f / (0.5f * rate));
        ecu.gK = 0.15f;
        ecu.gTau = 0.15f;
        ecu.gTrim = 2.5f;
        ecu.gI = 0.8f;
        car.setup(rate);
        set.drive = 0;
        set.mass = 1400.0f;
        configure();
        showGear = -2.0f;
        ready = 1;
    }

    void end()
    {
        if (ready != 0)
        {
            for (int i = 0; i < 12; ++i)
            {
                prim[i].release();
                run[i].release();
            }
            for (int i = 0; i < 2; ++i)
            {
                sec[i].release();
                pipe[i].release();
                ch1[i].release();
                mid[i].release();
                ch2[i].release();
                tail[i].release();
            }
            cross.release();
            listen.release();
        }
        ready = 0;
    }

    // The engine for the layout and the size dial: its cylinders, valves and pipes. Everything starts at rest.
    void configure()
    {
        lay.load(set.layout);
        lastLayout = set.layout;
        fuelUse = set.fuel;
        aspUse = set.asp < 0 ? 0 : (set.asp > 4 ? 4 : set.asp);
        // (stopped, with AMBIENT moved: it has stood in that air, as cold or as heat.warm as it is)
        heat.stood(ecu.state, set.ambF);
        heat.control(0.0f, set.ambF, vTotal, ecu.state, rpm, omega);
        for (int c = 0; c < lay.n; ++c)
            cyl[c].tw = heat.tSurf;
        ecu.kRet = 0.0f;
        lastSize = set.size;
        lastCam = set.cam;
        smMuf = set.muffler;
        smHdr = set.headers;
        smPipe = set.pipe;
        smXp = set.xpipe;
        boost.smTb = set.turbo;
        boost.smTs = boost.tsOf(set.tsize);
        smCam = set.cam;
        sizeSeen = set.size;
        sizeRest = 0.0f;
        // the size dial: the engine's displacement in litres (a rotary's: its two rotors' chambers), each cylinder kept
        // between 30 cc and 5 litres
        const float litres = fminf(fmaxf(set.size, 0.05f), 30.0f);
        const float swept = fminf(fmaxf(litres * 0.001f / (lay.rotary != 0 ? 2.0f : (float)lay.n), 3.0e-5f), 5.0e-3f);
        const float scale = swept / lay.swept;
        vTotal = swept * (lay.rotary != 0 ? 2.0f : (float)lay.n);
        // a bigger engine than the layout's own breathes out through bigger pipes: their diameters as the 0.45th power
        // of its size over the layout's (its flow's area: a 6.7 L six's 86 mm, a 15 L truck's 124, as theirs are some
        // 100 and 127; through the layout's 60 mm its gas ran at near half the speed of sound, a hiss)
        const float kPipe = expf(0.45f * logf(fmaxf(scale, 1.0f)));
        lay.pipeD *= kPipe;
        lay.tailD *= kPipe;
        smCR = fminf(fmaxf(set.comp, 6.0f), 25.0f);
        lastCR = smCR;
        // the torque the car's gears are chosen for: the full load's, for this engine (peakTorque's, at its new size; a
        // diesel's about half a gasoline engine's of its size here, its full fuel lean)
        {
            const float bg = aspUse == 0 ? 0.0f : (aspUse == 4 ? 0.25f + 0.75f * set.turbo : 0.35f + 1.05f * set.turbo);
            gearTq = (fuelUse != 0 ? 0.5f : 1.0f) * 1.6f * 0.6f * 1.0e6f * vTotal * 0.0795775f * (1.0f + 0.8f * bg);
        }
        // the bore and the stroke: a square cylinder's bore, moved by BORE/STROKE (the same swept volume: an
        // oversquare engine's bore wider, its stroke shorter; a rotary has neither)
        boreSq = lay.rotary != 0 ? 0.09f : expf(0.33333333f * logf(1.2732395f * swept));
        smBs = bsOf();
        boreStroke();
        // (a big cam's overlap dilutes the idle more the slower it turns: its tune idles it higher, as real ones are)
        ecu.idleRpm = fmaxf(idleBase + set.idle + 350.0f * fmaxf(set.cam - 0.35f, 0.0f) / 0.65f + heat.coldIdle(fuelUse), 350.0f);
        ecu.redRpm = fmaxf(redBase + set.redline, ecu.idleRpm + 1500.0f);
        nDuals = lay.topo == 2 ? 2 : 1;
        // the ecu.throttle and the plenum go with the engine's size
        aThrottle = 0.0028f * sqrtf(vTotal / 0.002f) * (lay.bike > 0.5f ? 1.25f : 1.0f);
        aBypass = 0.045f * aThrottle;
        vPlenum = fmaxf(0.8f * vTotal, 0.0004f);
        // (a diesel's crank and flywheel are heavier, for its pressures: twice a gasoline engine's of the layout's size,
        // and more the bigger it is: some 0.85 kg m^2 for a 6.7 L six, 2.2 for a 15 L truck's)
        clatSize = expf(0.33333333f * logf(swept / 0.0005f));
        jBase = fuelUse != 0 ? 2.0f * lay.inertia * expf(1.2f * logf(scale)) : lay.inertia * expf(0.6f * logf(scale));
        for (int c = 0; c < lay.n; ++c)
        {
            Cylinder* cy = &cyl[c];
            cy->setup(swept, smCR, 3.3f, lay.rotary, lay.cyc);
            cy->tw = heat.tSurf;
            cy->diesel = fuelUse;
            cy->bias = 0.025f * noise.rnd();
            float a0 = theta + lay.fire[c];
            while (a0 >= lay.cyc)
                a0 -= lay.cyc;
            cy->reset(a0);
            cy->t = heat.tAmb + 30.0f * heat.warm;
            cy->m = cy->p * cy->v / (287.0f * cy->t);
        }
        for (int i = 0; i < 12; ++i)
            portBank[i] = 0;
        for (int c = 0; c < lay.n; ++c)
            portBank[lay.port[c]] = lay.bank[c];
        valves();
        if (ecu.state != 0)
        {
            // running (a new layout or size under the fade): each cylinder's charge from where it stands (a fresh one at
            // the air outside would bang): the air's with its exhaust open (the pipes start at rest), else the plenum's
            for (int c = 0; c < lay.n; ++c)
            {
                Cylinder* cy = &cyl[c];
                float e = cy->ang - cy->evo;
                if (e < 0.0f)
                    e += cy->cyc;
                cy->p = e < cy->edur ? 101325.0f : pPlenum;
                cy->m = cy->p * cy->v / (287.0f * cy->t);
            }
        }
        for (int i = 0; i < 12; ++i)
        {
            prim[i].clear();
            run[i].clear();
        }
        for (int i = 0; i < 2; ++i)
        {
            sec[i].clear();
            pipe[i].clear();
            ch1[i].clear();
            mid[i].clear();
            ch2[i].clear();
            tail[i].clear();
            radPrev[i] = 0.0f;
            endR[i].clear();
        }
        for (int i = 0; i < 12; ++i)
            endRun[i].clear();
        cross.clear();
        listen.resetPaths();
        ex.pumpOn = fuelUse != 0 ? 0.6f : (lay.bike < 0.5f && lay.rotary == 0 ? 0.3f : 0.0f);
        ex.setClatter(fuelUse, cyl[0].vd);
        for (int i = 0; i < 12; ++i)
        {
            sHd[i] = 0.0f;
            qHd[i] = 0.0f;
        }
        for (int i = 0; i < 2; ++i)
        {
            qPp[i] = 0.0f;
            qM1[i] = 0.0f;
            qM4[i] = 0.0f;
        }
        for (int g = 0; g < 8; ++g)
        {
            fnG[g] = 0.0f;
            flowBand(g, 300.0f);
        }
        for (int i = 0; i < 8; ++i)
            sMf[i] = 0.0f;
        for (int i = 0; i < 2; ++i)
        {
            sMg[i] = 0.0f;
            sXp[i] = 0.0f;
            sEx[i] = 0.0f;
        }
        // each layout's loudness, measured: so they come out alike at speed
        const float norm[17] = {1.087f, 1.643f, 1.694f, 1.577f, 4.627f, 1.644f, 1.154f, 1.292f, 1.466f, 2.569f, 2.069f, 1.412f, 2.658f, 1.738f, 2.634f, 3.367f, 0.608f};
        // and the exhaust's own share, measured over full ecu.throttle from a third of the redline to near it, so the
        // physical pipes come out as loud there as the earlier model's did, the engine bay's sounds unchanged
        const float exT[17] = {0.923f, 1.249f, 1.388f, 1.815f, 3.380f, 3.990f, 4.603f, 1.741f, 5.346f, 5.230f, 5.831f, 3.722f, 8.169f, 3.613f, 4.332f, 5.947f, 1.226f};
        gainNorm = 0.5f * norm[set.layout < 0 ? 0 : (set.layout > 16 ? 16 : set.layout)];
        exTrim = exT[set.layout < 0 ? 0 : (set.layout > 16 ? 16 : set.layout)];
        // (the flow's and the jet's noise were tuned to the trims before the per-pass loss raised them: made at the
        // junctions and the tail, past most of that loss, they rise with them only a quarter as much in dB)
        const float exT1[17] = {0.288f, 0.348f, 0.402f, 0.400f, 0.884f, 0.995f, 0.999f, 0.439f, 1.527f, 1.113f, 1.609f, 0.501f, 1.415f, 0.853f, 0.837f, 1.123f, 0.401f};
        noiseTrim = sqrtf(sqrtf(exT1[set.layout < 0 ? 0 : (set.layout > 16 ? 16 : set.layout)] / exTrim));
        showRed = ecu.redRpm;
        // stopped, the walls as heat.warm as the engine is (heat.warm: where a long idle leaves them; cold: at the air outside);
        // running (a new layout or size under the fade), the plenum, the ecu.throttle, the controllers and the heat go on as
        // they were
        if (ecu.state == 0)
        {
            pPlenum = 101325.0f;
            tAir = heat.tAmb + 5.0f * heat.warm;
            tPort = heat.tAmb + 20.0f * heat.warm;
            ecu.throttle = 0.0f;
            ecu.bypass = 0.3f;
            ecu.idleInt = 0.15f;
            ecu.trim = 1.0f;
            ecu.govInt = 0.0f;
            mdotSlow = 0.36f * vTotal * ecu.idleRpm / 120.0f;
            for (int i = 0; i < 5; ++i)
                tWall[i] = heat.tAmb + 120.0f * heat.warm;
            for (int it = 0; it < 400; ++it)
                soak(heat.tAmb + 350.0f * heat.warm, mdotSlow, 3.0f * heat.warm);
            for (int i = 0; i < 5; ++i)
                tUse[i] = tGas[i];
        }
        mPlenum = pPlenum * vPlenum / (287.0f * tAir);
        pipes();
    }

    // The exhaust's heat (dt seconds on): the gas leaves the ports at tIn and cools along the system toward each part's
    // wall, keeping exp(-NTU) of its excess through a part (NTU from turbulent pipe flow's heat transfer, Dittus and
    // Boelter's: 0.0135 L / (m^0.2 D^0.8) for exhaust gas a branch carrying m kg/s; more in the pulsing headers and
    // the muffler's chambers). Each wall heats or cools toward where the gas inside and the air outside hold it
    // (convection, more with the car's speed, and radiation), over tens of seconds to minutes: its steel's heat over
    // what it exchanges. So the gas is hot near the engine and cooler down the system, much hotter at full ecu.throttle
    // than at idle, and the downstream parts take their time to follow.
    void soak(float tIn, float m, float dt)
    {
        const float hk = expf(0.9808293f * (smHdr - 0.5f));
        const float pk = expf(1.3862944f * (smPipe - 0.5f));
        const float dHead = 0.46f * bore;
        const float dSec = lay.topo == 0 ? lay.pipeD : 0.922f * lay.pipeD;
        const float vAir = set.drive != 0 ? fabsf(car.v) : 0.0f;
        float len[5];
        float dia[5];
        float br[5];
        len[0] = lay.hdr * hk;
        len[1] = lay.bike > 0.5f ? 0.25f : 0.38f;
        len[2] = lay.mainLen * pk;
        len[3] = lay.muff * 1.6f + 0.12f + 0.08f * (1.0f - lay.bike);
        len[4] = lay.bike > 0.5f ? 0.10f : 0.40f;
        dia[0] = dHead;
        dia[1] = dSec;
        dia[2] = lay.pipeD;
        dia[3] = lay.pipeD;
        dia[4] = lay.tailD;
        br[0] = (float)lay.ports;
        br[1] = lay.topo == 0 ? 1.0f : 2.0f;
        br[2] = (float)nDuals;
        br[3] = (float)nDuals;
        br[4] = (float)nDuals;
        const float enh[5] = {1.5f, 1.2f, 1.0f, 2.0f, 1.0f};
        const float shellK[5] = {1.0f, 1.0f, 1.0f, 4.0f, 1.0f};      // the outside's area over the inside's
        const float hCap[5] = {9000.0f, 6000.0f, 12000.0f, 10000.0f, 5000.0f};  // J / (m^2 K) of the outside
        float t = tIn;
        for (int i = 0; i < 5; ++i)
        {
            const float mb = fmaxf(m / br[i], 2.0e-5f);
            const float ntu = 0.01352f * enh[i] * len[i] * expf(-0.2f * logf(mb) - 0.8f * logf(dia[i]));
            const float e = expf(-ntu);
            const float tw = tWall[i];
            tGas[i] = tw + (t - tw) * (1.0f - e) / ntu;
            t = tw + (t - tw) * e;
            const float sOut = 3.14159265f * dia[i] * len[i] * shellK[i];
            const float gIn = ntu * mb * 1150.0f;
            const float gOut = (20.0f + 4.0f * vAir + 4.536e-8f * (tw * tw + heat.tAmb * heat.tAmb) * (tw + heat.tAmb)) * sOut;
            const float tEq = (gIn * tGas[i] + gOut * heat.tAmb) / (gIn + gOut);
            tWall[i] = tw + (tEq - tw) * fminf(dt * (gIn + gOut) / (hCap[i] * sOut), 1.0f);
        }
    }

    // The BORE/STROKE dial as the engine takes it: 0.5 to 2 (a rotary, or the dial unset: 1, square)
    float bsOf()
    {
        if (lay.rotary != 0 || set.bs <= 0.0f)
            return 1.0f;
        return fminf(fmaxf(set.bs, 0.5f), 2.0f);
    }

    // The bore and what goes with the bore over the stroke (smBs). At the same displacement the bore goes as its cube
    // root, the stroke as its cube root's inverse square: the valves, the ports and the headers go with the bore
    // (valves, pipes), the pistons' speed with the stroke (1.6 times a square engine's at the same revs at 0.5, 0.63
    // times at 2: their rubbing with it), the burn's degrees with the flame's path across the bore over the gas's
    // churn, which the pistons' speed makes (as its 0.35th power: 27 % longer at 2, 22 % shorter at 0.5; the spark
    // leads it by half that), and the end gas, longer waiting for the flame, knocks at a lower compression (some 1
    // less at 2, 1 more at 0.5)
    void boreStroke()
    {
        const float lb = logf(smBs);
        bore = boreSq * expf(0.33333333f * lb);
        strokeK = expf(-0.66666667f * lb);
        burnK = expf(0.35f * lb);
        crBs = -1.5f * lb;
        lastBs = smBs;
        // a diesel turns at most what keeps its pistons under some 13.5 m/s (a 6.7 L six of 107 by 124 mm: 3270 rpm, a
        // 15 L of 137 by 169: 2400), at most six tenths of the layout's redline, and idles at a quarter of that (a 15 L
        // truck's 650); a gasoline engine keeps its layout's
        const float stroke = lay.rotary != 0 ? 0.01f : bore / smBs;
        redBase = fuelUse != 0 ? fminf(0.6f * lay.redRpm, 405.0f / fmaxf(stroke, 0.01f)) : lay.redRpm;
        idleBase = fuelUse != 0 ? fminf(lay.idleRpm, 0.27f * redBase) : lay.idleRpm;
    }

    // The cams: how long the valves open and how much they overlap (the cam dial), and the valves' areas
    void valves()
    {
        const float c = smCam;
        lastCam = c;
        const float ap = 0.785398f * bore * bore;
        for (int k = 0; k < lay.n; ++k)
        {
            Cylinder* cy = &cyl[k];
            if (lay.rotary != 0)
            {
                // peripheral exhaust port, side intake ports (degrees of the eccentric shaft; the face fires at 0)
                cy->evo = 195.0f - 25.0f * c;
                cy->edur = 395.0f + 35.0f * c;
                cy->ivo = 572.0f - 40.0f * c;
                cy->idur = 285.0f + 60.0f * c;
                cy->aE = 0.0016f * (vTotal / 0.0013f);
                cy->aI = 0.0020f * (vTotal / 0.0013f);
            }
            else
            {
                const float ed = 224.0f + 76.0f * c;           // exhaust duration
                const float id = 224.0f + 76.0f * c;
                const float lsa = 112.0f - 6.0f * c;           // lobe separation
                cy->evo = 360.0f - lsa - 0.5f * ed;
                cy->edur = ed;
                cy->ivo = 360.0f + lsa - 0.5f * id;
                cy->idur = id;
                // two valves each: the curtain at full lift (a quarter of the diameter) with its discharge coefficient there
                // (about 0.4): some 9 % of the piston's area for the exhaust, 12 % for the intake (cylinder.fm, flowArea,
                // shapes the lift's way up)
                cy->aE = 0.091f * ap;
                cy->aI = 0.118f * ap;
            }
            cy->sparkAt = lay.cyc - 20.0f;
            cy->burnDur = 50.0f;
        }
    }

    // Where a muffler's scattering starts taking the highs (Hz): some 500 Hz, or in a short pipe half its own first
    // resonance (c / 2L), so that the delay its shelves add at the lows fits in its line (c: m/s, len: m)
    float backFc(float c, float len)
    {
        return fmaxf(500.0f, 0.25f * c / fmaxf(len, 0.01f));
    }

    // The pipes' sizes for the layout and the dials, and their lengths in samples at the gas's temperatures now
    void pipes()
    {
        const float hk = expf(0.9808293f * (smHdr - 0.5f));     // headers: 0.61 to 1.63 times
        const float pk = expf(1.3862944f * (smPipe - 0.5f));        // pipe: half to twice
        const float dHead = 0.46f * bore;
        const float aHead = 0.785398f * dHead * dHead;
        const float aPipe = 0.785398f * lay.pipeD * lay.pipeD;
        const float aTail = 0.785398f * lay.tailD * lay.tailD;
        const float aSec = lay.topo == 0 ? aPipe : 0.85f * aPipe;
        // the gas cools as it goes, and heats and cools with the load (soak): the pipes follow it slowly, so the
        // system's resonances move with the heat over seconds, never with the pulses
        const float tH = tUse[0];
        const float tS = tUse[1];
        const float tP = tUse[2];
        const float tM = tUse[3];
        const float tT = tUse[4];
        const float cH = sqrtf(1.35f * 287.0f * tH);
        const float cS = sqrtf(1.35f * 287.0f * tS);
        const float cP = sqrtf(1.35f * 287.0f * tP);
        const float cM = sqrtf(1.35f * 287.0f * tM);
        const float cT = sqrtf(1.35f * 287.0f * tT);
        // the muffler: from a straight-through tube (0) to big packed chambers (1)
        const float mu = smMuf;
        const float ratio1 = 1.0f + 15.0f * mu;
        const float ratio2 = 1.0f + 9.0f * mu;
        // below about a third it is a straight-through can (a perforated tube through a packed shell: the gas keeps to
        // the tube, so it loses little to its flow), above it chambers the gas expands into and out of (the losses of
        // those changes of area, and the back pressure they make); packed throughout, more with the dial. The packing
        // takes the highs (porous fill), less as the flow past the perforations grows (they choke with grazing flow).
        const float chamb = fminf(fmaxf((mu - 0.25f) / 0.35f, 0.0f), 1.0f);
        const float chambs = chamb * chamb * (3.0f - 2.0f * chamb);
        const float graze = 1.0f / (1.0f + 1.5f * ch1[0].mach);
        const float lk1 = (lay.muff / 0.45f) * graze;
        const float lk2 = 0.6f * lk1;
        const float dPipe = lay.pipeD;
        // what the model does not resolve takes a share of each pass, whatever the level: the converter's narrow
        // channels (their broadband absorption: some 2.3 dB a pass), the packing's lows, the bends, welds and slip
        // joints, the turbulent boundary layer's damping (some 1.1 dB through a header). Without it the system rings at
        // low flow as no real one does, and the losses that grow with the flow leave the level rising too little with
        // the revs.
        const float keepH = 0.878f;
        const float keepP = 0.769f;
        const float aRun = 0.9f * 0.27f * 0.785398f * bore * bore / 0.62f;
        for (int i = 0; i < lay.ports; ++i)
        {
            // each header a little different, as real ones are; the second bank of an unequal-length boxer much longer
            const int b = portBank[i];
            const float own = 1.0f + 0.06f * (float)((i * 7) % 5 - 2) / 2.0f;
            const float len = lay.hdr * hk * own * (b == 1 ? lay.hdrBank1 : 1.0f);
            prim[i].set(len, dHead, aHead, cH, rate);
            prim[i].extra(0.0f, keepH, rate);
            prim[i].steep = 0.87f / 101325.0f;
            run[i].set(lay.bike > 0.5f ? 0.16f : 0.30f, sqrtf(aRun * 1.2732395f), aRun, 350.0f, rate);
            run[i].extra(0.0f, 1.0f, rate);
        }
        // (a turbo's turbine sits at each collector: a restriction that smooths the pulses; one turbo for the engine is
        // the most of both, twins less, four between; a supercharger leaves the exhaust free)
        // (a smaller turbine than the match chokes more and smooths less: its housing's volume; as the root of its size)
        const float tb = aspUse >= 1 && aspUse <= 3 ? boost.smTb : 0.0f;
        const float tsr = expf(-0.5f * logf(boost.smTs));
        const float aS = aSec * fmaxf(1.0f - (aspUse == 2 ? 0.45f : (aspUse == 3 ? 0.5f : 0.55f)) * tb * tsr, 0.15f);
        const float tbHz = tb > 0.001f ? (1320.0f + 22680.0f * (1.0f - tb) * (1.0f - tb) * (1.0f - tb)) * (aspUse == 2 ? 1.25f : (aspUse == 3 ? 1.1f : 1.0f)) * tsr : 0.0f;
        for (int k = 0; k < 2; ++k)
        {
            sec[k].set(lay.bike > 0.5f ? 0.25f : 0.38f, sqrtf(aS * 1.2732395f), aS, cS, rate);
            sec[k].extra(tbHz, 1.0f, rate);
            sec[k].steep = 0.87f / 101325.0f;
            const float pl = lay.mainLen * pk;
            pipe[k].set(pl, dPipe, aPipe, cP, rate);
            pipe[k].extra(0.0f, keepP, rate);
            // (the converter's monolith: its narrow channels' walls take the highs, about as the root of the frequency:
            // some 2.5 dB at 1 kHz, 5 at 4 kHz, 7.5 at the top each way)
            pipe[k].pack(700.0f, 2.5f, 4000.0f, 5.0f, rate);
            pipe[k].steep = 0.87f / 101325.0f;
            ch1[k].set(lay.muff, dPipe * sqrtf(ratio1), aPipe * ratio1, cM, rate);
            ch1[k].extra(0.0f, expf(0.8f * logf(0.92f - 0.25f * mu)), rate);
            ch1[k].pack(1100.0f, (1.5f + 5.0f * mu) * lk1, 5000.0f, (3.0f + 14.0f * mu) * lk1, rate);
            mid[k].set(0.12f + 0.08f * (1.0f - lay.bike), dPipe, aPipe, cM, rate);
            mid[k].extra(0.0f, 0.935f, rate);
            ch2[k].set(0.6f * lay.muff, dPipe * sqrtf(ratio2), aPipe * ratio2, cM, rate);
            ch2[k].extra(0.0f, expf(0.8f * logf(0.93f - 0.20f * mu)), rate);
            ch2[k].pack(1100.0f, (1.5f + 5.0f * mu) * lk2, 5000.0f, (3.0f + 14.0f * mu) * lk2, rate);
            tail[k].set(lay.bike > 0.5f ? 0.10f : 0.40f, lay.tailD, aTail, cT, rate);
            tail[k].extra(0.0f, 0.960f, rate);
            // what the muffler sends back loses its highs: above some 500 Hz its reflections scatter into its chambers'
            // cross modes and the packing takes them (up to 40 dB a pass, as strongly as its changes of area reflect),
            // so its chambers, its tube, the tail and the pipe before it no longer ring there as a comb. Their lows
            // ring as they did. (A short pipe's from higher up, where its own first resonances are.)
            const float sc1 = 40.0f * (1.0f - 1.0f / ratio1);
            const float sc2 = 40.0f * (1.0f - 1.0f / ratio2);
            pipe[k].back(backFc(pipe[k].c, pipe[k].len), sc1, rate);
            ch1[k].back(backFc(ch1[k].c, ch1[k].len), sc1, rate);
            mid[k].back(backFc(mid[k].c, mid[k].len), sc2, rate);
            ch2[k].back(backFc(ch2[k].c, ch2[k].len), sc2, rate);
            tail[k].back(backFc(tail[k].c, tail[k].len), sc2, rate);
        }
        const float xa = fmaxf(smXp, 0.001f);
        cross.set(0.25f, dPipe * sqrtf(xa), xa * aPipe, cP, rate);
        cross.extra(0.0f, 0.960f, rate);
        // the junctions' losses: a header merging into its collector (and the flow pushed back into it), the collectors'
        // pipes merging, the H-pipe's sharp-edged ends, the muffler's sudden expansions ((1 - a/A)^2 on the narrow side's
        // speed) and contractions (about half of 1 - a/A), the tail's jet
        const float rhoH = prim[0].rho;
        const float rhoS = sec[0].rho;
        const float rhoM = ch1[0].rho;
        kHin = lossKap(0.25f, rhoH, aHead);
        kHout = lossKap(0.45f, rhoH, aHead);
        kSin = lossKap(0.15f, rhoS, aS);
        kSout = lossKap(0.30f, rhoS, aS);
        kXp = lossKap(0.5f, sec[0].rho, xa * aPipe);
        const float e1 = 1.0f - 1.0f / ratio1;
        const float e2 = 1.0f - 1.0f / ratio2;
        const float aCh2 = aPipe * ratio2;
        const float e3 = 1.0f - fminf(aTail / aCh2, 1.0f);
        kMuf[0] = lossKap(chambs * e1 * e1, rhoM, aPipe);   // pipe into the first chamber: an expansion
        kMuf[1] = lossKap(chambs * 0.5f * e1, rhoM, aPipe); // and back: a contraction
        kMuf[2] = lossKap(chambs * 0.5f * e1, rhoM, aPipe); // the first chamber into the tube
        kMuf[3] = lossKap(chambs * e1 * e1, rhoM, aPipe);
        kMuf[4] = lossKap(chambs * e2 * e2, rhoM, aPipe);   // the tube into the second chamber
        kMuf[5] = lossKap(chambs * 0.5f * e2, rhoM, aPipe);
        kMuf[6] = lossKap(0.5f * e3, rhoM, aTail);          // the second chamber into the tail
        kMuf[7] = lossKap(e3 * e3, rhoM, aTail);
        kInM = fmaxf(chambs * e1 * e1, 0.1f);           // (a straight-through's perforates still hiss)
        kOutM = fmaxf(0.5f * e3, 0.1f);
        kExit[0] = lossKap(1.0f, tail[0].rho, aTail);
        kExit[1] = lossKap(0.5f, tail[0].rho, aTail);
        // the muffler's perforations: the gas passes through them between the chambers and the tube, a resistance of
        // a twentieth to a fifth of the gas's rho c (more holes' worth of resistance in a more restrictive can)
        rPerf = (0.05f + 0.15f * mu) * ch1[0].rho * cM / aPipe;
        // the converter: a monolith's flow resistance (some 60 Pa s/m across it at 700 K with its cones, growing with
        // the gas's viscosity: a few kPa at full power), over the pipe's area
        rCat = 60.0f * expf(0.7f * logf(tP / 700.0f)) / aPipe;
        // the open end's reflection: Silva et al.'s fit to an unflanged pipe's (within 8 % to ka = 2), R = -(1 + 0.167
        // ts) / (1 + 1.393 ts + 0.457 t^2 s^2), t = a / c in the air outside, for the hot gas inside: the air's rho c
        // over the gas's (kEnd, about 1.6 at 750 K) multiplies the radiation's impedance z, so the end holds more of the
        // cold air's mass (a longer end correction) and lets more out: R = (kEnd z - 1) / (kEnd z + 1), z from the fit.
        // By the bilinear transform.
        const float aEnd = 0.5f * lay.tailD;
        const float tau = aEnd / 347.2f;
        const float kEnd = 1.018f * sqrtf(tT / heat.tAmb);
        const float nb1 = (0.613f * kEnd - 0.78f) * tau;
        const float nb2 = 0.2285f * (kEnd - 1.0f) * tau * tau;
        const float da1 = (0.613f * kEnd + 0.78f) * tau;
        const float da2 = 0.2285f * (kEnd + 1.0f) * tau * tau;
        const float kb = 2.0f * rate;
        const float kb2 = kb * kb;
        for (int k = 0; k < 2; ++k)
            endR[k].design(-1.0f + nb1 * kb + nb2 * kb2, -2.0f - 2.0f * nb2 * kb2, -1.0f - nb1 * kb + nb2 * kb2,
                           1.0f + da1 * kb + da2 * kb2, 2.0f - 2.0f * da2 * kb2, 1.0f - da1 * kb + da2 * kb2);
        // each runner's end in the plenum radiates into it as an open pipe's end does (the same fit, the same air
        // inside and out): the lows come back inverted, the highs go out. (A runner whose ends both reflected whole,
        // its valve shut at one end, rang at its high modes with nothing to stop it: a squeal at idle, the reversion
        // of a big cam's overlap striking them every cycle; a real one loses some 3 dB a round trip at 2.6 kHz there.)
        const float tR = sqrtf(aRun * 0.31830989f) / 347.2f;
        const float rn1 = -0.167f * tR * kb;
        const float rd1 = 1.393f * tR * kb;
        const float rd2 = 0.457f * tR * tR * kb2;
        for (int i = 0; i < lay.ports; ++i)
            endRun[i].design(-1.0f + rn1, -2.0f, -1.0f - rn1, 1.0f + rd1 + rd2, 2.0f - 2.0f * rd2, 1.0f - rd1 + rd2);
    }

    // The converter's cone's (and the merging's) flow noise for main pipe k: K 0.6 on the pipe's own speed
    float coneNoise(int k)
    {
        const float u = qPp[k] / pipe[k].area;
        return flowK * noiseTrim * 0.6f * 0.5f * pipe[k].rho * u * u * fnG[2 + k];
    }

    // A node where n pipe ends meet (a merge, a collector): a[i] the waves arriving there, z[i] each branch's impedance
    // (with any resistance in series), kf[i] and kr[i] its loss for flow into the node and out of it (lossKap), sl[i]
    // its drive's slow part and al[i] that part's smoothing, src a volume flow the node makes itself (a pop's gas).
    // The losses act on the slow part (quasi-steady, as separated flow does below a Strouhal number of about 0.2), from
    // the last sample's, so the node solves in one pass and stays passive. Leaves each branch's flow into the node in
    // q[i] (and its slow part updated in sl[i]); returns the node's pressure.
    float node(int n, float* a, float* z, float* kf, float* kr, float* sl, float* al, float* q, float src)
    {
        float sy = 0.0f;
        float sa = src;
        float h[14];
        for (int i = 0; i < n; ++i)
        {
            const float x = sl[i];
            h[i] = lossHold(x, z[i], x >= 0.0f ? kf[i] : kr[i]);
            sy += 1.0f / z[i];
            sa += 2.0f * a[i] / z[i] - h[i];
        }
        const float p = sa / sy;
        for (int i = 0; i < n; ++i)
        {
            const float d = 2.0f * a[i] - p;
            q[i] = d / z[i] - h[i];
            sl[i] += al[i] * (d - sl[i]);
        }
        return p;
    }

    // ---- the keys ----

    int keyDown(float note, float vel)
    {
        // (stopped, a new layout or size is taken at once; running, under the fade: control16)
        if (ecu.state == 0 && (set.layout != lastLayout || set.fuel != fuelUse || set.asp != aspUse || fabsf(set.size - lastSize) > 0.001f
                           || fabsf(set.ambF - heat.ambSeen) > 0.25f))
            configure();
        if (ecu.keyCount >= 16)
        {
            // full: the oldest key gives way, so the newest always drives
            for (int j = 0; j < 15; ++j)
            {
                ecu.keyNote[j] = ecu.keyNote[j + 1];
                ecu.keyVel[j] = ecu.keyVel[j + 1];
            }
            ecu.keyCount = 15;
        }
        ecu.keyNote[ecu.keyCount] = note;
        ecu.keyVel[ecu.keyCount] = vel;
        ecu.keyCount += 1;
        ecu.tokenCounter += 1;
        ecu.rendering = ecu.tokenCounter;
        // (driven, a key that goes down while it runs may switch it off: held a second)
        if (ecu.state == 2)
            ecu.offArmed = true;
        if (set.drive != 0)
            car.followLever(set.drive, set.lever);
        // driven, in gear it cranks only with the clutch's ecu.pedal down (as a car's clutch switch has it)
        const bool may = set.drive == 0 || car.gear == 0 || set.clutch > 0.75f;
        if ((ecu.state == 0 || ecu.state == 3) && may)
        {
            if (set.starter != 0 && omega < 60.0f)
                ecu.state = 1;
            else
            {
                ecu.state = 2;
                if (omega < 0.6f * ecu.idleRpm * 0.10471976f)
                {
                    omega = ecu.idleRpm * 0.10471976f;
                    ecu.rpmAvg = ecu.idleRpm;
                    rpm = ecu.idleRpm;
                    ecu.fuelCut = false;
                    // each cylinder between its intake closing and its spark fires on this pass
                    for (int c = 0; c < lay.n; ++c)
                    {
                        Cylinder* cy = &cyl[c];
                        const float ivc = cy->ivo + cy->idur >= lay.cyc ? cy->ivo + cy->idur - lay.cyc : cy->ivo + cy->idur;
                        if (cy->ang > ivc && cy->ang < cy->sparkAt)
                            comb.charge(&cyl[c], c, fuelUse, pPlenum, rpm, smCR, crBs, burnK, set.pops, set.rough, set.timing);
                    }
                }
            }
        }
        ecu.holdLeft = set.hold;
        return ecu.tokenCounter;
    }

    void keyUp(float note)
    {
        for (int i = 0; i < ecu.keyCount; ++i)
        {
            if (ecu.keyNote[i] == note)
            {
                for (int j = i; j < ecu.keyCount - 1; ++j)
                {
                    ecu.keyNote[j] = ecu.keyNote[j + 1];
                    ecu.keyVel[j] = ecu.keyVel[j + 1];
                }
                ecu.keyCount -= 1;
                break;
            }
        }
        if (ecu.keyCount == 0)
            ecu.holdLeft = set.hold;
    }

    // ---- every 16 samples: the driver, the idle valve, the ECU, the pipes' temperatures ----

    void control16()
    {
        const float d16 = 16.0f * dt;
        rpm = omega * 9.5492966f;
        heat.control(d16, set.ambF, vTotal, ecu.state, rpm, omega);
        for (int c = 0; c < lay.n; ++c)
            cyl[c].tw = heat.tSurf;
        ecu.sense(d16, rpm, idleBase, set.idle, set.cam, heat.coldIdle(fuelUse), redBase, set.redline);
        // a new layout, or a new size once its dial rests, under the fade (renderAt makes it at the fade's quiet)
        if (fabsf(set.size - sizeSeen) > 0.0005f)
        {
            sizeSeen = set.size;
            sizeRest = 0.0f;
        }
        else
            sizeRest += d16;
        if (set.layout != lastLayout || set.fuel != fuelUse || set.asp != aspUse || (fabsf(set.size - lastSize) > 0.001f && sizeRest > 0.15f)
            || (ecu.state == 0 && fabsf(set.ambF - heat.ambSeen) > 0.25f))
            cutWant |= 1;
        // the dials that shape the pipes and the cams, smoothed
        smMuf += (set.muffler - smMuf) * kDial;
        smHdr += (set.headers - smHdr) * kDial;
        smPipe += (set.pipe - smPipe) * kDial;
        smXp += (set.xpipe - smXp) * kDial;
        boost.glide(set.turbo, set.tsize, kDial);
        smCam += (set.cam - smCam) * kDial;
        if (fabsf(smCam - lastCam) > 0.0005f)
            valves();
        // the compression: the cylinders' clearance follows it (the gas in them takes the change as the piston's)
        smCR += (fminf(fmaxf(set.comp, 6.0f), 25.0f) - smCR) * kDial;
        if (fabsf(smCR - lastCR) > 0.005f)
        {
            for (int c = 0; c < lay.n; ++c)
                cyl[c].setup(cyl[c].vd, smCR, 3.3f, lay.rotary, lay.cyc);
            lastCR = smCR;
        }
        // the bore over the stroke: the bore, the valves (the pipes follow it, pipes())
        smBs += (bsOf() - smBs) * kDial;
        if (fabsf(smBs - lastBs) > 0.0005f)
        {
            boreStroke();
            valves();
        }
        float ped = ecu.driver(d16, set.drive, set.bend, set.bendRange, set.keys, lay.rotary, lay.n);
        if (set.drive != 0)
            ped = car.drive16(set.drive, d16, jBase * expf(1.6094379f * (set.inertia - 0.5f)), peakTorque(), gearTq, set.mass,
                              ecu.redRpm, lay.bike, set.clutch, set.brake, set.lever, set.buttons, set.gas, rpm, ecu.idleRpm, ecu.rpmAvg);
        else
            car.lastDrive = 0;
        if (ecu.control(d16, ped, set.drive, set.modwheel, set.pressure, rpm, fuelUse, heat.warm, car.shiftCut, car.gear,
                        set.clutch, omega))
            omega = 0.0f;
        // the exhaust's mass flow and its power, for the turbo
        mdot += (mSum / 16.0f - mdot) * 0.15f;         // (mSum: 16 samples of kg/s)
        const float mRef = 1.2f * vTotal * ecu.redRpm / 120.0f * 0.9f;
        boost.control(aspUse, boost.smTb, mdot * tPort / 1100.0f / fmaxf(mRef, 1.0e-6f), fuelUse != 0 ? 1.0f : ecu.throttle, ecu.throttle,
                   set.bov, rpm / ecu.redRpm, rpm * 0.016666667f, boost.smTs, d16);
        pBox = 101325.0f + 100000.0f * boost.boost;
        tAir = heat.tAmb + 5.0f * heat.warm + 25.0f * boost.boost;
        // the exhaust's temperature: what the ports let out, slowly
        if (mSum > 1.0e-9f)
        {
            const float tNew = eSum / mSum;
            tPort += (tNew - tPort) * (1.0f - expf(-d16 / 0.8f));
        }
        else
            tPort += (heat.tAmb - tPort) * (1.0f - expf(-d16 / 4.0f));
        eSum = 0.0f;
        mSum = 0.0f;
        const float surf = 0.022f * expf(0.6666667f * logf(cyl[0].vd / 0.0005f));
        for (int c = 0; c < lay.n; ++c)
            cyl[c].hA = 260.0f * surf * (0.6f + rpm / 2500.0f);
        mdotSlow += (mdot - mdotSlow) * kMdot;
        soak(tPort, mdotSlow, d16);
        for (int i = 0; i < 5; ++i)
            tUse[i] += (tGas[i] - tUse[i]) * kUse;
        pipes();
        // the pipes' flow losses, from the mean speed of the gas through each since the last time
        for (int i = 0; i < lay.ports; ++i)
        {
            prim[i].flow16(xiWall, k16Flow);
            run[i].flow16(xiWall, k16Flow);
        }
        for (int k = 0; k < 2; ++k)
        {
            sec[k].flow16(xiWall, k16Flow);
            pipe[k].flow16(xiWall, k16Flow);
            ch1[k].flow16(xiWall, k16Flow);
            mid[k].flow16(xiWall, k16Flow);
            ch2[k].flow16(xiWall, k16Flow);
            tail[k].flow16(xiWall, k16Flow);
        }
        cross.flow16(xiWall, k16Flow);
        // the jet's noise peaks where its Strouhal number is about 0.3 (0.3 times its speed over the pipe's width, as a
        // jet's mixing noise does; no higher than 2.5 kHz)
        for (int k = 0; k < nDuals; ++k)
        {
            const float u = fmaxf(qJet[k], 0.0f) / tail[k].area;
            jetBand(k, 0.3f * u / sqrtf(tail[k].area * 1.2732395f));
        }
        // the flow noise's bands: a Strouhal number of 0.4 on each flow's mean speed over its width, no higher than
        // 3 kHz (above it, the plane waves the pipes carry are no longer all the noise makes: it roars, it does not
        // hiss)
        const int nb = lay.topo == 0 ? 1 : 2;
        for (int k = 0; k < nb; ++k)
            flowBand(k, 0.4f * prim[0].mach * prim[0].c / prim[0].diam);
        for (int k = 0; k < nDuals; ++k)
        {
            flowBand(2 + k, 0.4f * pipe[k].mach * pipe[k].c / pipe[k].diam);
            flowBand(4 + k, 0.4f * pipe[k].mach * pipe[k].c / pipe[k].diam);
            flowBand(6 + k, 0.4f * tail[k].mach * tail[k].c / tail[k].diam);
        }
    }

    // A flow noise's band about fPeak (from half of it; falling 12 dB an octave above twice it, as turbulence's
    // spectrum does), at unit strength (its equivalent bandwidth 1.005 fPeak)
    void flowBand(int g, float fPeak)
    {
        const float f = fminf(fmaxf(fPeak, 80.0f), 3000.0f);
        fnHp[g].set(0.5f * f, rate);
        fnLp[g].set(2.0f * f, rate);
        fnLp2[g].set(2.0f * f, rate);
        fnN[g] = sqrtf(rate / (0.67f * f));
    }

    // ---- driven (DRIVE CAR) ----

    float gearTq;       // the full-load torque the car's gearing was chosen for (at the layout's or size's change)
    float clatSize;     // a diesel's clatter for its cylinders' size: their panels' area (a cube root of the volume)

    // About the most torque this engine gives (the turbo's boost with it), for the clutch's capacity
    float peakTorque()
    {
        const float b = aspUse == 0 ? 0.0f : (aspUse == 4 ? 0.25f + 0.75f * set.turbo : 0.35f + 1.05f * set.turbo);
        return 1.6f * idleTq * (1.0f + 0.8f * b);
    }

    // The tail's jet noise in a band about fPeak: from half of it up to three times it (one-pole slopes beyond), at unit
    // strength (the band's noise power: 2/3 / rate a Hz of white noise, over 4.04 fPeak of bandwidth)
    OnePole vnLp;       // (the valves' jet noise past hearing taken out)
    float jetN[2];      // what makes that band's noise of unit strength, whatever its width and the sample rate
    float nScale;       // white noise's strength for the same loudness at any sample rate

    void jetBand(int k, float fPeak)
    {
        const float f = fminf(fmaxf(fPeak, 60.0f), 2500.0f);
        tnHp[k].set(0.5f * f, rate);
        tnLp[k].set(3.0f * f, rate);
        jetN[k] = sqrtf(rate / (2.693f * f));
    }

    // ---- one sample ----

    void sampleTick()
    {
        const int np = lay.ports;
        for (int i = 0; i < np; ++i)
        {
            prim[i].read();
            run[i].read();
        }
        const int nb = lay.topo == 0 ? 1 : 2;
        for (int k = 0; k < nb; ++k)
            sec[k].read();
        for (int k = 0; k < nDuals; ++k)
        {
            pipe[k].read();
            ch1[k].read();
            mid[k].read();
            ch2[k].read();
            tail[k].read();
        }
        if (nDuals == 2)
            cross.read();
        // the crank
        const float dDeg = omega * dt * 57.2957795f;
        theta += dDeg;
        if (theta >= 2160.0f)
            theta -= 2160.0f;
        // the cylinders
        float qe[12];
        float qi[12];
        for (int i = 0; i < np; ++i)
        {
            qe[i] = 0.0f;
            qi[i] = 0.0f;
        }
        float torque = 0.0f;
        float dps = 0.0f;
        const float clickAmp = 0.15f + 0.5f * expf(0.8f * logf(fmaxf(fminf(rpm / 4000.0f, 1.6f), 0.01f)));
        // (a piston's slap: its skirt hits the bore as the side thrust changes sides at the top, harder with the gas's
        // pressure there and the piston's speed)
        const float slapAmp = 0.4f + 0.6f * fminf(rpm / 3000.0f, 2.0f);
        const float tH = tUse[0];
        // faces that share a port (a rotary's) are solved together: each sees the pipe as the others' flows leave it
        float eShare[12];
        float iShare[12];
        float qE0[12];
        float qI0[12];
        if (np < lay.n)
        {
            for (int i = 0; i < np; ++i)
            {
                eShare[i] = 0.0f;
                iShare[i] = 0.0f;
            }
            for (int c = 0; c < lay.n; ++c)
            {
                float a = theta + lay.fire[c];
                while (a >= lay.cyc)
                    a -= lay.cyc;
                const int pi = lay.port[c];
                qE0[c] = cyl[c].exhaustFlowAt(a, prim[pi].near, prim[pi].z, tH);
                qI0[c] = cyl[c].intakeFlowAt(a, run[pi].near, run[pi].z, tAir);
                eShare[pi] += qE0[c];
                iShare[pi] += qI0[c];
            }
        }
        for (int c = 0; c < lay.n; ++c)
        {
            Cylinder* cy = &cyl[c];
            float a = theta + lay.fire[c];
            while (a >= lay.cyc)
                a -= lay.cyc;
            const int pi = lay.port[c];
            float bE = prim[pi].near;
            float bI = run[pi].near;
            if (np < lay.n)
            {
                bE += 0.5f * prim[pi].z * (eShare[pi] - qE0[c]);
                bI += 0.5f * run[pi].z * (iShare[pi] - qI0[c]);
            }
            cy->step(a, dDeg, dt, bE, prim[pi].z, tH, bI, run[pi].z, tAir);
            qe[pi] += cy->qEa;
            qi[pi] += cy->qIa;
            torque += cy->tq;
            if (cy->mE > 0.0f)
            {
                eSum += cy->mE * cy->t;
                mSum += cy->mE;
            }
            if (cy->ivcNow)
            {
                comb.charge(&cyl[c], c, fuelUse, pPlenum, rpm, smCR, crBs, burnK, set.pops, set.rough, set.timing);
                ex.valveClick(clickAmp);
            }
            if (cy->evcNow)
            {
                ex.valveClick(clickAmp);
                if (fuelUse == 0)
                    ex.injectorClick(0.3f);
            }
            if (fuelUse != 0 && cy->sparkNow && cy->qTot > 0.0f)
            {
                ex.injectorClick(1.0f);
                // (its premixed burn starts: how fast it raises the pressure, Pa/s, over an idling diesel's 5 bar a
                // millisecond, as its 0.55th power: the combustion noise some 12 dB up at full load at 2500 rpm)
                const float rise = 0.3f * cy->beta * cy->qTot / cy->vc * 6.0f * fmaxf(rpm, 100.0f) / cy->burnDur;
                ex.clatterClick(expf(0.55f * logf(fmaxf(rise * 2.0e-9f, 1.0e-6f))) * clatSize);
            }
            if (cy->knockNow)
                ex.knockClick(cy->knock);
            if (cy->slapNow)
                ex.slapClick(slapAmp * sqrtf(fmaxf(cy->p - 101325.0f, 0.0f) / 5.0e6f));
            if (cy->burnAt >= 0.0f && cy->dpdt > 0.0f)
                dps += cy->dpdt;
        }
        // the ports send their waves into the headers and runners
        float hNear[12];
        float rNear[12];
        const float wn = nScale * vnLp.lowpass(vnHp.highpass(noise.rnd()));
        for (int i = 0; i < np; ++i)
        {
            // the gas through the valve is a jet: a hiss in proportion to the flow, the louder the faster
            const float jet = prim[i].z * qe[i];
            hNear[i] = prim[i].near + jet * (1.0f + valveK * wn * fminf(fabsf(jet) * 0.00004f, 1.0f));
            rNear[i] = run[i].near + run[i].z * qi[i];
        }
        // the collectors: each bank's headers merge into its pipe, losing as they merge (pipes.fm, lossFlow); a pop is
        // the node's own gas
        float hFar[12];
        float sNear[2];
        float na[14];
        float nz[14];
        float nkf[14];
        float nkr[14];
        float nq[14];
        float ns[14];
        float nal[14];
        int ni[14];
        for (int k = 0; k < nb; ++k)
            fnG[k] = fnN[k] * fnLp2[k].lowpass(fnLp[k].lowpass(fnHp[k].highpass(noise.rnd())));
        for (int k = 0; k < nDuals; ++k)
        {
            fnG[2 + k] = fnN[2 + k] * fnLp2[2 + k].lowpass(fnLp[2 + k].lowpass(fnHp[2 + k].highpass(noise.rnd())));
            fnG[4 + k] = fnN[4 + k] * fnLp2[4 + k].lowpass(fnLp[4 + k].lowpass(fnHp[4 + k].highpass(noise.rnd())));
            fnG[6 + k] = fnN[6 + k] * fnLp2[6 + k].lowpass(fnLp[6 + k].lowpass(fnHp[6 + k].highpass(noise.rnd())));
        }
        for (int k = 0; k < nb; ++k)
        {
            int m = 0;
            for (int i = 0; i < np; ++i)
            {
                if (portBank[i] == k || lay.topo == 0)
                {
                    // (the header's jet's noise: a pressure in series with it, half on each side of the drive)
                    const float uh = qHd[i] / prim[i].area;
                    const float eh = flowK * noiseTrim * (uh >= 0.0f ? 0.25f : 0.45f) * 0.5f * prim[i].rho * uh * uh * fnG[k];
                    na[m] = prim[i].far - 0.5f * eh;
                    nz[m] = prim[i].z;
                    nkf[m] = kHin;
                    nkr[m] = kHout;
                    ns[m] = sHd[i];
                    nal[m] = prim[i].qsA;
                    ni[m] = i;
                    m += 1;
                }
            }
            na[m] = sec[k].near;
            nz[m] = sec[k].z;
            nkf[m] = 0.0f;
            nkr[m] = 0.0f;
            ns[m] = 0.0f;
            nal[m] = 0.0f;
            float sy = 0.0f;
            for (int j = 0; j <= m; ++j)
                sy += 1.0f / nz[j];
            const float pj = node(m + 1, na, nz, nkf, nkr, ns, nal, nq, pop[k].tick() * sy);
            shell[k] = shellHp[k].highpass(pj);
            for (int j = 0; j < m; ++j)
            {
                hFar[ni[j]] = prim[ni[j]].far - prim[ni[j]].z * nq[j];
                sHd[ni[j]] = ns[j];
                qHd[ni[j]] = nq[j];
            }
            sNear[k] = sec[k].near - sec[k].z * nq[m];
        }
        // after the collectors: one pipe (topo 0, 1) or two with an H-pipe between them (topo 2); the catalytic converter
        // at the head of each pipe (a resistance in series)
        float sFar[2];
        float pNear[2];
        float xNear = 0.0f;
        float xFar = 0.0f;
        if (lay.topo == 0)
        {
            na[0] = sec[0].far;
            nz[0] = sec[0].z;
            nkf[0] = kSin;
            nkr[0] = kSout;
            ns[0] = sMg[0];
            nal[0] = sec[0].qsA;
            na[1] = pipe[0].near - 0.5f * coneNoise(0);
            nz[1] = pipe[0].z + rCat;
            nkf[1] = 0.0f;
            nkr[1] = 0.0f;
            ns[1] = 0.0f;
            nal[1] = 0.0f;
            node(2, na, nz, nkf, nkr, ns, nal, nq, 0.0f);
            sMg[0] = ns[0];
            sFar[0] = sec[0].far - sec[0].z * nq[0];
            pNear[0] = pipe[0].near - pipe[0].z * nq[1];
            qPp[0] = -nq[1];
        }
        else if (lay.topo == 1)
        {
            for (int k = 0; k < 2; ++k)
            {
                na[k] = sec[k].far;
                nz[k] = sec[k].z;
                nkf[k] = kSin;
                nkr[k] = kSout;
                ns[k] = sMg[k];
                nal[k] = sec[k].qsA;
            }
            na[2] = pipe[0].near - 0.5f * coneNoise(0);
            nz[2] = pipe[0].z + rCat;
            nkf[2] = 0.0f;
            nkr[2] = 0.0f;
            ns[2] = 0.0f;
            nal[2] = 0.0f;
            node(3, na, nz, nkf, nkr, ns, nal, nq, 0.0f);
            sMg[0] = ns[0];
            sMg[1] = ns[1];
            sFar[0] = sec[0].far - sec[0].z * nq[0];
            sFar[1] = sec[1].far - sec[1].z * nq[1];
            pNear[0] = pipe[0].near - pipe[0].z * nq[2];
            qPp[0] = -nq[2];
        }
        else
        {
            for (int k = 0; k < 2; ++k)
            {
                na[0] = sec[k].far;
                nz[0] = sec[k].z;
                nkf[0] = kSin;
                nkr[0] = kSout;
                ns[0] = sMg[k];
                nal[0] = sec[k].qsA;
                na[1] = pipe[k].near - 0.5f * coneNoise(k);
                nz[1] = pipe[k].z + rCat;
                nkf[1] = 0.0f;
                nkr[1] = 0.0f;
                ns[1] = 0.0f;
                nal[1] = 0.0f;
                na[2] = k == 0 ? cross.near : cross.far;
                nz[2] = cross.z;
                nkf[2] = kXp;
                nkr[2] = kXp;
                ns[2] = sXp[k];
                nal[2] = cross.qsA;
                node(3, na, nz, nkf, nkr, ns, nal, nq, 0.0f);
                sMg[k] = ns[0];
                sXp[k] = ns[2];
                sFar[k] = sec[k].far - sec[k].z * nq[0];
                pNear[k] = pipe[k].near - pipe[k].z * nq[1];
                qPp[k] = -nq[1];
                if (k == 0)
                    xNear = cross.near - cross.z * nq[2];
                else
                    xFar = cross.far - cross.z * nq[2];
            }
        }
        // the pipes on to the muffler and out of the tail, each change of area losing what it does
        for (int k = 0; k < nDuals; ++k)
        {
            // (each: the lossless flow less what the loss holds back, from the drive's slow part)
            const int j = 4 * k;
            const float z1 = pipe[k].z + ch1[k].z;
            const float d1 = 2.0f * (pipe[k].far - ch1[k].near);
            const float u1 = qM1[k] / pipe[k].area;
            const float e1n = flowK * noiseTrim * kInM * 0.5f * ch1[k].rho * u1 * u1 * fnG[4 + k];
            const float q1 = (d1 - e1n) / z1 - lossHold(sMf[j], z1, sMf[j] >= 0.0f ? kMuf[0] : kMuf[1]);
            qM1[k] = q1;
            sMf[j] += pipe[k].qsA * (d1 - sMf[j]);
            const float z2 = ch1[k].z + mid[k].z + rPerf;
            const float d2 = 2.0f * (ch1[k].far - mid[k].near);
            const float q2 = d2 / z2 - lossHold(sMf[j + 1], z2, sMf[j + 1] >= 0.0f ? kMuf[2] : kMuf[3]);
            sMf[j + 1] += mid[k].qsA * (d2 - sMf[j + 1]);
            const float z3 = mid[k].z + ch2[k].z + rPerf;
            const float d3 = 2.0f * (mid[k].far - ch2[k].near);
            const float q3 = d3 / z3 - lossHold(sMf[j + 2], z3, sMf[j + 2] >= 0.0f ? kMuf[4] : kMuf[5]);
            sMf[j + 2] += mid[k].qsA * (d3 - sMf[j + 2]);
            const float z4 = ch2[k].z + tail[k].z;
            const float d4 = 2.0f * (ch2[k].far - tail[k].near);
            const float u4 = qM4[k] / tail[k].area;
            const float e4n = flowK * noiseTrim * kOutM * 0.5f * tail[k].rho * u4 * u4 * fnG[6 + k];
            const float q4 = (d4 - e4n) / z4 - lossHold(sMf[j + 3], z4, sMf[j + 3] >= 0.0f ? kMuf[6] : kMuf[7]);
            qM4[k] = q4;
            sMf[j + 3] += tail[k].qsA * (d4 - sMf[j + 3]);
            // the open end: the lows come back inverted, the highs go out; the jet leaving loses its momentum
            const float a = tail[k].far;
            const float dq = a - endR[k].tick(a);
            const float q = dq / tail[k].z - lossHold(sEx[k], tail[k].z, sEx[k] >= 0.0f ? kExit[0] : kExit[1]);
            sEx[k] += tail[k].qsA * (dq - sEx[k]);
            const float b = a - tail[k].z * q;
            float rad = (q - radPrev[k]) * rate;
            radPrev[k] = q;
            // the jet out of the tail: its speed is the mean flow out (what the engine pushes through), puffing with
            // each pulse; turbulence that grows steeply with that speed
            qJet[k] += jetA * (q - qJet[k]);
            const float qm = fmaxf(qJet[k], 1.0e-5f);
            const float un = fminf(qm / tail[k].area * 0.025f, 4.0f);
            const float puff = fminf(fmaxf(q / (2.0f * qm), 0.0f), 1.6f);
            const float noise = jetN[k] * tnLp[k].lowpass(tnHp[k].highpass(noise.rnd()));
            rad += jetK * noiseTrim * un * un * un * puff * noise * 14400.0f * tail[k].area;
            if (k == 0)
                outL = rad;
            else
                outR = rad;
            pipe[k].write(pNear[k], pipe[k].far - pipe[k].z * q1);
            ch1[k].write(ch1[k].near + ch1[k].z * q1, ch1[k].far - ch1[k].z * q2);
            mid[k].write(mid[k].near + mid[k].z * q2, mid[k].far - mid[k].z * q3);
            ch2[k].write(ch2[k].near + ch2[k].z * q3, ch2[k].far - ch2[k].z * q4);
            tail[k].write(tail[k].near + tail[k].z * q4, b);
        }
        if (nDuals == 1)
            outR = outL;
        else
            cross.write(xNear, xFar);
        for (int k = 0; k < nb; ++k)
            sec[k].write(sNear[k], sFar[k]);
        // the intake: the runners open into the plenum (its pressure is what they see there; the highs go on into it)
        const float pg = pPlenum - 101325.0f;
        float qIn = 0.0f;
        for (int i = 0; i < np; ++i)
        {
            const float back = 0.5f * pg + endRun[i].tick(run[i].far - 0.5f * pg);
            qIn += (run[i].far - back) / run[i].z;
            prim[i].write(hNear[i], hFar[i]);
            run[i].write(rNear[i], back);
        }
        // the ecu.throttle fills the plenum from the air box (a diesel has none: its plate stands open, and the ecu.throttle is
        // its fuel)
        const float plate = fuelUse != 0 ? 1.0f : ecu.throttle;
        const float aT = aThrottle * (expf(1.8f * logf(fmaxf(plate, 1.0e-4f))) + 0.0006f) + (fuelUse != 0 ? 0.0f : aBypass * ecu.bypass);
        float mT = 0.0f;
        const float dp = pBox - pPlenum;
        if (dp > 0.0f)
        {
            const float rho = pBox / (287.0f * tAir);
            mT = aT * fminf(sqrtf(2.0f * rho * dp), 0.676f * pBox / sqrtf(287.0f * tAir));
        }
        else
            mT = -aT * sqrtf(-2.0f * (pPlenum / (287.0f * tAir)) * dp);
        mPlenum = fmaxf(mPlenum + (mT + qIn * pPlenum / (287.0f * tAir)) * dt, 1.0e-6f);
        pPlenum = mPlenum * 287.0f * tAir / vPlenum;
        qThr = mT * 287.0f * tAir / pBox;
        // the crank: torque, friction, the load, the starter. The friction is the rubbing and the accessories only (the
        // pumping is the gas exchange's, simulated): about 1.3 bar of mean pressure at 2000 rpm, 1.9 at 4800, 2.6 at
        // 6800, below the older correlation's 1.5, 2.6 and 3.7, which counted the pumping as well (with it, and 70 % of
        // the fuel's heat, a 1.5 L four made 95 N m where the real one makes 144; now some 120)
        // (the rubbing goes with the pistons' speed: a longer stroke's, BORE/STROKE, faster at the same revs)
        const float nk = rpm * 0.001f * strokeK;
        // (cold, its thick oil rubs more: as the thickness's 0.15th power, 1.4 times at 80 F, twice at 20 F, at most 3)
        const float fmep = (1.0f + 0.10f * nk + 0.02f * nk * nk) * 100000.0f * fminf(expf(0.15f * logf(heat.viscK)), 3.0f)
                           * (fuelUse != 0 ? 1.0f + 0.025f * fmaxf(smCR - 18.0f, 0.0f) : 1.0f);
        const float tf = fmep * vTotal * 0.0795775f * fminf(omega / 5.0f, 1.0f);
        heat.fricJ += tf * omega * dt;
        // (a supercharger takes what it pumps from the crank: its boost times the air it moves, at some 60 %)
        const float tsc = aspUse == 4 ? boost.boost * 1.0e5f * vTotal * (1.0f + boost.boost) * 0.1326f * fminf(omega / 5.0f, 1.0f) : 0.0f;
        const float tl = set.load * idleTq * (0.15f + 0.85f * (rpm / ecu.redRpm) * (rpm / ecu.redRpm));
        // (a cold battery gives less: 65 % at -40 F, all of it from 80 F)
        const float bat = 1.0f - 0.35f * (1.0f - fminf(fmaxf((heat.tAmb - 233.15f) / 66.85f, 0.0f), 1.0f));
        const float ts = ecu.starterOn * 4.5e5f * cyl[0].vd * expf(0.9f * logf(smCR / 10.0f)) * fmaxf(1.0f - omega / 30.0f, 0.0f) * bat;
        if (set.drive == 0)
        {
            const float j = jBase * expf(1.6094379f * (set.inertia - 0.5f)) * (1.0f + 5.0f * set.load);
            omega = fmaxf(omega + (torque - tf - tsc - tl + ts) / j * dt, 0.0f);
        }
        else
            omega = car.step(omega, torque - tf - tsc + ts, dt);      // (the car is the load: the load dial rests)
        tqMean += (torque - tqMean) * 0.0005f;
        tqNow = torque - tqMean;
        const float drop = fminf(fmaxf(1.0f - pPlenum / pBox, 0.0f), 1.0f);
        ex.tick(qThr, drop, omega * 0.15915494f, dps);
        boost.sound(omega * 0.15915494f, mdot, set.bov);
        ex.tickStarter(omega * 0.15915494f, ecu.starterOn);
    }

    // n of the host's samples, added into left and right: the engine's own when the host runs at its rate (96 kHz),
    // else its output resampled
    void render(float* left, float* right, int n)
    {
        if (ready == 0)
            return;
        if (listen.rsOn == 0)
        {
            renderAt(left, right, n);
            return;
        }
        for (int i = 0; i < n; ++i)
        {
            while (listen.needs())
            {
                renderAt(listen.rsBl, listen.rsBr, 16);
                listen.pushPart();
            }
            listen.resampled(left, right, i);
        }
    }

    // n of the engine's own samples, added into left and right
    void renderAt(float* left, float* right, int n)
    {
        idleTq = 0.6f * 1.0e6f * vTotal * 0.0795775f;     // about the torque at full load, for the load and the starter
        int at = 0;
        while (at < n)
        {
            const int m = n - at < 16 ? n - at : 16;
            // every 16 samples, the view and the dials as heard: another view (or layout, or size: control16) is taken
            // at the fade's quiet
            const int vw = set.view < 0 ? 0 : (set.view > 4 ? 4 : set.view);
            if (vw != vUse)
                cutWant |= 2;
            if (cutWant != 0 && cutG <= 0.0f)
            {
                // (a new engine fills its pipes over a few firings: it comes back slower, over 80 ms)
                cutUp = 1.0f / (((cutWant & 1) != 0 ? 0.08f : 0.012f) * rate);
                if ((cutWant & 1) != 0)
                    configure();
                vUse = vw;
                cutWant = 0;
            }
            const int v = vUse;
            listen.block(v, set.intake, set.mech, set.distance, set.room, set.level, aspUse, exTrim, gainNorm, nDuals,
                         lay.bike, lay.tailD);
            for (int i = 0; i < m; ++i)
            {
                if (tick16 == 0)
                    control16();
                tick16 += 1;
                if (tick16 == 16)
                    tick16 = 0;
                sampleTick();
                // the sources, as they are heard from here
                const float rd = set.drive != 0 ? car.road(v == 4 ? 0.45f : 1.0f) : 0.0f;
                // (the fade's gain eased: a smooth step)
                cutG = cutWant != 0 ? fmaxf(cutG - cutDn, 0.0f) : fminf(cutG + cutUp, 1.0f);
                listen.mix(i, outL, outR, ex.intake, tqNow, ex.mech, ex.block, boost.turbo, ex.starter, ex.comb, shell[0],
                           lay.topo == 0 ? shell[0] : shell[1], set.drive, rd, cutG);
            }
            listen.finish(left, right, at, m);
            at += m;
        }
        if (ecu.state != 0)
            quiet = 0.0f;
        else
            quiet += (float)n;
        // the panel's
        showRpm = rpm;
        showRed = ecu.redRpm;
        showGear = set.drive != 0 ? (float)car.gear : -2.0f;
        showKmh = set.drive != 0 ? car.kmh() : 0.0f;
        showThr = ecu.throttle;
        showMap = (pPlenum - 101325.0f) * 0.00001f;
        showLamps = (float)ecu.state + (ecu.limiting || comb.droop < 0.95f ? 4.0f : 0.0f) + (ecu.fuelCut && ecu.state == 2 ? 8.0f : 0.0f) + (set.drive != 0 ? 16.0f : 0.0f)
                    + 32.0f * floorf(fminf(fmaxf((heat.tCool - 273.15f) * 1.8f + 92.0f, 0.0f), 511.0f) + 0.5f)
                    + 16384.0f * floorf(fminf(heat.pOil / 6894.76f, 127.0f) + 0.5f) + (set.drive == 2 ? 2097152.0f : 0.0f);
        showPedals = 0.0f;
        if (set.drive != 0)
            showPedals = floorf(100.0f * fminf(fmaxf(set.brake, 0.0f), 1.0f) + 0.5f) + 1000.0f * floorf(100.0f * fminf(fmaxf(set.clutch, 0.0f), 1.0f) + 0.5f);
        // the cycle as it turns, eased toward a few a second at speed so the eye can follow the order
        const float cycHz = rpm / 60.0f * 360.0f / lay.cyc;
        const float visHz = cycHz < 2.4f ? cycHz : fminf(2.4f * expf(0.25f * logf(cycHz / 2.4f)), 4.0f);
        showCycle += visHz * (float)n * dt;
        showCycle -= floorf(showCycle);
        showBoost = boost.boost;
        showAir = (aspUse != 0 ? (float)aspUse + fminf(boost.smTb, 0.99f) : 0.0f)
                  + 10.0f * (floorf(66.0f * (smBs - 0.5f) + 0.5f) + 1.0f);
        showPipes = floorf(99.0f * fminf(fmaxf(smHdr, 0.0f), 1.0f) + 0.5f) * 10000.0f
                    + floorf(99.0f * fminf(fmaxf(smPipe, 0.0f), 1.0f) + 0.5f) * 100.0f
                    + floorf(99.0f * fminf(fmaxf(smXp, 0.0f), 1.0f) + 0.5f);
    }

    // Still sounding: the engine runs, or the room still rings after it stopped (or, driven, the car still rolls)
    bool audible()
    {
        return ecu.state != 0 || quiet < (0.4f + 2.2f * set.room + 0.3f) * rate || (set.drive != 0 && car.moving());
    }
};
