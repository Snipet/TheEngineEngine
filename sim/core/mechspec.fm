// mechspec.fm: the mechanics' settings, as card D appends them to spec.engine once the split (K3b) has landed.
//
// Until then this module stands in for that section, so the mechanics can be built and tested on their own: the field
// names, units and attributes are the ones they will have in sim/spec/engine.fm. With `custom` off (the default) none
// of them is read, and the engine is the reference's (its layout dial, its size and bore/stroke dials, its one friction
// curve). With `custom` on:
//
//   the layout is these cylinders: each one's bank, crank pin, firing revolution and place along the crank, and each
//   bank's angle (sim/core/layout.fm derives the firing angles from them); or, with `rotors` above 0, a rotary of that
//   many rotors, three faces each, its port timing in the four port fields;
//   the cylinder is `bore`, `stroke`, `rodLength` and `compression` (0: the reference's dials' derivation);
//   the moving masses are `pistonMass` (piston, pin and rings), `rodMass` and the share of the rod that moves with the
//   piston, and `flywheel` (the crank, flywheel and all that turns with them, kg m^2; 0: the reference's, by layout);
//   balance shafts cancel the first or second order's shaking force;
//   friction is by part (sim/core/friction.fm, Chen and Flynn's form), each coefficient a field;
//   `redline` (0: by piston speed, sim/core/layout.fm).
//
// Which changes are glided and which are made under the fade (02-contracts.md §2 rule 5): the layout, the cylinder's
// geometry and the masses are made under the fade (they change what the crank is); the friction coefficients, the
// accessories' loads and the balance shafts are glided (they only scale torques).
#pragma once

enum
{
    MECH_MAX_CYL = 16,      // cylinders (spec/limits.fm's MAX_CYL once K3 has written it)
    MECH_MAX_BANKS = 4,     // banks: a W engine's four
    MECH_MAX_ROTORS = 4     // a rotary's rotors (twelve faces: within MECH_MAX_CYL)
};

module MechSpec
{
    int rev [[ui::hidden]];
    bool custom [[fminus::default(0)]] [[ui::label("Custom engine")]]
        [[ui::help("Off: the reference's layouts and dials. On: the geometry, masses and friction below.")]];

    // ---- layout ----
    int cylinders [[fminus::range(1, 16)]] [[fminus::default(8)]] [[ui::label("Cylinders")]] [[ui::group("Layout")]];
    int rotors [[fminus::range(0, 4)]] [[fminus::default(0)]] [[ui::label("Rotors")]]
        [[ui::help("Above 0: a rotary of this many rotors, three faces each; the cylinders' fields are its rotors'.")]];
    float bankAngle [[fminus::range(-180, 180)]] [[ui::label("Bank angle")]] [[ui::unit("deg")]]
        [[ui::help("Each bank's cylinder axis from vertical, crank degrees in the direction it turns.")]] [MECH_MAX_BANKS];
    int bank [[fminus::range(0, 3)]] [[ui::label("Bank")]] [MECH_MAX_CYL];
    float pin [[fminus::range(0, 360)]] [[ui::label("Crank pin")]] [[ui::unit("deg")]]
        [[ui::help("Where the cylinder's crank pin sits on the crank at crank angle 0.")]] [MECH_MAX_CYL];
    int fireRev [[fminus::range(0, 1)]] [[ui::label("Fires on revolution")]] [[ui::choices("First", "Second")]] [MECH_MAX_CYL];
    float place [[fminus::range(0, 2)]] [[ui::label("Place along the crank")]] [[ui::quantity("length")]] [MECH_MAX_CYL];

    // ---- the cylinder ----
    float bore [[fminus::range(0, 0.25)]] [[fminus::default(0)]] [[ui::label("Bore")]] [[ui::quantity("length")]]
        [[ui::group("Cylinder")]] [[ui::help("0: from the size and bore/stroke dials, as the reference.")]];
    float stroke [[fminus::range(0, 0.25)]] [[fminus::default(0)]] [[ui::label("Stroke")]] [[ui::quantity("length")]];
    float rodLength [[fminus::range(0, 0.6)]] [[fminus::default(0)]] [[ui::label("Rod length")]] [[ui::quantity("length")]]
        [[ui::help("Centre to centre. 0: 3.3 times the crank's radius, the reference's.")]];
    float compression [[fminus::range(0, 25)]] [[fminus::default(0)]] [[ui::label("Compression")]] [[ui::quantity("ratio")]]
        [[ui::help("0: the reference's dial.")]];

    // ---- moving masses ----
    float pistonMass [[fminus::range(0, 20)]] [[fminus::default(0)]] [[ui::label("Piston, pin and rings")]]
        [[ui::quantity("mass")]] [[ui::group("Moving masses")]] [[ui::help("0: by the bore (sim/core/inertia.fm).")]];
    float rodMass [[fminus::range(0, 20)]] [[fminus::default(0)]] [[ui::label("Rod")]] [[ui::quantity("mass")]]
        [[ui::help("0: by the bore and stroke (sim/core/inertia.fm).")]];
    float rodRecip [[fminus::range(0, 1)]] [[fminus::default(0.333)]] [[ui::label("Rod's share moving with the piston")]]
        [[ui::quantity("fraction")]];
    float flywheel [[fminus::range(0, 5)]] [[fminus::default(0)]] [[ui::label("Crank and flywheel")]]
        [[ui::quantity("inertia")]] [[ui::help("0: the reference's, by layout and size.")]];
    bool balance1 [[fminus::default(0)]] [[ui::label("First-order balance shafts")]];
    bool balance2 [[fminus::default(0)]] [[ui::label("Second-order balance shafts")]];

    // ---- friction (Chen and Flynn: sim/core/friction.fm) ----
    float fricConst [[fminus::range(0, 200000)]] [[fminus::default(40000)]] [[ui::label("Constant")]]
        [[ui::quantity("pressure")]] [[ui::group("Friction")]] [[ui::help("Seals, the oil pump's base load.")]];
    float fricPeak [[fminus::range(0, 0.02)]] [[fminus::default(0.004)]] [[ui::label("Rings by peak pressure")]]
        [[ui::decimals(4)]] [[ui::help("Mean friction pressure per unit of peak cylinder pressure.")]];
    float fricSpeed [[fminus::range(0, 10000)]] [[fminus::default(2000)]] [[ui::label("Rings and skirts by piston speed")]]
        [[ui::unit("Pa s/m")]];
    float fricSpeed2 [[fminus::range(0, 1000)]] [[fminus::default(190)]] [[ui::label("Rings and skirts by piston speed squared")]]
        [[ui::unit("Pa s2/m2")]];
    float fricBearing [[fminus::range(0, 20000)]] [[fminus::default(3500)]] [[ui::label("Bearings, per 1000 rpm")]]
        [[ui::unit("Pa")]];
    int valvetrain [[fminus::range(0, 3)]] [[fminus::default(0)]] [[ui::label("Valvetrain")]]
        [[ui::choices("Flat tappet", "Roller", "Finger follower", "None")]];
    float alternator [[fminus::range(0, 5000)]] [[fminus::default(300)]] [[ui::label("Alternator load")]]
        [[ui::quantity("power")]];
    bool airCon [[fminus::default(0)]] [[ui::label("Air conditioner")]];

    // ---- redline ----
    float redline [[fminus::range(0, 2500)]] [[fminus::default(0)]] [[ui::label("Redline")]] [[ui::quantity("rotation")]]
        [[ui::group("Limits")]] [[ui::help("0: the layout's, or by piston speed for a custom engine.")]];

    // ---- a rotary's ports (degrees of the eccentric shaft; the face fires at 0) ----
    float portExOpen [[fminus::range(0, 1080)]] [[fminus::default(0)]] [[ui::label("Exhaust port opens")]]
        [[ui::unit("deg")]] [[ui::group("Rotary ports")]] [[ui::help("0: the reference's peripheral port, by the cam dial.")]];
    float portExDur [[fminus::range(0, 720)]] [[fminus::default(0)]] [[ui::label("Exhaust port open for")]] [[ui::unit("deg")]];
    float portInOpen [[fminus::range(0, 1080)]] [[fminus::default(0)]] [[ui::label("Intake port opens")]] [[ui::unit("deg")]];
    float portInDur [[fminus::range(0, 720)]] [[fminus::default(0)]] [[ui::label("Intake port open for")]] [[ui::unit("deg")]];
};
