// kinematics.fm: the slider-crank, the piston's motion as the crank turns it.
//
// A crank of radius r (half the stroke) turns; a rod of length l joins its pin to the piston's, which slides along the
// cylinder's axis. With theta the crank's angle from the cylinder's top dead centre and lambda = l / r, the piston's
// distance down from top dead centre is
//
//     x      = r (1 - cos t + lambda - q),                    q = sqrt(lambda^2 - sin^2 t)
//     dx/dt  = r sin t (1 + cos t / q)
//     d2x/dt2 = r (cos t + (cos^2 t - sin^2 t) / q + sin^2 t cos^2 t / q^3)
//
// (exact: the textbook series cos t + cos 2t / lambda is their first two orders, sim/core/shake.fm). The volume over the
// piston is the clearance volume plus the bore's area times x; dV/dt is the area times dx/dt, the reference's
// Cylinder::volumeSlope exactly (sim/ref/cylinder.fm: its `rr` is lambda, its 0.5 vd is the area times r). Derivatives
// are per radian of the crank.
//
// What it leaves out: the piston pin's offset from the bore's axis (desaxé), the rod's and crank's stretch, the
// bearings' clearances.
#pragma once

module SliderCrank
{
    float r;        // the crank's radius (half the stroke), m
    float l;        // the rod, centre to centre, m
    float lam;      // l over r
    float area;     // the bore's, m^2
    float vd;       // swept volume, m^3
    float vc;       // clearance volume, m^3
    // at the last angle asked
    float x;
    float dx;
    float ddx;
    float vol;
    float dvol;

    void setup(float bore, float stroke, float rod, float compression)
    {
        r = 0.5f * stroke;
        l = rod;
        lam = l / r;
        area = 0.78539816f * bore * bore;
        vd = area * stroke;
        vc = vd / (compression - 1.0f);
    }

    // The motion at a crank angle given by its sine and cosine (from the cylinder's top dead centre)
    void at(float s, float c)
    {
        const float q = sqrtf(lam * lam - s * s);
        const float iq = 1.0f / q;
        x = r * (1.0f - c + lam - q);
        dx = r * s * (1.0f + c * iq);
        ddx = r * (c + (c * c - s * s) * iq + s * s * c * c * iq * iq * iq);
        vol = vc + area * x;
        dvol = area * dx;
    }

    // The same at an angle in degrees
    void atDeg(float a)
    {
        const float t = a * 0.01745329252f;
        at(sinf(t), cosf(t));
    }
};
