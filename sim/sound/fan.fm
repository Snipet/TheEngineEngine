// sound/fan.fm: the radiator's cooling fan (module FanVoice): a viscous-clutch fan on the water pump's shaft, or an
// electric one, its roar coming and going with the coolant's temperature.
//
// A viscous clutch couples the fan to the pump's pulley (1.1 times the crank here) through a silicone fluid let in by
// a bimetal spring in the air leaving the radiator: cold it slips, the fan turning at some 25 % of its drive; hot (at
// `fanOn` and above) it locks to some 90 %; between, in proportion over the 15 K below. The fluid takes some seconds
// to fill and drain (a time constant of 4 s here). The famous roar is a locked clutch at high revs, and it fades as
// the clutch lets go (Horton's and Behr's descriptions of the thermostatic clutch; the numbers are typical ones,
// judgement). An electric fan switches on at `fanOn` (373 K, 100 C, by default) and off 5 K lower, as a thermo switch's
// two contacts do (cited: the Mahle Behr 0065453924 switch, on at 100 C and off at 95 C; others run 5 to 11 K apart,
// docs/measurements/2026-11-25-0032-judgement-sources.md): the hosts' warm hold (368 K, tee/Warm.h) sits at the off point, 5 K under the on, so a warm render
// has the fan off unless the coolant climbs past 373 K by itself (with the on point at 368 the hold's few hundredths of
// a kelvin either side decided whether a 280 Hz line was in the render: the lead's 21:47). Its motor takes it to
// 2400 rpm in about a second (time constant 0.35 s) and lets it coast down in some three (1.2 s).
//
// What it sounds like (Neise, "Noise reduction in centrifugal fans", and the axial fan's literature): rushing air with
// a tone inside it. The broadband noise of the turbulence off the blades, whose sound power rises as the tip speed's
// fifth to sixth power: amplitude here as (U / U0)^2.75, shaped into a band an octave or so about twice the blade
// pass, falling 18 dB an octave above eight times it (a fan's broadband spectrum falls steeply above its peak; a band
// at four times with 6 dB an octave left a 2400 rpm fan's 8 kHz octave 3 dB under the whole idling exhaust's, the
// owner's 21:32 report). The blades' passing, with its harmonic: the blades are unevenly spaced, as automotive cooling
// fans are made (SAE 2008-01-0569, Lee and Nam, "Development of Low-Noise Cooling Fan Using Uneven Fan Blade Spacing";
// the size of the effect here is this model's own geometry, FAN_SPREAD, judgement), so the blade pass's energy is
// spread over the shaft orders beside it (makeLines). The tone's level against the rush is judgement, set by the
// lead's ruling of 25 Nov: every one of its lines at least 10 dB under the fan's own rush in its third octave
// (tests/sim/sound/FrontTest.cpp, "fan: an electric fan running"; at even spacing and the old level, 0.004, the
// 280 Hz line stood 9 to 22 dB over everything in its third octave at the cameras: the owner's hum whenever the fan ran). An electric fan's motor adds its
// commutator's ripple (8 segments, faint). Tip speed at the fan's 0.4 m across.
#pragma once
#include "lib/biquad.fm"
#include "lib/noise.fm"
#include "osc.fm"

// how far a blade sits from its even place, at most, as a share of the pitch (judgement: see makeLines)
const float FAN_SPREAD = 0.25f;
// the tone's amplitude at a 40 m/s tip (was 0.004) and the rush's band's centre in blade passes (was 4): judgement, so
// that the tone sits 10 dB under the fan's own rush in its third octaves (the lead's ruling, 25 Nov)
const float FAN_TONE = 0.0001f;
const float FAN_RUSH_AT = 2.0f;

enum
{
    FAN_NONE = 0,
    FAN_VISCOUS = 1,
    FAN_ELECTRIC = 2,
};

module FanVoice
{
    float rate;
    float dt;
    Noise noise;
    SineTable* sn;
    float nScale;
    Shaft fan;
    Biquad broad;
    Biquad soft;        // the broadband's fall above its band
    float hz;           // the fan's turns a second, every 16 samples
    float hzStep;
    float hzSet;        // its speed now (the clutch's, the motor's)
    float lock;         // a viscous clutch's share, 0.25 to 0.9
    int on;             // an electric fan's switch
    int fromHeat;       // 1: the switch and the clutch are Heat's (Engine hands them over every 16 samples: card D, the
    int heatOn;         // lead's ruling, 24 Nov: the thermoswitch a physical state, so the fan cools what switched it on);
    float heatLock;     // 0: its own, as below (a rig with no engine)
    float blades;
    float bladesSeen;   // the blades the lines below were made for
    int kMin;           // the tone's lowest shaft order
    int kMax;           // and its highest
    float ordSin[28];   // the tone's weights by shaft order (from the blades' places): its sine's
    float ordCos[28];   // and its cosine's
    Glide aTone;
    Glide aNoise;
    float motor;        // an electric fan's motor ripple's share
    // out
    float out;

    void setup(float rateIn, SineTable* table)
    {
        rate = rateIn;
        dt = 1.0f / rate;
        sn = table;
        noise.rs = 161803;
        nScale = sqrtf(rate / 48000.0f);
        clear();
    }

    void clear()
    {
        broad.clear();
        soft.clear();
        aTone.clear();
        aNoise.clear();
        hz = 0.0f;
        hzStep = 0.0f;
        hzSet = 0.0f;
        lock = 0.25f;
        on = 0;
        fromHeat = 0;
        heatOn = 0;
        heatLock = 0.25f;
        blades = 7.0f;
        bladesSeen = 0.0f;
        kMin = 1;
        kMax = 0;
        for (int i = 0; i < 28; ++i)
        {
            ordSin[i] = 0.0f;
            ordCos[i] = 0.0f;
        }
        motor = 0.0f;
        out = 0.0f;
    }

    bool turning()
    {
        return hzSet > 0.5f;
    }

    // The air it draws through the radiator, as a share of an electric fan's at full speed (its flow goes as its
    // speed): for card D's heat model, so that the fan cools what switched it on (sim/README.md, the hooks)
    float air()
    {
        return fminf(hzSet / 40.0f, 1.5f);
    }

    // Every 16 samples. d16: seconds; kind: FAN_*; crankHz; coolant (K); onAt (K); nBlades; k: its gain; power: the
    // car's electrics live (the key on), for an electric fan
    void control(float d16, int kind, float crankHz, float coolant, float onAt, int nBlades, float k, int power)
    {
        blades = (float)nBlades;
        float want = 0.0f;
        if (kind == FAN_VISCOUS)
        {
            const float x = fminf(fmaxf((coolant - (onAt - 15.0f)) / 15.0f, 0.0f), 1.0f);
            const float lockWant = 0.25f + 0.65f * x;
            lock += (lockWant - lock) * (1.0f - expf(-d16 / 4.0f));
            if (fromHeat != 0)
                lock = heatLock;
            want = 1.1f * crankHz * lock;
            hzSet = want;
            motor = 0.0f;
        }
        else if (kind == FAN_ELECTRIC)
        {
            if (power == 0 || coolant < onAt - 5.0f)
                on = 0;
            else if (coolant >= onAt)
                on = 1;
            if (fromHeat != 0)
                on = heatOn;
            want = on != 0 ? 40.0f : 0.0f;
            const float tau = on != 0 ? 0.35f : 1.2f;
            hzSet += (want - hzSet) * (1.0f - expf(-d16 / tau));
            if (hzSet < 0.5f && on == 0)
                hzSet = 0.0f;
            motor = on != 0 ? 1.0f : 0.0f;
        }
        else
        {
            hzSet = 0.0f;
            motor = 0.0f;
        }
        hzStep = (hzSet - hz) * 0.0625f;
        if (blades != bladesSeen)
            makeLines();
        // the tip's speed over 40 m/s, (0.4 m across: pi 0.4 a turn)
        const float u = hzSet * 1.2566371f / 40.0f;
        const float lu = u > 1.0e-4f ? expf(2.75f * logf(u)) : 0.0f;
        const float fb = fmaxf(blades * hzSet, 20.0f);
        broad.setBandpass(fminf(FAN_RUSH_AT * fb, 6000.0f), 0.5f, rate);
        soft.setLowpass(fminf(8.0f * fb, 12000.0f), 0.707f, rate);
        aTone.to(k * FAN_TONE * fminf(lu, 16.0f));
        aNoise.to(k * 0.012f * fminf(lu, 16.0f));
    }

    // The tone's lines from the blades' places (when the count changes). Blade i of B sits at (i + d_i) / B of a turn,
    // d_i = SPREAD sin(2 pi i / B) of a pitch: an uneven, sinusoidally modulated spacing. Each blade's pressure pulse
    // repeats once a turn, so the tone is a sum over shaft orders k of h(k) |c_k| sin(2 pi k phase + arg c_k) (kept as a sine's and a cosine's weights), with
    // c_k = (1 / B) sum_i exp(i 2 pi k (i + d_i) / B): evenly spaced (SPREAD 0) only k = B, 2B, ... are left and this is
    // the even fan's line at the blade pass and its harmonic; uneven, the blade pass's energy spreads to the orders
    // beside it (the cooling fan's uneven spacing: SAE 2008-01-0569). h(k) the pulse's own spectrum: 1 about the
    // blade pass, 0.4 about twice it. The orders kept: B - 2 to B + 2 and 2B - 2 to 2B + 2 (to order 27; the next ones out are some 23 dB down at
    // this spacing).
    void makeLines()
    {
        bladesSeen = blades;
        const int b = (int)(blades + 0.5f) < 2 ? 2 : ((int)(blades + 0.5f) > 12 ? 12 : (int)(blades + 0.5f));
        kMin = b - 2 < 1 ? 1 : b - 2;
        kMax = 0;
        for (int i = 0; i < 28; ++i)
        {
            ordSin[i] = 0.0f;
            ordCos[i] = 0.0f;
        }
        for (int h = 1; h <= 2; ++h)
        {
            for (int j = -2; j <= 2; ++j)
            {
                const int k = h * b + j;
                if (k < 1 || k > 27 || (h == 2 && k <= b + 2))
                    continue;
                float re = 0.0f;
                float im = 0.0f;
                for (int i = 0; i < b; ++i)
                {
                    const float d = FAN_SPREAD * sinf(6.28318531f * (float)i / (float)b);
                    const float th = 6.28318531f * (float)k * ((float)i + d) / (float)b;
                    re += cosf(th);
                    im += sinf(th);
                }
                re /= (float)b;
                im /= (float)b;
                // (h |c_k| sin(x + arg c_k) = h re sin x + h im cos x; a line under 1 % is left out)
                const float w = h == 1 ? 1.0f : 0.4f;
                if (sqrtf(re * re + im * im) < 0.01f)
                    continue;
                ordSin[k] = w * re;
                ordCos[k] = w * im;
                if (k > kMax)
                    kMax = k;
            }
        }
    }

    void tick()
    {
        hz += hzStep;
        fan.turn(hz, dt);
        const float at = aTone.next();
        const float an = aNoise.next();
        out = 0.0f;
        if (at != 0.0f || an != 0.0f)
        {
            // (the shaft's orders by rotation from the lowest kept one: four table reads a sample, not two a line)
            const float s1 = sn->at(fan.ph);
            const float c1 = sn->cosAt(fan.ph);
            const float x0 = (float)kMin * fan.ph;
            float sk = sn->at(x0);
            float ck = sn->cosAt(x0);
            float tone = 0.0f;
            for (int k = kMin; k <= kMax; ++k)
            {
                tone += ordSin[k] * sk + ordCos[k] * ck;
                const float sn1 = sk * c1 + ck * s1;
                ck = ck * c1 - sk * s1;
                sk = sn1;
            }
            out = at * (tone + 0.05f * motor * sn->at(fan.mesh(8.0f))) + an * soft.tick(broad.tick(nScale * noise.rnd()));
        }
    }
};
