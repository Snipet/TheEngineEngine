// sound/extras.fm: what an engine sounds like besides its exhaust (module Extras): the intake, the valvetrain and
// injectors, the block, the starter (the turbos' and a supercharger's sounds are Boost's: boost/boost.fm). Each is driven by what the engine model does (flows,
// pressures, events), not by a clock of its own, so it follows the engine wherever it goes.
//
// Package M (spec.voices, sound/voices.fm): with spec.voices.model 0 (the default) this is the reference's engine bay,
// bit for bit: nothing below that names `vo` runs, and no draw of `noise` moves. With model 1 the mechanical voices
// (`Voices vo`: the gearbox and the final drive, the belts and the cam drive, the fan, the fuel pump and direct
// injectors, the lifters' tick and the valves' float, the wastegate, the starter) are added to `mech`, the starter's
// replaces the reference's, each voice also kept as an output of its own (vo.gearbox, vo.axle, vo.front, vo.head,
// vo.tank, vo.gateOut, vo.starter) for the listener. Their inputs come every 16 samples through control16.
#pragma once
#include "lib/biquad.fm"
#include "lib/onepole.fm"
#include "lib/noise.fm"
#include "sound/voices.fm"

module Extras
{
    float rate;
    Noise noise;        // its own stream, which Boost's sounds draw from too (in the reference's order)
    float nScale;       // white noise's strength for the same loudness at any sample rate
    // the intake: the air box's resonance between the throttle and the snorkel; the throttle's hiss
    Biquad box;
    Biquad hiss;
    float qBoxPrev;
    // the valvetrain and the injectors: clicks ringing in the head, the cam cover and the injector bodies
    Biquad vres[3];
    Biquad ires[2];
    float vKick;
    float iKick;
    // the block: the combustion's sharpness rings its walls
    Biquad bres[2];
    // the pistons' slap at each top dead centre, near 1.5 kHz in the block (Lyon et al.); a direct-injection engine's
    // high-pressure pump, ticking three strokes a turn of its cam
    Biquad sres;
    float sKick;
    // knock: the end gas lighting on its own rings the cylinder's gas at its first circumferential modes (some 6 and
    // 10 kHz in a car's bore): the ping
    Biquad kres[2];
    float kKick;
    // a diesel's clatter: its premixed burn's sudden pressure rise strikes the head and the block, ringing their panels'
    // modes (some 0.9 to 4.8 kHz in a car's, lower in a truck's), each a little differently each time, with a rattle
    Biquad cres[6];
    float cKick;
    float cKw[6];
    Biquad cnoise;
    float cEnv;
    float cDecay;
    int cOn;
    Biquad pres;
    float pumpPh;
    float pumpOn;       // the pump's tick (0: none), set with the layout
    // the timing chain's whine
    float chainPh;
    // the starter
    float stPh;
    Biquad stres;
    // what came out this sample
    float intake;
    float mech;
    float block;
    float comb;         // the combustion's own noise: the knock, a diesel's clatter
    float starter;
    // package M's voices (spec.voices.model 1)
    VoicesSpec* vs;
    Voices vo;
    int voOn;           // 1: the voices run (model 1, or gliding out)
    int voFade;         // 1: model 0 asked, the voices gliding out this block

    void setup(float rateIn, float boxHz, VoicesSpec* voicesSpec)
    {
        rate = rateIn;
        vs = voicesSpec;
        vo.setup(rate);
        voOn = 0;
        voFade = 0;
        noise.rs = 424242;
        nScale = sqrtf(rate / 48000.0f);
        box.setLowpass(boxHz, 2.2f, rate);
        hiss.setBandpass(2600.0f, 0.7f, rate);
        vres[0].setBandpass(2300.0f, 14.0f, rate);
        vres[1].setBandpass(3900.0f, 18.0f, rate);
        vres[2].setBandpass(6400.0f, 22.0f, rate);
        ires[0].setBandpass(7200.0f, 25.0f, rate);
        ires[1].setBandpass(10500.0f, 30.0f, rate);
        bres[0].setBandpass(1100.0f, 6.0f, rate);
        bres[1].setBandpass(2600.0f, 8.0f, rate);
        sres.setBandpass(1500.0f, 5.0f, rate);
        kres[0].setBandpass(6200.0f, 30.0f, rate);
        kres[1].setBandpass(9600.0f, 25.0f, rate);
        pres.setBandpass(3400.0f, 16.0f, rate);
        sKick = 0.0f;
        pumpPh = 0.0f;
        stres.setBandpass(420.0f, 3.0f, rate);
        qBoxPrev = 0.0f;
    }

    void clear()
    {
        box.clear();
        hiss.clear();
        for (int i = 0; i < 3; ++i)
            vres[i].clear();
        ires[0].clear();
        ires[1].clear();
        bres[0].clear();
        bres[1].clear();
        sres.clear();
        kres[0].clear();
        kres[1].clear();
        for (int j = 0; j < 6; ++j)
            cres[j].clear();
        cnoise.clear();
        cKick = 0.0f;
        cEnv = 0.0f;
        pres.clear();
        stres.clear();
        vo.clear();
    }

    // The voices make a sound (the fuel pump's prime, a fan, the starter running down): Engine renders while so
    bool busy()
    {
        return voOn != 0 && vo.busy();
    }

    // Every 16 samples (Engine::control16, last): the voices' inputs. Nothing happens with spec.voices.model 0 and the
    // voices silent. d16: seconds; ignition: ctl.ignition; state: the engine's; crankHz; coolant (K); driven: a vehicle
    // (0 on the bench); boxKind: BOX_* (the reference's car: a manual); truck; gear (-1 R, 0 N, 1 up); wIn: the
    // gearbox's input (rad/s); ratioTotal: crank turns to the wheels' in this gear (0 in N); fd: the final drive; wOut:
    // the propshaft's speed (rad/s); torque, peak: the brake torque and the engine's most (N m); engaged: the clutch (0
    // out, 1 in); asp: the induction (0 natural, 1 to 3 turbos, 4 a supercharger); boostShare: its boost over its most;
    // gateOpen: the wastegate's opening (0 to 1); gateExternal; flowShare: the exhaust's mass flow over its most;
    // cylinders, cycleDeg: the layout's; clatter: the valves' float (card E, 0 to 1); displacement (m^3); diesel
    void control16(float d16, int ignition, int state, float crankHz, float coolant, int driven, int boxKind, int truck,
                   int gearIn, float wIn, float ratioTotal, float fd, float wOut, float torque, float peak, float engaged,
                   int asp, float boostShare, float gateOpen, int gateExternal, float flowShare, int cylinders,
                   float cycleDeg, float clatter, float displacement, int diesel)
    {
        if (vs->model == 0)
        {
            if (voOn == 0)
                return;
            if (voFade != 0)
            {
                // glided out over the last 16 samples: stop
                voOn = 0;
                voFade = 0;
                vo.clear();
                return;
            }
            voFade = 1;
        }
        else
        {
            if (voOn == 0)
                vo.clear();
            voOn = 1;
            voFade = 0;
        }
        vo.control16(vs, voFade != 0 ? 0.0f : 1.0f, d16, ignition, state, crankHz, coolant, driven, boxKind, truck, gearIn, wIn,
                     ratioTotal, fd, wOut, torque, peak, engaged, asp, boostShare, gateOpen, gateExternal, flowShare, cylinders,
                     cycleDeg, clatter, displacement, diesel);
    }

    // A valve came down on its seat (amp 0 to 1; intake: 1 an intake valve, 0 an exhaust valve), an injector opened
    void valveClick(float amp, int intake)
    {
        vKick += amp * (0.7f + 0.3f * noise.rnd());
        if (voOn != 0)
            vKick += vo.valve.landed(amp, intake);
    }

    void injectorClick(float amp)
    {
        // (a gasoline engine's direct injector: package M's; a diesel's and a port injector's, the reference's)
        if (voOn != 0 && vo.direct != 0 && cOn == 0)
        {
            vo.fuel.directClick(amp * 3.3333333f * vo.kInj);
            return;
        }
        iKick += amp;
    }

    // The end gas knocked (amp: how hard)
    void knockClick(float amp)
    {
        kKick += amp;
    }

    // The engine: a diesel's or not, and its cylinders' size (m^3): its clatter's modes, lower in a bigger engine
    void setClatter(int diesel, float swept)
    {
        cOn = diesel;
        const float fs = expf(0.16666667f * logf(0.0005f / fmaxf(swept, 3.0e-5f)));
        const float cf[6] = {900.0f, 1350.0f, 1900.0f, 2600.0f, 3500.0f, 4800.0f};
        const float cq[6] = {8.0f, 9.0f, 10.0f, 10.0f, 12.0f, 12.0f};
        for (int j = 0; j < 6; ++j)
            cres[j].setBandpass(cf[j] * fs, cq[j], rate);
        cnoise.setBandpass(2400.0f * fs, 0.9f, rate);
        cDecay = expf(-1.0f / (0.0016f * rate));
    }

    // A diesel's premixed burn began (amp: how sharply its pressure rises)
    void clatterClick(float amp)
    {
        cKick += amp;
        for (int j = 0; j < 6; ++j)
            cKw[j] = 0.55f + 0.45f * fabsf(noise.rnd());
    }

    // A piston slapped its bore (amp: how hard)
    void slapClick(float amp)
    {
        sKick += amp;
    }

    // One sample of all of it. qThrottle: the volume flow through the throttle (m^3/s); dropRatio: how much of the
    // pressure the throttle drops (0 wide open, near 1 shut at speed); crankHz: the crank's turns a second; dpdt: the
    // cylinders' pressure rise this sample (Pa). Boost's sound follows, then tickStarter.
    void tick(float qThrottle, float dropRatio, float crankHz, float dpdt)
    {
        // (the voices' valve taps and bounces due this sample join the head's ring)
        if (voOn != 0)
        {
            vo.valve.tick(crankHz * 360.0f / rate);
            vKick += vo.valve.bounce;
        }
        // the intake: the air box rings between the throttle and the snorkel; what the snorkel lets out is its sound
        const float qb = box.tick(qThrottle);
        intake = (qb - qBoxPrev) * rate * 0.02f;
        qBoxPrev = qb;
        intake += 0.9f * qThrottle * dropRatio * dropRatio * hiss.tick(nScale * noise.rnd());
        // the valvetrain and the injectors
        float v = 0.0f;
        if (vKick != 0.0f)
        {
            v = vKick;
            vKick = 0.0f;
        }
        float ij = 0.0f;
        if (iKick != 0.0f)
        {
            ij = iKick;
            iKick = 0.0f;
        }
        mech = vres[0].tick(v) + 0.8f * vres[1].tick(v) + 0.5f * vres[2].tick(v) + 0.6f * (ires[0].tick(ij) + 0.7f * ires[1].tick(ij));
        // the timing chain: a faint whine at the sprocket's teeth (21 a turn of the crank)
        chainPh += 21.0f * crankHz / rate;
        if (chainPh >= 1.0f)
            chainPh -= floorf(chainPh);
        const float cr = fminf(crankHz / 100.0f, 1.0f);
        const float chain = 0.004f * cr * cr * sinf(6.28318531f * chainPh);
        if (voOn == 0 || vo.timing == 0)
            mech += chain;
        // the block: the burn's pressure rise knocks on its walls
        const float k = dpdt * 2.0e-6f;
        block = bres[0].tick(k) + 0.6f * bres[1].tick(k);
        float sk = 0.0f;
        if (sKick != 0.0f)
        {
            sk = sKick;
            sKick = 0.0f;
        }
        block += 0.38f * sres.tick(sk);
        float kk = 0.0f;
        if (kKick != 0.0f)
        {
            kk = kKick;
            kKick = 0.0f;
        }
        // (the ping, some 15 dB over the block's own ring: heard over the bonnet, faintly behind the car)
        comb = 9.0f * (kres[0].tick(kk) + 0.5f * kres[1].tick(kk));
        if (cOn != 0)
        {
            float ck = 0.0f;
            if (cKick != 0.0f)
            {
                ck = cKick;
                cKick = 0.0f;
                cEnv = fmaxf(cEnv, ck);
            }
            float cs = 0.0f;
            for (int j = 0; j < 6; ++j)
                cs += cres[j].tick(ck * cKw[j]);
            cEnv *= cDecay;
            comb += 2.5f * (cs + 0.004f * cEnv * cnoise.tick(nScale * noise.rnd()));
        }
        // the pump: 1.5 strokes a turn of the crank, a click at each
        pumpPh += 1.5f * crankHz / rate;
        float pk = 0.0f;
        if (pumpPh >= 1.0f)
        {
            pumpPh -= floorf(pumpPh);
            pk = pumpOn;
            if (voOn != 0 && cOn == 0)
                pk = vo.hpPump;
        }
        mech += 0.6f * pres.tick(pk);
        if (voOn != 0)
        {
            vo.tick(crankHz);
            mech += vo.all;
        }
    }

    // Then, after Boost's sound (which draws from the same noise): the starter
    void tickStarter(float crankHz, float starterOn)
    {
        // the starter: its motor's buzz and its pinion's teeth on the ring gear
        starter = 0.0f;
        if (starterOn > 0.0f)
        {
            const float fa = fmaxf(crankHz, 1.0f) * 11.0f;            // the armature, through the reduction
            stPh += fa / rate;
            if (stPh >= 1.0f)
                stPh -= floorf(stPh);
            const float saw = 2.0f * stPh - 1.0f;
            starter = 0.05f * (saw - saw * saw * saw) + 0.02f * stres.tick(nScale * noise.rnd()) + 0.03f * sinf(6.28318531f * 9.0f * stPh);
        }
        // (package M's starter in place of it; the reference's draw above kept, so the stream Boost shares is as it was)
        if (voOn != 0)
        {
            vo.start.tick(crankHz, starterOn);
            vo.starter = vo.start.out;
            starter = vo.starter;
        }
    }
};
