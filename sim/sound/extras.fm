// sound/extras.fm: what an engine sounds like besides its exhaust (module Extras): the intake, the valvetrain and
// injectors, the block, the starter (the turbos' and a supercharger's sounds are Boost's: boost/boost.fm). Each is driven by what the engine model does (flows,
// pressures, events), not by a clock of its own, so it follows the engine wherever it goes.
#pragma once
#include "lib/biquad.fm"
#include "lib/onepole.fm"
#include "lib/noise.fm"

module Extras
{
    float rate;
    Noise noise;        // its own stream, which Boost's sounds draw from too (in the reference's order)
    float nScale;       // white noise's strength for the same loudness at any sample rate
    // the intake: the air box's resonance between the throttle and the snorkel; the throttle's hiss
    Biquad box;
    Biquad hiss;
    float qBoxPrev;
    // the valvetrain and the injectors: clicks ringing in the head, the cam cover and the injector bodies
    Biquad vres[3];
    Biquad ires[2];
    float vKick;
    float iKick;
    // the block: the combustion's sharpness rings its walls
    Biquad bres[2];
    // the pistons' slap at each top dead centre, near 1.5 kHz in the block (Lyon et al.); a direct-injection engine's
    // high-pressure pump, ticking three strokes a turn of its cam
    Biquad sres;
    float sKick;
    // knock: the end gas lighting on its own rings the cylinder's gas at its first circumferential modes (some 6 and
    // 10 kHz in a car's bore): the ping
    Biquad kres[2];
    float kKick;
    // a diesel's clatter: its premixed burn's sudden pressure rise strikes the head and the block, ringing their panels'
    // modes (some 0.9 to 4.8 kHz in a car's, lower in a truck's), each a little differently each time, with a rattle
    Biquad cres[6];
    float cKick;
    float cKw[6];
    Biquad cnoise;
    float cEnv;
    float cDecay;
    int cOn;
    Biquad pres;
    float pumpPh;
    float pumpOn;       // the pump's tick (0: none), set with the layout
    // the timing chain's whine
    float chainPh;
    // the starter
    float stPh;
    Biquad stres;
    // what came out this sample
    float intake;
    float mech;
    float block;
    float comb;         // the combustion's own noise: the knock, a diesel's clatter
    float starter;

    void setup(float rateIn, float boxHz)
    {
        rate = rateIn;
        noise.rs = 424242;
        nScale = sqrtf(rate / 48000.0f);
        box.setLowpass(boxHz, 2.2f, rate);
        hiss.setBandpass(2600.0f, 0.7f, rate);
        vres[0].setBandpass(2300.0f, 14.0f, rate);
        vres[1].setBandpass(3900.0f, 18.0f, rate);
        vres[2].setBandpass(6400.0f, 22.0f, rate);
        ires[0].setBandpass(7200.0f, 25.0f, rate);
        ires[1].setBandpass(10500.0f, 30.0f, rate);
        bres[0].setBandpass(1100.0f, 6.0f, rate);
        bres[1].setBandpass(2600.0f, 8.0f, rate);
        sres.setBandpass(1500.0f, 5.0f, rate);
        kres[0].setBandpass(6200.0f, 30.0f, rate);
        kres[1].setBandpass(9600.0f, 25.0f, rate);
        pres.setBandpass(3400.0f, 16.0f, rate);
        sKick = 0.0f;
        pumpPh = 0.0f;
        stres.setBandpass(420.0f, 3.0f, rate);
        qBoxPrev = 0.0f;
    }

    void clear()
    {
        box.clear();
        hiss.clear();
        for (int i = 0; i < 3; ++i)
            vres[i].clear();
        ires[0].clear();
        ires[1].clear();
        bres[0].clear();
        bres[1].clear();
        sres.clear();
        kres[0].clear();
        kres[1].clear();
        for (int j = 0; j < 6; ++j)
            cres[j].clear();
        cnoise.clear();
        cKick = 0.0f;
        cEnv = 0.0f;
        pres.clear();
        stres.clear();
    }

    // A valve came down on its seat (amp 0 to 1), an injector opened
    void valveClick(float amp)
    {
        vKick += amp * (0.7f + 0.3f * noise.rnd());
    }

    void injectorClick(float amp)
    {
        iKick += amp;
    }

    // The end gas knocked (amp: how hard)
    void knockClick(float amp)
    {
        kKick += amp;
    }

    // The engine: a diesel's or not, and its cylinders' size (m^3): its clatter's modes, lower in a bigger engine
    void setClatter(int diesel, float swept)
    {
        cOn = diesel;
        const float fs = expf(0.16666667f * logf(0.0005f / fmaxf(swept, 3.0e-5f)));
        const float cf[6] = {900.0f, 1350.0f, 1900.0f, 2600.0f, 3500.0f, 4800.0f};
        const float cq[6] = {8.0f, 9.0f, 10.0f, 10.0f, 12.0f, 12.0f};
        for (int j = 0; j < 6; ++j)
            cres[j].setBandpass(cf[j] * fs, cq[j], rate);
        cnoise.setBandpass(2400.0f * fs, 0.9f, rate);
        cDecay = expf(-1.0f / (0.0016f * rate));
    }

    // A diesel's premixed burn began (amp: how sharply its pressure rises)
    void clatterClick(float amp)
    {
        cKick += amp;
        for (int j = 0; j < 6; ++j)
            cKw[j] = 0.55f + 0.45f * fabsf(noise.rnd());
    }

    // A piston slapped its bore (amp: how hard)
    void slapClick(float amp)
    {
        sKick += amp;
    }

    // One sample of all of it. qThrottle: the volume flow through the throttle (m^3/s); dropRatio: how much of the
    // pressure the throttle drops (0 wide open, near 1 shut at speed); crankHz: the crank's turns a second; dpdt: the
    // cylinders' pressure rise this sample (Pa). Boost's sound follows, then tickStarter.
    void tick(float qThrottle, float dropRatio, float crankHz, float dpdt)
    {
        // the intake: the air box rings between the throttle and the snorkel; what the snorkel lets out is its sound
        const float qb = box.tick(qThrottle);
        intake = (qb - qBoxPrev) * rate * 0.02f;
        qBoxPrev = qb;
        intake += 0.9f * qThrottle * dropRatio * dropRatio * hiss.tick(nScale * noise.rnd());
        // the valvetrain and the injectors
        float v = 0.0f;
        if (vKick != 0.0f)
        {
            v = vKick;
            vKick = 0.0f;
        }
        float ij = 0.0f;
        if (iKick != 0.0f)
        {
            ij = iKick;
            iKick = 0.0f;
        }
        mech = vres[0].tick(v) + 0.8f * vres[1].tick(v) + 0.5f * vres[2].tick(v) + 0.6f * (ires[0].tick(ij) + 0.7f * ires[1].tick(ij));
        // the timing chain: a faint whine at the sprocket's teeth (21 a turn of the crank)
        chainPh += 21.0f * crankHz / rate;
        if (chainPh >= 1.0f)
            chainPh -= floorf(chainPh);
        const float cr = fminf(crankHz / 100.0f, 1.0f);
        mech += 0.004f * cr * cr * sinf(6.28318531f * chainPh);
        // the block: the burn's pressure rise knocks on its walls
        const float k = dpdt * 2.0e-6f;
        block = bres[0].tick(k) + 0.6f * bres[1].tick(k);
        float sk = 0.0f;
        if (sKick != 0.0f)
        {
            sk = sKick;
            sKick = 0.0f;
        }
        block += 0.38f * sres.tick(sk);
        float kk = 0.0f;
        if (kKick != 0.0f)
        {
            kk = kKick;
            kKick = 0.0f;
        }
        // (the ping, some 15 dB over the block's own ring: heard over the bonnet, faintly behind the car)
        comb = 9.0f * (kres[0].tick(kk) + 0.5f * kres[1].tick(kk));
        if (cOn != 0)
        {
            float ck = 0.0f;
            if (cKick != 0.0f)
            {
                ck = cKick;
                cKick = 0.0f;
                cEnv = fmaxf(cEnv, ck);
            }
            float cs = 0.0f;
            for (int j = 0; j < 6; ++j)
                cs += cres[j].tick(ck * cKw[j]);
            cEnv *= cDecay;
            comb += 2.5f * (cs + 0.004f * cEnv * cnoise.tick(nScale * noise.rnd()));
        }
        // the pump: 1.5 strokes a turn of the crank, a click at each
        pumpPh += 1.5f * crankHz / rate;
        float pk = 0.0f;
        if (pumpPh >= 1.0f)
        {
            pumpPh -= floorf(pumpPh);
            pk = pumpOn;
        }
        mech += 0.6f * pres.tick(pk);
    }

    // Then, after Boost's sound (which draws from the same noise): the starter
    void tickStarter(float crankHz, float starterOn)
    {
        // the starter: its motor's buzz and its pinion's teeth on the ring gear
        starter = 0.0f;
        if (starterOn > 0.0f)
        {
            const float fa = fmaxf(crankHz, 1.0f) * 11.0f;            // the armature, through the reduction
            stPh += fa / rate;
            if (stPh >= 1.0f)
                stPh -= floorf(stPh);
            const float saw = 2.0f * stPh - 1.0f;
            starter = 0.05f * (saw - saw * saw * saw) + 0.02f * stres.tick(nScale * noise.rnd()) + 0.03f * sinf(6.28318531f * 9.0f * stPh);
        }
    }
};
