// compressor.fm: a centrifugal compressor, its map made from its sizes, and the air in its duct.
//
// Physically: an impeller (inducer diameter at the eye, exducer at the tip) in a volute whose A/R sets how wide its map
// is. What it does is a map: for each shaft speed, the pressure ratio it makes against the flow through it (a speed
// line), and its efficiency over that plane. Here the map is not someone's product's table but a family fitted to
// the shapes such maps have (Watson and Janota ch. 4; Moore and Greitzer's compression-system model):
//
//   - The work's scale is the tip speed U = omega d_ex / 2: the ideal temperature rise at the speed line's knee (its
//     highest ratio) is tauK = psiK U^2 / (cp T1), psiK = 0.45 (judgement: a backswept wheel's slip and work
//     coefficient times its efficiency, so that a 60 mm wheel at 150,000 rpm makes about 2.8, as such wheels do).
//     The map is written in that rise, tau = PR^(1/3.5) - 1, so the ratio is (1 + tau)^3.5: a cube and a root a
//     sample, no power function, and the outlet's temperature T2 = T1 (1 + tau / eta) follows at once.
//   - The flow's scale is the choke flow, mc = 0.45 rho01 a01 A_inducer (the eye's annulus, its hub 0.3 of it) at a
//     tip Mach number of 1.63 (the tip limit's, 560 m/s) and above, less at lower speed (0.3 of it standing still,
//     growing in a line between), and wider with the housing's A/R (as (A/R / 0.6)^0.25: judgement). phi = mdot / mc.
//     (The 1.63 from docs/measurements/calibration/boost/published-compressor-maps.md: the published choke at the
//     last contour grows with the ratio to 2 to 2.5, 0.69 to 0.92 of its largest at 1.5; saturating at 1.2, as
//     before, it fell from a ratio of 1.5 on)
//   - A speed line: from shut-off (phi 0, tau0 = 0.88 tauK: flat toward surge) up to the knee (phiK = 0.40 + 0.178
//     (M - 1) at an A/R of 0.6, smaller with a larger one: a wider map; between 0.2 and 0.7) as a smooth step (3x^2 - 2x^3: its slope positive between, which is
//     what makes surge); from the knee down to choke (phi 1) a quarter ellipse to tauC = 0.35 tauK, vertical there;
//     past choke a steep fall (the wheel a restriction); below phi 0 the reversed flow's branch, a rise with phi^2
//     (Moore and Greitzer's: pushing air back through a spinning wheel takes pressure).
//     (The knee's law from published-compressor-maps.md. The published surge line is where a compressor goes
//     unstable; this model's goes unstable near 0.9 of its knee (measured: a throttle closed on F's rig at two
//     speeds; compressor-map-model.md), and the surge flag and the variable vanes' guard read that line (machine.fm,
//     0.9 phiK). With it the line is at 0.24, 0.29, 0.36, 0.44 of the choke at the last contour at ratios 1.5, 2, 2.5,
//     3, against the published middles 0.24, 0.30, 0.37, 0.44 (the four small petrol maps and the S400; the 2 L diesel
//     VGT has no published map and takes these ranges). A fixed 0.5 with the flag at 0.8 of it put it at 0.31 and
//     0.38 at 1.5 and 2: too far right, its flow climbing only 1.22 times from 1.5 to 2 where the published climb
//     1.45. Read in the file's terms by a mirror of this map: compressor-map-model.md)
//   - Efficiency: an island, etaMax less 0.9 (phi - phiB)^2 less 0.25 (M - 1.1)^2, phiB 0.61 of the way from the knee
//     to choke (published-compressor-maps.md: with the knee at its ruled place the ridge reads 0.60, 0.62, 0.70,
//     0.79 of the choke at the last contour at ratios 1.5 to 3 against 0.51-0.61, 0.62-0.76, 0.62-0.91, 0.75-0.78:
//     inside at 1.5 and 2.5, on the edge at 2, at 3 over by 0.007, inside the readings' own +-0.02; no one value is
//     inside at both 2 and 3 (0.58: 0.604 at 2); the efficiency a tenth of choke right of surge then 0.67-0.69 against
//     the small wheels' 61-69 %), M the tip Mach number; never under 0.3. (Judgement: the shape real islands have, with their peak
//     near a ratio of 2.) Past choke the wheel's work a kilogram stays the choke point's (Euler's work does not fall
//     with the ratio; what the ratio loses is heat), so a compressor driven past choke still loads its shaft.
//
// Surge is not an effect. The air in the compressor's duct (its inducer's area, a length of ten inducer diameters
// and 0.2 m) has inertia: d mdot / dt = (A / L) (p1 PR(mdot, U) - p2), p2 the volume it fills. Left of the knee the
// line's slope is positive, and with the volume behind it that system oscillates by itself (Greitzer's B parameter
// above about 0.8 at these sizes): the flow reverses, the volume empties back through the wheel, the flow recovers,
// fills it again. Solved semi-implicitly in the flow (the map's slope taken at the last flow), so the steep choke side
// cannot make it unstable.
//
// Left out: the inducer's recirculation and ported shrouds; the map's Reynolds and size effects; a diffuser's stall
// before surge; inlet swirl; heat from the turbine through the housing.
#pragma once
#include "gas.fm"

module BoostCompressor
{
    // sizes (size())
    float rTip;         // exducer radius, m
    float aInd;         // the inducer's annulus, m^2
    float arWide;       // (A/R / 0.6)^0.25: the choke flow's widening
    float kAr;          // (A/R / 0.6)^-0.3: the knee's narrowing with a wider housing
    float phiK;         // the knee, a share of the choke flow (at this speed: speed())
    float phiB;         // the best efficiency's flow (at this speed)
    float etaMax;
    float kDuct;        // dt A / L, m s
    // the speed's part (speed(), every 16 samples)
    float u;            // tip speed, m/s
    float mach;         // tip Mach number
    float mc;           // choke flow now, kg/s
    float tauK;
    float tau0;
    float tauC;
    float etaM;         // etaMax less the Mach number's term
    float windage;      // W: the wheel's churning, flow or none
    // state
    float mdot;         // kg/s through it (negative: surging back)
    float p1;           // its inlet, Pa absolute and K
    float t1;
    float pr;           // what it makes now
    float tau;
    float dtau;         // d tau / d phi
    float eta;
    float t2;           // its outlet's temperature, K
    float power;        // W it takes from its shaft

    void size(float dInd, float dEx, float ar, float etaPeak, float dt)
    {
        const float ri = 0.5f * fmaxf(dInd, 0.005f);
        rTip = 0.5f * fmaxf(dEx, dInd * 1.05f);
        aInd = 3.14159265f * ri * ri * 0.91f;
        arWide = expf(0.25f * logf(fmaxf(ar, 0.2f) / 0.6f));
        kAr = expf(-0.3f * logf(fmaxf(ar, 0.2f) / 0.6f));
        knee(0.0f);
        etaMax = etaPeak;
        const float len = 10.0f * 2.0f * ri + 0.2f;
        kDuct = dt * aInd / len;
    }

    // The choke flow (kg/s) at a tip Mach number and an inlet's state
    float chokeFlow(float m, float p, float t)
    {
        const float a01 = sqrtf(1.4f * kBoostR * t);
        const float rho01 = p / (kBoostR * t);
        return 0.506f * rho01 * a01 * aInd * arWide * (0.3f + 0.7f * fminf(m / 1.63f, 1.0f));
    }

    // The knee and the island at a tip Mach number m (published-compressor-maps.md, above)
    void knee(float m)
    {
        // (the knee's law fitted to every cited map, the lead's ruling 25 Nov: phiK = 0.349 + 0.551 (M - 1), least
        // squares over P's S400SX-E and S300SX3 line by line (sources section 21) and the five maps of
        // published-compressor-maps.md ratio by ratio; docs/measurements/calibration/boost/map-shape-fit.md. Below
        // tip Mach 0.67, the lowest cited speed line (the S400SX-E's 230 m/s), it is held at that line's: a law is read
        // only where its maps are (at an idle's few hundred m/s the knee would otherwise move with every firing pulse,
        // its 16-sample steps sounding between the firing harmonics: the diesel clatter case))
        phiK = fminf(fmaxf((0.349f + 0.551f * (fmaxf(m, 0.67f) - 1.0f)) * kAr, 0.15f), 0.9f);
        phiB = phiK + 0.61f * (1.0f - phiK);
    }

    // Every 16 samples: the map at this shaft speed (rad/s) and inlet
    void speed(float omega, float pIn, float tIn)
    {
        p1 = pIn;
        t1 = tIn;
        u = omega * rTip;
        const float a01 = sqrtf(1.4f * kBoostR * t1);
        mach = u / a01;
        mc = chokeFlow(mach, p1, t1);
        knee(mach);
        // (the rise at the knee, its fall toward choke and the choke flow's scale (chokeFlow's 0.506) fitted with the
        // knee to every cited map (map-shape-fit.md): tau_knee = (0.608 - 0.157 (M - 1)) U^2 / (cp T), the line falling to
        // 0.652 of it at choke; the generic wheel is the maps' mean: within some 3 % of a published wheel's peak ratio
        // and 6 % of its surge flow on average, the two heavy-duty maps disagreeing beyond their reading precision
        // (known limits: compressor-map-model.md). The efficiency's Mach term held at the lowest cited line (0.67),
        // as the knee: under 230 m/s the map claims nothing and keeps that line's efficiency)
        tauK = (0.608f - 0.157f * (mach - 1.0f)) * u * u / (kBoostCpA * t1);
        tau0 = 0.88f * tauK;
        tauC = 0.652f * tauK;
        const float dm = fmaxf(mach, 0.67f) - 1.1f;
        etaM = etaMax - 0.25f * dm * dm;
        // (a disc's churning: some hundreds of watts at full speed, about rho U^3 r^2 / 500)
        windage = 0.002f * (p1 / (kBoostR * t1)) * u * u * u * rTip * rTip;
    }

    // The map's rise tau at a share phi of the choke flow, and its slope (in dtau)
    float rise(float phi)
    {
        if (phi < 0.0f)
        {
            const float c = 1.2f * (tauK + 0.03f) / (phiK * phiK);
            dtau = 2.0f * c * phi;
            return tau0 + c * phi * phi;
        }
        if (phi < phiK)
        {
            const float x = phi / phiK;
            dtau = (tauK - tau0) * 6.0f * x * (1.0f - x) / phiK;
            return tau0 + (tauK - tau0) * x * x * (3.0f - 2.0f * x);
        }
        if (phi < 1.0f)
        {
            const float w = 1.0f - phiK;
            const float y = (phi - phiK) / w;
            const float s = sqrtf(fmaxf(1.0f - y * y, 1.0e-4f));
            dtau = fmaxf(-(tauK - tauC) * y / (s * w), -60.0f * (tauK + 0.05f));
            return tauC + (tauK - tauC) * s;
        }
        const float sl = 8.0f * (tauK + 0.1f);
        dtau = -sl;
        return fmaxf(tauC - sl * (phi - 1.0f), -0.6f);
    }

    // Its efficiency at a share phi of the choke flow, at this speed
    float efficiency(float phi)
    {
        const float d = phi - phiB;
        return fmaxf(etaM - 0.9f * d * d, 0.3f);
    }

    // One sample: the flow through it against the volume it fills (p2, Pa absolute). Then mdot, pr, t2 and power
    // are this sample's.
    void step(float p2)
    {
        const float im = 1.0f / fmaxf(mc, 1.0e-5f);
        const float phi = mdot * im;
        tau = rise(phi);
        const float c = 1.0f + tau;
        const float sc = sqrtf(c);
        pr = c * c * c * sc;
        const float dpr = 3.5f * c * c * sc * dtau * im;
        // (the duct's own friction, a linear part: 4 kPa a kg/s, so that its Helmholtz ring dies away at rest with a Q
        // of some 20 rather than ringing on; judgement)
        const float den = fmaxf(1.0f - kDuct * p1 * dpr, 0.5f) + kDuct * 4000.0f;
        mdot += kDuct * (p1 * pr - p2 - 4000.0f * mdot) / den;
        const float phiN = mdot * im;
        eta = efficiency(phiN);
        // (past choke the ratio collapses but the wheel still does its work on every kilogram, the choke point's,
        // all of it lost to heat in the air: the efficiency falls with the ratio)
        float tr = fmaxf(tau, 0.0f) / eta;
        if (phiN > 1.0f)
        {
            tr = tauC / efficiency(1.0f);
            // (a shaft standing still has no choke rise, tr 0: the efficiency is then the choke point's, not 0 / 0:
            // card X's X-020, a second turbo created under a running engine)
            eta = tr > 1.0e-9f ? fmaxf(tau, 0.0f) / tr : efficiency(1.0f);
        }
        t2 = t1 * (1.0f + tr);
        power = fabsf(mdot) * kBoostCpA * t1 * tr + windage;
    }

    void reset(float pIn, float tIn)
    {
        mdot = 0.0f;
        p1 = pIn;
        t1 = tIn;
        pr = 1.0f;
        tau = 0.0f;
        dtau = 0.0f;
        eta = 0.3f;
        t2 = tIn;
        power = 0.0f;
        speed(0.0f, pIn, tIn);
    }
};
