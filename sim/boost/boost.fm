// boost/boost.fm: forced induction (module Boost). Owner: package F.
//
// One turbo, two or four (two smaller ones spool sooner, four sooner still: sequential pairs), or a supercharger. A
// turbo's shaft spins up on the exhaust's energy with lag, the wastegate holds the boost, the blow-off valve opens when
// the throttle shuts on boost (without one, the compressor surges); its turbine at each collector is a restriction that
// smooths the pulses (turbineArea, turbineHz: the exhaust's pipes take them). A supercharger's rotors turn with the crank:
// a twin-screw's boost comes with the revs at once, and it takes what it pumps from the crank. Its sounds: each turbo's
// whistle at its compressor's blades and the rush of air, the blow-off valve, the surge; a supercharger's whine at its
// pockets' passing. What it leaves out: the compressor's map (surge line, choke), the intercooler, the turbine's own
// work on the exhaust's waves (it is a fixed restriction and a low-pass).
//
//   setup(rate, noise)     in init; noise: the stream its sounds draw from (Extras')
//   glide(level, tsize, kDial)  every 16 samples: the BOOST and TURBO SIZE dials smoothed (smTb, smTs)
//   control(...)           every 16 samples: the shaft, the boost, the valves (the reference's turbo16)
//   sound(crankHz, massFlow, bovLevel)   each sample, after Extras' tick and before its tickStarter: into turbo
//   tsOf(tsize)            the TURBO SIZE dial as the engine takes it
// Its state read by others: boost (bar over the air), smTb, smTs.
//
// boost.model 1 (card F): the machine in the gas path (machine.fm, BoostMachine; docs/models/boost.md) in place of
// all of the above, which then rests (its control keeps `boost` from the machine's pressure, its sound is the
// machine's, its drag the machine's). Model 0, the default, runs exactly the code above. The machine's seams, here so
// that Engine and the other modules call one module (README, Boost):
//   applyMachine(spec, vd, redRpm, pAmb, tAmb)    when spec.boost's rev moves, and in configure
//   housingOf(bank, group, banks), housing(h, drive, admit, tGas), downpipe(side, a, z), gatePipe(t, a, z)   the exhaust
//   pressure(), temperature()                     the intake, before its throttle (pBox, tAir)
//   draw(m), tick(omegaCrank, pPlenum)            each sample, after the throttle; crankTorque (N m) then
//   control16(d16, target, antiLag, nitrous)      every 16 samples, with the ECU's
//   oxygen(), oxygenShare()                       Combustion
//   telemetry(&tel.boost, tAir), scope(&scope)    after a call (tAir: the charge air the engine has, for no machine)
#pragma once
#include "lib/biquad.fm"
#include "lib/noise.fm"
#include "spec/telemetry.fm"
#include "spec/scope.fm"
#include "spec/ecu.fm"
#include "machine.fm"

module Boost
{
    float rate;
    float nScale;       // white noise's strength for the same loudness at any sample rate
    Noise* nz;
    float smTb;         // BOOST, smoothed
    float smTs;         // TURBO SIZE, smoothed
    // the forced induction: one turbo, two or four (each whistling a little apart), or a supercharger
    int kind;           // 0 none, 1 a turbo, 2 twin turbos, 3 quad turbos, 4 a supercharger
    float tbSize;       // how much boost it is set for, 0 to 1
    float spool;        // shaft speed, 0 to 1 (a supercharger's rotors: with the crank)
    float boost;        // bar above the air outside
    float maxB;         // the most it makes
    float bov;          // the blow-off valve's breath, 0 to 1
    float flutter;      // the compressor surging against a shut throttle (no blow-off valve)
    float flPh;
    float whPh[4];
    float scRatio;      // a supercharger's drive: its rotors' turns a turn of the crank (its pulley's)
    float tsK;          // the turbos' size over the match: their whistle's pitch and their rush's band go with it
    float scW[6];       // its whine's harmonics: how strong each comes out (every 16 samples)
    Biquad tnoise;
    Biquad bovf;
    float lastThrottle;
    float thrSlow;      // the throttle a tenth of a second behind
    float turbo;        // this sample's sound
    int model;          // spec.boost.model: 0 the reference above, 1 the machine
    BoostSpec* spec;    // the Spec's section, from applyMachine (haveSpec 1): read every 16 samples for heatSettle
    int haveSpec;
    int seenSettle;     // spec.boost.heatSettle as last acted on
    BoostMachine mach;

    // A turbo's shaft still turning (boost.model 1): the engine stopped, it runs down for some seconds and is heard
    // whistling down; while it turns the simulation keeps stepping (engine.fm's audible())
    bool spinning()
    {
        for (int t = 0; t < BOOST_TURBOS; ++t)
            if (mach.shaft[t].omega > 50.0f)
                return true;
        return false;
    }
    int mapRev;         // the map's lines last copied to the Scope
    float crankTorque;  // N m the machine takes from the crank (model 1), as of the last sample

    void setup(float rateIn, Noise* noise)
    {
        mach.setup(rateIn, 0.002f, 7000.0f);   // (the engine's own rate: 96 kHz, or a lighter tier's)
        haveSpec = 0;
        seenSettle = 0;
        rate = rateIn;
        nz = noise;
        nScale = sqrtf(rate / 48000.0f);
        tnoise.setBandpass(5000.0f, 2.5f, rate);
        bovf.setBandpass(3200.0f, 0.9f, rate);
        spool = 0.0f;
        boost = 0.0f;
        bov = 0.0f;
        flutter = 0.0f;
    }

    // The TURBO SIZE dial as the engine takes it: 0.5 to 2 (unset: 1, matched)
    float tsOf(float tsize)
    {
        return tsize > 0.0f ? fminf(fmaxf(tsize, 0.5f), 2.0f) : 1.0f;
    }

    // The dials smoothed, every 16 samples (kDial: the 80 ms one-pole's coefficient)
    void glide(float level, float tsize, float kDial)
    {
        smTb += (level - smTb) * kDial;
        smTs += (tsOf(tsize) - smTs) * kDial;
    }

    // Every 16 samples: the forced induction (kindIn: 0 none, 1 a turbo, 2 twin turbos, 3 quad turbos, 4 a
    // supercharger; size 0 to 1: how much boost). A turbo's shaft spins up on the exhaust's energy, with lag (two
    // smaller ones sooner, four sooner still: sequential pairs), the wastegate holds the boost, the blow-off valve
    // opens when the throttle shuts on boost (falling some 0.15 under where it was a tenth of a second before). A
    // supercharger's rotors turn with the crank (rpmFrac: the revs over the redline): a twin-screw's boost comes with
    // the revs at once, most of it by a third of the redline, and its bypass valve lets it go as the load (the
    // throttle; a diesel's fuel) falls. Its pulley turns the rotors 2 to 2.8 times the crank with the boost it is
    // set for (a smaller pulley: more boost, a higher whine); two rotors of three lobes let six pockets of air through
    // a turn of the rotors, each meeting the boost as it opens to the outlet: a pulse, sharper with more boost (its
    // harmonics fall off less), its harmonics ringing the case and the outlet near 2.6 kHz on their way out (the
    // whine's colour changes as it rises through there).
    void control(int kindIn, float size, float exhaustPower, float throttle, float load, float bovLevel, float rpmFrac,
                 float crankHz, float tsz, float d16)
    {
        kind = kindIn;
        tbSize = size;
        tsK = tsz;
        if (model == 1)
        {
            boost = (mach.pressure() - mach.pOut) * 1.0e-5f;
            return;
        }
        if (kind == 0 || size <= 0.001f)
        {
            spool = 0.0f;
            boost = 0.0f;
            bov = 0.0f;
            flutter = 0.0f;
            lastThrottle = throttle;
            return;
        }
        if (kind == 4)
        {
            spool += (fminf(fmaxf(rpmFrac, 0.0f), 1.25f) - spool) * (1.0f - expf(-d16 / 0.03f));
            maxB = 0.25f + 0.75f * size;
            const float sp = fminf(spool / 0.35f, 1.0f);
            const float bs = maxB * expf(0.6f * logf(fmaxf(sp, 1.0e-4f))) * (0.1f + 0.9f * load * load);
            bov = 0.0f;
            flutter = 0.0f;
            lastThrottle = throttle;
            boost += (bs - boost) * (1.0f - expf(-d16 / 0.05f));
            scRatio = 2.0f + 0.8f * size;
            const float f0 = 6.0f * scRatio * fmaxf(crankHz, 1.0f);
            const float slope = 1.5f - 0.7f * fminf(boost / fmaxf(maxB, 0.05f), 1.0f);
            for (int k = 0; k < 6; ++k)
            {
                const float fk = (float)(k + 1) * f0;
                const float x = fk / 2600.0f - 2600.0f / fk;
                const float res = 1.0f / sqrtf(1.0f + 6.0f * x * x);
                const float top = fminf(fmaxf((18000.0f - fk) / 4000.0f, 0.0f), 1.0f);  // (faded out by 18 kHz)
                scW[k] = top * expf(-slope * logf((float)(k + 1))) * (0.5f + 0.5f * res);
            }
            return;
        }
        const float kz = kind == 1 ? 1.0f : (kind == 2 ? 0.72f : 0.55f);
        // (its size, tsz, over the match: a small one spins nearer its top on the same exhaust, as the size's -0.6th
        // power, its lag as the 1.3th; past its flow it lets the boost go: near the redline for one half the size)
        const float lts = logf(tsz);
        const float target = fminf(sqrtf(fmaxf(exhaustPower, 0.0f)) * (1.25f - 0.45f * size) * expf(-0.6f * lts), 1.0f);
        const float tauUp = (0.35f + 1.5f * size) * kz * expf(1.3f * lts);
        const float tau = target > spool ? tauUp : 1.2f;
        spool += (target - spool) * (1.0f - expf(-d16 / tau));
        const float maxBoost = 0.35f + 1.05f * size;
        maxB = maxBoost;
        float b = maxBoost * spool * spool * 1.6f;
        if (b > maxBoost)
            b = maxBoost;                                   // the wastegate opens
        b = fminf(b, maxBoost * fminf(1.3f * expf(1.5f * lts) / fmaxf(rpmFrac, 0.01f), 1.0f));   // (a small one chokes)
        // the throttle shut on boost: the blow-off valve (or, without one, the compressor surges)
        thrSlow += (throttle - thrSlow) * (1.0f - expf(-d16 / 0.1f));
        if (throttle < thrSlow - 0.15f && boost > 0.25f)
        {
            if (bovLevel > 0.15f)
                bov = fmaxf(bov, fminf(boost / maxBoost, 1.0f));
            else
                flutter = fmaxf(flutter, fminf(boost / maxBoost, 1.0f));
        }
        lastThrottle = throttle;
        bov *= expf(-d16 / 0.28f);
        flutter *= expf(-d16 / 0.45f);
        if (bov > 0.05f || flutter > 0.05f)
        {
            b *= 0.5f;                                      // the boost vents
            spool *= expf(-d16 / 0.9f);
        }
        boost += (b - boost) * (1.0f - expf(-d16 / 0.08f));
    }

    // One sample of the turbos' (or the supercharger's) sound, into turbo
    void sound(float crankHz, float massFlow, float bovLevel)
    {
        // the turbos: each one's whistle at its compressor's blades (smaller ones higher, each a little apart from the
        // others), the rush of air, the blow-off valve, the surge
        if (model == 1)
        {
            turbo = mach.outInlet + mach.outVent + mach.outCase + mach.outBang;
            return;
        }
        turbo = 0.0f;
        if (kind == 4 && tbSize > 0.001f)
        {
            // a supercharger: its rotors whine at their pockets' passing (six a turn of the rotors: turbo16 sets
            // their harmonics), louder with the speed and the boost (off the boost, its bypass open, the rotors still
            // turn: some 30 % of it), a little uneven over a turn of the rotors (their lobes are not quite alike); the
            // air rushing through them
            whPh[0] += 6.0f * scRatio * crankHz / rate;
            if (whPh[0] >= 1.0f)
                whPh[0] -= floorf(whPh[0]);
            whPh[1] += scRatio * crankHz / rate;
            if (whPh[1] >= 1.0f)
                whPh[1] -= floorf(whPh[1]);
            const float sp = fminf(crankHz / 100.0f, 1.0f);
            const float ld = fminf(boost / fmaxf(maxB, 0.05f), 1.0f);
            const float ph = 6.28318531f * whPh[0];
            // (the harmonics' sines by the recurrence sin (k + 1) x = 2 cos x sin k x - sin (k - 1) x)
            const float c1 = cosf(ph);
            float s0 = 0.0f;
            float s1 = sinf(ph);
            float w = scW[0] * s1;
            for (int k = 1; k < 6; ++k)
            {
                const float s2 = 2.0f * c1 * s1 - s0;
                w += scW[k] * s2;
                s0 = s1;
                s1 = s2;
            }
            turbo = 0.15f * sp * (0.3f + 0.7f * ld) * (1.0f + 0.12f * sinf(6.28318531f * whPh[1])) * w;
            tnoise.setBandpass(1200.0f + 3000.0f * sp, 1.5f, rate);
            turbo += 0.09f * sp * ld * tnoise.tick(nScale * nz->rnd());
        }
        else if (kind != 0 && tbSize > 0.001f)
        {
            const int nv = kind == 1 ? 1 : (kind == 2 ? 2 : 4);
            const float fw = (900.0f + 7200.0f * spool) * (kind == 1 ? 1.0f : (kind == 2 ? 1.2f : 1.4f)) * expf(-0.8f * logf(tsK));
            const float det[4] = {1.0f, 1.012f, 0.991f, 1.021f};
            float ws = 0.0f;
            for (int j = 0; j < nv; ++j)
            {
                whPh[j] += fw * det[j] / rate;
                if (whPh[j] >= 1.0f)
                    whPh[j] -= floorf(whPh[j]);
                ws += sinf(6.28318531f * whPh[j]) + 0.25f * sinf(12.5663706f * whPh[j]);
            }
            const float s2 = spool * spool;
            turbo = 0.09f * s2 * ws / sqrtf((float)nv);
            tnoise.setBandpass((1500.0f + 5500.0f * spool) * expf(-0.5f * logf(tsK)), 2.5f, rate);
            turbo += 0.15f * s2 * fminf(massFlow * 8.0f, 1.0f) * tnoise.tick(nScale * nz->rnd());
            if (bov > 0.001f)
                turbo += 0.35f * bovLevel * bov * bov * bovf.tick(nScale * nz->rnd());
            if (flutter > 0.001f)
            {
                flPh += (16.0f + 6.0f * flutter) / rate;
                if (flPh >= 1.0f)
                    flPh -= 1.0f;
                const float pulse = fmaxf(sinf(6.28318531f * flPh), 0.0f);
                turbo += 0.25f * flutter * pulse * pulse * pulse * bovf.tick(nScale * nz->rnd());
            }
        }
    }

    // A supercharger takes what it pumps from the crank: its boost times the air it moves, at some 60 % (N m; asp 4)
    float drag(int asp, float vTotal, float omega)
    {
        if (model == 1)
            return mach.crankTorque;
        return asp == 4 ? boost * 1.0e5f * vTotal * (1.0f + boost) * 0.1326f * fminf(omega / 5.0f, 1.0f) : 0.0f;
    }

    // ---- boost.model 1: the machine's seams --------------------------------------------------------------------------

    // The spec's section and the engine it is on (displacement m^3, redline rpm, the air outside Pa and K); when the
    // section's rev moves and in configure. Model 0 leaves the machine at rest.
    void applyMachine(BoostSpec* s, float vd, float redRpm, float pAmb, float tAmb)
    {
        model = s->model;
        if (haveSpec == 0)
            seenSettle = s->heatSettle;
        spec = s;
        haveSpec = 1;
        mach.vd = vd;
        mach.redRpm = redRpm;
        mach.ambient(pAmb, tAmb);
        if (model == 1)
            mach.apply(s);
        else
            mach.active = 0;
    }

    int housingOf(int bank, int group, int banks)
    {
        return model == 1 ? mach.housingOf(bank, group, banks) : -1;
    }

    float housing(int h, float drive, float admit, float tGas)
    {
        return model == 1 ? mach.housing(h, drive, admit, tGas) : 0.0f;
    }

    float downpipe(int side, float a, float z)
    {
        return model == 1 ? mach.downpipe(side, a, z) : 0.0f;
    }

    // The exhaust's side count (card G: at every configure, before housingOf): a turbo whose side the exhaust does not
    // build empties into side 0's downpipe, so no turbo is left without one
    void exhaustSides(int n)
    {
        mach.exSides = n < 1 ? 1 : (n > 2 ? 2 : n);
        mach.houseSeen = 0;
    }

    // External gates (card G asked): how many turbos have a gate of their own pipe; gatePipe(t, ...) takes t from 0
    // to this less 1 (turbo t's). 0 under model 0, for a supercharger and for internal gates.
    int externalGates()
    {
        if (model != 1 || mach.active == 0 || mach.sc != 0)
            return 0;
        int n = 0;
        for (int t = 0; t < mach.turbos; ++t)
            if (mach.turb[t].gateExt != 0)
                n = t + 1;
        return n;
    }

    float gatePipe(int t, float a, float z)
    {
        return model == 1 ? mach.gatePipe(t, a, z) : 0.0f;
    }

    // The level over which an ECU's over-boost cut acts by default (Pa over the air): 1.3 times the target or the
    // spring, whichever is more (makers' boost limits sit some 1.2 to 1.3 of the target: a stock build never reaches
    // it), for turbos; 0 (none) for a supercharger, whose boost no loop holds, and under model 0. Engine hands it to
    // Ecu::overBoostRef (card N2's).
    float overBoostLevel()
    {
        if (model != 1 || mach.active == 0 || mach.sc != 0 || mach.turbos == 0)
            return 0.0f;
        return 1.3f * fmaxf(mach.target, mach.gateSpring);
    }

    // Before the throttle: Pa absolute and K (model 1; called by Engine only then)
    float pressure()
    {
        return model == 1 ? mach.pressure() : 101325.0f + 100000.0f * boost;
    }

    float temperature()
    {
        return model == 1 ? mach.temperature() : 300.0f;
    }

    // The charge's oxygen by mass (0.232 air), and over air's (1 without nitrous)
    float oxygen()
    {
        return model == 1 ? mach.oxygen() : 0.232f;
    }

    float oxygenShare()
    {
        return model == 1 ? mach.oxygen() * 4.3103448f : 1.0f;
    }

    void draw(float m)
    {
        if (model == 1)
            mach.draw(m);
    }

    void tick(float omegaCrank, float pPlenum)
    {
        if (model == 1)
        {
            mach.tick(omegaCrank, pPlenum);
            crankTorque = mach.crankTorque;
        }
    }

    // Every 16 samples (model 1), with the ECU's (card H's): its boost target over the air (Pa; 0 none: the spec's
    // target or the gate's spring), anti-lag (0 off, 1 on: fuel past the engine, a tenth of the matched full-load
    // fuel, burns in the housing; judgement), nitrous (above a half: the window open)
    void control16(float d16, float target, float antiLagOn, float nitrousOn)
    {
        if (model != 1)
            return;
        mach.cmdTarget = target > 0.0f ? target : -1.0f;
        mach.cmdAntiLag = antiLagOn * 0.1f * mach.mMatch / 14.7f;
        mach.cmdNitrous = nitrousOn > 0.5f ? 1 : 0;
        mach.control(d16);
        crankTorque = mach.crankTorque;
        // (card C's settle: at each press, the intercooler's core where the present flow holds it)
        if (haveSpec != 0 && spec->heatSettle != seenSettle)
        {
            seenSettle = spec->heatSettle;
            mach.settleCore();
        }
    }

    // The vanes' position from the ECU's map (below 0: the machine's own loop), and purges counted (a press counter)
    void vanesAndPurge(float vanes, int purges)
    {
        mach.cmdVanes = vanes;
        mach.cmdPurge = purges;
    }

    // The car's speed through the intercooler, m/s
    void airSpeed(float v)
    {
        mach.airSpeed = v;
    }

    // A governed diesel's rated speed (rpm) for the machine's design point, before applyMachine; below 0 (or never
    // called): a spark-ignition engine, matched at 0.85 of its redline (machine.fm, apply)
    void designSpeed(float rpm)
    {
        mach.designRpm = rpm;
    }

    // (N2, the lead's ruling (b), 25 Nov) For a governed diesel's compressor sizing (machine.fm, apply), before
    // applyMachine: its full-load fuel curve's plateau start, the lowest speed within 2 % of the curve's most (torque
    // goes with the fuel there; 0: no curve, and the machine takes 0.6 of rated, judgement, unless spec.boost.peakRpm
    // states a maker's speed), and the compression ratio (the back pressure's cost to the fresh air)
    void peakSpeed(EcuSpec* e, float compression)
    {
        float most = 0.0f;
        for (int i = 0; i < 8; ++i)
            most = fmaxf(most, e->fuelCurveMg[i]);
        float at = 0.0f;
        if (most > 0.0f)
        {
            for (int i = 7; i >= 0; --i)
            {
                if (e->fuelCurveMg[i] > 0.0f && e->fuelCurveMg[i] >= 0.98f * most)
                    at = e->fuelCurveRpm[i];
            }
        }
        mach.curvePeakRpm = at;
        mach.compression = compression;
    }

    // 1: on an engine test cell (MODE_DYNO_ENGINE with the absorber on): the cell's charge-air cooling holds the
    // intercooler's core at the air's temperature (SAE J1349; machine.fm, the core)
    void testCell(int on)
    {
        mach.cellHeld = on != 0 ? 1 : 0;
    }

    // tel.boost's card F fields (model 0: zeros, the shafts none). tCharge: the charge air's temperature as the engine
    // has it (Intake's tAir, K), which the two temperatures read when no machine is in the path: the air that reaches
    // the throttle, with no intercooler before it
    void telemetry(BoostTel* t, float tCharge)
    {
        const int on = model == 1 && mach.active != 0 ? 1 : 0;
        t->turbos = on != 0 ? mach.turbos : 0;
        for (int i = 0; i < 4; ++i)
        {
            t->shaftSpeed[i] = on != 0 ? mach.telSpeed[i] : 0.0f;
            t->ratio[i] = on != 0 ? mach.telPr[i] : 0.0f;
            t->flow[i] = on != 0 ? mach.telFlow[i] : 0.0f;
            t->efficiency[i] = on != 0 ? mach.telEta[i] : 0.0f;
            t->compressorOut[i] = on != 0 ? mach.telT2[i] : 0.0f;
            t->gate[i] = on != 0 ? mach.telGate[i] : 0.0f;
            t->vanes[i] = on != 0 ? mach.telVanes[i] : 0.0f;
            t->turbineIn[i] = on != 0 ? mach.telPTurb[i] : 0.0f;
            t->turbineInTemp[i] = on != 0 ? mach.telTTurb[i] : 0.0f;
            t->drive[i] = on != 0 ? mach.telDrive[i] : 0.0f;
        }
        t->chargePipe = on != 0 ? mach.v1.p - mach.pOut : 0.0f;
        t->intercoolerOut = on != 0 ? mach.telIcOut : tCharge;
        t->throttleIn = on != 0 ? mach.v2.t : tCharge;
        t->blowOffValve = on != 0 ? mach.bovLift : 0.0f;
        t->superchargerPower = on != 0 ? mach.telScPower : 0.0f;
        t->oxygen = on != 0 ? mach.telO2 : 0.0f;
        // (card N2: the charge system against the engine, the lead's X-021 ruling: the fields mean what they say, so
        // a 15 L engine with a 2 L engine's cooler makes little boost; these say so. Warnings, not physics, the
        // thresholds judgement: an intercooler rated under 0.4 of the engine's matched flow (the compressor's at its
        // redline at a ratio of 1.9, mMatch: above most engines' rated air, so P's rotary sized from its rated power
        // reads 0.45 of it); a wastegate spring under a tenth of the boost asked (the target, the ECU's or the spec's:
        // a low spring under a duty is a real design, P's kei's 10 kPa under 65; a tenth is where the exhaust's push
        // alone opens it); charge pipes under 0.3 or over 4 times 2.5 displacements (F's defaults' ratio on a 2 L
        // engine: 5 L of pipes; the twin rotor's 2.6 L sit at 0.4). Turbos and superchargers alike; no target, no
        // spring warning)
        int mm = 0;
        float springWants = 0.0f;
        float volWants = 0.0f;
        if (on != 0)
        {
            const float asked = mach.cmdTarget > 0.0f ? mach.cmdTarget : mach.target;
            springWants = mach.sc == 0 ? fmaxf(asked, 0.0f) : 0.0f;
            volWants = 2.5f * mach.vd;
            if (mach.icFlowHas < 0.4f * mach.mMatch)
                mm |= 1;
            if (springWants > 0.0f && mach.gateSpring < 0.1f * springWants)
                mm |= 2;
            if (mach.chargeVolHas < 0.3f * volWants || mach.chargeVolHas > 4.0f * volWants)
                mm |= 4;
            // (the lead's X-024 ruling: a compressor far bigger than the engine can swallow makes no boost, and says
            // so: its choke flow over four times a matched one's, 1.15 times the engine's matched flow: twice the
            // inducer's diameter)
            if (mach.sc == 0 && mach.compFlowHas > 4.0f * 1.15f * mach.mMatch)
                mm |= 8;
            // (the lead's ruling on the design point: a turbine's nozzle under half or over twice what the build's
            // own design point gives (an explicit A/R far from it): it spools early and chokes the engine, or never)
            if (mach.sc == 0 && mach.turbNozWants > 0.0f
                && (mach.turbNozHas < 0.5f * mach.turbNozWants || mach.turbNozHas > 2.0f * mach.turbNozWants))
                mm |= 16;
            // (the lead's ruling: a twin turbo whose second wheel the exhaust leaves without gas, a one-bank engine's
            // one collector: the builder's to cure, this says it)
            if (mach.unfedTurbo() != 0)
                mm |= 128;
        }
        t->mismatch = mm;
        t->coolerHas = on != 0 ? mach.icFlowHas : 0.0f;
        t->coolerWants = on != 0 ? mach.mMatch : 0.0f;
        t->springHas = on != 0 && mach.sc == 0 ? mach.gateSpring : 0.0f;
        t->springWants = springWants;
        t->volumeHas = on != 0 ? mach.chargeVolHas : 0.0f;
        t->volumeWants = volWants;
        t->compressorHas = on != 0 && mach.sc == 0 ? mach.compFlowHas : 0.0f;
        t->compressorWants = on != 0 && mach.sc == 0 ? 1.15f * mach.mMatch : 0.0f;
        t->turbineHas = on != 0 && mach.sc == 0 ? mach.turbNozHas : 0.0f;
        t->turbineWants = on != 0 && mach.sc == 0 ? mach.turbNozWants : 0.0f;
        t->flags = on != 0 ? mach.flags : 0;
    }

    // The Scope's map and trail (model 1): the lines when they were rebuilt, the trail each time
    void scope(Scope* sc)
    {
        if (model != 1)
            return;
        if (mapRev != mach.mapRev)
        {
            mapRev = mach.mapRev;
            sc->boostMapRev = mapRev;
            for (int l = 0; l < 8; ++l)
            {
                sc->boostLineSpeed[l] = mach.lineSpeed[l];
                sc->boostSurgeFlow[l] = mach.surgeFlow[l];
                sc->boostSurgeRatio[l] = mach.surgePr[l];
                for (int i = 0; i < 16; ++i)
                {
                    sc->boostLineFlow[l][i] = mach.lineFlow[l][i];
                    sc->boostLineRatio[l][i] = mach.linePr[l][i];
                }
            }
            for (int v = 0; v < 5; ++v)
            {
                sc->boostContourEta[v] = mach.contourEta[v];
                for (int i = 0; i < 16; ++i)
                {
                    sc->boostContourFlow[v][i] = mach.contourFlow[v][i];
                    sc->boostContourRatio[v][i] = mach.contourPr[v][i];
                }
            }
        }
        sc->boostTrailAt = mach.trailAt;
        for (int i = 0; i < 256; ++i)
        {
            sc->boostTrailFlow[i] = mach.trailFlow[i];
            sc->boostTrailRatio[i] = mach.trailPr[i];
        }
    }
};
