// lab.fm: the valvetrain lab: each cylinder's valve events, from the cams a person specified (valve.model 1).
//
// What it holds: the head (area.fm), the cams (cam.fm) of both stages and both valves, an auxiliary exhaust event, the
// intake's prebuilt lift steps for continuous lift, each made into an area table; the two phasers (phaser.fm); the
// stage and deactivation logic; the float (float.fm); the flow bench (bench.fm). What the cylinder sees each sample
// is one area for its intake and one for its exhaust (the main event and the auxiliary one summed), each a table
// lookup, as the reference's (cylinder.fm, areaAt).
//
// Every profile's table has two copies: the one the cylinders read, and one a change is built into. Every 16 samples
// (control): a Spec change becomes a new copy, one table a tick at most (a queue, and only the profiles whose request
// changed); the phasers move toward their targets; the stage, the lift command and the deactivation are decided; and
// each cylinder moves to the table it should read (the stage's, its newest copy) only while the valve it changes is
// shut in both. So no lift jumps and nothing needs a crossfade, whether a stage changes or a cam is edited while the
// engine runs, and a change goes round the engine in a cycle, as a real cam change does. A cylinder is deactivated in
// its power stroke (both valves shut, its exhaust next): its exhaust then stays shut, keeping the burned gas as a
// spring, and its intake with it; it comes back in the same place, the exhaust first. Combustion asks active(c) as
// the intake closes: a resting cylinder gets no fuel.
//
// Continuous lift (BMW's Valvetronic, Toyota's Valvematic, Nissan's VVEL: an intake's): lift and duration scale
// together with the command, the centreline kept (the phaser moves it); five tables prebuilt from the least lift to
// the most, each the cam's own shape over a shorter span (duration 0.4 + 0.6 of the lift's share: judgement), and the
// table in use a blend of the two either side, made every tick the command moves (a small step each tick, as a
// phaser's).
//
// The angles are the cylinder's own (cylinder.fm). Free of the engine: everything here is a function of the angles,
// the speed, the load and the oil, so it is tested alone (tests/sim/valvetrain/).
#pragma once
#include "lab-spec.fm"
#include "phaser.fm"
#include "float.fm"
#include "bench.fm"

enum
{
    VT_IN_A = 0,
    VT_IN_B = 1,
    VT_EX_A = 2,
    VT_EX_B = 3,
    VT_AUX = 4,
    VT_LIFT0 = 5,       // the intake's lift steps, VT_LIFTS of them
    VT_LIFTS = 5,
    VT_PROFILES = 10,
    VT_TABLES = 20,     // two copies of each: profile i's are tab[i] and tab[i + VT_PROFILES]
    VT_MAXCYL = 16
};

module ValveLab
{
    Head head;
    CamShape cam[VT_PROFILES];
    AreaTable tab[VT_TABLES];
    int front[VT_PROFILES];     // which copy of each profile is the newest (0 or 1)
    AreaTable inLive;   // the intake's table under continuous lift: a blend of two lift steps
    Phaser phIn;
    Phaser phEx;
    ValveFloat flt;
    FlowBench bench;
    float bore;
    float cyc;
    int nCyl;
    // what the Spec asked, kept between ticks
    int valves;
    float dInAsk;
    float dExAsk;
    float qInAsk;
    float qExAsk;
    int stagesOn;
    float stageUp;
    float stageHyst;
    int liftOn;
    float liftMin;
    int liftThr;
    int auxOn;
    int deacMask;
    float deacLo;
    float deacHi;
    float deacLoad;
    int train;
    float springRate;
    float springPre;
    float valveMass;
    // the table queue: a bit a profile still to build (lowest first), and whether the float speeds wait for it
    int dirty;
    int floatDirty;
    // the state
    int stageWant;      // 0 A, 1 B
    int useIn[VT_MAXCYL];   // the table each cylinder's intake reads (an index into tab)
    int useEx[VT_MAXCYL];
    int deacWant;
    int offIn[VT_MAXCYL];   // 1: this valve rests
    int offEx[VT_MAXCYL];
    float liftCmd;      // 0 to 1 of the lift steps' range
    float liftMade;     // the command inLive was made for (-1: none)
    int floating;
    float sevMade;      // the severity the tables' tails were made for
    float clatter;      // 0 to 1: how hard the floating valves land, for the sound
    // what it shows (telemetry)
    float showIvo;      // the four events (degrees of the cylinder's cycle) of cylinder 0 as they are now
    float showIvc;
    float showEvo;
    float showEvc;
    float overlap1mm;   // degrees both valves are above 1 mm
    int activeMask;     // a bit a cylinder: firing

    // In init: the engine's bore (m), its cylinders and its cycle's degrees
    void setup(float boreIn, int n, float cycIn)
    {
        bore = boreIn;
        nCyl = n > VT_MAXCYL ? VT_MAXCYL : n;
        cyc = cycIn;
    }

    // At rest: stage A, every valve working, the phasers parked, no lift command yet
    void reset()
    {
        stageWant = 0;
        deacWant = 0;
        for (int c = 0; c < VT_MAXCYL; ++c)
        {
            useIn[c] = VT_IN_A + VT_PROFILES * front[VT_IN_A];
            useEx[c] = VT_EX_A + VT_PROFILES * front[VT_EX_A];
            offIn[c] = 0;
            offEx[c] = 0;
        }
        phIn.reset();
        phEx.reset();
        liftCmd = 1.0f;
        liftMade = -1.0f;
        floating = 0;
        sevMade = -1.0f;
        clatter = 0.0f;
        flt.sevIn = 0.0f;
        flt.sevEx = 0.0f;
    }

    // The newest copy of profile i
    int newest(int i)
    {
        return i + VT_PROFILES * front[i];
    }

    // The Spec's section: what it says becomes requests, and the profiles whose request changed are queued. now 1:
    // build every profile at once into its first copy, and every cylinder reads it (in init, off the audio thread);
    // 0: one table a tick, each cylinder moving to it with its valve shut
    void apply(ValveLabSpec* s, int now)
    {
        const int headMoved = valves != s->valves || dInAsk != s->dIn || dExAsk != s->dEx || qInAsk != s->portIn
                              || qExAsk != s->portEx ? 1 : 0;
        valves = s->valves;
        dInAsk = s->dIn;
        dExAsk = s->dEx;
        qInAsk = s->portIn;
        qExAsk = s->portEx;
        head.setup(s->valves, bore, s->dIn, s->dEx, s->portIn, s->portEx);
        if (s->inKind == 1)
            cam[VT_IN_A].requestFree(s->freeInOpen, s->freeInClose, s->inLift, s->freeFlank);
        else
            cam[VT_IN_A].request(s->inDurSeat, s->inDur1mm, s->inLift, 360.0f + s->inCentre, s->inFat);
        if (s->exKind == 1)
            cam[VT_EX_A].requestFree(s->freeExOpen, s->freeExClose, s->exLift, s->freeFlank);
        else
            cam[VT_EX_A].request(s->exDurSeat, s->exDur1mm, s->exLift, 360.0f - s->exCentre, s->exFat);
        cam[VT_IN_B].request(s->inDurSeatB, s->inDur1mmB, s->inLiftB, 360.0f + s->inCentreB, s->inFat);
        cam[VT_EX_B].request(s->exDurSeatB, s->exDur1mmB, s->exLiftB, 360.0f - s->exCentreB, s->exFat);
        cam[VT_AUX].requestFree(s->auxOpen, s->auxOpen + s->auxDur, s->auxLift, fminf(0.4f * s->auxDur, s->freeFlank));
        phIn.setup(s->inPhaseRange, s->phaseRate);
        phEx.setup(s->exPhaseRange, s->phaseRate);
        stagesOn = s->stages;
        stageUp = s->stageSpeed;
        stageHyst = s->stageHyst;
        liftOn = s->liftControl;
        const int stepsMoved = liftMin != s->liftMin ? 1 : 0;
        liftMin = s->liftMin;
        liftThr = s->liftThrottle;
        auxOn = s->auxOn;
        deacMask = s->deacMask;
        deacLo = s->deacLow;
        deacHi = s->deacHigh;
        deacLoad = s->deacLoad;
        train = s->train;
        springRate = s->springRate;
        springPre = s->springPreload;
        valveMass = s->valveMass;
        const int steps = ((1 << VT_LIFTS) - 1) << VT_LIFT0;
        for (int i = 0; i < VT_LIFT0; ++i)
            if (cam[i].changed != 0 || headMoved != 0)
                dirty = dirty | (1 << i);
        if ((dirty & 1) != 0 || stepsMoved != 0)
            dirty = dirty | steps;
        floatDirty = 1;
        if (now != 0)
        {
            dirty = (1 << VT_PROFILES) - 1;
            for (int c = 0; c < VT_MAXCYL; ++c)
            {
                useIn[c] = -1;
                useEx[c] = -1;
            }
            for (int i = 0; i < VT_PROFILES; ++i)
                front[i] = 1;   // (so each is built into copy 0)
            for (int i = 0; i < VT_PROFILES; ++i)
                buildNext();
            for (int c = 0; c < VT_MAXCYL; ++c)
            {
                useIn[c] = newest(VT_IN_A);
                useEx[c] = newest(VT_EX_A);
            }
        }
        bench.measure(&head);
    }

    // Is copy t of a profile read by a cylinder now?
    int inUse(int t)
    {
        for (int c = 0; c < nCyl; ++c)
            if (useIn[c] == t || useEx[c] == t)
                return 1;
        return 0;
    }

    // The lowest profile still queued whose spare copy no cylinder reads: its cam solved, its table made into that
    // copy, which becomes the newest (the lift steps from the intake's own cam)
    void buildNext()
    {
        int i = 0;
        while (i < VT_PROFILES && ((dirty & (1 << i)) == 0 || inUse(i + VT_PROFILES * (1 - front[i])) != 0))
            i += 1;
        if (i >= VT_PROFILES)
            return;
        dirty = dirty & ~(1 << i);
        if (i >= VT_LIFT0)
        {
            CamShape* base = &cam[VT_IN_A];
            const float sh = liftMin + (1.0f - liftMin) * (float)(i - VT_LIFT0) / (float)(VT_LIFTS - 1);
            const float sd = 0.4f + 0.6f * sh;
            CamShape* c = &cam[i];
            c->kind = base->kind;
            c->flank = base->flank * sd;
            c->p = base->p;
            c->k = base->k;
            c->kNorm = base->kNorm;
            c->lift = base->lift * sh;
            c->centre = base->centre;
            c->span = base->span * sd;
            c->open = vtWrap(c->centre - 0.5f * c->span, 720.0f);
            c->reached = base->reached;
            for (int j = 0; j < VT_POINTS; ++j)
                c->shape[j] = base->shape[j];
            c->rise1 = c->riseDeg(kVtOneMm);
        }
        else
            cam[i].build();
        const int t = i + VT_PROFILES * (1 - front[i]);
        tab[t].build(&cam[i], &head, i >= VT_EX_A && i <= VT_AUX ? 1 : 0);
        tab[t].noTail();
        tab[t].place(shiftOf(i), cyc);
        front[i] = 1 - front[i];
        sevMade = -1.0f;
        liftMade = -1.0f;
    }

    // Where profile i's events are moved now: the intake's earlier by its phaser, the exhaust's later by its own
    float shiftOf(int i)
    {
        if (i <= VT_IN_B || i >= VT_LIFT0)
            return -phIn.phase;
        if (i == VT_AUX)
            return 0.0f;
        return phEx.phase;
    }

    // The intake's table cylinder c reads now
    AreaTable* inTable(int c)
    {
        if (liftOn != 0)
            return &inLive;
        return &tab[useIn[c]];
    }

    // ---- per sample: the areas (m^2) cylinder c's valves open at its angle a ----
    float areaIn(int c, float a)
    {
        if (offIn[c] != 0)
            return 0.0f;
        if (liftOn != 0)
            return inLive.at(a, cyc);
        return tab[useIn[c]].at(a, cyc);
    }

    float areaEx(int c, float a)
    {
        if (offEx[c] != 0)
            return 0.0f;
        const float main = tab[useEx[c]].at(a, cyc);
        return auxOn != 0 ? main + tab[newest(VT_AUX)].at(a, cyc) : main;
    }

    // Combustion asks as the intake closes: does cylinder c fire this cycle?
    bool active(int c)
    {
        return offIn[c] == 0;
    }

    // How a cylinder stands now: 1 when both its valves are shut and its exhaust opens next (its power stroke)
    int powerStroke(int c, float a)
    {
        AreaTable* ti = inTable(c);
        AreaTable* te = &tab[useEx[c]];
        if (ti->at(a, cyc) > 0.0f || te->at(a, cyc) > 0.0f)
            return 0;
        const float dE = vtWrap(te->openNow - a, cyc);
        const float dI = vtWrap(ti->openNow - a, cyc);
        return dE < dI ? 1 : 0;
    }

    // ---- every 16 samples ----
    // d16: seconds; omega: the crank (rad/s); redline (rad/s); load 0 to 1; pOil: Pa above the air's; tOil: K; ang:
    // each cylinder's angle now. The ECU's targets: the phasers' (degrees from parked) and the lift command (0 to 1); a
    // negative one: none, this lab's own schedule.
    void control(float d16, float omega, float redline, float load, float pOil, float tOil, float* ang,
                 float inTarget, float exTarget, float liftTarget)
    {
        // the queue: one table a tick
        if (dirty != 0)
            buildNext();
        else if (floatDirty != 0)
        {
            floatDirty = 0;
            const float mIn = flt.massOf(head.dIn, valveMass, train);
            const float mEx = flt.massOf(head.dEx, valveMass * (head.dEx / head.dIn) * (head.dEx / head.dIn), train);
            flt.omegaIn = flt.speedFor(&cam[VT_IN_A], springRate, springPre, mIn, train);
            flt.omegaEx = flt.speedFor(&cam[VT_EX_A], springRate, springPre, mEx, train);
        }
        // the phasers
        const float share = omega / fmaxf(redline, 1.0f);
        const float wantIn = inTarget >= 0.0f ? inTarget : phIn.schedule(share, load, 1);
        const float wantEx = exTarget >= 0.0f ? exTarget : phEx.schedule(share, load, 0);
        phIn.control(d16, wantIn, pOil, tOil);
        phEx.control(d16, wantEx, pOil, tOil);
        for (int t = 0; t < VT_TABLES; ++t)
            tab[t].place(shiftOf(t % VT_PROFILES), cyc);
        // the lift command, and the table it reads
        if (liftOn != 0)
        {
            liftCmd = fminf(fmaxf(liftTarget >= 0.0f ? liftTarget : (liftThr != 0 ? load : 1.0f), 0.0f), 1.0f);
            if ((dirty & (((1 << VT_LIFTS) - 1) << VT_LIFT0)) == 0 && fabsf(liftCmd - liftMade) > 0.002f)
            {
                const float x = liftCmd * (float)(VT_LIFTS - 1);
                int j = (int)x;
                if (j > VT_LIFTS - 2)
                    j = VT_LIFTS - 2;
                inLive.blend(&tab[newest(VT_LIFT0 + j)], &tab[newest(VT_LIFT0 + j + 1)], x - (float)j);
                inLive.noTail();
                liftMade = liftCmd;
            }
            inLive.place(-phIn.phase, cyc);
        }
        // the stage: up above the speed, down below it less the hysteresis, only with oil pressure and warm
        if (stagesOn != 0 && pOil > 100000.0f && tOil > 333.0f)
        {
            if (stageWant == 0 && omega > stageUp)
                stageWant = 1;
            else if (stageWant == 1 && omega < stageUp - stageHyst)
                stageWant = 0;
        }
        else
            stageWant = 0;
        // deactivation: in its speed window, under its load, warm
        if (deacMask != 0 && omega > deacLo && omega < deacHi && load < deacLoad && tOil > 333.0f)
            deacWant = 1;
        else if (deacWant == 1 && (deacMask == 0 || omega < deacLo * 0.95f || omega > deacHi * 1.05f
                                   || load > deacLoad + 0.05f || tOil < 333.0f))
            deacWant = 0;
        // each cylinder moves to what it should read while the valve it changes is shut in both tables
        const int tIn = newest(VT_IN_A + stageWant);
        const int tEx = newest(VT_EX_A + stageWant);
        int mask = 0;
        for (int c = 0; c < nCyl; ++c)
        {
            const float a = ang[c];
            if (useIn[c] != tIn && tab[useIn[c]].at(a, cyc) <= 0.0f && tab[tIn].at(a, cyc) <= 0.0f)
                useIn[c] = tIn;
            if (useEx[c] != tEx && tab[useEx[c]].at(a, cyc) <= 0.0f && tab[tEx].at(a, cyc) <= 0.0f)
                useEx[c] = tEx;
            const int rest = deacWant != 0 && (deacMask & (1 << c)) != 0 ? 1 : 0;
            if (rest != offEx[c] && powerStroke(c, a) != 0)
            {
                offEx[c] = rest;
                offIn[c] = rest;
            }
            if (offIn[c] == 0)
                mask = mask | (1 << c);
        }
        activeMask = mask;
        // float: past its speed the valves land late and bounce
        flt.sevIn = flt.severity(omega, flt.omegaIn);
        flt.sevEx = flt.severity(omega, flt.omegaEx);
        floating = flt.sevIn > 0.0f || flt.sevEx > 0.0f ? 1 : 0;
        clatter = fminf(fmaxf(flt.sevIn, flt.sevEx), 1.0f);
        const float sevNow = flt.sevIn + flt.sevEx;
        if (fabsf(sevNow - sevMade) > 0.01f || (sevNow == 0.0f && sevMade != 0.0f))
        {
            sevMade = sevNow;
            for (int g = 0; g < 2; ++g)
            {
                flt.tailFor(&tab[VT_IN_A + VT_PROFILES * g], flt.sevIn);
                flt.tailFor(&tab[VT_IN_B + VT_PROFILES * g], flt.sevIn);
                flt.tailFor(&tab[VT_EX_A + VT_PROFILES * g], flt.sevEx);
                flt.tailFor(&tab[VT_EX_B + VT_PROFILES * g], flt.sevEx);
            }
        }
        show();
    }

    // The events as they are now (cylinder 0's tables), and the overlap at 1 mm
    void show()
    {
        AreaTable* ti = inTable(0);
        AreaTable* te = &tab[useEx[0]];
        showIvo = ti->openNow;
        showIvc = vtWrap(ti->openNow + ti->span, cyc);
        showEvo = te->openNow;
        showEvc = vtWrap(te->openNow + te->span, cyc);
        // 1 mm: from each cam's own curve, moved as its table is
        CamShape* ci = &cam[liftOn != 0 ? VT_IN_A : useIn[0] % VT_PROFILES];
        CamShape* ce = &cam[useEx[0] % VT_PROFILES];
        const float in1 = vtWrap(ti->openNow + ci->rise1 * ti->span / ci->span, cyc);
        const float ex1 = vtWrap(te->openNow + ce->span - ce->rise1, cyc);
        float ov = ex1 - in1;
        if (ov > 360.0f)
            ov -= cyc;
        if (ov < -360.0f)
            ov += cyc;
        overlap1mm = fmaxf(ov, 0.0f);
    }
};
