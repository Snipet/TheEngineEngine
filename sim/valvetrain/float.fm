// float.fm: valve float, the speed past which a valve leaves its cam.
//
// Over the nose of a lobe the cam decelerates the valve: it would fly on, and only the spring holds it to the cam. The
// spring's force there is its preload plus its rate times the lift; what it must hold is the valvetrain's effective
// mass (the valve, the retainer, a third of the spring, and the follower, rocker, pushrod and lifter as the valve
// feels them) times the cam's deceleration, which goes as the square of the speed. Past the speed where the two meet
// the valve leaves the cam over the nose, lands late on the closing flank, and bounces on its seat:
//
//   w_float = min over the nose of sqrt((F0 + k L(th)) / (m |d2L/dth2|))      (crank radians, th the crank's angle)
//
// The effective masses added to the valve's own, by kind (judgement, from published valvetrain masses: a small-block
// V8's pushrod train weighs some 0.2 kg more at the valve than its valve does, a bucket's some 0.06): a pushrod's
// 0.20 kg, a rocker's (an overhead cam's rocker arm) 0.08, a bucket's 0.06, a finger follower's 0.045. A pneumatic
// spring (Formula 1's) never floats here. A valve's own mass left at 0 is a steel valve's for its diameter, 0.10 kg at
// 49 mm (a small-block's intake) as the diameter's 2.5th power.
//
// Beyond it (s = (w / w_float)^2 - 1 above 0) the valve lands late and bounces: a little area for some degrees after it
// should be shut, a tail on the area table (AreaTable::tail): bounces of a fifth of the lift's area falling away over
// 10 + 30 s degrees (at most 40), as high as 0.15 s of the most area (at most 0.3). The cylinder loses its charge back
// into the runner and the overlap draws exhaust back: the power falls over, from the gas model itself. Each landing is
// a clatter for the sound (clatter, 0 to 1). No damage. The bounce's size and length are judgement.
#pragma once
#include "area.fm"

module ValveFloat
{
    float omegaIn;      // the speed (crank rad/s) where each valve begins to float (0: never)
    float omegaEx;
    float sevIn;        // how far past it, now (0: not floating)
    float sevEx;

    // The effective mass (kg) of a valve of diameter d (m), mass (0: from the diameter), and its train's kind
    // (0 pushrod, 1 rocker, 2 bucket, 3 finger, 4 pneumatic)
    float massOf(float d, float mass, int kind)
    {
        const float mv = mass > 0.0f ? mass : 0.10f * expf(2.5f * logf(fmaxf(d, 0.005f) / 0.049f));
        float add = 0.20f;
        if (kind == 1)
            add = 0.08f;
        else if (kind == 2)
            add = 0.06f;
        else if (kind == 3)
            add = 0.045f;
        return mv + add;
    }

    // The float speed (crank rad/s) for a cam, a spring (rate N/m, preload N) and an effective mass (kg): 0 when the
    // spring is unset or pneumatic. Scans the curve (off the per-sample path: when the Spec moves)
    float speedFor(CamShape* cam, float rate, float preload, float mass, int kind)
    {
        if (kind == 4 || rate <= 0.0f || mass <= 0.0f)
            return 0.0f;
        const int n = 720;
        const float h = cam->span / (float)n;           // degrees
        const float hr = h * 0.01745329f;               // radians
        float best = 1.0e9f;
        for (int i = 1; i < n; ++i)
        {
            const float s = h * (float)i;
            const float l0 = cam->lift01(s - h);
            const float l1 = cam->lift01(s);
            const float l2 = cam->lift01(s + h);
            const float acc = cam->lift * (l2 - 2.0f * l1 + l0) / (hr * hr);    // m per rad^2
            if (acc < 0.0f)
            {
                const float w2 = (preload + rate * cam->lift * l1) / (mass * -acc);
                best = fminf(best, w2);
            }
        }
        return best < 1.0e8f ? sqrtf(best) : 0.0f;
    }

    // How far past the float speed omega (rad/s) is: 0 below it
    float severity(float omega, float omegaF)
    {
        if (omegaF <= 0.0f)
            return 0.0f;
        const float r = omega / omegaF;
        return fmaxf(r * r - 1.0f, 0.0f);
    }

    // A table's tail for a severity
    void tailFor(AreaTable* t, float sev)
    {
        if (sev <= 0.0f)
        {
            t->noTail();
            return;
        }
        t->tailDeg = fminf(10.0f + 30.0f * sev, 40.0f);
        t->tailK = (float)VT_TAIL / t->tailDeg;
        const float amp = fminf(0.15f * sev, 0.3f) * t->peak;
        for (int i = 0; i <= VT_TAIL; ++i)
        {
            // two bounces, each a half sine, the second a third of the first
            const float u = (float)i / (float)VT_TAIL;
            const float b = u < 0.6f ? sinf(3.14159265f * u / 0.6f) : 0.33f * sinf(3.14159265f * (u - 0.6f) / 0.4f);
            t->tail[i] = amp * b;
        }
    }
};
