// area.fm: from a valve's lift to the area the gas sees, and the tables the cylinder reads.
//
// A poppet valve's flow is limited by the curtain while it is low (the cylinder of air between the valve's head and its
// seat, pi d L) and by the port and the throat once it is lifted past about a quarter of its diameter, where more lift
// buys little. The discharge coefficient falls as the lift rises (the jet separates from the seat). The reference
// (cylinder.fm, flowArea) has that shape as measured valves have it, tanh(1.7 l) with l the lift over a quarter of the
// diameter, about 0.6 of the curtain at a tenth of the diameter and 0.4 of the valve's area at a quarter. This keeps
// its form and gives it the geometry:
//
//   A(L) = n min(q A0, A0'(0) L),   A0 = 0.4 (pi d^2 / 4) tanh(6.8 L / d) / tanh(1.7)
//
// n valves of diameter d, q the port's quality (1: the reference's coefficients; a good racing port flows some 20 to
// 30 % more at the same valve). Low down this is 0.73 of the curtain (four-valve heads: 0.66 and 0.63, below), at
// L = d / 4 it is 0.4 of the valves' area, and above it flattens (6 % more at d / 3). The diameter left at 0 is chosen from the bore as real heads have it
// (docs/models/valvetrain.md lists the heads): two valves a cylinder, an intake of 0.48 of the bore and an exhaust of
// 0.39; three (two intakes), 0.37 and 0.44; four, 0.39 and 0.33; five (three intakes), 0.32 and 0.33.
//
// An AreaTable is one profile's effective area (m^2) over its event, 129 points, rebuilt only when what made it
// changes (lab.fm: at the 16-sample rate, one table a tick at most). The cylinder's per-sample read is the reference's
// areaAt: an offset, a compare, one interpolation. A floating valve's late landing and bounce add a short tail after
// the event (float.fm), read only past the event's end.
//
// What it leaves out: the stem's and the guide's blockage, the port's own resonances (the runner's waveguide has
// those), the swirl and tumble a port makes.
#pragma once
#include "cam.fm"

enum { VT_TAIL = 16 };

module Head
{
    int nIn;            // valves a cylinder
    int nEx;
    float dIn;          // their diameters (m)
    float dEx;
    float qIn;          // the ports' quality
    float qEx;
    float kIn;          // the low-lift curtain's share of the base form's slope (1: 0.73 of pi d L; below)
    float kEx;

    // valves: 2 to 5 a cylinder; dIn, dEx: 0 to choose from the bore
    void setup(int valves, float bore, float dInSpec, float dExSpec, float qInSpec, float qExSpec)
    {
        const int v = valves < 2 ? 2 : (valves > 5 ? 5 : valves);
        float fi = 0.48f;
        float fe = 0.39f;
        nIn = 1;
        nEx = 1;
        if (v == 3)
        {
            nIn = 2;
            fi = 0.37f;
            fe = 0.44f;
        }
        else if (v == 4)
        {
            nIn = 2;
            nEx = 2;
            fi = 0.39f;
            fe = 0.33f;
        }
        else if (v == 5)
        {
            nIn = 3;
            nEx = 2;
            fi = 0.32f;
            fe = 0.33f;
        }
        dIn = dInSpec > 0.0f ? dInSpec : fi * bore;
        dEx = dExSpec > 0.0f ? dExSpec : fe * bore;
        qIn = qInSpec > 0.0f ? qInSpec : 1.0f;
        qEx = qExSpec > 0.0f ? qExSpec : 1.0f;
        // The low-lift curtain's coefficient by the head's valves (card N1, 25 Nov; the lead's ruling on the table).
        // Four valves: 0.66 of pi d L intake, 0.63 exhaust, the medians at 0.100 in of nine production four-valve
        // heads' flow sheets at 28 in (Stan Weiss's compilation, a secondary source; valves stated per row): intake
        // 0.60, 0.64, 0.66, 0.66, 0.66, 0.67, 0.67, 0.73, 0.79; exhaust 0.60, 0.60, 0.60, 0.61, 0.63, 0.64, 0.64, 0.72,
        // 0.76 (docs/measurements/calibration/na/flow-sheets-vs-seat.md). Two valves keep the base form's 0.73: two
        // heads measured (the LS7 0.70 / 0.67, the 882 0.78 / 0.84) straddle it and are too few to move it. Three and
        // five valves: no sheet, unchanged. Below 0.100 in (2.5 mm) nothing is measured: the same slope carried down.
        // It does not close N3-16 (the idle's burned share; that closes on the cards) and is tuned to no row.
        kIn = v == 4 ? 0.66f / 0.72696f : 1.0f;
        kEx = v == 4 ? 0.63f / 0.72696f : 1.0f;
    }

    // The effective area (m^2) of n valves of diameter d, quality q, at lift L (m), k the low-lift curtain's share
    // (1: the old expression bit for bit)
    float areaOf(int n, float d, float q, float l, float k)
    {
        if (l <= 0.0f)
            return 0.0f;
        // (the lesser of the port's limit and the curtain's: the port's quality acts where the port limits, and low down
        // the curtain limits whatever the port, at the base form's own low-lift slope, 0.73 of the curtain (Heywood,
        // Internal Combustion Engine Fundamentals, section 6.3: the flow's regimes by lift). The two meet at a lift of
        // 0.12 of the diameter for a quality of 1.35, 0.19 for 1.8, below the peak lifts, so the peaks are as before.
        // With the quality on every lift the default ports (1.35, 1.5) were given 1.0 to 1.1 of the geometric curtain
        // at low lift and the V10's and V12's (1.65, 1.8) 1.2 to 1.3, more than the gap can pass: the overlap's backflow
        // ran high, the warm idle's burned share at intake closing 0.49 and 0.52 (N3, causes.md N3-16: 0.10 by Fox,
        // Cheng and Heywood's correlation, SAE 931025) and their idles wandered sd 12 and 18 rpm (card N1, 25 Nov))
        const float base = 0.4f * 0.785398f * d * d * tanhf(6.8f * l / d) / 0.9354f;
        const float curtain = 0.4f * 0.785398f * d * 6.8f * l / 0.9354f;
        return (float)n * fminf(q * base, k < 1.0f ? k * curtain : fmaxf(curtain, base));
    }

    float areaIn(float l)
    {
        return areaOf(nIn, dIn, qIn, l, kIn);
    }

    float areaEx(float l)
    {
        return areaOf(nEx, dEx, qEx, l, kEx);
    }
};

module AreaTable
{
    float a[VT_POINTS]; // m^2 over the event
    float open;         // where the event starts (the cycle's angle, before any phasing)
    float openNow;      // and where it starts now, the phaser's shift added (place)
    float span;         // its degrees
    float k;            // VT_STEPS / span
    float peak;         // the most it reaches
    // a floating valve's tail: tailDeg degrees past the event, its area tail[] (0 when it does not float)
    float tailDeg;
    float tailK;
    float tail[VT_TAIL + 1];
    float leak;         // a floating valve that no longer seals: the area it leaves open while it should be shut (0)

    // From a cam's shape: ex 0 the intake's valves, 1 the exhaust's
    void build(CamShape* cam, Head* head, int ex)
    {
        open = cam->open;
        openNow = open;
        span = cam->span;
        k = (float)VT_STEPS / span;
        peak = 0.0f;
        for (int i = 0; i < VT_POINTS; ++i)
        {
            const float l = cam->lift * cam->shape[i];
            a[i] = ex != 0 ? head->areaEx(l) : head->areaIn(l);
            peak = fmaxf(peak, a[i]);
        }
    }

    // This table as a blend of two others (the same open and span assumed): t 0 is x, 1 is y
    void blend(AreaTable* x, AreaTable* y, float t)
    {
        float d = y->open - x->open;
        if (d > 360.0f)
            d -= 720.0f;
        if (d < -360.0f)
            d += 720.0f;
        open = vtWrap(x->open + d * t, 720.0f);
        openNow = open;
        span = x->span + (y->span - x->span) * t;
        k = (float)VT_STEPS / span;
        peak = 0.0f;
        for (int i = 0; i < VT_POINTS; ++i)
        {
            a[i] = x->a[i] + (y->a[i] - x->a[i]) * t;
            peak = fmaxf(peak, a[i]);
        }
    }

    void noTail()
    {
        tailDeg = 0.0f;
        tailK = 0.0f;
        leak = 0.0f;
        for (int i = 0; i <= VT_TAIL; ++i)
            tail[i] = 0.0f;
    }

    // The event moved later by shift degrees (a phaser's; negative: earlier), every 16 samples
    void place(float shift, float cyc)
    {
        openNow = vtWrap(open + shift, cyc);
    }

    // The area (m^2) at the cylinder's angle (degrees, 0 to cyc)
    float at(float ang, float cyc)
    {
        float s = ang - openNow;
        if (s < 0.0f)
            s += cyc;
        if (s >= span)
        {
            const float t = s - span;
            if (t >= tailDeg)
                return leak;
            const float y = t * tailK;
            int j = (int)fminf(fmaxf(y, 0.0f), (float)(VT_TAIL - 1));
            if (j > VT_TAIL - 1)
                j = VT_TAIL - 1;
            return tail[j] + (tail[j + 1] - tail[j]) * (y - (float)j);
        }
        const float x = s * k;
        int i = (int)fminf(fmaxf(x, 0.0f), (float)(VT_STEPS - 1));
        if (i > VT_STEPS - 1)
            i = VT_STEPS - 1;
        return a[i] + (a[i + 1] - a[i]) * (x - (float)i);
    }
};
