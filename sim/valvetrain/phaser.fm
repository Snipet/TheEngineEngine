// phaser.fm: a cam phaser (variable valve timing): the cam turned against its sprocket by oil.
//
// A vane phaser is a hydraulic actuator in the cam's sprocket: the engine's oil, let into one side of its vanes or the
// other by a solenoid valve the ECU drives, turns the cam some tens of degrees against the crank. Its speed is the oil's:
// with too little pressure it cannot move (a lock pin holds it at its parked end, and the cam's own torque pushes it
// back there), and thick cold oil moves it slowly. It never goes past its stops.
//
// Here the phase is degrees of the crank away from the parked end, 0 to range. The intake's phaser advances its cam
// (the events earlier), the exhaust's retards its own (later), as most engines' do: both park where the engine starts
// and idles best (the least overlap). The target is the ECU's (card H's maps); an engine without one has the schedule
// of schedule() below. The phase moves toward the target at rate (degrees a second, warm and at full pressure), less
// with less oil pressure (none below 70 kPa, all of it from 200 kPa: some 10 and 29 psi) and slower cold (a quarter of
// it at 40 C, all of it from 80 C); below 40 C, or with no pressure, it is parked: it goes back to 0 at half its rate,
// whatever the target. Every number here but the stops is judgement: docs/models/valvetrain.md says which.
//
// Only the events' angles move (AreaTable::place): no table is rebuilt.
#pragma once

module Phaser
{
    float range;        // degrees from parked to the far stop (0: no phaser)
    float rate;         // degrees a second, warm, at full pressure
    float target;       // degrees from parked, asked
    float phase;        // and reached
    int parked;         // 1: held at its parked end (cold, or no oil pressure)

    void setup(float rangeIn, float rateIn)
    {
        range = fmaxf(rangeIn, 0.0f);
        rate = fmaxf(rateIn, 1.0f);
        phase = fminf(phase, range);
        target = fminf(target, range);
    }

    void reset()
    {
        phase = 0.0f;
        target = 0.0f;
        parked = 1;
    }

    // Every 16 samples (d16 seconds): toward want (degrees from parked), with the oil's pressure (Pa above the air's)
    // and temperature (K)
    void control(float d16, float want, float pOil, float tOil)
    {
        target = fminf(fmaxf(want, 0.0f), range);
        parked = tOil < 313.0f || pOil < 70000.0f ? 1 : 0;
        if (range <= 0.0f)
        {
            phase = 0.0f;
            return;
        }
        float goal = target;
        float r = 0.5f * rate;
        if (parked == 0)
        {
            const float fp = fminf((pOil - 70000.0f) / 130000.0f, 1.0f);
            const float ft = fminf(fmaxf(0.25f + 0.75f * (tOil - 313.0f) / 40.0f, 0.25f), 1.0f);
            r = rate * fp * ft;
        }
        else
            goal = 0.0f;
        const float step = r * d16;
        const float e = goal - phase;
        phase += fminf(fmaxf(e, -step), step);
        phase = fminf(fmaxf(phase, 0.0f), range);
    }

    // A schedule for an engine whose ECU has none (degrees from parked, for the speed's share of the redline and the
    // load, 0 to 1). The exhaust's (in 0): retard at part load in the middle (overlap draws exhaust back: internal
    // EGR, less pumping), none at full load.
    //
    // The intake's (in 1) is scheduleIntake below: what a calibrator moves is where the intake valve closes. Early at
    // low speed, so the piston does not push back what it drew in; late at speed, where the charge's momentum still
    // flows in after bottom dead centre (Heywood, Internal Combustion Engine Fundamentals, section 6.3: the closing for
    // the most air moves later with speed). The target, at the seat: 20 degrees after bottom at a quarter of the
    // redline and below, rising to 67 at three quarters of it and above (makers' full-load closings run from 30 to 40
    // at low speed to 60 to 75 at the top). The advance is what brings this cam's parked closing there, so a long cam
    // parked late takes much and a short one little. Card N1's sweeps on three archetypes (a V12, a 3.2 six and a 1.5
    // four, with their own runners) put this within 7 % of each one's best fixed advance at every speed: no single
    // rule does better, since the best closing also follows where the runner's ram is tuned (the 1.5 four wanted its
    // earliest closing in mid range); an ECU map baked by a sweep (card C) is the exact answer. No overlap cap: one
    // was tried (40 + 60 x the speed's share, degrees) while the cylinder still made mass on its backflow; with the
    // cylinder conserving, the long cams wanted 80 degrees of overlap at 2000 rpm, and the cap cost them 15 %. At idle
    // none (the overlap dilutes a thin charge), and less at part load, as before.
    float schedule(float speedShare, float load, int intake)
    {
        const float x = fminf(fmaxf(speedShare, 0.0f), 1.2f);
        const float l = fminf(fmaxf(load, 0.0f), 1.0f);
        const float up = fminf(fmaxf((x - 0.12f) / 0.13f, 0.0f), 1.0f);
        const float dn = 1.0f - fminf(fmaxf((x - 0.5f) / 0.35f, 0.0f), 1.0f);
        if (intake != 0)
            return range * up * dn * (0.4f + 0.6f * l);
        return range * up * dn * (1.0f - l);
    }

    // ivcParked: the intake's closing at the seat, degrees after bottom dead centre, with the phaser parked
    float scheduleIntake(float speedShare, float load, float ivcParked)
    {
        const float x = fminf(fmaxf(speedShare, 0.0f), 1.2f);
        const float l = fminf(fmaxf(load, 0.0f), 1.0f);
        const float up = fminf(fmaxf((x - 0.12f) / 0.13f, 0.0f), 1.0f);
        const float s = fminf(fmaxf((x - 0.25f) / 0.5f, 0.0f), 1.0f);
        const float ivcWant = 20.0f + 47.0f * s;
        return fminf(fmaxf(ivcParked - ivcWant, 0.0f), range) * up * (0.4f + 0.6f * l);
    }
};
