// idle.fm: the speed the ECU goes by, the idle (its speed, the idle valve, the spark's quick trim) and the driver that
// holds ctl.holdSpeed (ecu.model 1). Each is the reference's control16 as it was, moved here with its explanations; the
// speeds are rpm inside, as the reference's.
//
// The speed: the crank's, its firing ripple smoothed out (35 ms), and how fast it changes (50 ms). The idle speed: the
// layout's, moved by the trim, raised for a big cam (its overlap dilutes the idle more the slower it turns: its tune
// idles it higher, as real ones are) and for a cold engine (its ECU idles it up to 500 rpm higher, a diesel's 250, as
// the coolant is colder than 55 C: at 80 F some 190, at 0 F some 420; none once warm). The idle valve holds that speed
// by an integral (slow: the plenum lags) and a proportional part on where the speed is going; the spark, which acts
// at once, gives more torque when the speed sags and less when it runs up. Driven, it is an ECU's idle spark: with the
// pedal up it takes the torque down as far as idling needs (no step back to full at idle + 450, which made an engine
// whose cam and boost give more than its friction there run up into the overrun cut and out again), with the pedal
// down it only helps below the idle, against a stall. Coasting down from speed the valve stays open a little (a
// dashpot), so the plenum is not pulled to nothing.
//
// The driver for ctl.holdSpeed (the reference's key governor): the pedal toward the speed asked, gently near it (an
// integral finds the throttle that holds it), hard when far below, looking ahead at the rate the speed goes (the
// plenum and the cycle lag the pedal); holding, it trims the spark the same way, with an integral (no steady error).
#pragma once

module EcuSpeed
{
    float rpm;          // the crank's, now
    float avg;          // the firing's ripple smoothed out
    float rate;         // rpm/s, smoothed
    float last;
    float kAvg;         // the smoothings' steps, every 16 samples
    float kRate;

    void setup(float d16)
    {
        kAvg = 1.0f - expf(-d16 / 0.035f);
        kRate = 1.0f - expf(-d16 / 0.05f);
    }

    void reset()
    {
        rpm = 0.0f;
        avg = 0.0f;
        rate = 0.0f;
        last = 0.0f;
    }

    void control(float omega, float d16)
    {
        rpm = omega * 9.5492966f;
        avg += (rpm - avg) * kAvg;
        rate += ((avg - last) / d16 - rate) * kRate;
        last = avg;
    }
};

module IdleControl
{
    float target;       // the idle speed now, rpm
    float integral;     // the idle valve's integral
    float slow;         // the speed over some 0.5 s (how far off the target it stands, for the valve's gain)
    float bypass;       // the idle valve, 0 to 1
    float trim;         // the spark's quick hand: the torque over the map's, 0.3 to 1.35
    float look;         // the spark trim's look-ahead on the speed's rate, s: the manifold's filling time (Ecu sets it; the
                        // reference's 0.08 when the plenum is unknown)
    float startAir;     // the valve's integral as the engine caught (its start position): the after-start air
    float trimInt;      // its integral (model 1's own): what the spark must take out to hold the idle once the valve is
                        // shut, the torque in reserve a real idle's retarded spark keeps

    void reset()
    {
        integral = 0.0f;
        slow = 0.0f;
        look = 0.08f;
        startAir = 0.0f;
        bypass = 0.0f;
        trim = 1.0f;
        trimInt = 0.0f;
    }

    // A cold engine's fast idle, rpm over the warm idle: up to `rise` (500; a diesel's 250) as the coolant (K) is
    // colder than 328 K
    float coldIdle(float coolant, float rise)
    {
        return rise * fminf(fmaxf((328.0f - coolant) / 75.0f, 0.0f), 1.0f);
    }

    // The idle speed: the base (the layout's, and the trim), the cam's share of overlap over 0.35 (the reference's cam
    // dial, 0 to 1), the coolant
    void speed(float base, float cam, float coolant, float rise)
    {
        target = fmaxf(base + 350.0f * fmaxf(cam - 0.35f, 0.0f) / 0.65f + coldIdle(coolant, rise), 350.0f);
    }

    // Every 16 samples: the speed, the pedal, whether driven (a car's idle spark), seconds since the pedal lifted, the
    // actual speed (for the dashpot), whether a gasoline engine (a diesel has no dashpot), seconds since it started
    void control(EcuSpeed* s, float pedal, bool driven, float sinceLift, bool gasoline, float sinceStart, float d16)
    {
        const float ie = (target - s->avg) * 0.001f;
        const float iep = (target - s->avg - 0.2f * s->rate) * 0.001f;
        // (not down through the start and post-start phase, the first 3 s, as Bosch's idle-speed control holds its
        // integrator then (Gasoline-Engine Management: the start and post-start phases): the start's flare is the
        // proportional part's to shave, not the integral's to unlearn. Unlearned, it left the valve at its idle
        // position as the speed fell through the target after the flare, and every warm start dipped: the first
        // build to 641 rpm against 750, the 7.0 to 433, a 1.5 four to 645, the V10 and V12 to some 720 against 900,
        // 2 to 3 s to recover (card N1, 25 Nov; held: 737, 677, 735, 883, 865))
        if (s->avg < target + 500.0f && !(gasoline && sinceStart < 3.0f && ie < 0.0f))
            integral = fminf(fmaxf(integral + 0.5f * ie * d16, 0.0f), 1.0f);
        // (the valve's proportional part half the reference's near the target: the plenum's filling lags the valve by
        // some 0.1 s, and at
        // the reference's gain the loop is marginal: it hunts plus or minus 100 rpm from some starts. The spark, which
        // acts within a cycle, is the fast hand). A diesel's "valve" is its idle fuel (no plenum between): four times it
        // Far from the target (a start's flare and fall, a stall coming) the reference's full gain, to catch it
        // and for 3 s after a start, whose flare falls fast toward a stall
        // (the gain rises from a quarter to a half as the speed stands 150 to 300 rpm off the target: read over some 0.5 s
        // (and at once below 0.6 of the target, a stall coming), not on the quick average. On the quick one a big cam's
        // lope (its dilution recursion, a period near 0.4 s, swinging some 200 rpm) read as far off and doubled the
        // gain on a valve whose air arrives half a lope late: the turbo six (cam 0.9999) on the bench with the intake
        // and boost models hunted sd 151 rpm, the valve swinging 0.04 to 0.52; with the gain read slow, 127, the
        // V10's, V12's and turbo four's warm idles unchanged (17.7, 12.7, 6.3 against 17.7, 9.4, 6.3). The valve's
        // quick reading itself stays: read slow (0.15 or 0.5 s) or without its rate, the V10 and V12 hunted 41 to 160
        // rpm, their plenum's loop wanting it. 0.5 s: judgement, longer than a lope)
        slow += (s->avg - slow) * (1.0f - expf(-d16 / 0.5f));
        const float off = s->avg < 0.6f * target ? 1.0f : fminf(fmaxf((fabsf(target - slow) * 0.001f - 0.15f) / 0.15f, 0.0f), 1.0f);
        const float near = !gasoline ? 1.0f : (sinceStart < 3.0f ? 0.5f : 0.25f + 0.25f * off);
        bypass = fminf(fmaxf(integral + near * iep, 0.0f), 1.0f);
        // the spark's integral: with the pedal up near the idle and the valve shut (it can take no more air away), the
        // spark takes the excess torque out over a second or two; it gives it back as the valve opens again
        // (and gives it back at once under the target: after a start's flare the integral must not hold the torque down
        // as the speed falls, or it stalls)
        if (pedal < 0.02f && s->avg < target + 450.0f && integral <= 0.0f && ie < 0.0f)
            trimInt = fmaxf(trimInt + 1.0f * ie * d16, -0.6f);
        else
            trimInt = fminf(trimInt + (ie > 0.0f ? 4.0f : 0.5f) * d16, 0.0f);
        // (the spark's hand looks ahead at the speed's rate by the manifold's filling time: the torque answers the plenum,
        // which lags the speed by that much. The reference's 0.08 s is the filling time of a 5.7 V8 on a 2.5 L plenum
        // (0.075); on a 7.0 L V8's 5.6 L plenum (0.128) it was too short and the idle loped 640 to 860 rpm (card N1))
        const float tr = 1.0f + 1.6f * (target - s->avg - look * s->rate) * 0.001f + trimInt;
        if (driven)
            trim = pedal < 0.02f ? fminf(fmaxf(tr, 0.3f), 1.35f) : fminf(fmaxf(tr, 1.0f), 1.35f);
        // (on the bench and the dyno the same rule for the pedal open: an idle spark trim belongs to a released pedal,
        // and with it open it only helps below the idle, against a stall. Before, it cut the torque toward 0.3 above
        // the idle with the pedal floored, to idle + 450 rpm, where it stepped back to full: a full-load dyno point or a
        // free rev's climb in that band ran on as little as a third of its torque. The lead's ruling, 25 Nov)
        else if (pedal >= 0.02f)
            trim = s->avg < target + 450.0f ? fminf(fmaxf(tr, 1.0f), 1.35f) : 1.0f;
        else
            trim = s->avg < target + 450.0f ? fminf(fmaxf(tr, 0.3f), 1.35f) : 1.0f;
        // after the start, the valve closes no faster than its start position decays (2 s): an idle actuator gives
        // the start and after-start air (Bosch, Gasoline-Engine Management: idle-speed control, start and post-start
        // phases) and is not snapped shut by the start's flare. Without it the proportional part on the flare's rate
        // shut the valve at the catch, a warm 7.0 L V8's plenum fell to 39 kPa while it ran at 1100 rpm, its charge to a
        // tenth, and it stalled (card N1, p-idle-warm). The start position is the integral's as it cranked (the
        // proportional part already read the flare); the 2 s is judgement ("a few seconds")
        if (gasoline && sinceStart <= 0.0f)
            startAir = integral;
        if (gasoline)
            bypass = fmaxf(bypass, startAir * expf(-sinceStart / 2.0f));
        if (gasoline)
            bypass = fmaxf(bypass, 0.35f * fminf(fmaxf((s->rpm - target - 400.0f) * 0.001f, 0.0f), 1.0f) * expf(-sinceLift / 0.6f));
    }
};

module SpeedDriver
{
    float integral;     // the pedal's integral
    float trimInt;      // the spark trim's
    float pedal;        // what it asks
    bool holding;       // it is near enough to trim the spark
    float trim;         // its spark trim (1: none)

    void reset()
    {
        integral = 0.0f;
        trimInt = 0.0f;
        pedal = 0.0f;
        holding = false;
        trim = 1.0f;
    }

    // Every 16 samples: the speed asked (rpm; at or under the idle + 120, nothing), the speed, the idle speed, the most
    // pedal (1)
    void control(float want, EcuSpeed* s, float idle, float most, float d16)
    {
        holding = false;
        trim = 1.0f;
        if (want <= idle + 120.0f)
        {
            integral *= 0.98f;
            trimInt *= 0.95f;
            pedal = 0.0f;
            return;
        }
        const float e = (want - s->avg) * 0.001f;
        const float ep = (want - s->avg - 0.15f * s->rate) * 0.001f;
        const float pp = 0.15f * ep + 1.5f * fmaxf(ep - 0.7f, 0.0f);
        const float raw = pp + integral;
        if (fabsf(e) < 2.0f && !(raw > most && e > 0.0f) && !(raw < 0.0f && e < 0.0f))
            integral = fminf(fmaxf(integral + 0.8f * e * d16, 0.0f), most);
        pedal = fminf(fmaxf(pp + integral, 0.0f), most);
        if (s->avg > want - 400.0f)
        {
            holding = true;
            trimInt = fminf(fmaxf(trimInt + 0.004f * (want - s->avg) * d16, -0.4f), 0.3f);
            trim = fminf(fmaxf(1.0f - 2.5f * (s->avg + 0.05f * s->rate - want) * 0.001f + trimInt, 0.1f), 1.3f);
        }
        else
            trimInt *= 0.95f;
    }
};
