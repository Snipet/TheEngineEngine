// gearbox.fm: the gearbox's logic, every 16 samples: which gear is in, which is coming, and how far each coupling is
// closed. vehicle.fm's step turns that into torques each sample.
//
// Five kinds (spec.car.gearbox):
//
//   Manual. An H-pattern lever (ctl.lever) and a clutch pedal, as the reference's: moving the lever takes the gear
//     out; the new one goes in when the clutch is down (the pedal past 85 % of its travel) or the input's speed is
//     within 30 rad/s of what the gear wants (a synchromesh matches the rest), otherwise it is refused and stays
//     pending until one of the two is true. With the lever in neutral the shift counters work it as the reference's
//     paddles do: a robotised clutch that closes with the revs from just over idle, opens for a shift, the new gear
//     in at 50 ms, closed again by 210 ms; an upshift asks for an ignition cut of 60 ms, a downshift for a blip.
//   Sequential (a dog box). The counters, one gear at a time. An upshift under power asks for a cut of 60 ms and
//     needs no clutch: the dogs come out at once, the next gear's go in 25 ms later, whatever the speeds, and the
//     clutch (still closed) takes up the difference with a jolt the driveline's play turns into a clunk. A downshift
//     asks for a blip to the lower gear's speed, the dogs in after 60 ms. Pulling away uses the same robotised clutch.
//   Dual clutch. The counters. The next gear is already in on the other shaft; its clutch closes as the first opens,
//     over the shift time (0.15 s by default), so the torque passes from one to the other with no gap. A downshift
//     asks for a blip.
//   Automatic. A torque converter (converter.fm), and clutches and bands that change gear by handing over, as the
//     dual clutch does, over 2.5 times the shift time (0.375 s). The lever: R, N, D (any forward position). A shift
//     schedule by the input's speed and the pedal (light pedal: up at 30 % of the way from idle to the redline;
//     full: at 90 %), a downshift when the input falls to 10 to 45 % of it, and a kickdown (the pedal past 90 %)
//     to the lowest gear that keeps the engine under 80 % of its redline. A lock-up clutch from third, released
//     for each shift and at full pedal.
//   CVT. A converter and a belt whose ratio moves (at most 1.5 times a second, in ratio's logarithm) to hold the
//     engine at a speed the pedal sets: a little over idle when it is light, 90 % of the redline when it is down;
//     within its span, at the belt's efficiency. Its lock-up closes above 20 km/h.
//
// Ratios here are the gearbox's (crank turns to the output's turn); the final drive multiplies them all.
#pragma once
#include "vspec.fm"

module VehGearbox
{
    int kind;
    int n;              // forward gears
    float r[VEH_GEARS]; // the forward ratios
    float rRev;
    float fd;           // the final drive
    float cvtLo;
    float cvtHi;
    float cvt;          // the CVT's ratio now
    // the state
    int gear;           // the gear in: -1 R, 0 N, 1 to n
    int pend;           // the lever's gear waiting for the clutch or the synchromesh (manual)
    bool refused;
    int lastLever;
    int lastUp;
    int lastDown;
    bool paddles;       // a manual's lever in neutral: the counters work it
    bool shifting;
    int from;           // a shift's gears
    int to;
    float t;            // seconds into it
    float dur;
    bool up;
    float aFrom;        // how far the old gear's coupling is closed, 0 to 1
    float aTo;          // the new gear's
    float robot;        // the automatic clutch, 0 open to 1 closed
    bool cut;           // asks the ECU to cut the ignition
    float blip;         // asks the ECU for this crank speed (rad/s), 0: nothing
    float lock;         // the lock-up clutch, 0 to 1
    float sinceShift;
    float lastPedal;
    float shiftTime;
    bool lockAllowed;   // the build has a lock-up clutch

    void reset()
    {
        gear = 0;
        pend = 0;
        refused = false;
        lastLever = 0;
        paddles = true;
        shifting = false;
        from = 0;
        to = 0;
        t = 0.0f;
        aFrom = 1.0f;
        aTo = 0.0f;
        robot = 1.0f;
        cut = false;
        blip = 0.0f;
        lock = 0.0f;
        sinceShift = 10.0f;
        lastPedal = 0.0f;
        cvt = cvtLo;
    }

    // Crank turns to a wheel's turn in gear g, through the final drive (negative in reverse, 0 in neutral)
    float ratioOf(int g)
    {
        if (g == 0)
            return 0.0f;
        if (g < 0)
            return -rRev * fd;
        if (kind == VEH_CVT)
            return cvt * fd;
        const int k = g > n ? n : g;
        return r[k - 1] * fd;
    }

    // The counters seen as they are now, without acting on them (at a reset, or when the kind changes)
    void sync(int lever, int upCount, int downCount)
    {
        lastLever = lever;
        lastUp = upCount;
        lastDown = downCount;
    }

    void begin(int g)
    {
        shifting = true;
        from = gear;
        to = g;
        up = g > gear;
        t = 0.0f;
        aFrom = 1.0f;
        aTo = 0.0f;
        dur = kind == VEH_AUTOMATIC || kind == VEH_CVT ? 2.5f * shiftTime : shiftTime;
        sinceShift = 0.0f;
    }

    // The gear the counters ask for from `g`, within lo to hi; into reverse only at a crawl, never down into a gear
    // that would take the engine past its redline
    int asked(int g, int ups, int downs, float wOut, float redW, float kmh)
    {
        int k = g;
        if (ups > 0)
            k = g + 1 > n ? n : g + 1;
        else if (downs > 0)
            k = g - 1 < -1 ? -1 : g - 1;
        if (k == -1 && kmh > 5.0f)
            k = 0;
        if (k > 0 && k < g && fabsf(wOut * ratioOf(k)) > 0.97f * redW)
            k = g;
        return k;
    }

    // Every 16 samples. d16: seconds since the last call; lever, upCount, downCount: the controls; engage: the clutch
    // pedal's engagement (0 down, 1 up); pedal: the throttle; w: the crank's speed; wOut: the output's (the wheels'
    // side); idleW, redW: the engine's idle and redline (rad/s); kmh: the car's speed.
    void control(float d16, int lever, int upCount, int downCount, float engage, float pedal, float w, float wOut,
                 float idleW, float redW, float kmh)
    {
        const int ups = upCount - lastUp;
        const int downs = downCount - lastDown;
        lastUp = upCount;
        lastDown = downCount;
        sinceShift += d16;
        refused = false;
        // the automatic clutch for pulling away: it closes with the revs from just over idle (as the reference's paddles)
        const float x = fminf(fmaxf((w - idleW - 15.7f) / 94.2f, 0.0f), 1.0f);
        const float launch = x * x * (3.0f - 2.0f * x);

        if (kind == VEH_MANUAL)
        {
            const int h = lever < -1 ? -1 : (lever > n ? n : lever);
            if (h != lastLever)
            {
                lastLever = h;
                pend = h;
                paddles = h == 0;
                shifting = false;
                cut = false;
                blip = 0.0f;
                gear = 0;
            }
            if (!paddles && pend != gear)
            {
                const float want = ratioOf(pend) * wOut;
                if (pend == -1 && kmh > 5.0f)
                    refused = true;
                else if (engage < 0.15f || fabsf(w - want) < 30.0f)
                    gear = pend;
                else
                    refused = true;
            }
            robot = 1.0f;
            if (paddles)
            {
                if (!shifting)
                {
                    const int k = asked(gear, ups, downs, wOut, redW, kmh);
                    if (k != gear)
                        begin(k);
                }
                if (gear != 0)
                    robot = launch;
                if (shifting)
                {
                    // the reference's paddle shift: open by 35 ms, the gear in at 50 ms, closed by 210 ms
                    t += d16;
                    if (t >= 0.05f && gear != to)
                        gear = to;
                    const float open = t < 0.035f ? 1.0f - t / 0.035f : (t < 0.06f ? 0.0f : fminf((t - 0.06f) / 0.15f, 1.0f));
                    robot = (to != 0 ? launch : 1.0f) * open;
                    cut = up && to > 1 && t < 0.06f;
                    blip = !up && to > 0 ? fabsf(wOut * ratioOf(to)) : 0.0f;
                    if (t >= 0.21f)
                    {
                        shifting = false;
                        cut = false;
                        blip = 0.0f;
                    }
                }
            }
            aFrom = 1.0f;
            aTo = 0.0f;
            return;
        }

        if (kind == VEH_SEQUENTIAL)
        {
            if (!shifting)
            {
                const int k = asked(gear, ups, downs, wOut, redW, kmh);
                if (k != gear)
                {
                    if (gear == 0 || k == 0 || gear == -1)
                        gear = k;           // in and out of neutral: at once (the clutch does the rest)
                    else
                        begin(k);
                }
            }
            robot = gear != 0 ? launch : 1.0f;
            if (shifting)
            {
                t += d16;
                if (up)
                {
                    // the dogs out at once, the next in 25 ms later; the cut 60 ms
                    gear = t >= 0.025f ? to : 0;
                    cut = t < 0.06f;
                    blip = 0.0f;
                    if (t >= 0.06f)
                    {
                        shifting = false;
                        cut = false;
                    }
                }
                else
                {
                    gear = t >= 0.06f ? to : 0;
                    blip = t < 0.1f ? fabsf(wOut * ratioOf(to)) : 0.0f;
                    cut = false;
                    if (t >= 0.1f)
                    {
                        shifting = false;
                        blip = 0.0f;
                    }
                }
                robot = 1.0f;       // (a dog shift leaves the clutch closed)
            }
            aFrom = 1.0f;
            aTo = 0.0f;
            return;
        }

        if (kind == VEH_DUALCLUTCH)
        {
            if (!shifting)
            {
                const int k = asked(gear, ups, downs, wOut, redW, kmh);
                if (k != gear)
                {
                    if (gear == 0 || k == 0 || gear == -1 || k == -1)
                        gear = k;
                    else
                        begin(k);
                }
            }
            robot = gear != 0 ? launch : 1.0f;
            if (shifting)
            {
                t += d16;
                const float p = fminf(t / dur, 1.0f);
                aTo = p * p * (3.0f - 2.0f * p);
                aFrom = 1.0f - aTo;
                blip = !up ? fabsf(wOut * ratioOf(to)) : 0.0f;
                if (p >= 1.0f)
                {
                    shifting = false;
                    gear = to;
                    aFrom = 1.0f;
                    aTo = 0.0f;
                    blip = 0.0f;
                }
            }
            else
            {
                aFrom = 1.0f;
                aTo = 0.0f;
            }
            cut = false;
            return;
        }

        // the automatic and the CVT: R, N, D by the lever
        const int sel = lever < 0 ? -1 : (lever > 0 ? 1 : 0);
        robot = 1.0f;
        cut = false;
        if (!shifting)
        {
            int k = gear;
            if (sel == 0)
                k = 0;
            else if (sel == -1)
                k = kmh < 5.0f ? -1 : 0;
            else if (gear <= 0)
                k = 1;
            else if (kind == VEH_AUTOMATIC)
            {
                // the schedule, on the input's speed in this gear
                const float wIn = fabsf(wOut * ratioOf(gear));
                const float span = redW - idleW;
                const float wUp = idleW + (0.30f + 0.60f * pedal) * span;
                const float wDown = idleW + (0.10f + 0.35f * pedal) * span;
                if (gear < n && wIn > wUp && sinceShift > 0.8f)
                    k = gear + 1;
                else if (gear > 1 && wIn < wDown && fabsf(wOut * ratioOf(gear - 1)) < 0.9f * redW && sinceShift > 0.8f)
                    k = gear - 1;
                else if (gear > 1 && pedal > 0.9f && lastPedal <= 0.9f)
                {
                    // the kickdown: as low as keeps the engine under 80 % of its redline
                    int g = gear;
                    while (g > 1 && fabsf(wOut * ratioOf(g - 1)) < 0.8f * redW)
                        g -= 1;
                    k = g;
                }
            }
            if (k != gear)
                begin(k);
        }
        if (shifting)
        {
            t += d16;
            const float p = fminf(t / dur, 1.0f);
            aTo = p * p * (3.0f - 2.0f * p);
            aFrom = 1.0f - aTo;
            if (p >= 1.0f)
            {
                shifting = false;
                gear = to;
                aFrom = 1.0f;
                aTo = 0.0f;
            }
        }
        else
        {
            aFrom = 1.0f;
            aTo = 0.0f;
        }
        lastPedal = pedal;
        if (kind == VEH_CVT && gear > 0)
        {
            // the ratio that holds the engine where the pedal sets it, moved at a bounded rate
            const float target = fmaxf(idleW * 1.3f, idleW + pedal * (0.9f * redW - idleW));
            const float wo = fabsf(wOut) * fd;
            float want = wo > 1.0e-3f ? target / wo : cvtLo;
            want = fminf(fmaxf(want, cvtHi), cvtLo);
            const float step = 1.5f * d16;
            const float lr = logf(want / cvt);
            cvt *= expf(fminf(fmaxf(lr, -step), step));
            cvt = fminf(fmaxf(cvt, cvtHi), cvtLo);
        }
        // the lock-up clutch
        bool lockWanted = false;
        if (kind == VEH_AUTOMATIC)
            lockWanted = gear >= 3 && !shifting && pedal < 0.9f;
        else
            lockWanted = gear > 0 && kmh > 20.0f && pedal < 0.95f;
        if (lockWanted && lockAllowed)
            lock = fminf(lock + d16 / 0.3f, 1.0f);
        else
            lock = 0.0f;
    }
};
