// vspec.fm: what the vehicle model (car.model = 1, vehicle.fm) reads and writes, as modules of their own: VehSpec,
// the fields card I appends to spec.car; VehEnv, what it reads of spec.env; VehTel, what it appends to tel.car.
//
// The model reads its Spec through a VehSpec of its own, which the Car seam fills from spec.car's fields of the same
// names when spec.car's rev moves (and a test fills directly). So the model is the same code standalone and in the
// engine, and spec.car keeps 02-contracts.md's rules: these fields are appended there with the same names, ranges,
// defaults and labels.
//
// Which changes are glided and which are not (02-contracts.md §2 rule 5): none of these is a sound the ear follows
// through a change, so none is glided; each takes effect at the next 16-sample control step. The kind of gearbox,
// the drive and the number of gears put the gearbox in neutral and the driveline at rest (the reference's own
// behaviour when DRIVE changed); a ratio's change takes effect at the next shift.
#pragma once

enum
{
    VEH_WHEELS = 4,         // front left, front right, rear left, rear right
    VEH_GEARS = 18,         // MAX_GEARS
};

enum
{
    VEH_FWD = 0,
    VEH_RWD = 1,
    VEH_AWD = 2,
};

enum
{
    VEH_MANUAL = 0,
    VEH_SEQUENTIAL = 1,
    VEH_DUALCLUTCH = 2,
    VEH_AUTOMATIC = 3,
    VEH_CVT = 4,
};

module VehSpec
{
    int model [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Vehicle model")]]
        [[ui::choices("Reference", "Vehicle")]] [[ui::group("Vehicle")]]
        [[ui::help("Reference: the reference's car, bit for bit. Vehicle: tyres, loads, differentials and gearboxes")]];
    float mass [[fminus::range(100, 50000)]] [[fminus::default(1400)]] [[ui::label("Mass")]] [[ui::quantity("mass")]];
    int drive [[fminus::range(0, 2)]] [[fminus::default(1)]] [[ui::label("Driven wheels")]]
        [[ui::choices("Front", "Rear", "All")]];
    float wheelbase [[fminus::range(1, 8)]] [[fminus::default(2.6)]] [[ui::label("Wheelbase")]] [[ui::quantity("length")]]
        [[ui::group("Body")]];
    float cgHeight [[fminus::range(0.2, 2.5)]] [[fminus::default(0.5)]] [[ui::label("Centre of mass height")]]
        [[ui::quantity("length")]];
    float frontWeight [[fminus::range(0.2, 0.8)]] [[fminus::default(0.53)]] [[ui::label("Weight on the front")]]
        [[ui::quantity("fraction")]];
    float track [[fminus::range(0.8, 2.6)]] [[fminus::default(1.55)]] [[ui::label("Track")]] [[ui::quantity("length")]];
    float cdA [[fminus::range(0.2, 12)]] [[fminus::default(0.7)]] [[ui::label("Drag area (Cd A)")]]
        [[ui::quantity("area")]];
    float clA [[fminus::range(-2, 5)]] [[fminus::default(0)]] [[ui::label("Downforce area (Cl A)")]]
        [[ui::quantity("area")]] [[ui::help("Positive presses the car down; negative is lift")]];
    float aeroBalance [[fminus::range(0, 1)]] [[fminus::default(0.45)]] [[ui::label("Downforce on the front")]]
        [[ui::quantity("fraction")]];
    int tyre [[fminus::range(0, 9)]] [[fminus::default(1)]] [[ui::label("Tyres")]] [[ui::group("Tyres")]]
        [[ui::choices("Economy", "Street", "Sport", "Semi-slick", "Slick", "Drag radial", "Drag slick", "Winter",
                      "Truck", "Motorcycle")]];
    float tyreRadius [[fminus::range(0.2, 0.7)]] [[fminus::default(0.33)]] [[ui::label("Rolling radius")]]
        [[ui::quantity("length")]];
    float wheelInertia [[fminus::range(0.2, 60)]] [[fminus::default(1.1)]] [[ui::label("Wheel inertia (each)")]]
        [[ui::quantity("inertia")]];
    float brakeDecel [[fminus::range(0.3, 2.5)]] [[fminus::default(1.2)]] [[ui::label("Brakes")]] [[ui::unit("g")]]
        [[ui::group("Brakes")]] [[ui::help("The deceleration a full pedal asks for, before the tyres' grip")]];
    float brakeBias [[fminus::range(0.3, 0.9)]] [[fminus::default(0.65)]] [[ui::label("Brake bias to the front")]]
        [[ui::quantity("fraction")]];
    bool abs [[fminus::default(1)]] [[ui::label("ABS")]];
    int gearbox [[fminus::range(0, 4)]] [[fminus::default(0)]] [[ui::label("Gearbox")]] [[ui::group("Gearbox")]]
        [[ui::choices("Manual", "Sequential", "Dual clutch", "Automatic", "CVT")]];
    int gears [[fminus::range(1, 18)]] [[fminus::default(6)]] [[ui::label("Forward gears")]];
    bool autoGearing [[fminus::default(1)]] [[ui::label("Gear it for the engine")]]
        [[ui::help("The reference's rule: the ratios and final drive chosen for the engine's power and redline")]];
    float ratio [[fminus::range(0.3, 20)]] [[fminus::default(1)]] [[ui::label("Ratios")]]
        [[ui::quantity("ratio")]] [VEH_GEARS];
    float reverseRatio [[fminus::range(1, 20)]] [[fminus::default(3.3)]] [[ui::label("Reverse")]]
        [[ui::quantity("ratio")]];
    float finalDrive [[fminus::range(1, 12)]] [[fminus::default(3.6)]] [[ui::label("Final drive")]]
        [[ui::quantity("ratio")]];
    float clutchTorque [[fminus::range(0, 20000)]] [[fminus::default(0)]] [[ui::label("Clutch capacity")]]
        [[ui::quantity("torque")]] [[ui::help("0: 1.35 times the engine's peak torque, as the reference sizes it")]];
    float gearEfficiency [[fminus::range(0.8, 1)]] [[fminus::default(0.97)]] [[ui::label("Gearbox efficiency")]]
        [[ui::quantity("fraction")]];
    float shiftTime [[fminus::range(0.05, 1)]] [[fminus::default(0.15)]] [[ui::label("Shift time")]]
        [[ui::quantity("time")]] [[ui::help("A dual clutch's handover; an automatic's overlap is 2.5 times it")]];
    float converterK [[fminus::range(5, 40)]] [[fminus::default(13.5)]] [[ui::label("Converter capacity")]]
        [[ui::unit("rad/s/sqrt(N m)")]] [[ui::group("Converter")]]
        [[ui::help("The impeller's speed over the square root of its torque at stall")]];
    float converterRatio [[fminus::range(1, 3)]] [[fminus::default(1.9)]] [[ui::label("Stall torque ratio")]]
        [[ui::quantity("ratio")]];
    float couplingPoint [[fminus::range(0.6, 0.95)]] [[fminus::default(0.85)]] [[ui::label("Coupling point")]]
        [[ui::quantity("fraction")]];
    bool lockUp [[fminus::default(1)]] [[ui::label("Lock-up clutch")]];
    float cvtLow [[fminus::range(1.5, 5)]] [[fminus::default(2.5)]] [[ui::label("CVT lowest ratio")]]
        [[ui::quantity("ratio")]] [[ui::group("CVT")]];
    float cvtHigh [[fminus::range(0.3, 1.2)]] [[fminus::default(0.45)]] [[ui::label("CVT highest ratio")]]
        [[ui::quantity("ratio")]];
    float cvtEfficiency [[fminus::range(0.8, 1)]] [[fminus::default(0.9)]] [[ui::label("CVT belt efficiency")]]
        [[ui::quantity("fraction")]];
    float centreSplit [[fminus::range(0, 1)]] [[fminus::default(0.4)]] [[ui::label("Torque to the front")]]
        [[ui::quantity("fraction")]] [[ui::group("Differentials")]] [[ui::help("All-wheel drive's centre differential")]];
    float centrePreload [[fminus::range(0, 5000)]] [[fminus::default(0)]] [[ui::label("Centre preload")]]
        [[ui::quantity("torque")]];
    float centreKSpeed [[fminus::range(0, 500)]] [[fminus::default(0)]] [[ui::label("Centre viscous")]]
        [[ui::unit("N m s/rad")]];
    float centreKTorque [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Centre torque bias")]]
        [[ui::quantity("fraction")]];
    bool centreLocked [[fminus::default(0)]] [[ui::label("Centre locked")]];
    float frontPreload [[fminus::range(0, 5000)]] [[fminus::default(0)]] [[ui::label("Front preload")]]
        [[ui::quantity("torque")]];
    float frontKSpeed [[fminus::range(0, 500)]] [[fminus::default(0)]] [[ui::label("Front viscous")]]
        [[ui::unit("N m s/rad")]];
    float frontKTorque [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Front torque bias")]]
        [[ui::quantity("fraction")]];
    bool frontLocked [[fminus::default(0)]] [[ui::label("Front locked")]];
    float rearPreload [[fminus::range(0, 5000)]] [[fminus::default(0)]] [[ui::label("Rear preload")]]
        [[ui::quantity("torque")]];
    float rearKSpeed [[fminus::range(0, 500)]] [[fminus::default(0)]] [[ui::label("Rear viscous")]]
        [[ui::unit("N m s/rad")]];
    float rearKTorque [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Rear torque bias")]]
        [[ui::quantity("fraction")]];
    bool rearLocked [[fminus::default(0)]] [[ui::label("Rear locked")]];
    bool liveAxle [[fminus::default(0)]] [[ui::label("Live rear axle")]]
        [[ui::help("The propeller shaft's torque reaction unloads the right rear tyre")]];
    bool proTree [[fminus::default(0)]] [[ui::label("Pro tree")]] [[ui::group("Strip")]]
        [[ui::help("The three ambers together, green 0.4 s later; otherwise half a second apart")]];
};

// What the model reads of spec.env (those fields are the lead's; until they exist the Car seam passes these values)
module VehEnv
{
    float density [[fminus::range(0.5, 1.5)]] [[fminus::default(1.2)]] [[ui::label("Air density")]]
        [[ui::unit("kg/m^3")]];
    float temperature [[fminus::range(230, 330)]] [[fminus::default(293.15)]] [[ui::label("Air temperature")]]
        [[ui::quantity("temperature")]];
    int surface [[fminus::range(0, 4)]] [[fminus::default(0)]] [[ui::label("Surface")]]
        [[ui::choices("Dry", "Damp", "Wet", "Snow", "Prepared strip")]];
    int surfaceLeft [[fminus::range(-1, 4)]] [[fminus::default(-1)]] [[ui::label("Surface under the left wheels")]]
        [[ui::choices("Same", "Dry", "Damp", "Wet", "Snow", "Prepared strip")]];
    float grade [[fminus::range(-0.3, 0.3)]] [[fminus::default(0)]] [[ui::label("Grade")]] [[ui::quantity("fraction")]]
        [[ui::help("Rise over run: 0.1 climbs 10 m in 100")]];
};

// What the model shows (appended to tel.car). Instantaneous at the block's end unless the label says otherwise.
module VehTel
{
    float speed [[ui::label("Speed")]] [[ui::quantity("speed")]];
    float accel [[ui::label("Acceleration")]] [[ui::unit("m/s^2")]];
    float distance [[ui::label("Distance")]] [[ui::quantity("length")]];
    int gear [[ui::label("Gear")]];
    int shift [[ui::label("Shift")]] [[ui::choices("None", "Up", "Down", "Refused")]];
    float wheelSpeed [[ui::label("Wheel speed")]] [[ui::quantity("rotation")]] [VEH_WHEELS];
    float wheelSlip [[ui::label("Wheel slip")]] [[ui::quantity("fraction")]] [VEH_WHEELS];
    float wheelLoad [[ui::label("Wheel load")]] [[ui::unit("N")]] [VEH_WHEELS];
    float wheelForce [[ui::label("Wheel force")]] [[ui::unit("N")]] [VEH_WHEELS];
    float wheelTorque [[ui::label("Drive torque at the wheel")]] [[ui::quantity("torque")]] [VEH_WHEELS];
    float wheelTemp [[ui::label("Tyre temperature")]] [[ui::quantity("temperature")]] [VEH_WHEELS];
    float clutchSlip [[ui::label("Clutch or converter slip")]] [[ui::quantity("rotation")]];
    float shaftTorque [[ui::label("Driveline torque at the wheels")]] [[ui::quantity("torque")]];
    float wheelPower [[ui::label("Power at the wheels")]] [[ui::quantity("power")]];
    float pitch [[ui::label("Load moved to the rear")]] [[ui::unit("N")]];
    int flags [[ui::label("Flags")]] [[ui::help("1 wheelspin, 2 wheelie, 4 ABS, 8 a locked wheel, 16 shifting, 32 cut asked, 64 blip asked, 128 traction limited")]];
    float ratio [[ui::label("Overall ratio")]] [[ui::quantity("ratio")]];
    int stripState [[ui::label("Strip")]] [[ui::choices("Off", "Staged", "Ambers", "Green", "Running", "Finished", "Red light")]];
    float tReaction [[ui::label("Reaction")]] [[ui::quantity("time")]];
    float t60 [[ui::label("60 ft")]] [[ui::quantity("time")]];
    float t330 [[ui::label("330 ft")]] [[ui::quantity("time")]];
    float t660 [[ui::label("1/8 mile")]] [[ui::quantity("time")]];
    float v660 [[ui::label("1/8 mile speed")]] [[ui::quantity("speed")]];
    float t1000 [[ui::label("1000 ft")]] [[ui::quantity("time")]];
    float t1320 [[ui::label("1/4 mile")]] [[ui::quantity("time")]];
    float v1320 [[ui::label("Trap speed")]] [[ui::quantity("speed")]];
};
