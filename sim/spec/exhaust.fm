// spec/exhaust.fm: the exhaust (spec.exhaust). Owner: package G.
//
// The reference's HEADERS, PIPE, X-PIPE and MUFFLER dials: the headers' length (0.61 to 1.63 times the layout's), the
// main pipe's (half to twice), the crossover between two pipes (its area over a pipe's), and the muffler from a
// straight-through can (0) to big packed chambers (1). All four glide over 80 ms.
//
// Then the exhaust builder's description (card G, docs/models/exhaust.md): `model` 0 is the reference's exhaust, its
// own code, bit for bit; 1 builds the system from the fields after it, which at their defaults are the reference's
// topology and sizes (a 0 in a size, -2 or -1 in a table: the layout's). The four dials above still act in model 1
// where a field says so. Changing `model`, a table, `sides` or any slot's kind is made under the exhaust's own short
// fade (6 ms down, the system rebuilt at rest, 12 ms up); so, for now, is every other builder field (their glides are
// to come), except the bypass valve's rule (`bypassRpm`, `bypassLoad`, `bypassTime`), which it follows as it goes.
// Slot arrays are indexed by side (0, 1), the tables by port (MAX_PORTS) and by collector (MAX_COLLECTORS).
#pragma once
#include "limits.fm"

module ExhaustSpec
{
    int rev [[ui::hidden]];
    float headers [[fminus::range(0, 1)]] [[fminus::default(0.5)]] [[ui::label("Headers")]] [[ui::quantity("fraction")]]
        [[ui::help("The headers' length: 0.61 to 1.63 times the layout's")]];
    float pipe [[fminus::range(0, 1)]] [[fminus::default(0.5)]] [[ui::label("Pipe")]] [[ui::quantity("fraction")]]
        [[ui::help("The main pipe's length: half to twice the layout's")]];
    float crossover [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Crossover")]]
        [[ui::quantity("fraction")]] [[ui::help("An H-pipe between two pipes: its area over a pipe's")]];
    float muffler [[fminus::range(0, 1)]] [[fminus::default(0.5)]] [[ui::label("Muffler")]] [[ui::quantity("fraction")]]
        [[ui::help("From a straight-through can to big packed chambers")]];
    // ---- the exhaust builder (card G) ----
    int model [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Exhaust model")]]
        [[ui::help("Reference: the original four dials. Builder: every pipe, collector, crossover, resonator and muffler as drawn")]]
        [[ui::choices("Reference", "Builder")]];
    // ---- the headers ----
    int primaryTo [[fminus::range(-2, 7)]] [[fminus::default(-2)]] [[ui::label("Primary joins")]] [[ui::group("Headers")]]
        [[ui::choices("Layout's", "Open stack", "Collector 1", "Collector 2", "Collector 3", "Collector 4", "Collector 5",
                      "Collector 6", "Collector 7", "Collector 8")]]
        [[ui::help("Which collector each port's primary joins: -2 the layout's, -1 an open stack")]] [MAX_PORTS];
    float primLen [[fminus::range(0, 3)]] [[fminus::default(0)]] [[ui::label("Primary length")]] [[ui::quantity("length")]]
        [[ui::help("0: the layout's")]] [MAX_PORTS];
    float primD [[fminus::range(0, 0.12)]] [[fminus::default(0)]] [[ui::label("Primary bore")]] [[ui::quantity("length")]]
        [[ui::help("0: the layout's, 0.46 of the cylinder's bore")]] [MAX_PORTS];
    float primSpread [[fminus::range(0, 0.3)]] [[fminus::default(0.06)]] [[ui::label("Primary differences")]]
        [[ui::quantity("fraction")]] [[ui::help("How much the primaries' lengths differ, as built (the reference's 6 %)")]];
    float primStepAt [[fminus::range(0, 0.9)]] [[fminus::default(0)]] [[ui::label("Step at")]] [[ui::quantity("fraction")]]
        [[ui::help("Where a stepped primary widens, along it; 0: no step")]];
    float primStepD [[fminus::range(1, 1.5)]] [[fminus::default(1.1)]] [[ui::label("Step")]] [[ui::quantity("ratio")]]
        [[ui::help("The bore after the step over the bore before it")]];
    // ---- the collectors ----
    int collectorTo [[fminus::range(-1, 9)]] [[fminus::default(-1)]] [[ui::label("Collector joins")]] [[ui::group("Collectors")]]
        [[ui::choices("Layout's", "Side 1", "Side 2", "Collector 1", "Collector 2", "Collector 3", "Collector 4",
                      "Collector 5", "Collector 6", "Collector 7", "Collector 8")]]
        [[ui::help("-1 the layout's; 0 or 1: that side; 2 to 9: the collector (2 less) its pipe merges into")]] [MAX_COLLECTORS];
    float colLen [[fminus::range(0, 1.5)]] [[fminus::default(0)]] [[ui::label("Collector pipe length")]]
        [[ui::help("The length of the pipe after a collector")]]
        [[ui::quantity("length")]] [MAX_COLLECTORS];
    float colD [[fminus::range(0, 0.15)]] [[fminus::default(0)]] [[ui::label("Collector pipe bore")]]
        [[ui::help("The bore of the pipe after a collector")]]
        [[ui::quantity("length")]] [MAX_COLLECTORS];
    float colVol [[fminus::range(0, 0.004)]] [[fminus::default(0)]] [[ui::label("Collector volume")]]
        [[ui::quantity("volume")]] [[ui::help("Above 0: a log manifold's chamber at the collector")]] [MAX_COLLECTORS];
    // ---- each side's chain ----
    int sides [[fminus::range(0, 2)]] [[fminus::default(0)]] [[ui::label("Sides")]] [[ui::group("Chain")]] [[ui::choices("Layout's", "Single", "Dual")]]
        [[ui::help("0: the layout's; 1 single; 2 dual")]];
    float mainLen [[fminus::range(0, 5)]] [[fminus::default(0)]] [[ui::label("Main pipe length")]]
        [[ui::help("The length of each side's main pipe")]]
        [[ui::quantity("length")]] [MAX_SIDES];
    float mainD [[fminus::range(0, 0.13)]] [[fminus::default(0)]] [[ui::label("Main pipe bore")]]
        [[ui::help("The bore of each side's main pipe")]]
        [[ui::quantity("length")]] [MAX_SIDES];
    int converter [[fminus::range(0, 2)]] [[fminus::default(1)]] [[ui::label("Converter")]]
        [[ui::help("Each side's catalytic converter: none, a standard one, or a high-flow one")]]
        [[ui::choices("None", "Standard", "High-flow")]] [MAX_SIDES];
    int crossKind [[fminus::range(0, 2)]] [[fminus::default(1)]] [[ui::label("Crossover kind")]]
        [[ui::help("A crossover between the two sides: none, an H-pipe (a deeper note) or an X-pipe (a smoother, higher one)")]]
        [[ui::choices("None", "H", "X")]];
    int crossAt [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Crossover at")]]
        [[ui::help("Where the crossover joins: near the heads or after the main pipes")]]
        [[ui::choices("Head", "After main pipe")]];
    float crossD [[fminus::range(0, 0.13)]] [[fminus::default(0)]] [[ui::label("Crossover bore")]]
        [[ui::quantity("length")]] [[ui::help("0: the Crossover dial's area")]];
    float crossLen [[fminus::range(0.05, 1)]] [[fminus::default(0.25)]] [[ui::label("H pipe length")]]
        [[ui::help("The length of an H-pipe's crossing tube")]]
        [[ui::quantity("length")]];
    float postLen [[fminus::range(0.1, 2)]] [[fminus::default(0.4)]] [[ui::label("Pipe after crossover")]]
        [[ui::help("The pipe after the crossover")]]
        [[ui::quantity("length")]];
    int resonator [[fminus::range(0, 3)]] [[fminus::default(0)]] [[ui::label("Resonator")]]
        [[ui::help("A resonator on each side that cancels a drone: a quarter-wave stub, a Helmholtz bottle, or a packed bottle")]]
        [[ui::choices("None", "Quarter-wave", "Helmholtz", "Packed bottle")]] [MAX_SIDES];
    float resHz [[fminus::range(40, 2000)]] [[fminus::default(200)]] [[ui::label("Resonator note")]]
        [[ui::help("The note a resonator is tuned to cancel")]]
        [[ui::quantity("frequency")]] [[ui::taper("log")]] [MAX_SIDES];
    float resD [[fminus::range(0, 0.13)]] [[fminus::default(0)]] [[ui::label("Resonator bore")]]
        [[ui::quantity("length")]] [[ui::help("A stub's or a neck's; 0: the pipe's (a neck: half of it)")]] [MAX_SIDES];
    float resVol [[fminus::range(0.0002, 0.02)]] [[fminus::default(0.003)]] [[ui::label("Chamber volume")]]
        [[ui::help("A Helmholtz resonator's chamber volume")]]
        [[ui::quantity("volume")]] [MAX_SIDES];
    float resLen [[fminus::range(0.1, 1)]] [[fminus::default(0.4)]] [[ui::label("Bottle length")]]
        [[ui::help("A packed bottle's length")]]
        [[ui::quantity("length")]] [MAX_SIDES];
    float linkLen [[fminus::range(0.1, 2)]] [[fminus::default(0.4)]] [[ui::label("Pipe after resonator")]]
        [[ui::help("The pipe after the resonator")]]
        [[ui::quantity("length")]];
    int mufKind [[fminus::range(0, 3)]] [[fminus::default(2)]] [[ui::label("Muffler kind")]]
        [[ui::help("Each side's muffler: none, straight-through (loud), chambered, or three-pass (quiet)")]]
        [[ui::choices("None", "Straight-through", "Chambered", "Three-pass")]] [MAX_SIDES];
    float mufSize [[fminus::range(-1, 1)]] [[fminus::default(-1)]] [[ui::label("Muffler size")]]
        [[ui::quantity("fraction")]] [[ui::help("-1: the Muffler dial's")]] [MAX_SIDES];
    float mufLen [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Muffler chamber")]]
        [[ui::quantity("length")]] [[ui::help("Its first chamber's length; 0: the layout's")]] [MAX_SIDES];
    int bypass [[fminus::range(0, 4)]] [[fminus::default(0)]] [[ui::label("Bypass valve")]]
        [[ui::help("A valve around the muffler: none, always shut, always open, opened by speed and load, or by the ECU")]]
        [[ui::choices("None", "Shut", "Open", "By speed and load", "By the ECU")]] [MAX_SIDES];
    float bypassD [[fminus::range(0, 0.13)]] [[fminus::default(0)]] [[ui::label("Bypass bore")]]
        [[ui::quantity("length")]] [[ui::help("0: the main pipe's")]];
    float bypassRpm [[fminus::range(1000, 9000)]] [[fminus::default(3500)]] [[ui::label("Valve opens above")]]
        [[ui::help("The bypass valve opens above this speed")]]
        [[ui::unit("rpm")]];
    float bypassLoad [[fminus::range(0, 1)]] [[fminus::default(0.5)]] [[ui::label("and above load")]]
        [[ui::help("... and above this load")]]
        [[ui::quantity("fraction")]];
    float bypassTime [[fminus::range(0.05, 2)]] [[fminus::default(0.3)]] [[ui::label("Valve travel")]]
        [[ui::help("How long the bypass valve takes to open or shut")]]
        [[ui::quantity("time")]];
    float tailLen [[fminus::range(0, 2)]] [[fminus::default(0)]] [[ui::label("Tailpipe length")]]
        [[ui::help("Each tailpipe's length")]]
        [[ui::quantity("length")]] [MAX_SIDES];
    float tailD [[fminus::range(0, 0.13)]] [[fminus::default(0)]] [[ui::label("Tailpipe bore")]]
        [[ui::help("Each tailpipe's bore")]]
        [[ui::quantity("length")]] [MAX_SIDES];
    int tips [[fminus::range(1, 2)]] [[fminus::default(1)]] [[ui::label("Tips")]]
        [[ui::help("One tip or two at each tailpipe")]] [[ui::unit("tips")]] [MAX_SIDES];
    float gateLen [[fminus::range(0.05, 1)]] [[fminus::default(0.3)]] [[ui::label("Wastegate pipe length")]]
        [[ui::quantity("length")]] [[ui::help("An external wastegate's own pipe, to the air")]];
    float gateD [[fminus::range(0.015, 0.08)]] [[fminus::default(0.038)]] [[ui::label("Wastegate pipe bore")]]
        [[ui::help("An external wastegate's pipe bore")]]
        [[ui::quantity("length")]];
    int exitAt [[fminus::range(-1, 6)]] [[fminus::default(-1)]] [[ui::label("Exits")]]
        [[ui::help("Where the tailpipes leave the car; it sets where the sound comes from")]]
        [[ui::choices("The layout's", "Rear centre", "Rear left", "Rear right", "Side left", "Side right", "Front", "Up")]]
        [MAX_SIDES];
    int heatSettle [[fminus::range(0, 1000000)]] [[fminus::default(0)]] [[ui::label("Settle the exhaust's heat")]]
        [[ui::unit("presses")]] [[ui::hidden]]
        [[ui::help("Counts requests: at each increase the gas at the ports and every wall of the exhaust are put at where the present flow would hold them (for a tool: a dyno's sweep without waiting minutes)")]];
    int flapKind [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Exhaust flap")]]
        [[ui::help("A butterfly at the head of each main pipe, behind the turbine: a diesel's exhaust brake. The ECU's brake shuts it (spec.ecu.exhaustBrake)")]]
        [[ui::choices("None", "Butterfly")]];
    float flapOrifice [[fminus::range(0.005, 0.3)]] [[fminus::default(0.03)]] [[ui::label("Flap shut")]]
        [[ui::quantity("fraction")]] [[ui::help("The area it leaves shut (a hole in the plate, the gap round it), over the pipe's")]];
    float flapRelief [[fminus::range(50000, 600000)]] [[fminus::default(350000)]] [[ui::label("Flap relief")]]
        [[ui::quantity("pressure")]] [[ui::help("Over the air: above it the flap's spring lets the plate blow open")]];
    float flapTime [[fminus::range(0.02, 1)]] [[fminus::default(0.15)]] [[ui::label("Flap travel")]]
        [[ui::quantity("time")]] [[ui::help("Open to shut")]];
    int portHeat [[fminus::range(0, 1)]] [[fminus::default(1)]] [[ui::label("Port cooling")]]
        [[ui::help("The exhaust port's water-cooled walls take heat from the gas before the headers (the builder; Caton and Heywood's correlation). None: the reference's")]]
        [[ui::choices("None", "Caton and Heywood")]];
    int flowClose [[fminus::range(0, 1)]] [[fminus::default(1)]] [[ui::label("Valve flow closed")]]
        [[ui::help("The pipes given what the exhaust valves let out on the mean (the valve's wave gain keeps the pulse's shape). None: the reference's, which gives them 5 to 20 % more")]]
        [[ui::choices("None", "Closed")]];
};
