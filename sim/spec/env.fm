// spec/env.fm: the world around the engine (spec.env). Owner: the lead.
//
// The reference's AMBIENT dial, in kelvin (it was degrees F: -40 F is 233.15 K, 120 F 322.04 K; the reference took
// 80.33 F as 300 K, and so does the conversion here). Moved while the engine is stopped, the engine has stood in that
// air; running, the air glides to it over some 2 s.
#pragma once

module EnvSpec
{
    int rev [[ui::hidden]];
    float temperature [[fminus::range(233.15, 322.04)]] [[fminus::default(300)]] [[ui::label("Air temperature")]]
        [[ui::quantity("temperature")]] [[ui::decimals(1)]];
    // asked by card I, added by the integrator: the air's pressure (the reference's 101325 Pa), the road's surface under
    // each side, its grade
    float pressure [[fminus::range(50000, 110000)]] [[fminus::default(101325)]] [[ui::label("Air pressure")]]
        [[ui::quantity("pressure")]] [[ui::decimals(0)]];
    int surface [[fminus::range(0, 4)]] [[fminus::default(0)]] [[ui::label("Surface")]]
        [[ui::choices("Dry", "Damp", "Wet", "Snow", "Prepared strip")]];
    int surfaceLeft [[fminus::range(-1, 4)]] [[fminus::default(-1)]] [[ui::label("Surface, left side")]]
        [[ui::choices("The same", "Dry", "Damp", "Wet", "Snow", "Prepared strip")]];
    float grade [[fminus::range(-0.3, 0.3)]] [[fminus::default(0)]] [[ui::label("Grade")]] [[ui::quantity("fraction")]]
        [[ui::help("Rise over run: uphill above 0")]];
};
