// spec/scope.fm: the taps, too big to copy every block (scope). The simulator fills it while ctl.scopeOn is set, and
// costs nothing when it is not; the host copies it only while a view asks.
//
// Cylinder 1's pressure, volume and both valves' lifts for each crank degree of its last whole cycle (720 degrees; a
// rotary's face 1080), and the pressure along the pipes. Packages append their own taps.
#pragma once

enum
{
    SCOPE_DEGREES = 1080,      // the longest cycle, in degrees
    SCOPE_PIPE_POINTS = 64,
    SCOPE_EXHAUST_DUCTS = 84,  // card G: the builder's pipe slots (sim/exhaust/slots.fm, XD_* and XO_*)
};

module Scope
{
    int degrees [[ui::label("Degrees")]] [[ui::help("How many of the arrays' entries the cycle fills (720, 1080)")]];
    int cycles [[ui::label("Cycles")]] [[ui::help("Counts the whole cycles written: it moves when a new one is in")]];
    float pressure [[ui::label("Cylinder pressure")]] [[ui::quantity("pressure")]] [SCOPE_DEGREES];
    float volume [[ui::label("Cylinder volume")]] [[ui::quantity("volume")]] [SCOPE_DEGREES];
    float liftExhaust [[ui::label("Exhaust lift")]] [[ui::quantity("fraction")]] [SCOPE_DEGREES];
    float liftIntake [[ui::label("Intake lift")]] [[ui::quantity("fraction")]] [SCOPE_DEGREES];
    int pipePoints [[ui::label("Pipe points")]];
    float pipePressure [[ui::label("Pipe pressure")]] [[ui::quantity("pressure")]] [SCOPE_PIPE_POINTS];
    // the ECU's maps baked from its formulas at their breakpoints (ctl.bakeMaps; card H fills them, the host copies
    // them into the build): how many bakes, each map's points in x and y, its axes and its values (z[i * 16 + j])
    int bakeCount [[ui::label("Bakes")]];
    int bakedNx [[ui::label("Baked points in x")]] [7];
    int bakedNy [[ui::label("Baked points in y")]] [7];
    float bakedX [[ui::label("Baked x")]] [7][16];
    float bakedY [[ui::label("Baked y")]] [7][16];
    float baked [[ui::label("Baked values")]] [7][256];
    // ---- card G (Exhaust, every 128 samples while it runs model 1): the pressure, over the air outside, along the
    // gas's path from one port (spec.exhaust's scope port: 0) to its tail at exhaustPoints points spaced by length
    // (exhaustX: m from the port), and at both ends of every pipe slot in use (ductUsed), with its length: a view
    // draws the system as built and the pulses travelling in it ----
    int exhaustPoints [[ui::label("Exhaust path points")]];
    float exhaustX [[ui::label("Exhaust path position")]] [[ui::quantity("length")]] [SCOPE_PIPE_POINTS];
    float exhaustPressure [[ui::label("Exhaust path pressure")]] [[ui::quantity("pressure")]] [SCOPE_PIPE_POINTS];
    int exhaustRefreshes [[ui::label("Exhaust refreshes")]] [[ui::help("Counts the exhaust's refreshes")]];
    int ductUsed [[ui::label("Pipe in use")]] [SCOPE_EXHAUST_DUCTS];
    float ductLength [[ui::label("Pipe length")]] [[ui::quantity("length")]] [SCOPE_EXHAUST_DUCTS];
    float ductNear [[ui::label("Pressure at the pipe's near end")]] [[ui::quantity("pressure")]] [SCOPE_EXHAUST_DUCTS];
    float ductFar [[ui::label("Pressure at the pipe's far end")]] [[ui::quantity("pressure")]] [SCOPE_EXHAUST_DUCTS];
};
