// spec/fuel.fm: the fuel (spec.fuel). Owner: package H.
//
// The reference's FUEL dial: gasoline (a spark, a throttle) or diesel (no throttle: the pedal is its fuel; it lights
// by compression after its ignition delay). Taken under the fade; stopped, at once.
#pragma once

module FuelSpec
{
    int rev [[ui::hidden]];
    int kind [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Fuel")]]
        [[ui::help("Petrol (spark ignition) or diesel (compression ignition)")]] [[ui::choices("Gasoline", "Diesel")]];
    // fuel.model 1 (card H): the fuels of sim/combustion/ (0: the reference's gasoline and diesel, bit for bit)
    int model [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Combustion model")]]
        [[ui::help("Reference: the original burn. Fuels: each fuel's heat, octane, burn speed and knock")]]
        [[ui::choices("Reference", "Fuels")]];
    int grade [[fminus::range(0, 9)]] [[fminus::default(0)]] [[ui::label("Fuel")]]
        [[ui::help("The fuel: its octane decides how much advance and boost it takes before knocking")]]
        [[ui::choices("Regular (87)", "Midgrade (89)", "Premium (91)", "Race", "E85", "Methanol", "Diesel", "Propane (untested)",
                      "Hydrogen (untested)", "Premium (93)")]];
    float direct [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Direct injection")]] [[ui::quantity("fraction")]]
        [[ui::help("0: port injection; 1: direct; between, a share of each")]];
    float knockDelay [[fminus::range(0.25, 8)]] [[fminus::default(3)]] [[ui::label("Knock delay")]] [[ui::quantity("ratio")]]
        [[ui::taper("log")]] [[ui::help("Douaud and Eyzat's ignition delay times this (3: the reference's V8 on regular at its knock edge)")]];
    float injector [[fminus::range(1e-4, 2e-2)]] [[fminus::default(3.7e-3)]] [[ui::label("Injector size")]] [[ui::unit("kg/s")]]
        [[ui::help("Each injector's flow wide open (3.7e-3 kg/s: some 300 cc/min of gasoline)")]];
    float soiAdd [[fminus::range(-20, 20)]] [[fminus::default(0)]] [[ui::label("Injection timing")]]
        [[ui::help("Injection timing moved against the map: earlier is louder and stronger, later quieter and smokier")]]
        [[ui::quantity("angle")]];
    float pilot [[fminus::range(0, 0.1)]] [[fminus::default(0)]] [[ui::label("Pilot injection")]]
        [[ui::help("The share of a diesel's fuel injected early as a pilot: it softens the clatter")]]
        [[ui::quantity("fraction")]];
    float rail [[fminus::range(200, 3000)]] [[fminus::default(1000)]] [[ui::label("Rail pressure")]]
        [[ui::help("A common-rail diesel's injection pressure: higher atomises the fuel finer")]] [[ui::unit("bar")]];
    float overFuel [[fminus::range(0, 0.4)]] [[fminus::default(0)]] [[ui::label("Over-fuel")]] [[ui::quantity("fraction")]]
        [[ui::help("Fuel past the smoke limit: more torque, black smoke")]];
    float octane [[fminus::range(0, 120)]] [[fminus::default(0)]] [[ui::label("Octane")]] [[ui::unit("AKI")]]
        [[ui::help("The pump number, (R+M)/2 (AKI); 0: the grade's own. It moves the knock and nothing else, read as the research octane by the grade's own sensitivity (RON = AKI + (RON - MON) / 2). The knock law is Douaud and Eyzat's fit over octanes 80 to 100: a number giving a RON past them (about AKI 75 to 95 on pump gasoline) is extrapolated, as race fuel and E85 already are. A diesel ignores it")]];
};
