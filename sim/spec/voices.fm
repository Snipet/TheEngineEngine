// spec/voices.fm: the mechanical voices (spec.voices). Owner: package M (sim/sound/, docs/models/voices.md).
//
// `model` 0 is the reference's engine bay (sim/sound/extras.fm as the reference has it), bit for bit: the default.
// `model` 1 adds every voice below, each driven by the model's own speeds, loads and events (none is a recording or a
// loop): the gearbox's whine and rattle, the final drive's, the belts and the timing drive, the cooling fan, the fuel
// pump and the injectors, the valvetrain's character, a wastegate's chatter and an external gate's dump, the starter.
// Every field is read only with `model` 1, every 16 samples once its `rev` moves; the levels glide over 16 samples
// (a voice never clicks on or off); the kinds take effect at once (a kind changes what a voice is made of, not how
// loud it is, and each voice starts from silence). A level of -60 dB is off: the voice is not computed.
#pragma once

module VoicesSpec
{
    int rev [[ui::hidden]];
    int model [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Mechanical voices")]]
        [[ui::choices("Reference", "Voices")]] [[ui::group("Voices")]]
        [[ui::help("Reference: the reference's engine bay, bit for bit. Voices: gears, belts, fan, pump, starter and more")]];
    float level [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("All voices")]] [[ui::unit("dB")]]
        [[ui::decimals(1)]] [[ui::help("Every voice of this section, together")]];
    // the gearbox and the final drive
    int gearCut [[fminus::range(0, 2)]] [[fminus::default(0)]] [[ui::label("Gear teeth")]] [[ui::group("Gearbox")]]
        [[ui::choices("By gearbox", "Helical", "Straight cut")]]
        [[ui::help("By gearbox: a sequential (dog) box and a truck's straight cut, the rest helical; reverse is always straight")]];
    float whine [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Gear whine")]]
        [[ui::help("The gearbox's gear whine")]] [[ui::unit("dB")]]
        [[ui::decimals(1)]];
    float axle [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Final drive whine")]]
        [[ui::help("The final drive's whine")]] [[ui::unit("dB")]]
        [[ui::decimals(1)]];
    float rattle [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Neutral rattle")]] [[ui::unit("dB")]]
        [[ui::decimals(1)]] [[ui::help("The idle gears' rattle in neutral with the clutch up: a dog box's loudest")]];
    int pinion [[fminus::range(0, 17)]] [[fminus::default(0)]] [[ui::label("Pinion teeth")]] [[ui::unit("teeth")]]
        [[ui::help("The final drive's pinion; 0: from the ratio (a ring of about 41 teeth)")]];
    // the drives at the front of the engine
    int timing [[fminus::range(0, 2)]] [[fminus::default(0)]] [[ui::label("Cam drive")]] [[ui::group("Drives")]]
        [[ui::choices("Chain", "Toothed belt", "Gears")]] [[ui::help("Chain: the reference's own whine")]];
    float timingLevel [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Cam drive level")]]
        [[ui::help("The cam drive's sound: a chain's, a belt's or gears'")]]
        [[ui::unit("dB")]] [[ui::decimals(1)]];
    float belt [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Accessory belt")]] [[ui::unit("dB")]]
        [[ui::decimals(1)]] [[ui::help("The alternator's whine, the water and steering pumps, the belt")]];
    int blowerDrive [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Supercharger drive")]]
        [[ui::choices("Belt", "Gears")]] [[ui::help("Heard only with a supercharger; its own whine is the boost's")]];
    // the cooling fan
    int fan [[fminus::range(0, 2)]] [[fminus::default(2)]] [[ui::label("Cooling fan")]]
        [[ui::help("The engine's cooling fan: none, viscous (turning with the engine) or electric")]]
        [[ui::group("Cooling fan")]]
        [[ui::choices("None", "Viscous clutch", "Electric")]];
    float fanOn [[fminus::range(300, 400)]] [[fminus::default(368)]] [[ui::label("Fan comes in at")]]
        [[ui::quantity("temperature")]] [[ui::help("The coolant's temperature: an electric fan's switch, a viscous clutch's full lock")]];
    int fanBlades [[fminus::range(2, 12)]] [[fminus::default(7)]] [[ui::label("Fan blades")]]
        [[ui::help("The fan's blades; their count sets its tone")]] [[ui::unit("blades")]];
    float fanLevel [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Fan level")]]
        [[ui::help("The fan's level")]] [[ui::unit("dB")]]
        [[ui::decimals(1)]];
    // fuel
    int injection [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Injection")]] [[ui::group("Fuel")]]
        [[ui::choices("Port", "Direct")]]
        [[ui::help("Direct: the injectors' sharp tick and the high-pressure pump on the cam (a gasoline engine's; a diesel keeps the reference's)")]];
    float injectors [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Injector tick")]]
        [[ui::help("The injectors' tick")]] [[ui::unit("dB")]]
        [[ui::decimals(1)]];
    float pump [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Fuel pump")]] [[ui::unit("dB")]]
        [[ui::decimals(1)]] [[ui::help("The tank's pump: its prime at key-on, its hum while the engine turns")]];
    float prime [[fminus::range(0, 10)]] [[fminus::default(2)]] [[ui::label("Prime")]]
        [[ui::help("How long the fuel pump primes when the key is turned on")]] [[ui::quantity("time")]]
        [[ui::decimals(1)]];
    // the valvetrain
    int lifters [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Lifters")]] [[ui::group("Valvetrain")]]
        [[ui::choices("Hydraulic", "Solid")]] [[ui::help("Solid: the lash's tick at every valve, louder with the lash")]];
    float lash [[fminus::range(0, 0.0008)]] [[fminus::default(0.00025)]] [[ui::label("Lash")]]
        [[ui::quantity("length")]] [[ui::help("A solid lifter's clearance, cold")]];
    float valveLevel [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Valvetrain tick and float")]]
        [[ui::help("The valvetrain's tick and, when the valves float, their clatter")]]
        [[ui::unit("dB")]] [[ui::decimals(1)]];
    // the wastegate
    float gate [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Wastegate")]] [[ui::group("Wastegate")]]
        [[ui::unit("dB")]] [[ui::decimals(1)]] [[ui::help("An internal gate's chatter; an external gate's open dump")]];
    int gateDump [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("External gate vents")]]
        [[ui::choices("Into the exhaust", "To the air")]]
        [[ui::help("To the air: a screamer pipe, heard only with an external gate")]];
    // the starter
    int starter [[fminus::range(0, 1)]] [[fminus::default(1)]] [[ui::label("Starter")]]
        [[ui::help("A direct-drive starter or a gear-reduction one (higher, whinier)")]] [[ui::group("Starter")]]
        [[ui::choices("Direct drive", "Gear reduction")]];
    float starterPower [[fminus::range(0, 10000)]] [[fminus::default(0)]] [[ui::label("Starter power")]]
        [[ui::quantity("power")]] [[ui::help("0: by the engine's size")]];
    float starterLevel [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Starter level")]]
        [[ui::help("The starter's level")]]
        [[ui::unit("dB")]] [[ui::decimals(1)]];
    // a motorcycle's (card B2's, spec.car.kind Motorcycle with car.model 1)
    float chain [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Chain whine")]]
        [[ui::help("A motorcycle's drive chain's whine")]] [[ui::group("Motorcycle")]]
        [[ui::unit("dB")]] [[ui::decimals(1)]];
    float lashLevel [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Chain lash clunk")]] [[ui::unit("dB")]]
        [[ui::decimals(1)]] [[ui::help("The drive's play closing as the throttle opens or shuts")]];
    float dryClutch [[fminus::range(-60, 12)]] [[fminus::default(0)]] [[ui::label("Dry clutch rattle")]] [[ui::unit("dB")]]
        [[ui::decimals(1)]] [[ui::help("Heard only with a dry clutch, at idle, the lever out")]];
};
