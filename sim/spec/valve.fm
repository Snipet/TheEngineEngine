// spec/valve.fm: the valvetrain (spec.valve). Owner: package E.
//
// The reference's one CAM dial until package E replaces it: 0 a mild cam (224 degrees each, 112 degrees apart), 1 a
// wild one (300 degrees, 106 apart: a long overlap, a lumpy idle, an idle the tune raises). It glides over 80 ms.
#pragma once

module ValveSpec
{
    int rev [[ui::hidden]];
    float cam [[fminus::range(0, 1)]] [[fminus::default(0.35)]] [[ui::label("Cam")]] [[ui::quantity("fraction")]]
        [[ui::help("From a mild cam to a wild one: duration and overlap")]];
    // the package's model (the integrator's switch, sim/README.md): 0 the reference's, bit for bit; 1 the package's own
    int model [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Valvetrain model")]] [[ui::choices("Reference", "New")]];
};
