// spec/engine.fm: the engine itself (spec.engine). Owner: package D.
//
// The reference's engine dials, with their meanings kept: the layout (one of the reference's seventeen, each with its
// firing order, banks and pipes: core/layouts.fm), its displacement (SI: m^3; the reference's SIZE dial in litres), the
// bore over the stroke, the compression ratio, the flywheel (the INERTIA dial: 0.45 to 2.2 times the layout's own
// inertia, 1 at 0.5), the idle and redline trims (rpm over the layout's own), how rough it runs, and the load a bench
// puts on it (MODE_BENCH only; driven, the car is the load).
//
// What the simulator does with a change: the layout, the displacement and nothing else here are taken under the
// reference's short fade (6 ms down, the change, 80 ms back up), the displacement once its value has rested 0.15 s;
// stopped, at once. The bore over the stroke and the compression glide over 80 ms; the trims, rough and the load act
// at once.
//
// Card D's fields, appended (docs/models/mechanics.md). With `custom` off (the default) none of them is read and the
// engine is the reference's. With it on:
//   the layout is the cylinders below (each one's bank, crank pin, firing revolution and place along the crank, each
//   bank's angle: core/layout.fm derives the firing angles), or, with `rotors` above 0, a rotary of that many rotors;
//   the cylinder is `bore` and `stroke` (0: from the displacement and bore/stroke dials) and `rodLength` (0: 3.3 times
//   the crank's radius, the reference's), at `compression` (the dial above: the same quantity);
//   the moving masses (`pistonMass`, `rodMass`, `rodRecip`) give the inertia torque and the varying inertia, and
//   `flywheelInertia` the crank's (0: the reference's, by layout and size and the flywheel dial);
//   friction is by part (core/friction.fm, Chen and Flynn's form), each coefficient a field;
//   `redlineSpeed` (0: by piston speed, 25 m/s);
//   `balance1`, `balance2`: balance shafts (telemetry only until wave 2 hears the shake).
// The layout, the cylinder's geometry and the masses are taken under the fade (as the layout dial); the friction's
// coefficients, the accessories and the balance shafts act at once.
#pragma once
#include "limits.fm"

enum
{
    ENGINE_MAX_BANKS = 4,      // a W engine's four
    ENGINE_MAX_ROTORS = 4      // a rotary's rotors (three faces each: twelve, within MAX_CYL)
};

module EngineSpec
{
    int rev [[ui::hidden]];
    int layout [[fminus::range(0, 16)]] [[fminus::default(12)]] [[ui::label("Layout")]]
        [[ui::choices("Single", "Twin 360", "Twin 270", "V-twin 45", "Inline 3", "Inline 4", "Flat 4", "Crossplane I4",
                      "Inline 5", "V6", "Inline 6", "Flat 6", "V8 crossplane", "V8 flat-plane", "V10", "V12", "Rotary")]]
        [[ui::help("The cylinders, their firing order and their exhaust's layout")]];
    float displacement [[fminus::range(0.00005, 0.03)]] [[fminus::default(0.00576)]] [[ui::label("Displacement")]]
        [[ui::quantity("volume")]] [[ui::taper("log")]] [[ui::decimals(2)]]
        [[ui::help("All the cylinders' swept volume (a rotary's: its two rotors' chambers)")]];
    float boreStroke [[fminus::range(0.5, 2)]] [[fminus::default(1)]] [[ui::label("Bore / stroke")]]
        [[ui::quantity("ratio")]] [[ui::decimals(2)]]
        [[ui::help("Above 1 oversquare: a wide bore, a short stroke, high revs")]];
    float compression [[fminus::range(6, 25)]] [[fminus::default(10)]] [[ui::label("Compression")]]
        [[ui::quantity("ratio")]] [[ui::decimals(1)]] [[ui::help("The compression ratio")]];
    float flywheel [[fminus::range(0, 1)]] [[fminus::default(0.5)]] [[ui::label("Flywheel")]]
        [[ui::quantity("fraction")]] [[ui::help("The crank and flywheel's inertia: 0.45 to 2.2 times the layout's")]];
    float idleTrim [[fminus::range(-400, 800)]] [[fminus::default(0)]] [[ui::label("Idle trim")]] [[ui::unit("rpm")]]
        [[ui::decimals(0)]] [[ui::help("The idle speed over the layout's own")]];
    float redlineTrim [[fminus::range(-3000, 3000)]] [[fminus::default(0)]] [[ui::label("Redline trim")]]
        [[ui::unit("rpm")]] [[ui::decimals(0)]] [[ui::help("The redline over the layout's own")]];
    float rough [[fminus::range(0, 1)]] [[fminus::default(0.3)]] [[ui::label("Rough")]] [[ui::quantity("fraction")]]
        [[ui::help("How much one cycle differs from the next")]];
    float benchLoad [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Bench load")]]
        [[ui::quantity("fraction")]] [[ui::help("The load a bench puts on the crank, with no vehicle")]];
    // ---- card D: a custom engine ----
    bool custom [[fminus::default(0)]] [[ui::label("Custom engine")]] [[ui::group("Custom engine")]]
        [[ui::help("Off: the reference's layouts and dials. On: the geometry, masses and friction below.")]];
    int cylinders [[fminus::range(1, 16)]] [[fminus::default(8)]] [[ui::label("Cylinders")]] [[ui::unit("cylinders")]];
    int rotors [[fminus::range(0, 4)]] [[fminus::default(0)]] [[ui::label("Rotors")]] [[ui::unit("rotors")]]
        [[ui::help("Above 0: a rotary of this many rotors, three faces each; the cylinders' fields are its rotors'.")]];
    float bankAngle [[fminus::range(-180, 180)]] [[fminus::default(0)]] [[ui::label("Bank angle")]] [[ui::unit("deg")]]
        [[ui::help("Each bank's cylinder axis from vertical, crank degrees in the direction it turns.")]] [ENGINE_MAX_BANKS];
    int bank [[fminus::range(0, 3)]] [[fminus::default(0)]] [[ui::label("Bank")]] [[ui::choices("A", "B", "C", "D")]] [MAX_CYL];
    float pin [[fminus::range(0, 360)]] [[fminus::default(0)]] [[ui::label("Crank pin")]] [[ui::unit("deg")]]
        [[ui::help("Where the cylinder's crank pin sits on the crank at crank angle 0.")]] [MAX_CYL];
    int fireRev [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Fires on revolution")]] [[ui::choices("First", "Second")]] [MAX_CYL];
    float place [[fminus::range(0, 2)]] [[fminus::default(0)]] [[ui::label("Place along the crank")]] [[ui::quantity("length")]] [MAX_CYL];
    float bore [[fminus::range(0, 0.25)]] [[fminus::default(0)]] [[ui::label("Bore")]] [[ui::quantity("length")]]
        [[ui::help("0: from the displacement and bore/stroke dials.")]];
    float stroke [[fminus::range(0, 0.25)]] [[fminus::default(0)]] [[ui::label("Stroke")]] [[ui::quantity("length")]]
        [[ui::help("0: from the displacement and bore/stroke dials.")]];
    float rodLength [[fminus::range(0, 0.6)]] [[fminus::default(0)]] [[ui::label("Rod length")]] [[ui::quantity("length")]]
        [[ui::help("Centre to centre. 0: 3.3 times the crank's radius, the reference's.")]];
    float pistonMass [[fminus::range(0, 20)]] [[fminus::default(0)]] [[ui::label("Piston, pin and rings")]]
        [[ui::quantity("mass")]] [[ui::help("0: by the bore (core/inertia.fm).")]];
    float rodMass [[fminus::range(0, 20)]] [[fminus::default(0)]] [[ui::label("Rod")]] [[ui::quantity("mass")]]
        [[ui::help("0: by the bore and the rod's length (core/inertia.fm).")]];
    float rodRecip [[fminus::range(0, 1)]] [[fminus::default(0.333)]] [[ui::label("Rod's share moving with the piston")]]
        [[ui::quantity("fraction")]];
    float flywheelInertia [[fminus::range(0, 5)]] [[fminus::default(0)]] [[ui::label("Crank and flywheel")]]
        [[ui::quantity("inertia")]] [[ui::help("0: the reference's, by layout and size and the flywheel dial.")]];
    bool balance1 [[fminus::default(0)]] [[ui::label("First-order balance shafts")]];
    bool balance2 [[fminus::default(0)]] [[ui::label("Second-order balance shafts")]];
    float fricConst [[fminus::range(0, 200000)]] [[fminus::default(40000)]] [[ui::label("Friction: constant")]]
        [[ui::quantity("pressure")]] [[ui::help("Seals, the oil pump's base load.")]];
    float fricPeak [[fminus::range(0, 0.02)]] [[fminus::default(0.004)]] [[ui::label("Friction: rings by peak pressure")]] [[ui::quantity("ratio")]]
        [[ui::decimals(4)]] [[ui::help("Mean friction pressure per unit of peak cylinder pressure.")]];
    float fricSpeed [[fminus::range(0, 10000)]] [[fminus::default(2000)]] [[ui::label("Friction: rings and skirts by piston speed")]]
        [[ui::unit("Pa s/m")]];
    float fricSpeed2 [[fminus::range(0, 1000)]] [[fminus::default(190)]] [[ui::label("Friction: by piston speed squared")]]
        [[ui::unit("Pa s2/m2")]];
    float fricBearing [[fminus::range(0, 20000)]] [[fminus::default(3500)]] [[ui::label("Friction: bearings, per 1000 rpm")]]
        [[ui::unit("Pa")]];
    int frictionValvetrain [[fminus::range(0, 3)]] [[fminus::default(0)]] [[ui::label("Friction: valvetrain")]]
        [[ui::choices("Flat tappet", "Roller", "Finger follower", "None")]] [[ui::help("Until card E's valvetrain kind.")]];
    float alternator [[fminus::range(0, 5000)]] [[fminus::default(300)]] [[ui::label("Alternator load")]]
        [[ui::quantity("power")]];
    bool airCon [[fminus::default(0)]] [[ui::label("Air conditioner")]];
    float redlineSpeed [[fminus::range(0, 2500)]] [[fminus::default(0)]] [[ui::label("Redline")]] [[ui::quantity("rotation")]]
        [[ui::help("0: by piston speed (25 m/s; a diesel's 13.5).")]];
    float portExOpen [[fminus::range(0, 1080)]] [[fminus::default(0)]] [[ui::label("Rotary: exhaust port opens")]]
        [[ui::unit("deg")]] [[ui::help("Degrees of the eccentric shaft; 0: the reference's peripheral port, by the cam dial.")]];
    float portExDur [[fminus::range(0, 720)]] [[fminus::default(0)]] [[ui::label("Rotary: exhaust port open for")]] [[ui::unit("deg")]];
    float portInOpen [[fminus::range(0, 1080)]] [[fminus::default(0)]] [[ui::label("Rotary: intake port opens")]] [[ui::unit("deg")]];
    float portInDur [[fminus::range(0, 720)]] [[fminus::default(0)]] [[ui::label("Rotary: intake port open for")]] [[ui::unit("deg")]];
    // ---- card T: the two-stroke (sim/core/twostroke/, docs/models/twostroke.md). `cycle` 0 (the default): none of the
    // fields below is read and the engine is as before. 1: the engine is a crankcase-scavenged two-stroke of `tsCylinders`
    // cylinders (bore, stroke, rod and compression as above: `bore` and `stroke` must be set), each with its own
    // expansion chamber; the layout, the valvetrain, the intake and the exhaust above and in their sections are not
    // used. Made under the fade: cycle, the cylinders, firing, ports, inlet, pipe's sections. Glided: the power valve, the
    // pipe's gas. Defaults: a 125 cc racing single's ports and pipe (judgement from Jennings's and Blair's books). ----
    int cycle [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Cycle")]] [[ui::choices("Four-stroke", "Two-stroke")]]
        [[ui::group("Two-stroke")]];
    // ---- the engine: how many cylinders and how they fire (bore, stroke, rod and compression are the fields above) ----
    int tsCylinders [[fminus::range(1, 4)]] [[fminus::default(1)]] [[ui::label("Cylinders")]] [[ui::unit("cyl")]];
    int tsFiring [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Firing")]] [[ui::choices("Even", "Together")]]
        [[ui::help("Even: one every 360 / cylinders degrees (a 180-degree twin, a 120-degree triple); together: all at once.")]];
    // ---- the ports: each opens when the piston uncovers its top edge, open for its duration about bottom dead centre;
    //      its width is the bore's share its windows span (the bridges between them left out) ----
    float tsExhaustDur [[fminus::range(140, 220)]] [[fminus::default(192)]] [[ui::label("Exhaust port open")]] [[ui::unit("deg")]]
        [[ui::group("Ports")]];
    float tsExhaustWidth [[fminus::range(0.3, 1.0)]] [[fminus::default(0.70)]] [[ui::label("Exhaust port width")]]
        [[ui::quantity("fraction")]] [[ui::help("Over the bore.")]];
    float tsExhaustRadius [[fminus::range(0, 0.5)]] [[fminus::default(0.25)]] [[ui::label("Exhaust port's corner radius")]]
        [[ui::quantity("fraction")]] [[ui::help("Its top corners' radius over its width: a rounder port opens more gently.")]];
    float tsTransferDur [[fminus::range(100, 150)]] [[fminus::default(130)]] [[ui::label("Transfer ports open")]] [[ui::unit("deg")]];
    float tsTransferWidth [[fminus::range(0.3, 1.6)]] [[fminus::default(1.10)]] [[ui::label("Transfer ports' width")]]
        [[ui::quantity("fraction")]] [[ui::help("All the transfers' windows together, over the bore.")]];
    float tsTransferRadius [[fminus::range(0, 0.5)]] [[fminus::default(0.15)]] [[ui::label("Transfer ports' corner radius")]]
        [[ui::quantity("fraction")]];
    float tsPortCd [[fminus::range(0.4, 0.9)]] [[fminus::default(0.70)]] [[ui::label("Ports' discharge coefficient")]] [[ui::quantity("ratio")]];
    // ---- the power valve: the exhaust port's top edge lowered at low speed (a shorter duration), raised above ----
    float tsValveDur [[fminus::range(0, 220)]] [[fminus::default(0)]] [[ui::label("Power valve closed: exhaust open")]]
        [[ui::unit("deg")]] [[ui::group("Power valve")]] [[ui::help("0: no power valve.")]];
    float tsValveFrom [[fminus::range(0, 2000)]] [[fminus::default(900)]] [[ui::label("Opens from")]] [[ui::quantity("rotation")]];
    float tsValveTo [[fminus::range(0, 2000)]] [[fminus::default(1150)]] [[ui::label("Fully open at")]] [[ui::quantity("rotation")]];
    // ---- the crankcase and its valve ----
    float tsCrankcaseRatio [[fminus::range(1.1, 2.0)]] [[fminus::default(1.40)]] [[ui::label("Crankcase compression")]]
        [[ui::quantity("ratio")]] [[ui::group("Crankcase")]];
    int tsInletKind [[fminus::range(0, 2)]] [[fminus::default(0)]] [[ui::label("Inlet")]]
        [[ui::choices("Reed valve", "Rotary disc", "Piston port")]];
    float tsInletArea [[fminus::range(0.0001, 0.003)]] [[fminus::default(0.0008)]] [[ui::label("Inlet's open area")]]
        [[ui::quantity("area")]];
    float tsReedFull [[fminus::range(1000, 50000)]] [[fminus::default(15000)]] [[ui::label("Reed fully open at")]]
        [[ui::quantity("pressure")]] [[ui::help("The drop across the reed that opens it fully.")]];
    float tsReedHz [[fminus::range(100, 2000)]] [[fminus::default(550)]] [[ui::label("Reed's natural frequency")]]
        [[ui::quantity("frequency")]] [[ui::help("The petal's own ring: a stiff, light petal follows a fast engine.")]];
    float tsReedDamping [[fminus::range(0.02, 1.0)]] [[fminus::default(0.15)]] [[ui::label("Reed's damping")]]
        [[ui::quantity("ratio")]];
    float tsDiscOpen [[fminus::range(0, 360)]] [[fminus::default(220)]] [[ui::label("Disc opens")]] [[ui::unit("deg")]]
        [[ui::help("Crank degrees after top dead centre: 220 is 140 before the next, as the piston rises.")]];
    float tsDiscDur [[fminus::range(90, 250)]] [[fminus::default(200)]] [[ui::label("Disc open for")]] [[ui::unit("deg")]];
    float tsPistonDur [[fminus::range(90, 200)]] [[fminus::default(140)]] [[ui::label("Piston port open for")]] [[ui::unit("deg")]]
        [[ui::help("About top dead centre: the piston's skirt uncovers the inlet.")]];
    float tsCarbArea [[fminus::range(0.0001, 0.003)]] [[fminus::default(0.00057)]] [[ui::label("Carburettor bore's area")]]
        [[ui::quantity("area")]];
    // ---- scavenging ----
    float tsMixing [[fminus::range(0, 1)]] [[fminus::default(0.55)]] [[ui::label("Scavenging: mixing")]]
        [[ui::quantity("fraction")]] [[ui::group("Scavenging")]]
        [[ui::help("0: the fresh charge displaces the burned gas; 1: it mixes with it at once.")]];
    float tsShortCircuit [[fminus::range(0, 0.5)]] [[fminus::default(0.10)]] [[ui::label("Short-circuited share")]]
        [[ui::quantity("fraction")]] [[ui::help("Of what the transfers deliver, what goes straight out of the exhaust.")]];
    // ---- the burn ----
    float tsSpark [[fminus::range(0, 40)]] [[fminus::default(18)]] [[ui::label("Spark")]] [[ui::unit("deg")]]
        [[ui::group("Burn")]] [[ui::help("Crank degrees before top dead centre.")]];
    float tsBurnDur [[fminus::range(20, 90)]] [[fminus::default(45)]] [[ui::label("Burn's duration")]] [[ui::unit("deg")]];
    float tsAfr [[fminus::range(10, 16)]] [[fminus::default(12.8)]] [[ui::label("Air-fuel ratio")]] [[ui::quantity("ratio")]];
    // ---- the expansion chamber: header, diffuser, belly, baffle cone, stinger ----
    float tsHeaderLen [[fminus::range(0.02, 0.6)]] [[fminus::default(0.16)]] [[ui::label("Header")]] [[ui::quantity("length")]]
        [[ui::group("Expansion chamber")]];
    float tsDiffuserLen [[fminus::range(0.05, 0.8)]] [[fminus::default(0.33)]] [[ui::label("Diffuser")]] [[ui::quantity("length")]];
    float tsBellyLen [[fminus::range(0.0, 0.5)]] [[fminus::default(0.12)]] [[ui::label("Belly")]] [[ui::quantity("length")]];
    float tsBaffleLen [[fminus::range(0.05, 0.5)]] [[fminus::default(0.24)]] [[ui::label("Baffle cone")]] [[ui::quantity("length")]];
    float tsStingerLen [[fminus::range(0.05, 0.5)]] [[fminus::default(0.22)]] [[ui::label("Stinger")]] [[ui::quantity("length")]];
    float tsHeaderDiam [[fminus::range(0.015, 0.08)]] [[fminus::default(0.038)]] [[ui::label("Header's bore")]] [[ui::quantity("length")]];
    float tsBellyDiam [[fminus::range(0.03, 0.2)]] [[fminus::default(0.115)]] [[ui::label("Belly's bore")]] [[ui::quantity("length")]];
    float tsStingerDiam [[fminus::range(0.01, 0.05)]] [[fminus::default(0.022)]] [[ui::label("Stinger's bore")]] [[ui::quantity("length")]];
    int tsConeSteps [[fminus::range(1, 16)]] [[fminus::default(8)]] [[ui::label("Steps a cone")]] [[ui::unit("steps")]]
        [[ui::help("Each cone as this many short ducts of stepped bore.")]];
    int tsChamber [[fminus::range(0, 1)]] [[fminus::default(1)]] [[ui::label("Pipe")]]
        [[ui::choices("Straight pipe", "Expansion chamber")]];
    int tsSilencer [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Silencer")]] [[ui::choices("None", "Packed")]]
        [[ui::help("After the stinger: a perforated core wrapped in fibre (its bore near the stinger's: straight through) or a can (a wide bore), its outlet then a short tube of the stinger's bore.")]];
    float tsSilencerLen [[fminus::range(0.1, 0.6)]] [[fminus::default(0.40)]] [[ui::label("Silencer's length")]]
        [[ui::quantity("length")]];
    float tsSilencerDiam [[fminus::range(0.012, 0.12)]] [[fminus::default(0.026)]] [[ui::label("Silencer's bore")]]
        [[ui::quantity("length")]];
    float tsSilencerPack [[fminus::range(0, 30)]] [[fminus::default(6)]] [[ui::label("Silencer's packing")]] [[ui::unit("dB")]]
        [[ui::help("What a pass through the silencer takes from the sound (the steady flow passes whole).")]];
    // the walls' heat (core/wallheat.fm): the reference's one coefficient by speed, or Woschni's from each cylinder's
    // own pressure, temperature and gas speed; meant with fuel.model 1's whole burn (card H)
    int wallHeat [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Wall heat")]] [[ui::group("Cylinder heat")]] [[ui::choices("Reference", "Woschni")]];
};
