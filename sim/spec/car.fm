// spec/car.fm: the vehicle (spec.car). Owner: package I.
//
// The reference's DRIVE (CAR or TRUCK: used in MODE_DRIVE) and WEIGHT dials. The kind takes effect the next time the
// vehicle is set up (a change of kind puts it at rest, in neutral, as the reference's DRIVE dial did); the mass at once.
//
// Then card I's: `model` (0 the reference's car, bit for bit: the default; 1 the vehicle model of sim/vehicle/vehicle.fm,
// docs/models/vehicle.md) and the model's fields, read only when `model` is 1. None is glided: each takes effect at the
// next 16-sample step; `model`, `gearbox`, `drive` and `gears` put the vehicle in neutral at rest. `mass` is the
// reference's, shared. The model reads them through its own VehSpec (vehicle/vspec.fm), whose fields have these names.
//
// Card B2's block (the motorcycle: kind Motorcycle with model 1; read by vehicle/bike.fm through its BikeSpec,
// vehicle/bspec.fm, whose fields have these names): the rider, the tuck, the pitch, the tyres, the primary drive and
// the sprockets, the chain's lash and efficiency, the slipper clutch, the quickshifter, the auto-blipper, the wheelie
// control. None is glided. With any other kind or model 0 none is read.
#pragma once

module CarSpec
{
    int rev [[ui::hidden]];
    int kind [[fminus::range(0, 2)]] [[fminus::default(0)]] [[ui::label("Vehicle")]] [[ui::choices("Car", "Truck", "Motorcycle")]]
        [[ui::help("A car: six gears; a semi truck: eighteen; a motorcycle (with the vehicle model; the reference's model takes it as a car)")]];
    float mass [[fminus::range(100, 50000)]] [[fminus::default(1400)]] [[ui::label("Mass")]]
        [[ui::help("The car's mass with its driver and fuel")]] [[ui::quantity("mass")]]
        [[ui::taper("log")]] [[ui::decimals(0)]];
    int model [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Vehicle model")]]
        [[ui::choices("Reference", "Vehicle")]] [[ui::group("Vehicle")]]
        [[ui::help("Reference: the reference's car, bit for bit. Vehicle: tyres, loads, differentials and gearboxes")]];
    int drive [[fminus::range(0, 2)]] [[fminus::default(1)]] [[ui::label("Driven wheels")]]
        [[ui::help("Which wheels the engine drives")]]
        [[ui::choices("Front", "Rear", "All")]];
    float wheelbase [[fminus::range(1, 8)]] [[fminus::default(2.6)]] [[ui::label("Wheelbase")]]
        [[ui::help("The distance between the front and rear axles; longer shifts less weight under acceleration")]]
        [[ui::quantity("length")]]
        [[ui::group("Body")]];
    float cgHeight [[fminus::range(0.2, 2.5)]] [[fminus::default(0.5)]] [[ui::label("Centre of mass height")]]
        [[ui::help("How high the centre of mass is: higher shifts more weight to the rear when pulling away")]]
        [[ui::quantity("length")]];
    float frontWeight [[fminus::range(0.2, 0.8)]] [[fminus::default(0.53)]] [[ui::label("Weight on the front")]]
        [[ui::help("The share of the weight on the front wheels at rest")]]
        [[ui::quantity("fraction")]];
    float track [[fminus::range(0.8, 2.6)]] [[fminus::default(1.55)]] [[ui::label("Track")]]
        [[ui::help("The distance between the left and right wheels")]] [[ui::quantity("length")]];
    float cdA [[fminus::range(0.2, 12)]] [[fminus::default(0.7)]] [[ui::label("Drag area (Cd A)")]]
        [[ui::help("The drag coefficient times the frontal area: what the air holds the car back with at speed")]]
        [[ui::quantity("area")]];
    float clA [[fminus::range(-2, 5)]] [[fminus::default(0)]] [[ui::label("Downforce area (Cl A)")]]
        [[ui::quantity("area")]] [[ui::help("Positive presses the car down; negative is lift")]];
    float aeroBalance [[fminus::range(0, 1)]] [[fminus::default(0.45)]] [[ui::label("Downforce on the front")]]
        [[ui::help("The share of the downforce on the front axle")]]
        [[ui::quantity("fraction")]];
    int tyre [[fminus::range(0, 9)]] [[fminus::default(1)]] [[ui::label("Tyres")]]
        [[ui::help("The tyres' compound: how much grip, how it grows with heat and how it falls away past the peak")]]
        [[ui::group("Tyres")]]
        [[ui::choices("Economy", "Street", "Sport", "Semi-slick", "Slick", "Drag radial", "Drag slick", "Winter",
                      "Truck", "Motorcycle")]];
    float tyreRadius [[fminus::range(0.2, 0.7)]] [[fminus::default(0.33)]] [[ui::label("Rolling radius")]]
        [[ui::help("The driven tyres' rolling radius")]]
        [[ui::quantity("length")]];
    float wheelInertia [[fminus::range(0.2, 60)]] [[fminus::default(1.1)]] [[ui::label("Wheel inertia (each)")]]
        [[ui::help("Each wheel's and tyre's inertia")]]
        [[ui::quantity("inertia")]];
    float brakeDecel [[fminus::range(0.3, 2.5)]] [[fminus::default(1.2)]] [[ui::label("Brakes")]] [[ui::unit("g")]]
        [[ui::group("Brakes")]] [[ui::help("The deceleration a full pedal asks for, before the tyres' grip")]];
    float brakeBias [[fminus::range(0.3, 0.9)]] [[fminus::default(0.65)]] [[ui::label("Brake bias to the front")]]
        [[ui::help("The share of the braking done by the front wheels")]]
        [[ui::quantity("fraction")]];
    bool abs [[fminus::default(1)]] [[ui::label("ABS")]]
        [[ui::help("On: the brakes are released before a wheel locks")]] ;
    int gearbox [[fminus::range(0, 5)]] [[fminus::default(0)]] [[ui::label("Gearbox")]]
        [[ui::help("Manual (H-pattern and clutch), sequential (a dog box), dual clutch, automatic (torque converter), CVT, or a truck's eighteen-speed (range and splitter, no synchromesh)")]]
        [[ui::group("Gearbox")]]
        [[ui::choices("Manual", "Sequential", "Dual clutch", "Automatic", "CVT", "Eighteen-speed")]];
    int gears [[fminus::range(1, 18)]] [[fminus::default(6)]] [[ui::label("Forward gears")]]
        [[ui::help("How many forward gears")]] [[ui::unit("gears")]];
    bool autoGearing [[fminus::default(1)]] [[ui::label("Gear it for the engine")]]
        [[ui::help("The reference's rule: the ratios and final drive chosen for the engine's power and redline")]];
    float ratio [[fminus::range(0.3, 20)]] [[fminus::default(1)]] [[ui::label("Ratios")]]
        [[ui::help("Each gear's ratio, first gear first: crank turns to the output's one")]]
        [[ui::quantity("ratio")]] [MAX_GEARS];
    float reverseRatio [[fminus::range(1, 20)]] [[fminus::default(3.3)]] [[ui::label("Reverse")]]
        [[ui::help("The reverse gear's ratio")]]
        [[ui::quantity("ratio")]];
    float finalDrive [[fminus::range(1, 12)]] [[fminus::default(3.6)]] [[ui::label("Final drive")]]
        [[ui::help("The differential's ratio, multiplying every gear")]]
        [[ui::quantity("ratio")]];
    float clutchTorque [[fminus::range(0, 20000)]] [[fminus::default(0)]] [[ui::label("Clutch capacity")]]
        [[ui::quantity("torque")]] [[ui::help("0: 1.35 times the engine's peak torque, as the reference sizes it")]];
    float gearEfficiency [[fminus::range(0.8, 1)]] [[fminus::default(0.97)]] [[ui::label("Gearbox efficiency")]]
        [[ui::help("The share of the power the gearbox and differential pass on")]]
        [[ui::quantity("fraction")]];
    float shiftTime [[fminus::range(0.05, 1)]] [[fminus::default(0.15)]] [[ui::label("Shift time")]]
        [[ui::quantity("time")]] [[ui::help("A dual clutch's handover; an automatic's overlap is 2.5 times it")]];
    float converterK [[fminus::range(5, 40)]] [[fminus::default(13.5)]] [[ui::label("Converter capacity")]]
        [[ui::unit("rad/s/sqrt(N m)")]] [[ui::group("Converter")]]
        [[ui::help("The impeller's speed over the square root of its torque at stall")]];
    float converterRatio [[fminus::range(1, 3)]] [[fminus::default(1.9)]] [[ui::label("Stall torque ratio")]]
        [[ui::help("The torque converter's torque multiplication when the car is held still (its stall ratio)")]]
        [[ui::quantity("ratio")]];
    float couplingPoint [[fminus::range(0.6, 0.95)]] [[fminus::default(0.85)]] [[ui::label("Coupling point")]]
        [[ui::help("The speed ratio where the converter stops multiplying torque and couples")]]
        [[ui::quantity("fraction")]];
    bool lockUp [[fminus::default(1)]] [[ui::label("Lock-up clutch")]]
        [[ui::help("On: a clutch locks the converter solid at cruising speed")]] ;
    float cvtLow [[fminus::range(1.5, 5)]] [[fminus::default(2.5)]] [[ui::label("CVT lowest ratio")]]
        [[ui::help("The CVT's lowest (pulling-away) ratio")]]
        [[ui::quantity("ratio")]] [[ui::group("CVT")]];
    float cvtHigh [[fminus::range(0.3, 1.2)]] [[fminus::default(0.45)]] [[ui::label("CVT highest ratio")]]
        [[ui::help("The CVT's highest (cruising) ratio")]]
        [[ui::quantity("ratio")]];
    float cvtEfficiency [[fminus::range(0.8, 1)]] [[fminus::default(0.9)]] [[ui::label("CVT belt efficiency")]]
        [[ui::help("The share of the power the CVT's belt passes on")]]
        [[ui::quantity("fraction")]];
    float centreSplit [[fminus::range(0, 1)]] [[fminus::default(0.4)]] [[ui::label("Torque to the front")]]
        [[ui::quantity("fraction")]] [[ui::group("Differentials")]] [[ui::help("All-wheel drive's centre differential")]];
    float centrePreload [[fminus::range(0, 5000)]] [[fminus::default(0)]] [[ui::label("Centre preload")]]
        [[ui::help("The torque the centre differential's clutches pass before the axles may turn at different speeds")]]
        [[ui::quantity("torque")]];
    float centreKSpeed [[fminus::range(0, 500)]] [[fminus::default(0)]] [[ui::label("Centre viscous")]]
        [[ui::help("The centre differential's viscous locking for each rad/s of difference")]]
        [[ui::unit("N m s/rad")]];
    float centreKTorque [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Centre torque bias")]]
        [[ui::help("The centre differential's torque bias: how much more the gripping axle may take")]]
        [[ui::quantity("fraction")]];
    bool centreLocked [[fminus::default(0)]] [[ui::label("Centre locked")]]
        [[ui::help("On: the centre differential is locked solid")]] ;
    float frontPreload [[fminus::range(0, 5000)]] [[fminus::default(0)]] [[ui::label("Front preload")]]
        [[ui::help("The front differential's preload")]]
        [[ui::quantity("torque")]];
    float frontKSpeed [[fminus::range(0, 500)]] [[fminus::default(0)]] [[ui::label("Front viscous")]]
        [[ui::help("The front differential's viscous locking")]]
        [[ui::unit("N m s/rad")]];
    float frontKTorque [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Front torque bias")]]
        [[ui::help("The front differential's torque bias")]]
        [[ui::quantity("fraction")]];
    bool frontLocked [[fminus::default(0)]] [[ui::label("Front locked")]]
        [[ui::help("On: the front differential is locked solid")]] ;
    float rearPreload [[fminus::range(0, 5000)]] [[fminus::default(0)]] [[ui::label("Rear preload")]]
        [[ui::help("The rear differential's preload")]]
        [[ui::quantity("torque")]];
    float rearKSpeed [[fminus::range(0, 500)]] [[fminus::default(0)]] [[ui::label("Rear viscous")]]
        [[ui::help("The rear differential's viscous locking")]]
        [[ui::unit("N m s/rad")]];
    float rearKTorque [[fminus::range(0, 1)]] [[fminus::default(0)]] [[ui::label("Rear torque bias")]]
        [[ui::help("The rear differential's torque bias")]]
        [[ui::quantity("fraction")]];
    bool rearLocked [[fminus::default(0)]] [[ui::label("Rear locked")]]
        [[ui::help("On: the rear differential is locked solid (a spool)")]] ;
    bool liveAxle [[fminus::default(0)]] [[ui::label("Live rear axle")]]
        [[ui::help("The propeller shaft's torque reaction unloads the right rear tyre")]];
    bool proTree [[fminus::default(0)]] [[ui::label("Pro tree")]] [[ui::group("Strip")]]
        [[ui::help("The three ambers together, green 0.4 s later; otherwise half a second apart")]];
    // ---- card B2: the motorcycle (kind Motorcycle, model 1; sim/vehicle/bspec.fm's BikeSpec, the same names) ----
    float riderMass [[fminus::range(0, 200)]] [[fminus::default(80)]] [[ui::label("Rider")]] [[ui::quantity("mass")]]
        [[ui::group("Motorcycle")]] [[ui::help("The rider and their kit; the bike's own mass is Mass above")]];
    float riderHeight [[fminus::range(0.4, 1.6)]] [[fminus::default(1.0)]] [[ui::label("Rider's centre of mass height")]]
        [[ui::quantity("length")]] [[ui::help("Sitting up; a full tuck lowers it 0.12 m")]];
    float riderForward [[fminus::range(0, 1)]] [[fminus::default(0.42)]] [[ui::label("Rider ahead of the rear axle")]]
        [[ui::quantity("fraction")]] [[ui::help("Their centre of mass, as a share of the wheelbase; a full tuck moves it 0.06 forward")]];
    float tuck [[fminus::range(0, 1)]] [[fminus::default(1)]] [[ui::label("Tuck")]] [[ui::quantity("fraction")]]
        [[ui::help("0 sitting up (Cd A above), 1 flat on the tank (Cd A tucked)")]];
    float cdATuck [[fminus::range(0.1, 1.5)]] [[fminus::default(0.32)]] [[ui::label("Drag area tucked in")]]
        [[ui::help("A motorcycle's drag area with the rider tucked in")]]
        [[ui::quantity("area")]];
    float pitchInertia [[fminus::range(5, 300)]] [[fminus::default(50)]] [[ui::label("Pitch inertia")]]
        [[ui::quantity("inertia")]] [[ui::help("The bike and rider about their centre of mass, nose up and down")]];
    int bikeTyre [[fminus::range(0, 5)]] [[fminus::default(1)]] [[ui::label("Motorcycle tyres")]]
        [[ui::help("A motorcycle's tyres")]]
        [[ui::choices("Touring", "Sport", "Hypersport", "Race slick", "Dual sport", "Cruiser")]];
    float primaryRatio [[fminus::range(1, 4)]] [[fminus::default(1.7)]] [[ui::label("Primary drive")]]
        [[ui::quantity("ratio")]] [[ui::group("Chain and clutch")]] [[ui::help("The crank's gear to the clutch's basket")]];
    int frontSprocket [[fminus::range(10, 30)]] [[fminus::default(16)]] [[ui::label("Front sprocket")]]
        [[ui::help("A motorcycle's front sprocket's teeth; fewer is lower gearing")]]
        [[ui::unit("teeth")]];
    int rearSprocket [[fminus::range(25, 70)]] [[fminus::default(42)]] [[ui::label("Rear sprocket")]]
        [[ui::help("A motorcycle's rear sprocket's teeth; more is lower gearing")]] [[ui::unit("teeth")]];
    float chainEfficiency [[fminus::range(0.85, 1)]] [[fminus::default(0.97)]] [[ui::label("Chain efficiency")]]
        [[ui::quantity("fraction")]] [[ui::help("A clean O-ring chain's is about 0.97 to 0.98; a belt's 0.95 to 0.97")]];
    float chainLash [[fminus::range(0, 0.25)]] [[fminus::default(0.035)]] [[ui::label("Driveline lash")]]
        [[ui::unit("rad")]] [[ui::help("The play between throttle on and off, at the rear wheel: the dogs, the chain's slack, the cush drive")]];
    bool slipper [[fminus::default(1)]] [[ui::label("Slipper clutch")]]
        [[ui::help("Lets the clutch slip when the rear wheel drives the engine hard, as on a clumsy downshift")]];
    float slipperTorque [[fminus::range(0.05, 1)]] [[fminus::default(0.15)]] [[ui::label("Slipper's back torque")]]
        [[ui::quantity("fraction")]] [[ui::help("The most it passes backwards, as a share of the clutch's capacity")]];
    bool quickshifter [[fminus::default(1)]] [[ui::label("Quickshifter")]] [[ui::group("Shifting")]]
        [[ui::help("Upshifts under power without the clutch: the ignition is cut while the dogs change over")]];
    float quickshiftCut [[fminus::range(0.02, 0.12)]] [[fminus::default(0.05)]] [[ui::label("Quickshift cut")]]
        [[ui::help("How long the quickshifter cuts the ignition for an upshift")]]
        [[ui::quantity("time")]];
    bool autoBlip [[fminus::default(1)]] [[ui::label("Auto-blipper")]]
        [[ui::help("Downshifts without the clutch: the throttle is blipped to the lower gear's speed")]];
    int wheelieControl [[fminus::range(0, 2)]] [[fminus::default(1)]] [[ui::label("Wheelie control")]]
        [[ui::choices("Off", "By the throttle", "By the clutch")]] [[ui::group("Wheelie")]]
        [[ui::help("What holds the front up at the angle below: a rider or an anti-wheelie control easing the throttle, or a rider slipping the clutch")]];
    float wheelieAngle [[fminus::range(0, 40)]] [[fminus::default(4)]] [[ui::label("Wheelie held at")]]
        [[ui::help("The wheelie control holds the front wheel at about this angle")]] [[ui::unit("deg")]];
    bool clutchDry [[fminus::default(0)]] [[ui::label("Dry clutch")]]
        [[ui::help("Off: a wet multi-plate clutch in oil (it drags a little when open); on: a dry one (no drag; it rattles at idle)")]];
    // ---- end of card B2's block ----
    // ---- card D2's block (heavy diesels: sim/vehicle/truckair.fm) ----
    bool truckAir [[fminus::default(0)]] [[ui::label("Air system")]] [[ui::group("Truck")]]
        [[ui::help("A truck's air brakes heard: the compressor's governor and the dryer's purge, the brakes' release, the spring brakes (with the listener, sound.model 1)")]];
    // ---- end of card D2's block ----
};
