// spec/telemetry.fm: what the machine does (tel). The simulator writes it during Engine::process; the host reads it
// after each call. Values are as they stand at the call's end, unless a label says mean or peak. Nested as the Spec is,
// each section appended to by its Spec section's owner; a label and a quantity make a gauge.
#pragma once

enum
{
    STATE_OFF = 0,         // tel.engine.state
    STATE_CRANKING = 1,
    STATE_RUNNING = 2,
    STATE_RUNNING_DOWN = 3,
};

enum
{
    FLAG_LIMITER = 1,      // tel.engine.flags: the rev limiter (a diesel: its governor) holds it
    FLAG_FUEL_CUT = 2,     // the fuel is cut while it runs (the limiter, the overrun, a shift)
};

module EngineTel
{
    int state [[fminus::range(0, 3)]] [[ui::label("State")]] [[ui::choices("Off", "Cranking", "Running", "Running down")]];
    float speed [[ui::label("Speed")]] [[ui::quantity("rotation")]];
    float redline [[ui::label("Redline")]] [[ui::quantity("rotation")]];
    float idle [[ui::label("Idle")]] [[ui::quantity("rotation")]];
    float throttle [[ui::label("Throttle plate")]] [[ui::quantity("fraction")]];
    float manifold [[ui::label("Manifold")]] [[ui::quantity("pressure")]] [[ui::help("Absolute")]];
    float coolant [[ui::label("Coolant")]] [[ui::quantity("temperature")]];
    float oilPressure [[ui::label("Oil pressure")]] [[ui::quantity("pressure")]] [[ui::help("Over the air outside")]];
    int flags [[ui::label("Flags")]] [[ui::help("FLAG_LIMITER, FLAG_FUEL_CUT")]];
    float cycle [[ui::label("Cycle")]] [[ui::quantity("fraction")]]
        [[ui::help("A slowed copy of the crank's cycle, 0 to 1, for pictures that turn with it")]];
    float crank [[ui::label("Crank")]] [[ui::quantity("angle")]] [[ui::help("0 to 2160: a common cycle of every layout")]];
};

module BoostTel
{
    float pressure [[ui::label("Boost")]] [[ui::quantity("pressure")]] [[ui::help("Over the air outside")]];
};

module ExhaustTel
{
    float portTemperature [[ui::label("Exhaust gas")]] [[ui::quantity("temperature")]]
        [[ui::help("At the ports, smoothed")]];
    // ---- card G: written every 16 samples by Exhaust (sim/exhaust/exhaust.fm). Sections, in the gas's order: 0
    // primaries, 1 collectors' pipes, 2 second merges' pipes, 3 main pipes, 4 pipes after a crossover or a resonator,
    // 5 mufflers, 6 tails (a section the build lacks reads 0; in model 0 sections 2 and 4 are always 0) ----
    int model [[ui::label("Exhaust model")]] [[ui::help("The model running: 0 the reference's, 1 the builder")]];
    float pTurbine [[ui::label("Collector pressure")]] [[ui::quantity("pressure")]]
        [[ui::help("Mean, over the air outside, at the collectors: before a turbine (model 1)")]];
    float pConverter [[ui::label("Pressure before the converter")]] [[ui::quantity("pressure")]]
        [[ui::help("Mean, over the air outside, at each side's head (model 1)")]] [2];
    float pMuffler [[ui::label("Back pressure")]] [[ui::quantity("pressure")]]
        [[ui::help("Mean, over the air outside, before each side's muffler (model 1)")]] [2];
    float gasTemperature [[ui::label("Gas temperature")]] [[ui::quantity("temperature")]]
        [[ui::help("Each section's gas")]] [7];
    float wallTemperature [[ui::label("Wall temperature")]] [[ui::quantity("temperature")]]
        [[ui::help("Each section's wall (a view makes headers glow by it)")]] [7];
    float mach [[ui::label("Mach number")]] [[ui::quantity("ratio")]]
        [[ui::help("Each section's mean flow speed over its speed of sound")]] [7];
    float valve [[ui::label("Bypass valve")]] [[ui::quantity("fraction")]]
        [[ui::help("Each side's valve's travel, 0 shut to 1 open")]] [2];
    int ends [[ui::label("Radiating ends")]] [[ui::help("How many of endLevel, endTag are in use")]];
    float endLevel [[ui::label("End level")]] [[ui::unit("dB")]]
        [[ui::help("Each radiating end's level: 10 log10 of its mean square (dq/dt, m^3/s^2), smoothed")]] [24];
    int endTag [[ui::label("End position")]]
        [[ui::choices("Rear centre", "Rear left", "Rear right", "Side left", "Side right", "Front", "Up")]] [24];
    int endSlot [[ui::label("End's pipe")]] [[ui::help("The pipe each end ends: its slot (Scope's duct arrays)")]] [24];
    int flame [[ui::label("Flame")]]
        [[ui::help("1 while a bang burns near a tail in hot gas (a view draws flame)")]];
};

module EcuTel
{
    float knockRetard [[ui::label("Knock retard")]] [[ui::quantity("angle")]]
        [[ui::help("The spark taken back for knock")]];
};

module CarTel
{
    float speed [[ui::label("Speed")]] [[ui::quantity("speed")]];
    int gear [[ui::label("Gear")]] [[ui::help("-1 R, 0 N, 1 up")]];
    float brake [[ui::label("Brake")]] [[ui::quantity("fraction")]];
    float clutch [[ui::label("Clutch")]] [[ui::quantity("fraction")]];
    // card I's, filled while the vehicle model (car.model 1) drives, every 16 samples
    float accel [[ui::label("Acceleration")]] [[ui::unit("m/s^2")]];
    float distance [[ui::label("Distance")]] [[ui::quantity("length")]];
    int shift [[ui::label("Shift")]] [[ui::choices("None", "Up", "Down", "Refused")]];
    float wheelSpeed [[ui::label("Wheel speed")]] [[ui::quantity("rotation")]] [MAX_WHEELS];
    float wheelSlip [[ui::label("Wheel slip")]] [[ui::quantity("fraction")]] [MAX_WHEELS];
    float wheelLoad [[ui::label("Wheel load")]] [[ui::unit("N")]] [MAX_WHEELS];
    float wheelForce [[ui::label("Wheel force")]] [[ui::unit("N")]] [MAX_WHEELS];
    float wheelTorque [[ui::label("Drive torque at the wheel")]] [[ui::quantity("torque")]] [MAX_WHEELS];
    float wheelTemp [[ui::label("Tyre temperature")]] [[ui::quantity("temperature")]] [MAX_WHEELS];
    float clutchSlip [[ui::label("Clutch or converter slip")]] [[ui::quantity("rotation")]];
    float shaftTorque [[ui::label("Driveline torque at the wheels")]] [[ui::quantity("torque")]];
    float wheelPower [[ui::label("Power at the wheels")]] [[ui::quantity("power")]];
    float pitch [[ui::label("Load moved to the rear")]] [[ui::unit("N")]];
    int flags [[ui::label("Flags")]] [[ui::help("1 wheelspin, 2 wheelie, 4 ABS, 8 a locked wheel, 16 shifting, 32 cut asked, 64 blip asked, 128 traction limited")]];
    float ratio [[ui::label("Overall ratio")]] [[ui::quantity("ratio")]];
    int stripState [[ui::label("Strip")]] [[ui::choices("Off", "Staged", "Ambers", "Green", "Running", "Finished", "Red light")]];
    float tReaction [[ui::label("Reaction")]] [[ui::quantity("time")]];
    float t60 [[ui::label("60 ft")]] [[ui::quantity("time")]];
    float t330 [[ui::label("330 ft")]] [[ui::quantity("time")]];
    float t660 [[ui::label("1/8 mile")]] [[ui::quantity("time")]];
    float v660 [[ui::label("1/8 mile speed")]] [[ui::quantity("speed")]];
    float t1000 [[ui::label("1000 ft")]] [[ui::quantity("time")]];
    float t1320 [[ui::label("1/4 mile")]] [[ui::quantity("time")]];
    float v1320 [[ui::label("Trap speed")]] [[ui::quantity("speed")]];
};

module SoundTel
{
    float peak [[ui::label("Peak")]] [[ui::quantity("fraction")]] [[ui::help("The call's largest sample, either channel")]];
};

module Telemetry
{
    EngineTel engine [[ui::label("Engine")]];
    BoostTel boost [[ui::label("Boost")]];
    ExhaustTel exhaust [[ui::label("Exhaust")]];
    EcuTel ecu [[ui::label("ECU")]];
    CarTel car [[ui::label("Vehicle")]];
    SoundTel sound [[ui::label("Sound")]];
};
