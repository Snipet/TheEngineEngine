// spec/telemetry.fm: what the machine does (tel). The simulator writes it during Engine::process; the host reads it
// after each call. Values are as they stand at the call's end, unless a label says mean or peak. Nested as the Spec is,
// each section appended to by its Spec section's owner; a label and a quantity make a gauge.
#pragma once
#include "limits.fm"

enum
{
    STATE_OFF = 0,         // tel.engine.state
    STATE_CRANKING = 1,
    STATE_RUNNING = 2,
    STATE_RUNNING_DOWN = 3,
};

enum
{
    FLAG_LIMITER = 1,      // tel.engine.flags: the rev limiter (a diesel: its governor) holds it
    FLAG_FUEL_CUT = 2,     // the fuel is cut while it runs (the limiter, the overrun, a shift)
};

module EngineTel
{
    int state [[fminus::range(0, 3)]] [[ui::label("State")]] [[ui::choices("Off", "Cranking", "Running", "Running down")]];
    float speed [[ui::label("Speed")]] [[ui::quantity("rotation")]];
    float redline [[ui::label("Redline")]] [[ui::quantity("rotation")]];
    float idle [[ui::label("Idle")]] [[ui::quantity("rotation")]];
    float throttle [[ui::label("Throttle plate")]] [[ui::quantity("fraction")]];
    float manifold [[ui::label("Manifold")]] [[ui::quantity("pressure")]] [[ui::help("Absolute")]];
    float coolant [[ui::label("Coolant")]] [[ui::quantity("temperature")]];
    float oilPressure [[ui::label("Oil pressure")]] [[ui::quantity("pressure")]] [[ui::help("Over the air outside")]];
    int flags [[ui::label("Flags")]] [[ui::help("FLAG_LIMITER, FLAG_FUEL_CUT")]];
    float cycle [[ui::label("Cycle")]] [[ui::quantity("fraction")]]
        [[ui::help("A slowed copy of the crank's cycle, 0 to 1, for pictures that turn with it")]];
    float crank [[ui::label("Crank")]] [[ui::quantity("angle")]] [[ui::help("0 to 2160: a common cycle of every layout")]];
    // card D (core/*.fm, docs/models/mechanics.md): every engine's, the reference's included, unless said
    float torque [[ui::label("Torque")]] [[ui::quantity("torque")]]
        [[ui::help("Brake torque, its mean over some 0.1 s: the gases' less friction and a supercharger's drag; on the dyno, the absorber's")]];
    float gasTorque [[ui::label("Gas torque")]] [[ui::quantity("torque")]] [[ui::help("The gases' on the crank, its mean over some 20 ms")]];
    float firing [[ui::label("Firing rate")]] [[ui::quantity("frequency")]] [[ui::help("Firings a second, every cylinder's")]];
    float power [[ui::label("Power")]] [[ui::quantity("power")]] [[ui::help("The torque (brake) times the speed")]];
    float imep [[ui::label("IMEP")]] [[ui::quantity("pressure")]] [[ui::help("Indicated mean effective pressure, gross: the power loop's, the last cycle's mean over the cylinders")]];
    float pmep [[ui::label("PMEP")]] [[ui::quantity("pressure")]] [[ui::help("Pumping: the gas exchange's loop, its work taken")]];
    float fmep [[ui::label("FMEP")]] [[ui::quantity("pressure")]] [[ui::help("Friction, now")]];
    float bmep [[ui::label("BMEP")]] [[ui::quantity("pressure")]] [[ui::help("Brake: 4 pi times the torque over the displacement")]];
    float veManifold [[ui::label("Volumetric efficiency (manifold)")]] [[ui::quantity("fraction")]]
        [[ui::help("The air trapped at intake closing over what the displacement holds at the manifold's density")]];
    float veAir [[ui::label("Volumetric efficiency (air)")]] [[ui::quantity("fraction")]]
        [[ui::help("The same at the outside air's density")]];
    float peakPressure [[ui::label("Peak pressure")]] [[ui::quantity("pressure")]] [[ui::help("The last cycle's highest, any cylinder")]];
    float pistonSpeed [[ui::label("Mean piston speed")]] [[ui::quantity("speed")]];
    float ripple [[ui::label("Speed ripple")]] [[ui::quantity("rotation")]] [[ui::help("The crank's speed's spread over the last whole cycle")]];
    float dynoTorque [[ui::label("Dyno torque")]] [[ui::quantity("torque")]] [[ui::help("The absorber's, its mean over 0.1 s (MODE_DYNO_ENGINE)")]];
    float dynoSpeed [[ui::label("Dyno set speed")]] [[ui::quantity("rotation")]];
    float inertiaTorque [[ui::label("Inertia torque")]] [[ui::quantity("torque")]] [[ui::help("The reciprocating masses' (a custom engine's)")]];
    float shake1 [[ui::label("Shaking force, 1st order")]] [[ui::unit("N")]] [[ui::help("Amplitude at this speed (a custom engine's), after balance shafts")]];
    float shake2 [[ui::label("Shaking force, 2nd order")]] [[ui::unit("N")]];
    float rock1 [[ui::label("Rocking moment, 1st order")]] [[ui::quantity("torque")]];
    float rock2 [[ui::label("Rocking moment, 2nd order")]] [[ui::quantity("torque")]];
    int cylinders [[ui::label("Cylinders")]] [[ui::help("A rotary's faces")]];
    float firingAngle [[ui::label("Firing angle")]] [[ui::quantity("angle")]] [[ui::help("Each cylinder's, after cylinder 1's, in the order it fires")]] [MAX_CYL];
    float cylPeak [[ui::label("Cylinder's peak pressure")]] [[ui::quantity("pressure")]] [MAX_CYL];
    float cylPeakAngle [[ui::label("Its angle")]] [[ui::quantity("angle")]] [[ui::help("After the firing top dead centre")]] [MAX_CYL];
    int layoutRefused [[ui::label("Custom layout refused")]]
        [[ui::help("1: the custom geometry has cylinders firing together; the layout dial's runs instead")]];
    float oilTemperature [[ui::label("Oil temperature")]] [[ui::quantity("temperature")]];
};

module BoostTel
{
    float pressure [[ui::label("Boost")]] [[ui::quantity("pressure")]] [[ui::help("Over the air outside")]];
    // card F's, boost.model 1 (model 0 leaves them at 0): each shaft [MAX_TURBOS], then the charge path
    int turbos [[ui::label("Shafts")]] [[ui::help("How many of the arrays below are in use")]];
    float shaftSpeed [[ui::label("Shaft speed")]] [[ui::quantity("rotation")]] [4];
    float ratio [[ui::label("Compressor ratio")]] [[ui::quantity("ratio")]] [4];
    float flow [[ui::label("Corrected flow")]] [[ui::quantity("flow")]]
        [[ui::help("Through the compressor, at 101325 Pa and 293.15 K")]] [4];
    float efficiency [[ui::label("Compressor efficiency")]] [[ui::quantity("fraction")]] [4];
    float compressorOut [[ui::label("Compressor outlet")]] [[ui::quantity("temperature")]] [4];
    float gate [[ui::label("Wastegate")]] [[ui::quantity("fraction")]] [[ui::help("Its opening")]] [4];
    float vanes [[ui::label("Vanes")]] [[ui::quantity("fraction")]] [[ui::help("A variable nozzle's opening; 1 fixed")]] [4];
    float turbineIn [[ui::label("Before the turbine")]] [[ui::quantity("pressure")]] [[ui::help("Absolute")]] [4];
    float turbineInTemp [[ui::label("Turbine inlet")]] [[ui::quantity("temperature")]] [4];
    float drive [[ui::label("Drive ratio")]] [[ui::quantity("ratio")]]
        [[ui::help("The pressure before the turbine over the charge pipe's, both absolute")]] [4];
    float chargePipe [[ui::label("Charge pipe")]] [[ui::quantity("pressure")]]
        [[ui::help("After the compressor, before the intercooler: over the air outside")]];
    float intercoolerOut [[ui::label("Intercooler outlet")]] [[ui::quantity("temperature")]];
    float throttleIn [[ui::label("Before the throttle")]] [[ui::quantity("temperature")]];
    float blowOffValve [[ui::label("Blow-off valve")]] [[ui::quantity("fraction")]] [[ui::help("Its opening")]];
    float superchargerPower [[ui::label("Supercharger drive")]] [[ui::quantity("power")]];
    float oxygen [[ui::label("Charge oxygen")]] [[ui::quantity("fraction")]] [[ui::help("By mass; 0.232 for air")]];
    int flags [[ui::label("Boost flags")]]
        [[ui::help("1 surge, 2 choke, 4 over-speed, 8 over-boost, 16 blow-off open, 32 nitrous flowing")]];
};

module ExhaustTel
{
    float portTemperature [[ui::label("Exhaust gas")]] [[ui::quantity("temperature")]]
        [[ui::help("At the ports, smoothed")]];
    // ---- card G: written every 16 samples by Exhaust (sim/exhaust/exhaust.fm). Sections, in the gas's order: 0
    // primaries, 1 collectors' pipes, 2 second merges' pipes, 3 main pipes, 4 pipes after a crossover or a resonator,
    // 5 mufflers, 6 tails (a section the build lacks reads 0; in model 0 sections 2 and 4 are always 0) ----
    int model [[ui::label("Exhaust model")]] [[ui::help("The model running: 0 the reference's, 1 the builder")]];
    float pTurbine [[ui::label("Collector pressure")]] [[ui::quantity("pressure")]]
        [[ui::help("Mean, over the air outside, at the collectors: before a turbine (model 1)")]];
    float pConverter [[ui::label("Pressure before the converter")]] [[ui::quantity("pressure")]]
        [[ui::help("Mean, over the air outside, at each side's head (model 1)")]] [2];
    float pMuffler [[ui::label("Back pressure")]] [[ui::quantity("pressure")]]
        [[ui::help("Mean, over the air outside, before each side's muffler (model 1)")]] [2];
    float gasTemperature [[ui::label("Gas temperature")]] [[ui::quantity("temperature")]]
        [[ui::help("Each section's gas")]] [7];
    float wallTemperature [[ui::label("Wall temperature")]] [[ui::quantity("temperature")]]
        [[ui::help("Each section's wall (a view makes headers glow by it)")]] [7];
    float mach [[ui::label("Mach number")]] [[ui::quantity("ratio")]]
        [[ui::help("Each section's mean flow speed over its speed of sound")]] [7];
    float valve [[ui::label("Bypass valve")]] [[ui::quantity("fraction")]]
        [[ui::help("Each side's valve's travel, 0 shut to 1 open")]] [2];
    int ends [[ui::label("Radiating ends")]] [[ui::help("How many of endLevel, endTag are in use")]];
    float endLevel [[ui::label("End level")]] [[ui::unit("dB")]]
        [[ui::help("Each radiating end's level: 10 log10 of its mean square (dq/dt, m^3/s^2), smoothed")]] [24];
    int endTag [[ui::label("End position")]]
        [[ui::choices("Rear centre", "Rear left", "Rear right", "Side left", "Side right", "Front", "Up")]] [24];
    int endSlot [[ui::label("End's pipe")]] [[ui::help("The pipe each end ends: its slot (Scope's duct arrays)")]] [24];
    int flame [[ui::label("Flame")]]
        [[ui::help("1 while a bang burns near a tail in hot gas (a view draws flame)")]];
};

module EcuTel
{
    float knockRetard [[ui::label("Knock retard")]] [[ui::quantity("angle")]]
        [[ui::help("The spark taken back for knock")]];
    // ecu.model 1 and fuel.model 1 (card H): 0 under the reference's models where they do not apply
    float advanceAsked [[ui::label("Spark asked")]] [[ui::quantity("angle")]] [[ui::help("Before the top: the map's, with the timing and every retard but knock's")]];
    float advance [[ui::label("Spark")]] [[ui::quantity("angle")]] [[ui::help("Before the top: the last firing's, knock's retard taken")]];
    float knockByCylinder [[ui::label("Knock retard by cylinder")]] [[ui::quantity("angle")]] [MAX_CYL];
    int knock [[ui::label("Knocks")]] [[ui::help("A count: knocks heard since the start")]];
    float lambdaTarget [[ui::label("Lambda asked")]] [[ui::quantity("ratio")]];
    float lambda [[ui::label("Lambda")]] [[ui::quantity("ratio")]] [[ui::help("As a wide-band sensor in the collector reads it")]];
    float injectorDuty [[ui::label("Injector duty")]] [[ui::quantity("fraction")]];
    float fuelFlow [[ui::label("Fuel flow")]] [[ui::unit("kg/s")]];
    float halfBurn [[ui::label("Half burned")]] [[ui::quantity("angle")]] [[ui::help("Degrees after the top, cylinder 1's last cycle")]];
    float peakPressure [[ui::label("Peak pressure")]] [[ui::quantity("pressure")]] [[ui::help("Cylinder 1's last cycle")]];
    float peakAngle [[ui::label("Peak at")]] [[ui::quantity("angle")]] [[ui::help("Degrees after the top")]];
    int flags [[ui::label("ECU flags")]]
        [[ui::help("1 limiter, 2 fuel cut, 4 spark cut, 8 overrun, 16 launch, 32 flat-shift, 64 anti-lag, 128 nitrous, 256 traction, 512 pit, 1024 knock retard")]];
    float idleValve [[ui::label("Idle valve")]] [[ui::quantity("fraction")]];
    float idleTarget [[ui::label("Idle speed")]] [[ui::quantity("rotation")]];
    float boostTarget [[ui::label("Boost target")]] [[ui::quantity("pressure")]] [[ui::help("Over the air outside")]];
    int state [[ui::label("ECU state")]] [[ui::choices("Stopped", "Cranking", "Running", "Running down")]];
    float smoke [[ui::label("Smoke")]] [[ui::help("A diesel's filter smoke number, 0 to 10")]];
    int limiter [[ui::label("Limiter")]] [[ui::help("1 while a limiter acts (rev, launch, flat-shift, pit)")]];
    float load [[ui::label("Load")]] [[ui::quantity("ratio")]] [[ui::help("The maps' y axis now: the manifold over the air outside")]];
};

module CarTel
{
    float speed [[ui::label("Speed")]] [[ui::quantity("speed")]];
    int gear [[ui::label("Gear")]] [[ui::help("-1 R, 0 N, 1 up")]];
    float brake [[ui::label("Brake")]] [[ui::quantity("fraction")]];
    float clutch [[ui::label("Clutch")]] [[ui::quantity("fraction")]];
    // card I's, filled while the vehicle model (car.model 1) drives, every 16 samples
    float accel [[ui::label("Acceleration")]] [[ui::unit("m/s^2")]];
    float distance [[ui::label("Distance")]] [[ui::quantity("length")]];
    int shift [[ui::label("Shift")]] [[ui::choices("None", "Up", "Down", "Refused")]];
    float wheelSpeed [[ui::label("Wheel speed")]] [[ui::quantity("rotation")]] [MAX_WHEELS];
    float wheelSlip [[ui::label("Wheel slip")]] [[ui::quantity("fraction")]] [MAX_WHEELS];
    float wheelLoad [[ui::label("Wheel load")]] [[ui::unit("N")]] [MAX_WHEELS];
    float wheelForce [[ui::label("Wheel force")]] [[ui::unit("N")]] [MAX_WHEELS];
    float wheelTorque [[ui::label("Drive torque at the wheel")]] [[ui::quantity("torque")]] [MAX_WHEELS];
    float wheelTemp [[ui::label("Tyre temperature")]] [[ui::quantity("temperature")]] [MAX_WHEELS];
    float clutchSlip [[ui::label("Clutch or converter slip")]] [[ui::quantity("rotation")]];
    float shaftTorque [[ui::label("Driveline torque at the wheels")]] [[ui::quantity("torque")]];
    float wheelPower [[ui::label("Power at the wheels")]] [[ui::quantity("power")]];
    float pitch [[ui::label("Load moved to the rear")]] [[ui::unit("N")]];
    int flags [[ui::label("Flags")]] [[ui::help("1 wheelspin, 2 wheelie, 4 ABS, 8 a locked wheel, 16 shifting, 32 cut asked, 64 blip asked, 128 traction limited")]];
    float ratio [[ui::label("Overall ratio")]] [[ui::quantity("ratio")]];
    int stripState [[ui::label("Strip")]] [[ui::choices("Off", "Staged", "Ambers", "Green", "Running", "Finished", "Red light")]];
    float tReaction [[ui::label("Reaction")]] [[ui::quantity("time")]];
    float t60 [[ui::label("60 ft")]] [[ui::quantity("time")]];
    float t330 [[ui::label("330 ft")]] [[ui::quantity("time")]];
    float t660 [[ui::label("1/8 mile")]] [[ui::quantity("time")]];
    float v660 [[ui::label("1/8 mile speed")]] [[ui::quantity("speed")]];
    float t1000 [[ui::label("1000 ft")]] [[ui::quantity("time")]];
    float t1320 [[ui::label("1/4 mile")]] [[ui::quantity("time")]];
    float v1320 [[ui::label("Trap speed")]] [[ui::quantity("speed")]];
    // ---- card B2's, filled while the motorcycle (car.kind Motorcycle, car.model 1) drives, every 16 samples. The wheel
    // arrays above then hold the front in [0] and the rear in [2] ----
    float liftAngle [[ui::label("Front lifted")]] [[ui::unit("deg")]]
        [[ui::help("The bike's pitch about its rear tyre: 0 with both wheels down")]];
    float liftRate [[ui::label("Front lifting at")]] [[ui::unit("deg/s")]];
    int bikeFlags [[ui::label("Motorcycle flags")]]
        [[ui::help("1 the rear hopping or locked on the overrun, 2 looped, 4 the wheelie control acting, 8 the slipper slipping, 16 a quickshift's cut, 32 an auto-blip, 64 a stoppie")]];
    int chainLash [[ui::label("Lash events")]] [[ui::help("A counter: one more each time the driveline's play closes")]];
    float chainLashSpeed [[ui::label("Last lash's closing speed")]] [[ui::quantity("rotation")]]
        [[ui::help("At the rear wheel: how hard the play closed")]];
    int chainLashSide [[ui::label("Last lash's side")]] [[ui::choices("Drive", "Overrun")]];
    float backTorque [[ui::label("Back torque")]] [[ui::quantity("torque")]]
        [[ui::help("At the crank: what the rear wheel drives the engine with through the clutch (0 under power)")]];
    float slipperSlip [[ui::label("Slipper slipping")]] [[ui::quantity("rotation")]];
    int quickshifts [[ui::label("Quickshifts")]] [[ui::help("A counter")]];
    int blips [[ui::label("Auto-blips")]] [[ui::help("A counter")]];
    float wheelieLimit [[ui::label("Wheelie limit")]] [[ui::unit("m/s^2")]]
        [[ui::help("The acceleration at which the front leaves the road now")]];
    // ---- end of card B2's block ----
};

module SoundTel
{
    float peak [[ui::label("Peak")]] [[ui::quantity("fraction")]] [[ui::help("The call's largest sample, either channel")]];
    float rate [[ui::label("Sample rate")]] [[ui::quantity("frequency")]] [[ui::help("The host's, the sound's")]];
    // package L's (spec.sound.model 1; 0 otherwise)
    int camera [[ui::label("Camera heard")]] [[ui::choices("Tailpipe", "Rear", "Side", "Engine bay", "Driver", "Trackside", "Chase")]];
    float range [[ui::label("Listener range")]] [[ui::quantity("length")]] [[ui::help("From the listener to the car's middle")]];
    float doppler [[ui::label("Doppler")]] [[ui::quantity("ratio")]] [[ui::help("The pitch the exhaust is heard at over the pitch it is made at")]];
    float roadPosition [[ui::label("Car past the listener")]] [[ui::quantity("length")]] [[ui::help("Trackside: how far the car's middle is past the listener, along the road")]];
    float loudness [[ui::label("Loudness trim")]] [[ui::unit("dB")]] [[ui::help("The level computed for this build, the reference's table replaced")]];
    float exhaustLevel [[ui::label("Exhaust radiation")]] [[ui::unit("dB")]] [[ui::help("The tailpipes' radiation before any gain, its mean square over the last 0.4 s")]];
    float mixLevel [[ui::label("Mix level")]] [[ui::unit("dB")]] [[ui::help("What the listener hears before the level and the compressor, its mean square over the last 0.4 s")]];
};

// tel.valve: card E's valvetrain (model 1; at model 0 the events are the CAM dial's, the rest 0)
module ValveTel
{
    float inPhaseTarget [[ui::label("Intake phase asked")]] [[ui::quantity("angle")]] [[ui::help("Crank degrees of advance from parked")]];
    float inPhase [[ui::label("Intake phase")]] [[ui::quantity("angle")]];
    float exPhaseTarget [[ui::label("Exhaust phase asked")]] [[ui::quantity("angle")]] [[ui::help("Crank degrees of retard from parked")]];
    float exPhase [[ui::label("Exhaust phase")]] [[ui::quantity("angle")]];
    int stage [[fminus::range(0, 1)]] [[ui::label("Cam stage")]] [[ui::choices("A", "B")]];
    float lift [[ui::label("Lift command")]] [[ui::quantity("fraction")]];
    int active [[ui::label("Active cylinders")]] [[ui::help("A bit a cylinder, in the layout's order")]];
    int floating [[fminus::range(0, 1)]] [[ui::label("Valve float")]];
    float floatSpeed [[ui::label("Float speed")]] [[ui::quantity("rotation")]] [[ui::help("Where the intake valves begin to float; 0: never")]];
    float ivo [[ui::label("Intake opens")]] [[ui::quantity("angle")]] [[ui::help("Cylinder 1's, now: degrees of its cycle, 0 the firing top")]];
    float ivc [[ui::label("Intake closes")]] [[ui::quantity("angle")]];
    float evo [[ui::label("Exhaust opens")]] [[ui::quantity("angle")]];
    float evc [[ui::label("Exhaust closes")]] [[ui::quantity("angle")]];
    float overlap [[ui::label("Overlap at 1 mm")]] [[ui::quantity("angle")]];
    float benchLift [[ui::label("Bench lift")]] [[ui::quantity("length")]] [16];
    float benchIntake [[ui::label("Intake flow at 28 in")]] [[ui::quantity("flow")]] [16];
    float benchExhaust [[ui::label("Exhaust flow at 28 in")]] [[ui::quantity("flow")]] [16];
};

// tel.intake: card E's induction
module IntakeTel
{
    float manifold [[ui::label("Manifold")]] [[ui::quantity("pressure")]] [[ui::help("Absolute; with throttles a runner, the runners' mean")]];
    float ripple [[ui::label("Manifold ripple")]] [[ui::quantity("pressure")]] [[ui::help("Peak to peak over the last cycle")]];
    float runnerLength [[ui::label("Runner length")]] [[ui::quantity("length")]];
    float box [[ui::label("Air box")]] [[ui::quantity("pressure")]] [[ui::help("Over the air outside (model 1)")]];
};

module Telemetry
{
    EngineTel engine [[ui::label("Engine")]];
    BoostTel boost [[ui::label("Boost")]];
    ExhaustTel exhaust [[ui::label("Exhaust")]];
    EcuTel ecu [[ui::label("ECU")]];
    CarTel car [[ui::label("Vehicle")]];
    SoundTel sound [[ui::label("Sound")]];
    ValveTel valve [[ui::label("Valves")]];
    IntakeTel intake [[ui::label("Intake")]];
};
