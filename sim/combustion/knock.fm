// A table's linear read at x (in its steps), clamped to its ends
float knockRead(const float* t, int last, float x)
{
    const float c = fminf(fmaxf(x, 0.0f), (float)last - 0.001f);
    const int i = (int)c;
    const float f = c - (float)i;
    return t[i] + (t[i + 1] - t[i]) * f;
}

// 1 / tau (1/s) at the octane index's factor, a pressure (Pa) and a temperature (K), by the tables
float knockRate(float octaneK, float p, float t)
{
    return octaneK * knockRead(kKnockPow, 512, p * (2.0f / 101325.0f)) * knockRead(kKnockArr, 256, (t - 250.0f) * 0.2f);
}

// The factor of 1 / tau that the octane index makes: 1000 / 17.68 (ON / 100)^-3.402 (per second; once a cycle)
float knockOctane(float octane)
{
    return 56.561086f * expf(-3.402f * logf(fmaxf(octane, 1.0f) * 0.01f));
}

// One cylinder's end gas, over one cycle
module EndGas
{
    float sum;          // Livengood and Wu's integral so far
    float octaneK;      // knockOctane of the fuel
    float p0;           // the charge at the valve's closing: its pressure (Pa) and its temperature (K)
    float t0;
    float r0;           // 4 / p0: the pressure ratio's step in kKnockGas
    float tu;           // the end gas's temperature now
    int on;             // 1 from start() to the burn's end
    float intensity;    // what knocked this cycle: the unburned share that lit (0 none)
    int pre;            // 1: it lit before the spark
    int ticks;

    // At the intake valve's closing: the charge's pressure and temperature (the evaporation's cooling taken off), the
    // fuel's octane index (0 or less: a fuel that does not knock, the integral stays off), and the delay's calibration
    // (tau's multiplier: 1 is Douaud and Eyzat's own)
    void start(float p, float t, float octane, float delayK)
    {
        sum = 0.0f;
        p0 = fmaxf(p, 1000.0f);
        t0 = t;
        r0 = 4.0f / p0;
        tu = t;
        intensity = 0.0f;
        pre = 0;
        ticks = 0;
        on = octane > 0.0f ? 1 : 0;
        octaneK = octane > 0.0f ? knockOctane(octane) / fmaxf(delayK, 0.01f) : 0.0f;
    }

    // `seconds` since the last tick, the cylinder's pressure now (Pa), the burned share of the charge (0 to 1), and
    // whether it has been lit (the spark has passed). Returns the knock's intensity on the tick it knocks (the unburned
    // share then), else 0. The burn's end (98 % burned) ends the integral.
    float tick(float seconds, float p, float burned, int lit)
    {
        if (on == 0)
            return 0.0f;
        ticks += 1;
        tu = t0 * knockRead(kKnockGas, 512, p * r0);
        sum += seconds * knockRate(octaneK, p, tu);
        if (lit != 0 && burned >= 0.98f)
        {
            on = 0;
            return 0.0f;
        }
        if (sum >= 1.0f)
        {
            on = 0;
            pre = lit != 0 ? 0 : 1;
            intensity = lit != 0 ? fmaxf(1.0f - burned, 0.0f) : 1.0f;
            return intensity;
        }
        return 0.0f;
    }

    // Ends the integral early (a cycle that will not burn: a cut, a misfire)
    void stop()
    {
        on = 0;
    }
};
