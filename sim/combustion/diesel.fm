// diesel.fm: what the diesel's charge (the reference's chargeDiesel, which stays as it is) takes from the fields of
// fuel.model 1: the injection's timing, a pilot injection, the rail's pressure, and the smoke limit with an over-fuel
// allowance. At their defaults each leaves the reference's numbers as they were.
//
// The reference's diesel: at full fuel an equivalence ratio of 0.75 (the smoke limit), injecting some degrees before the
// top (4 + 14 times the speed over the redline + 3 times the lever, plus TIMING), lighting after Wolfer's delay; what
// was injected during the delay burns at once (Watson's premixed share, beta), the rest as it mixes (the diffusion
// burn, over 35 + 30 times the lever degrees).
//
// Injection timing: degrees added to the start of injection (earlier: more of the fuel in before it lights, a larger
// premixed share, louder; later: quieter, cooler, smokier). A pilot: a small share of the fuel (0 to 10 %) injected
// ahead of the main; it lights first and heats the charge, so the main's delay is short and its premixed share small
// (the clatter goes): the premixed share falls by 70 % with a pilot of 3 % or more (judgement after common-rail
// engines' published heat release, where a pilot all but removes the premixed spike). The rail's pressure: the
// spray's speed goes as its square root and the mixing (the diffusion burn's rate) with it, so the diffusion burn
// takes (1000 bar / rail)^0.5 times as long (Heywood §10.5: mixing-controlled; 1000 bar is the reference's, judgement).
// The smoke limit: the most equivalence ratio the governor allows, 0.75 (the reference's) times 1 plus the over-fuel
// allowance (a tuner's "smoke" setting: more torque, black smoke). The smoke number (a Bosch filter smoke number, 0 to
// 10) rises from none at 0.6 to 4 at an equivalence ratio of 0.9 and more beyond (judgement, the shape of published
// FSN against air-fuel ratio).
#pragma once

module DieselFields
{
    float soiAdd;       // degrees added to the start of injection
    float pilot;        // the pilot's share of the fuel
    float rail;         // bar
    float overFuel;     // the smoke limit's allowance, 0 to 0.4
    // what it gave the last charge
    float phiMax;
    float smoke;
    // card D2's (sim/combustion/heavy.fm): its governor's rack in place of the reference's lever (-1: the reference's),
    // and the fuel metered by the rack (fuelFull kg a stroke at full rack) and capped by the boost compensator at an
    // equivalence ratio afcPhi of the air there (0: no compensator), in place of the reference's fuel by the air
    float lever;
    int metered;
    float fuelFull;
    float afcPhi;
    float phiAsked;     // what the rack asked, as an equivalence ratio of the air there
    // card D2's: the last charge's ignition delay (degrees), and the start of combustion's cycle-to-cycle spread, a
    // standard deviation, a degree of it (fuel.model 1: chargeDiesel adds socSpread x delay x a gauss to the start). A
    // diesel's ignition delay is not the same every cycle, and the longer it is the more it varies (cyclic variation
    // rising linearly with the delay: a Fischer-Tropsch-fuelled diesel, Appl. Sci. 2019, doi 10.3390/app9102032, the
    // trend only, paper unread). The size, 0.150 a degree: 0.559 degrees at the tractor archetype's warm idle delay of
    // 3.73 degrees, from Szpica and Kluczynski, Energies 2026, 19, 1343 (read by card P, its Table A3): a Perkins
    // 1104D-E44TA at idle, 800 rpm, no load, 500 cycles: the crank angle of PEAK PRESSURE, sigma 0.559 degrees (range 1
    // to 4, about 1 degree's resolution; COV of IMEP 6.92 %). That is not the start of combustion's spread: the peak's
    // angle holds the burn's own variation too, so this likely overstates it; no measured spread of the start at idle
    // was found (docs/measurements/2026-11-25-0032-judgement-sources.md, 2). It matters to the sound: the clatter (the
    // reference's, sim/sound/extras.fm) is struck at the start of combustion, and struck at the same moment every cycle
    // its panels ring as sharp lines at the firing harmonics (card P's idle row)
    float delayDeg;
    float socSpread;

    void defaults()
    {
        soiAdd = 0.0f;
        pilot = 0.0f;
        rail = 1000.0f;
        overFuel = 0.0f;
        phiMax = 0.75f;
        smoke = 0.0f;
        lever = -1.0f;
        metered = 0;
        fuelFull = 0.0f;
        afcPhi = 0.0f;
        phiAsked = 0.0f;
        delayDeg = 0.0f;
        socSpread = 0.150f;
    }

    // Card D2: the rack's fuel (over-fuelled by overFuel) against the air the cylinder holds (kg), as an equivalence
    // ratio, the compensator's cap taken; past some 0.85 the fuel finds less and less oxygen: what burns levels off
    // toward 1, the rest goes out as soot (the smoke number, as phiAt's, from what was injected)
    float phiMetered(float air, float rack)
    {
        const float fuel = fmaxf(rack, 0.0f) * fuelFull * (1.0f + fminf(fmaxf(overFuel, 0.0f), 0.4f));
        float phi = fuel * 14.5f / fmaxf(air, 1.0e-7f);
        if (afcPhi > 0.0f)
            phi = fminf(phi, afcPhi);
        phiAsked = phi;
        const float x = fmaxf(phi - 0.6f, 0.0f) / 0.3f;
        smoke = fminf(4.0f * x * x, 10.0f);
        if (phi <= 0.85f)
            return phi;
        const float e = expf(-(phi - 0.85f) / 0.15f);
        return 0.85f + 0.15f * (1.0f - e);
    }

    // The equivalence ratio at the lever (0 to 1): the reference's 0.75 lever at no allowance
    float phiAt(float lever)
    {
        phiMax = 0.75f * (1.0f + fminf(fmaxf(overFuel, 0.0f), 0.4f));
        const float phi = phiMax * lever;
        const float x = fmaxf(phi - 0.6f, 0.0f) / 0.3f;
        smoke = fminf(4.0f * x * x, 10.0f);
        return phi;
    }

    // The premixed share, from the reference's (Watson's)
    float premixed(float beta)
    {
        const float p = fminf(fmaxf(pilot, 0.0f), 0.1f);
        return fminf(fmaxf(beta * (1.0f - 0.7f * fminf(p / 0.03f, 1.0f)), 0.02f), 0.9f);
    }

    // The diffusion burn's degrees, from the reference's
    float diffusion(float dur2)
    {
        return dur2 * sqrtf(1000.0f / fminf(fmaxf(rail, 200.0f), 3000.0f));
    }
};
