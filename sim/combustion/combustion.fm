// combustion/combustion.fm: the charge and its burn (module Combustion). Owner: package H.
//
// When a cylinder's intake valve shuts: how much fuel it gets (none while the ECU cuts it), how much of it this
// cycle's flame will burn (the burned gas it holds dilutes it: Daw et al.'s recursion near the limit, a big cam's lope),
// where the spark falls and how long the burn takes, knock and pre-ignition (and the ECU's retard for them), the pops
// of unburned fuel lighting in the hot header; a diesel's charge (its lever's fuel, its injection, its ignition delay
// and whether it lights at all, its premixed share). The burn itself runs in the cylinder (core/cylinder.fm, a Wiebe
// curve). The reference's own explanations stand with each part below.
//
// The share of the fuel's heat the gas keeps (charge, charge1) follows `walls`, the engine's one decision on whose walls
// take the burn's heat (Engine::woschniWalls): 0.97 with Woschni's, the reference's 0.60 + 0.20 x manifold with its own.
// (Card D, as integrator, 24 Nov: before, the share read spec.engine.wallHeat alone and fuel.model 1 brought Woschni's
// walls without it: the walls' loss was taken twice.)
//
//   setup(rate, noise, ecu, heat, layout, pops)   in init: the streams and the state it reads and writes
//   charge(cy, ci, fuel, pPlenum, rpm, compression, crBs, burnK, pops, rough, timing)   at cylinder ci's intake closing
// It reads the ECU's cuts, trim, throttle, idle valve and speeds, the heat's temperatures; it writes the cylinder's
// charge (qTot, sparkAt, burnDur, knock, cBurn, beta, dur2), the heat the burn gives (Heat's heatJ), the ECU's knock
// retard (kRet: its knock sensor hears it) and fires a pop in the exhaust's collector (Pop).
//
// fuel.model 1 or ecu.model 1 (card H; docs/models/combustion.md): a gasoline charge by charge1() instead: the ECU's
// decision for the firing (ecu.model 1: Ecu1.fire, its spark and lambda; else the reference's cut and spark), the
// fuel's heat at that lambda (fuel.model 1: Charge1 and the fuel's row; else the reference's), knock from the end gas
// (fuel.model 1: EndGas, ticked every 4 samples by sample(); else the reference's rule), the unburned fuel and air to
// the ECU's account, whose bangs sample() fires in the Pops. A diesel takes fuel.model 1's fields (diesel.fm). Under
// both models 0 none of it runs and sample() returns at once.
//
//   sample(cy, c, dt)   each sample, after cylinder c's step
#pragma once
#include "lib/noise.fm"
#include "spec/limits.fm"
#include "charge1.fm"
#include "diesel.fm"

// Where ecu.model 1's spark formula puts the half of the burn: degrees after the top (best torque has it 6 to 12 in
// engines: Heywood, ch. 9; 8, judgement)
const float kHalfBurn = 8.0f;

module Combustion
{
    float rate;
    Noise* nz;
    Ecu* ecu;
    Heat* heat;
    Layout* lay;
    Pop* pop;
    float droop;        // a diesel's governor near its redline: the share of the fuel it lets through
    float oxygen;       // the charge's oxygen over air's: Boost's oxygenShare() (1 without nitrous), set by Engine
    float dilution[MAX_CYL]; // each cylinder's burned-gas share at its last intake closing
    // fuel.model 1 and ecu.model 1 (card H)
    FuelSpec* fuel;
    EngineSpec* eng;    // the engine's Spec
    int walls;          // 1: Woschni's walls take the burn's heat (Engine::woschniWalls, handed over by the engine as the
                        // fade makes the switches; card D as integrator, 24 Nov), 0: the reference's
    Charge1 one;
    EndGas gas[MAX_CYL];
    DieselFields diesel;
    int ticks;          // samples, for the end gas's tick every 4

    void setup(float rateIn, Noise* noise, Ecu* ecuIn, Heat* heatIn, Layout* layIn, Pop* pops, FuelSpec* fuelIn, EngineSpec* engIn)
    {
        eng = engIn;
        fuel = fuelIn;
        diesel.defaults();
        rate = rateIn;
        nz = noise;
        ecu = ecuIn;
        heat = heatIn;
        lay = layIn;
        pop = pops;
        droop = 1.0f;
    }

    // When the intake valve shuts: the fuel for this cycle (none when the ECU cuts it), from what of the charge can
    // burn (all but the burned gas in it: the products the last cycle left and what the overlap drew back), and how
    // much of that this cycle's flame takes. That falls steeply as the burned gas dilutes the charge past about 0.45
    // (half at 0.56: the model's share counts all the burned gas it draws back, and runs above measured residual
    // fractions). What fails to burn stays, so the next cycle has more to burn and less burned gas, burns well, and
    // leaves the one after diluted again (Daw et al.'s recursion): near the limit a big cam's idle lopes in that
    // pattern, and tiny differences between cycles swing it.
    void charge(Cylinder* cy, int ci, int fuelUse, float pPlenum, float rpm, float smCR, float crBs, float burnK, float pops,
                float rough, float timing)
    {
        if (fuelUse != 0)
        {
            chargeDiesel(cy, ci, pPlenum, rpm, smCR, burnK, rough, timing);
            return;
        }
        if (fuel->model == 1 || ecu->model1())
        {
            charge1(cy, ci, pPlenum, rpm, smCR, crBs, burnK, rough, timing);
            return;
        }
        droop = 1.0f;
        // (what the last burn left unburned has gone into the hot header: now and then it lights there)
        const float lastC = cy->cBurn;
        if (lastC < 0.75f && pops > 0.0f && !ecu->fuelCut && nz->rnd() > 1.0f - 1.6f * pops * (0.75f - lastC))
        {
            const int b = lay->topo == 0 ? 0 : lay->bank[ci];
            pop[b].fire(20000.0f * (0.75f - lastC) * (0.5f + 0.5f * fabsf(nz->rnd())), rate, 99 + b);
        }
        const float dil = fminf(cy->mInert / fmaxf(cy->m, 1.0e-9f), 0.95f);
        const float burnable = fmaxf(cy->m - cy->mInert, 0.0f);
        // (of the fuel's heat the gas keeps some 80 % at full load: the rest goes to the walls or out unburned; a
        // larger share at part load, where the charge is thinner and the walls take more)
        float q = burnable / 14.0f * 44.0e6f * (walls != 0 ? 0.97f : 0.60f + 0.20f * fminf(pPlenum / 101325.0f, 1.2f));
        const float d50 = (lay->rotary != 0 ? 0.62f : 0.56f) * (1.0f + (0.015f + 0.03f * rough) * nz->gauss());
        const float cb = 1.0f / (1.0f + expf((dil - d50) / 0.035f));
        cy->cBurn = cb;
        dilution[ci] = dil;
        const float sigma = 0.015f + 0.06f * rough;
        q *= cb * fmaxf(1.0f + cy->bias + sigma * nz->gauss(), 0.0f) * ecu->trim;
        if (ecu->fuelCut)
        {
            q = 0.0f;
            // pops: on the overrun some fuel gets through and lights in the pipe
            if ((ecu->dfco || ecu->limiting) && pops > 0.0f)
            {
                const float chance = pops * (0.25f + 0.75f * rpm / ecu->redRpm) * expf(-ecu->sinceLift / 2.5f);
                if (nz->rnd() > 1.0f - 0.9f * chance)
                {
                    const int b = lay->topo == 0 ? 0 : lay->bank[ci];
                    pop[b].fire(30000.0f * (0.35f + 0.65f * fabsf(nz->rnd())), rate, 99 + b);
                }
            }
        }
        cy->qTot = q;
        heat->heatJ += q;
        // knock: past the compression the fuel takes at this load (some 14 at full load, less with boost, far more at
        // part load) the end gas lights on its own, more often and harder the further past: a ping. More spark advance
        // (TIMING, less what the ECU has taken back: 0.12 a degree), hotter air under the bonnet (0.3 a 10 K) and a
        // hotter engine take that compression lower
        const float mapB = pPlenum / 101325.0f;
        const float crLim = (mapB >= 1.0f ? 14.0f - 2.5f * (mapB - 1.0f) : 14.0f + 20.0f * (1.0f - mapB)) + crBs
                            - 0.12f * (timing - ecu->kRet) - 0.03f * (heat->tAmb + 5.0f * heat->warm - 305.0f) - 0.02f * (heat->tCool - 363.0f);
        const float over = (smCR - crLim) / 3.0f;
        cy->knock = 0.0f;
        if (over > 0.0f && q > 0.0f && 0.5f + 0.5f * nz->rnd() < fminf(4.0f * over, 1.0f))
            cy->knock = fminf(1.5f * over, 1.5f) * (0.6f + 0.4f * fabsf(nz->rnd()));
        // its knock sensor hears it: the ECU takes the spark back 1.5 degrees a knock, up to 15 (and gives it back at 2
        // a second), which buys it some 2 points of compression; a knocking cycle loses heat to the walls the knock
        // scrubs (a tenth of it at a hard knock)
        if (cy->knock > 0.0f)
        {
            ecu->kRet = fminf(ecu->kRet + 1.5f, 15.0f);
            q *= 1.0f - 0.1f * cy->knock;
            cy->qTot = q;
        }
        // the spark: earlier at speed, later under load; TIMING moves it, the ECU takes back what knocks
        const float adv = 12.0f + 22.0f * sqrtf(fminf(rpm / ecu->redRpm, 1.2f)) - 8.0f * (pPlenum / 101325.0f - 0.4f)
                          + 22.0f * (burnK - 1.0f) + timing - ecu->kRet;
        // (a diluted charge lights later and burns slower: the flame's development and its speed)
        const float dx = fmaxf(dil - 0.15f, 0.0f);
        cy->sparkAt = lay->cyc - fminf(fmaxf(adv, 6.0f), 40.0f) + 1.5f * rough * nz->gauss() + 25.0f * fminf(dx, 0.3f);
        if (cy->sparkAt >= lay->cyc)
            cy->sparkAt -= lay->cyc;                         // (after the top: a late spark)
        // (a low compression's charge is cooler at the spark: its flame slower, as the ratio's -0.3th power)
        cy->burnDur = (44.0f + 11.0f * fmaxf(0.8f - pPlenum / 101325.0f, 0.0f)) * (1.0f + 0.08f * rough * nz->gauss())
                      * (1.0f + 2.5f * dx) * burnK * expf(-0.3f * logf(smCR * 0.1f));
        // far past the limit (some 2.5 points of compression past what the ECU's retard buys), the charge lights
        // itself as it is squeezed, 30 to 45 degrees before the top: pre-ignition, a fast burn that fights the piston's
        // rise (the torque falls away) and knocks its hardest; past some 8 points, most cycles do
        if (over > 0.8f && q > 0.0f && 0.5f + 0.5f * nz->rnd() < fminf(0.5f * (over - 0.8f), 0.9f))
        {
            cy->sparkAt = lay->cyc - 30.0f - 15.0f * fabsf(nz->rnd());
            cy->burnDur = 20.0f;
            cy->knock = 1.5f;
            ecu->kRet = 15.0f;
        }
    }

    // A diesel's charge, as its intake valve shuts: all the air it breathed (no ecu->throttle) and the fuel the lever asks
    // (the ecu->throttle, the idle governor's, or a start's while it cranks and for a moment after), lean: an equivalence
    // ratio of 0.75 at full fuel, the smoke limit; near the redline the governor takes the fuel back instead of cutting
    // it. It injects some degrees before the top (earlier at speed and with more fuel) and lights after its ignition
    // delay: Wolfer's, 0.44 p^-1.19 exp(4650 / T) ms (p in atmospheres), from the air squeezed polytropically from now
    // to the injection (and the glow plugs while it cranks), at most 30 degrees. What was injected during the delay
    // burns at once (Watson's share, 1 - 0.926 phi^0.37 / tau^0.26): a spike of pressure that rings the block, the
    // knock, louder at idle and the lower the compression; the rest burns as it mixes with the air.
    void chargeDiesel(Cylinder* cy, int ci, float pPlenum, float rpm, float smCR, float burnK, float rough, float timing)
    {
        const float air = fmaxf(cy->m - cy->mInert, 0.0f);
        dilution[ci] = fminf(cy->mInert / fmaxf(cy->m, 1.0e-9f), 0.95f);
        cy->cBurn = 1.0f;
        droop = fminf(fmaxf((ecu->redRpm + 50.0f - rpm) / 250.0f, 0.0f), 1.0f);
        // (ecu.model 1: its idle governor's fuel, 0.5 of full at the most, with no floor under it: the reference's 0.12
        // floor held a heavy diesel above its idle)
        const float idleFuel = ecu->model1() ? 0.5f * ecu->bypass : 0.12f + 0.5f * ecu->bypass;
        float lever = fminf(fmaxf(fmaxf(ecu->throttle, idleFuel), 0.45f * expf(-ecu->sinceStart / 1.0f)), 1.0f) * droop;
        if (diesel.lever >= 0.0f)
            lever = diesel.lever;                    // (card D2's governor: heavy.fm)
        const bool f1 = fuel->model == 1;
        if (f1)
        {
            diesel.soiAdd = fuel->soiAdd;
            diesel.pilot = fuel->pilot;
            diesel.rail = fuel->rail;
            diesel.overFuel = fuel->overFuel;
        }
        float phi = f1 ? diesel.phiAt(lever) : 0.75f * lever;
        if (diesel.metered != 0)
            phi = diesel.phiMetered(air, lever);     // (card D2: the fuel by the rack, capped by the compensator)
        const float sigma = 0.015f + 0.06f * rough;
        float q = air * phi / 14.5f * 42.5e6f * 0.62f * fmaxf(1.0f + cy->bias + sigma * nz->gauss(), 0.0f) * ecu->trim;
        if (ecu->fuelCut)
            q = 0.0f;
        // (TIMING injects earlier; a cold chamber's walls take more of the squeeze's heat, its charge some 4 % cooler
        // at the top, and cranking's slow squeeze loses more still (and blows by), some 20 %; its glow plugs heat it
        // while it cranks, and for a minute and a half after a cold start)
        const float soi = 4.0f + 14.0f * fminf(rpm / ecu->redRpm, 1.2f) + 3.0f * lever + timing + (f1 ? diesel.soiAdd : 0.0f);
        const float lr = logf(fmaxf(cy->v / cy->volumeAt(lay->cyc - soi), 1.0f));
        const float cold = 1.0f - heat->warmS;
        const float nSq = 0.35f - 0.015f * cold - (ecu->state == 1 ? 0.08f : 0.0f);
        const float glow = ecu->state == 1 ? 200.0f : 100.0f * (1.0f - heat->warm) * fmaxf(1.0f - heat->runT / 90.0f, 0.0f);
        const float tc = cy->t * expf(nSq * lr) + glow;
        const float pc = cy->p * expf(1.35f * lr) / 101325.0f;
        const float tau = 0.44f * expf(-1.19f * logf(fmaxf(pc, 1.0f))) * expf(4650.0f / fmaxf(tc, 400.0f));
        const float delayRaw = tau * 0.006f * fmaxf(rpm, 100.0f);
        const float delay = fminf(delayRaw, 30.0f);
        // whether it lights at all: the charge's temperature squeezed to the top (with the same losses and glow) must
        // reach some 740 K (none under 680), and it must light before the piston is well on its way down. Injected
        // early, into cooler air, the delay mostly runs as the squeeze heats it: what is left of it at the top runs at
        // the top's pace (Livengood and Wu's integral, in two steps), from 10 degrees after it on less and less, none
        // past 20. What does not light goes out unburned (white smoke): a diesel of too little compression misses and
        // stalls, and a cold one cranks and cranks (a 17:1 diesel some -20 F, 0 F hard), or will not start at all
        const float lrT = logf(fmaxf(cy->v / cy->vc, 1.0f));
        const float tTop = cy->t * expf(nSq * lrT) + glow;
        const float pTop = cy->p * expf(1.35f * lrT) / 101325.0f;
        const float dTop = 0.44f * expf(-1.19f * logf(fmaxf(pTop, 1.0f))) * expf(4650.0f / fmaxf(tTop, 400.0f)) * 0.006f * fmaxf(rpm, 100.0f);
        const float late = delayRaw > soi ? (delayRaw - soi) * dTop / fmaxf(delayRaw, 0.001f) : 0.0f;
        const float pIgn = fminf(fmaxf((tTop - 680.0f) / 60.0f, 0.0f), 1.0f) * fminf(fmaxf((20.0f - late) / 10.0f, 0.0f), 1.0f);
        if (pIgn < 1.0f && 0.5f + 0.5f * nz->rnd() >= pIgn)
            q = 0.0f;
        // (past some 18, a higher compression's tighter chamber gives its walls more of the burn: 1.5 % a point)
        q *= 1.0f - 0.015f * fmaxf(smCR - 18.0f, 0.0f);
        cy->qTot = q;
        heat->heatJ += q;
        cy->sparkAt = lay->cyc - soi + delay + rough * nz->gauss();
        if (cy->sparkAt >= lay->cyc)
            cy->sparkAt -= lay->cyc;
        cy->beta = fminf(fmaxf(1.0f - 0.926f * expf(0.37f * logf(fmaxf(phi, 0.01f)) - 0.26f * logf(fmaxf(tau, 0.05f))), 0.05f), 0.9f);
        if (f1)
            cy->beta = diesel.premixed(cy->beta);
        cy->burnDur = 4.5f + 2.5f * fminf(rpm / ecu->redRpm, 1.0f);
        cy->knock = 0.0f;
        cy->dur2 = (35.0f + 30.0f * lever) * (1.0f + 0.08f * rough * nz->gauss()) * burnK;
        if (f1)
            cy->dur2 = diesel.diffusion(cy->dur2);
    }

    // A gasoline charge under fuel.model 1 or ecu.model 1: the reference's dilution toll, scatter and burn's length,
    // with the firing, the spark and lambda the ECU's (ecu.model 1), the heat the fuel's (fuel.model 1), and knock from
    // the end gas (fuel.model 1) or the reference's rule
    void charge1(Cylinder* cy, int ci, float pPlenum, float rpm, float smCR, float crBs, float burnK, float rough, float timing)
    {
        const bool f1 = fuel->model == 1;
        const bool e1 = ecu->model1();
        droop = 1.0f;
        ecu->cylinders = lay->n;
        if (ci == 0)
            ecu->watch.cycle();
        const float dil = fminf(cy->mInert / fmaxf(cy->m, 1.0e-9f), 0.95f);
        const float burnable = fmaxf(cy->m - cy->mInert, 0.0f);
        // (the gas keeps: with Woschni's walls (comb.walls: wallHeat 1 or fuel.model 1, the engine's one decision) the
        // burn's own efficiency, 0.97,
        // the mixture's heat having already left out what goes unburned and the walls taking theirs through the cylinder;
        // with the reference's walls the reference's 0.60 + 0.20 x manifold, its walls' and its unburned share at once:
        // the energy counted once whichever way the two switches stand)
        const float share = walls != 0 ? 0.97f : 0.60f + 0.20f * fminf(pPlenum / 101325.0f, 1.2f);
        const float d50 = (lay->rotary != 0 ? 0.62f : 0.56f) * (1.0f + (0.015f + 0.03f * rough) * nz->gauss());
        const float cb = 1.0f / (1.0f + expf((dil - d50) / 0.035f));
        cy->cBurn = cb;
        dilution[ci] = dil;
        const float sigma = 0.015f + 0.06f * rough;
        const float factor = cb * fmaxf(1.0f + cy->bias + sigma * nz->gauss(), 0.0f) * ecu->trim;
        // the burn's length without its scatter (degrees; as the reference's below), and the diluted charge's late lighting
        const float dx = fmaxf(dil - 0.15f, 0.0f);
        const float burnBase = (44.0f + 11.0f * fmaxf(0.8f - pPlenum / 101325.0f, 0.0f)) * (1.0f + 2.5f * dx) * burnK
                               * expf(-0.3f * logf(smCR * 0.1f));
        // the ECU's decision and spark (degrees before the top)
        int firing = CHARGE_BURN;
        float adv = 0.0f;
        float lambda = 1.0f;
        float extra = 1.0f;
        float kRetC = ecu->kRet;
        if (e1)
        {
            ecu->one.maps.tune.burnK = burnK;
            firing = ecu->one.fire(ci);
            ecu->one.maps.tune.compression = smCR;
            lambda = ecu->one.lambda;
            // (the spark's formula, when the map is on it, for this charge: the half of its burn at kHalfBurn degrees
            // after the top: the Wiebe curve's first half (0.517 of its length; its length as below, the mixture's flame
            // in it under fuel.model 1) and the diluted charge's late lighting before it, ahead of that; the ECU's
            // timing (an offset over the formula) and its retards over it)
            adv = ecu->one.sparkFor;
            if (ecu->spec->maps.sparkAuto)
            {
                const float flame = f1 ? 1.0f / sqrtf(one.mix.flameShare(fuel->grade, 1.0f / fmaxf(lambda, 0.3f))
                                                      * kFuelFlame[fuelRow(fuel->grade)]) : 1.0f;
                adv += 0.517f * burnBase * flame + 25.0f * fminf(dx, 0.3f) - kHalfBurn - ecu->one.sparkBase;
            }
            extra = ecu->one.fuelFactor;
            kRetC = ecu->one.knock.retard[ci < 16 ? ci : 15];
        }
        else
        {
            firing = ecu->fuelCut ? CHARGE_FUEL_CUT : CHARGE_BURN;
            adv = 12.0f + 22.0f * sqrtf(fminf(rpm / ecu->redRpm, 1.2f)) - 8.0f * (pPlenum / 101325.0f - 0.4f)
                  + 22.0f * (burnK - 1.0f) + timing - ecu->kRet;
        }
        adv = fminf(fmaxf(adv, e1 ? -40.0f : 6.0f), 40.0f);
        // the heat, and what leaves unburned
        float q = 0.0f;
        float outFuel = 0.0f;
        float outAir = burnable;
        float burnLen = 1.0f;
        if (f1)
        {
            one.make(fuel->grade, firing, burnable, oxygen, lambda, fuel->direct, cy->t, share, factor, -adv,
                     0.5f + 0.5f * nz->rnd(), extra);
            q = one.heat;
            outFuel = one.outFuel;
            outAir = one.outAir;
            burnLen = one.burnK;
            ecu->sensor.firing(one.lambdaOut);
            ecu->lastFuel = one.fuel;
            ecu->meter.firing(one.fuel);
        }
        else
        {
            const float f = firing == CHARGE_FUEL_CUT ? 0.0f : burnable / 14.0f;
            const float inCyl = firing == CHARGE_BURN ? 1.0f : (firing == CHARGE_OVERRUN ? fminf(fmaxf(1.0f + adv / 60.0f, 0.0f), 1.0f) : 0.0f);
            q = burnable / 14.0f * 44.0e6f * share * factor * inCyl;
            outFuel = f * (1.0f - inCyl);
            outAir = burnable * (1.0f - inCyl);
            ecu->sensor.firing(f > 0.0f ? 1.0f : 10.0f);
            ecu->lastFuel = f;
            ecu->meter.firing(f);
        }
        if (e1)
        {
            const int b = lay->topo == 0 ? 0 : lay->bank[ci];
            ecu->one.account.add(b, outFuel, outAir);
        }
        cy->qTot = q;
        heat->heatJ += q;
        cy->knock = 0.0f;
        cy->sparkAt = lay->cyc - adv + 1.5f * rough * nz->gauss() + 25.0f * fminf(dx, 0.3f);
        if (cy->sparkAt >= lay->cyc)
            cy->sparkAt -= lay->cyc;
        cy->burnDur = (44.0f + 11.0f * fmaxf(0.8f - pPlenum / 101325.0f, 0.0f)) * (1.0f + 0.08f * rough * nz->gauss())
                      * (1.0f + 2.5f * dx) * burnK * expf(-0.3f * logf(smCR * 0.1f)) * burnLen;
        if (f1)
        {
            // the end gas from now (sample() ticks it)
            // (running only: cranking's slow squeeze loses its heat to the walls, which the isentropic end gas does not
            // know, and Douaud and Eyzat's fit is a running engine's)
            if (q > 0.0f && ecu->state == 2)
                gas[ci].start(cy->p, one.tEnd, fuelOctane(fuel->grade), fuel->knockDelay);
            else
                gas[ci].stop();
            return;
        }
        // the reference's knock rule, with this cylinder's retard
        const float mapB = pPlenum / 101325.0f;
        const float crLim = (mapB >= 1.0f ? 14.0f - 2.5f * (mapB - 1.0f) : 14.0f + 20.0f * (1.0f - mapB)) + crBs
                            - 0.12f * (timing - kRetC) - 0.03f * (heat->tAmb + 5.0f * heat->warm - 305.0f) - 0.02f * (heat->tCool - 363.0f);
        const float over = (smCR - crLim) / 3.0f;
        if (over > 0.0f && q > 0.0f && 0.5f + 0.5f * nz->rnd() < fminf(4.0f * over, 1.0f))
            cy->knock = fminf(1.5f * over, 1.5f) * (0.6f + 0.4f * fabsf(nz->rnd()));
        if (cy->knock > 0.0f)
        {
            heard(ci, cy->knock / 1.5f);
            cy->qTot = q * (1.0f - 0.1f * cy->knock);
        }
    }

    // The knock sensor hears cylinder c at an intensity (0 to 1): the ECU's retard
    void heard(int c, float intensity)
    {
        if (ecu->model1())
            ecu->one.knock.heard(ecu->spec->knock.on, c, intensity, ecu->spec->knock.step, ecu->spec->knock.most);
        else
            ecu->kRet = fminf(ecu->kRet + 1.5f, 15.0f);
    }

    // Each sample, after cylinder c's step: under fuel.model 1 its end gas every 4 samples (a knock lights the rest
    // of the charge: its ping, the heat it scrubs, the ECU's retard; before the spark, pre-ignition), cylinder 1's burn
    // for the telemetry, and the bangs the ECU's account fired. Nothing under both models 0
    void sample(Cylinder* cy, int c, float dt)
    {
        const bool f1 = fuel->model == 1;
        if (!f1 && !ecu->model1())
            return;
        if (c == 0)
        {
            ticks += 1;
            const float a = cy->ang > 0.5f * lay->cyc ? cy->ang - lay->cyc : cy->ang;
            ecu->watch.tick(cy->p, a, cy->burnAt >= 0.0f ? cy->xPrev : 0.0f);
            if (ecu->model1())
                for (int b = 0; b < 2; ++b)
                    if (ecu->one.account.pulse[b] > 0.0f)
                    {
                        pop[b].fire(ecu->one.account.pulse[b], rate, 99 + b);
                        ecu->one.account.pulse[b] = 0.0f;
                    }
        }
        if (!f1 || gas[c].on == 0 || ((ticks + c) & 3) != 0)
            return;
        const int lit = cy->burnAt >= 0.0f ? 1 : 0;
        const float k = gas[c].tick(4.0f * dt, cy->p, lit != 0 ? cy->xPrev : 0.0f, lit);
        if (k <= 0.0f)
            return;
        if (gas[c].pre != 0)
        {
            // pre-ignition: it burns from now, fast, against the piston
            cy->burnAt = 0.0f;
            cy->xPrev = 0.0f;
            cy->burnDur = 20.0f;
            cy->sparkAt = cy->ang;
            cy->knock = 1.5f;
        }
        else
        {
            cy->knock = 1.5f * k;
            cy->qTot *= 1.0f - 0.1f * cy->knock;
        }
        heard(c, fminf(k, 1.0f));
    }
};
