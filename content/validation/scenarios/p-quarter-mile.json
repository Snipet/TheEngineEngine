{
  "format": "tee-scenario",
  "version": 1,
  "name": "p-quarter-mile",
  "description": "Card P's drag run, as card I's test runs one: warm, the gearbox made an automatic for the run (an open-loop timeline cannot shift a manual at the right speeds; the ratios are the build's), staged at 6 s, the green at 8.5 s, the brakes off and the pedal brought down over 0.6 s. Read car.t1320 and car.v1320.",
  "seconds": 40,
  "warm": true,
  "events": [
    {
      "t": 0.0,
      "ctl": {
        "mode": 1,
        "lever": 0,
        "clutch": 0,
        "throttle": 0,
        "brake": 0,
        "ignition": 1
      }
    },
    {
      "t": 0.25,
      "ctl": {
        "ignition": 2
      }
    },
    {
      "t": 2.0,
      "ctl": {
        "ignition": 1
      }
    },
    {
      "t": 0.0,
      "spec": {
        "car.gearbox": "Automatic"
      }
    },
    {
      "t": 2.3,
      "ctl": {
        "lever": 1,
        "brake": 1
      }
    },
    {
      "t": 6.0,
      "press": [
        "strip"
      ]
    },
    {
      "t": 8.5,
      "ctl": {
        "brake": 0,
        "throttle": 0.15
      }
    },
    {
      "t": 8.5,
      "ctl": {
        "throttle": 1
      },
      "ramp": 0.6
    }
  ],
  "assertions": [
    {
      "audio": "finite"
    },
    {
      "audio": "peak",
      "<=": 1,
      "source": "02-contracts.md, section 1: within +-1"
    }
  ]
}
