{
  "format": "tee-scenario",
  "version": 1,
  "name": "p-hot-start",
  "description": "Card P's hot start: the engine warm (as after a run) in 318 K air (45 C, a hot day's under-bonnet), the key turned at 0.25 s and held 4 s, idling to 12 s, off. Read engine.state and engine.speed.",
  "seconds": 14,
  "events": [
    {
      "t": 0.0,
      "spec": {
        "env.temperature": 318.0
      }
    },
    {
      "t": 0.0,
      "ctl": {
        "mode": 1,
        "lever": 0,
        "clutch": 0,
        "throttle": 0,
        "brake": 0,
        "ignition": 1
      }
    },
    {
      "t": 0.25,
      "ctl": {
        "ignition": 2
      }
    },
    {
      "t": 4.25,
      "ctl": {
        "ignition": 1
      }
    },
    {
      "t": 12.0,
      "ctl": {
        "ignition": 0
      }
    }
  ],
  "assertions": [
    {
      "audio": "finite"
    },
    {
      "audio": "peak",
      "<=": 1,
      "source": "02-contracts.md, section 1: within +-1"
    }
  ],
  "warm": true
}
