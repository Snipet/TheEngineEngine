  "warm": true,
  "events": [
    {
      "t": 0.0,
      "ctl": {
        "mode": 1,
        "lever": 0,
        "clutch": 0,
        "throttle": 0,
        "brake": 0,
        "ignition": 1
      }
    },
    {
      "t": 0.25,
      "ctl": {
        "ignition": 2
      }
    },
    {
      "t": 2.0,
      "ctl": {
        "ignition": 1
      }
    },
    {
      "t": 5.0,
      "ctl": {
        "brake": 1
      }
    },
    {
      "t": 5.5,
      "ctl": {
        "lever": 1
      }
    },
    {
      "t": 8.0,
      "press": [
        "strip"
      ]
    },
    {
      "t": 9.0,
      "ctl": {
        "throttle": 1
      },
      "ramp": 0.3
    },
    {
      "t": 10.5,
      "ctl": {
        "brake": 0
      }
    }
  ],
  "assertions": [
    {
      "audio": "finite"
    },
    {
      "audio": "peak",
      "<=": 1
    }
  ],
  "warmTyres": true
