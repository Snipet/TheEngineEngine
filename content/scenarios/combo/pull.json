{
  "format": "tee-scenario",
  "version": 1,
  "name": "pull",
  "description": "Package X's pull (tests/sim/combo/Combo.cpp writes it: edit there, not here).",
  "seconds": 17,
  "events": [
    { "t": 0, "spec": { "env.temperature": 293.15 } },
    { "t": 0, "ctl": { "mode": 1 } },
    { "t": 0, "ctl": { "lever": 0 } },
    { "t": 0, "ctl": { "clutch": 0 } },
    { "t": 0, "ctl": { "throttle": 0 } },
    { "t": 0, "ctl": { "brake": 0 } },
    { "t": 0, "ctl": { "ignition": 1 } },
    { "t": 0.25, "ctl": { "ignition": 2 } },
    { "t": 2, "ctl": { "ignition": 1 } },
    { "t": 3, "press": ["shiftUp"] },
    { "t": 3.3, "ctl": { "throttle": 0.5 }, "ramp": 0.2 },
    { "t": 4.5, "ctl": { "throttle": 1 }, "ramp": 0.1 },
    { "t": 6.5, "press": ["shiftUp"] },
    { "t": 8.5, "press": ["shiftUp"] },
    { "t": 10.5, "ctl": { "throttle": 0 }, "ramp": 0.05 },
    { "t": 11, "press": ["shiftDown"] },
    { "t": 12, "ctl": { "brake": 0.6 }, "ramp": 0.2 },
    { "t": 13.5, "ctl": { "clutch": 1 }, "ramp": 0.2 },
    { "t": 14, "ctl": { "ignition": 0 } }
  ],
  "assertions": [
    { "audio": "finite" },
    { "audio": "peak", "<=": 1 }
  ]
}
