{
  "format": "tee-scenario",
  "version": 1,
  "name": "drive-past",
  "description": "Full throttle from rest through three gears, past the camera (package X's listening pack, for card L)",
  "seconds": 15,
  "events": [
    {
      "t": 0,
      "spec": {
        "env.temperature": 293.15
      },
      "ctl": {
        "mode": 1,
        "lever": 0,
        "clutch": 0,
        "throttle": 0,
        "ignition": 1
      }
    },
    {
      "t": 0.25,
      "ctl": {
        "ignition": 2
      }
    },
    {
      "t": 2.0,
      "ctl": {
        "ignition": 1
      }
    },
    {
      "t": 3.0,
      "press": [
        "shiftUp"
      ]
    },
    {
      "t": 3.3,
      "ctl": {
        "throttle": 1
      },
      "ramp": 0.2
    },
    {
      "t": 6.0,
      "press": [
        "shiftUp"
      ]
    },
    {
      "t": 9.0,
      "press": [
        "shiftUp"
      ]
    },
    {
      "t": 13.0,
      "ctl": {
        "throttle": 0
      },
      "ramp": 0.1
    }
  ],
  "assertions": [
    {
      "audio": "finite"
    },
    {
      "audio": "peak",
      "<=": 1
    }
  ]
}