{
  "format": "tee-scenario",
  "version": 1,
  "name": "lug-windows",
  "description": "Up to fifth at part throttle, lugging low; at 14 s the windows wind down over 2 s (package X's listening pack, for card L)",
  "seconds": 20,
  "events": [
    {
      "t": 0,
      "spec": {
        "env.temperature": 293.15
      },
      "ctl": {
        "mode": 1,
        "lever": 0,
        "clutch": 0,
        "throttle": 0,
        "ignition": 1
      }
    },
    {
      "t": 0.25,
      "ctl": {
        "ignition": 2
      }
    },
    {
      "t": 2.0,
      "ctl": {
        "ignition": 1
      }
    },
    {
      "t": 3.0,
      "press": [
        "shiftUp"
      ]
    },
    {
      "t": 3.2,
      "ctl": {
        "throttle": 0.4
      },
      "ramp": 0.3
    },
    {
      "t": 5.0,
      "press": [
        "shiftUp"
      ]
    },
    {
      "t": 6.5,
      "press": [
        "shiftUp"
      ]
    },
    {
      "t": 8.0,
      "press": [
        "shiftUp"
      ]
    },
    {
      "t": 9.5,
      "press": [
        "shiftUp"
      ]
    },
    {
      "t": 10.0,
      "ctl": {
        "throttle": 0.6
      },
      "ramp": 0.5
    },
    {
      "t": 14.0,
      "spec": {
        "sound.windows": 1
      },
      "ramp": 2.0
    }
  ],
  "assertions": [
    {
      "audio": "finite"
    },
    {
      "audio": "peak",
      "<=": 1
    }
  ]
}