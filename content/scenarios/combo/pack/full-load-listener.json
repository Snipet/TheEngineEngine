{
  "format": "tee-scenario",
  "version": 1,
  "name": "full-load-listener",
  "description": "The listener (sound.model 1): flat out in neutral against the limiter for 4 s (package X's listening pack, for card L)",
  "seconds": 9,
  "events": [
    {
      "t": 0,
      "spec": {
        "env.temperature": 293.15,
        "sound.model": 1
      },
      "ctl": {
        "mode": 1,
        "lever": 0,
        "clutch": 0,
        "throttle": 0,
        "ignition": 1
      }
    },
    {
      "t": 0.25,
      "ctl": {
        "ignition": 2
      }
    },
    {
      "t": 2.0,
      "ctl": {
        "ignition": 1
      }
    },
    {
      "t": 3.0,
      "ctl": {
        "throttle": 1
      },
      "ramp": 0.2
    },
    {
      "t": 7.0,
      "ctl": {
        "throttle": 0
      },
      "ramp": 0.05
    }
  ],
  "assertions": [
    {
      "audio": "finite"
    },
    {
      "audio": "peak",
      "<=": 1
    }
  ]
}