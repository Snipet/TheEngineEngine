+// (scratch, local only: needs cylinder.fm's dbg fields) N3-16's drivers, the lead's ask 25 Nov 01:37
+TEST_CASE("overlap drivers", "[.drivers]")
+{
+    for (const char* build : {"archetypes/v10-52", "archetypes/v12-65", "archetypes/hot-hatch-16-16v", "archetypes/economy-four-15"})
+        for (int mean = 0; mean < 2; ++mean)
+        {
+            Bench b(build);
+            std::string e;
+            REQUIRE(b.player().setSpec("car.model", 0, e));
+            b.start();
+            b.warm();
+            const int nc = int(b.tel("engine.cylinders"));
+            for (int c = 0; c < nc; ++c)
+                b.write("cyl[" + std::to_string(c) + "].dbgMean", mean);
+            b.ctl().throttle = 0.0f;
+            b.play(5.0);
+            for (int j = 0; j < 80; ++j)
+                b.write("cyl[0].dbgBin[" + std::to_string(j) + "]", 0.0);
+            for (int j = 0; j < 12; ++j)
+                b.write("cyl[0].dbgCyc[" + std::to_string(j) + "]", 0.0);
+            double s = 0, s2 = 0, n = 0, map = 0;
+            b.play(4.0, [&] {
+                const double r = b.tel("engine.speed") * 9.5492966;
+                s += r; s2 += r * r; n += 1; map += b.tel("engine.manifold");
+            });
+            const double rpm = s / n, sd = std::sqrt(std::max(s2 / n - rpm * rpm, 0.0)), cycles = 4.0 * rpm / 120.0;
+            auto c = [&](int j) { return b.field("cyl[0].dbgCyc[" + std::to_string(j) + "]"); };
+            auto bn = [&](int j) { return b.field("cyl[0].dbgBin[" + std::to_string(j) + "]"); };
+            const double nIvc = std::max(c(3), 1.0), nIvo = nIvc;
+            const double R = c(0) / nIvo, X = c(1) / nIvc, F = c(2) / nIvc;
+            std::printf("%s%s: %.0f rpm sd %.1f, manifold %.1f kPa; at IVC: share %.3f (burned %.4f g = R %.4f at IVO + %.4f after; fresh F %.4f g); "
+                        "E (exhaust back in, both open) %.4f g; ideal-orifice E with the port's pressure %.4f, with its cycle mean %.4f (%.0f %% of it); "
+                        "port mean %.1f kPa\n",
+                        build, mean ? " [port pressure held at its mean while both open]" : "", rpm, sd, map / n / 1000.0, X / (X + F), 1e3 * X,
+                        1e3 * R, 1e3 * (X - R), 1e3 * F, 1e3 * c(4) / cycles, 1e3 * c(5) / cycles, 1e3 * c(6) / cycles,
+                        100.0 * c(6) / std::max(c(5), 1e-12), c(8) / std::max(c(7), 1e-12) / 1000.0);
+            if (mean == 0)
+                for (int k = 0; k < 8; ++k)
+                {
+                    const double T = bn(k * 10);
+                    if (T <= 0)
+                        continue;
+                    std::printf("   %3d-%3d: p ex %.1f cyl %.1f int %.1f kPa; exhaust out %.4f in %.4f, intake pushed %.4f drawn %.4f g\n",
+                                330 + 10 * k, 340 + 10 * k, bn(k * 10 + 1) / T / 1e3, bn(k * 10 + 2) / T / 1e3, bn(k * 10 + 3) / T / 1e3,
+                                1e3 * bn(k * 10 + 4) / cycles, 1e3 * bn(k * 10 + 5) / cycles, 1e3 * bn(k * 10 + 6) / cycles,
+                                1e3 * bn(k * 10 + 7) / cycles);
+                }
+        }
