+            int nx = rF + 1 >= cap ? 0 : rF + 1;
+            while ((float)(ageF - 1) >= fd[nx])
+            {
+                rF = nx;
+                ageF -= 1;
+                nx = rF + 1 >= cap ? 0 : rF + 1;
+            }
+            f = fw[rF] + (fw[nx] - fw[rF]) * (((float)ageF - fd[rF]) / (1.0f + fd[nx] - fd[rF]));
+        }
+        else
+            f = c0 * fw[k + 1] + c1 * fw[k] + c2 * fw[k - 1] + c3 * fw[k - 2];
+        rawF = f;
+    }
