+    // (lanes) read() in three parts, for DuctLanes: the lines' reads here, the tracker and the wall across pipes in
+    // DuctLanes::run, the rest in finishRead: the same arithmetic in the same order for each pipe
+    void readRaw()
+    {
+        const int k = w - di + cap;
+        float f = 0.0f;
+        const int kb = w - bdi + cap;
+        rawB = bc0 * bw[kb + 1] + bc1 * bw[kb] + bc2 * bw[kb - 1] + bc3 * bw[kb - 2];
