+                pwF[i] = pb1[i] * f - pa1[i] * yf;
+                f = yf;
+                const float yb = pb0[i] * b + pwB[i];
+                pwB[i] = pb1[i] * b - pa1[i] * yb;
+                b = yb;
+            }
