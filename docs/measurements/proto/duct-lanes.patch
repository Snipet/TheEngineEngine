+// (lanes) The steady flow's tracker and the wall's three shelves of up to 32 pipes, as arrays across the pipes: one loop
+// the vectoriser takes. A pipe without the wall (wallOn 0) passes its waves, its shelves' states standing.
+module DuctLanes
+{
+    float kDc[32];
+    int on[32];         // the pipe's wallOn: off, its wave passes and its shelves' states stand, as in Duct::read
+    float mF[32];
+    float mB[32];
+    float sb0[3][32];
+    float sb1[3][32];
+    float sa1[3][32];
+    float wsF[3][32];
+    float wsB[3][32];
+    float fr[32];
+    float br[32];
+    float fo[32];
+    float bo[32];
+    int n;
+
+    void clear()
+    {
+        for (int p = 0; p < 32; ++p)
+        {
+            mF[p] = 0.0f;
+            mB[p] = 0.0f;
+            for (int i = 0; i < 3; ++i)
+            {
+                wsF[i][p] = 0.0f;
+                wsB[i][p] = 0.0f;
+            }
+        }
+    }
+
+    // lane p takes pipe d's coefficients (every time its pipe is sized)
+    void take(int p, Duct* d)
+    {
+        kDc[p] = d->kDc;
+        on[p] = d->wallOn;
+        for (int i = 0; i < 3; ++i)
+        {
+            sb0[i][p] = d->sb0[i];
+            sb1[i][p] = d->sb1[i];
+            sa1[i][p] = d->sa1[i];
+        }
+    }
+
+    void run()
+    {
+        for (int p = 0; p < n; ++p)
+        {
+            float f = fr[p];
+            float b = br[p];
+            mF[p] += kDc[p] * (f - mF[p]);
+            mB[p] += kDc[p] * (b - mB[p]);
+            f -= mF[p];
+            b -= mB[p];
+            const bool w = on[p] != 0;
+            for (int i = 0; i < 3; ++i)
+            {
+                const float yf = sb0[i][p] * f + wsF[i][p];
+                const float yb = sb0[i][p] * b + wsB[i][p];
+                wsF[i][p] = w ? sb1[i][p] * f - sa1[i][p] * yf : wsF[i][p];
+                wsB[i][p] = w ? sb1[i][p] * b - sa1[i][p] * yb : wsB[i][p];
+                f = w ? yf : f;
+                b = w ? yb : b;
+            }
+            fo[p] = f;
+            bo[p] = b;
+        }
+    }
+};
