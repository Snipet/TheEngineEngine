+                const float yb = rb0[i] * b + rwB[i];
+                rwB[i] = rb1[i] * b - ra1[i] * yb;
+                b = yb;
+            }
+        }
+        if (lp > 0.0f)
+        {
+            sF += (1.0f - lp) * (f - sF);
+            sB += (1.0f - lp) * (b - sB);
+            f = sF;
+            b = sB;
+        }
+        far = gain * f + mFv;
+        near = gain * b + mBv;
