     float omegaMax[BOOST_TURBOS];
-    float mMatch;                   // the engine's flow at its redline, matched, kg/s
+    float mMatch;
+    int matchBaked;     // 1: the turbine matched on the baked rated p4 and T3; 0: on the stand-ins (tel.boost.mismatch 32)
+    int bothEnds;       // 0: (b)'s wheel fails rule (c)'s rated check (tel.boost.mismatch 64)
+    float ratedPhi;     // the rated check's mean share of choke flow on the chosen wheel (0.96 its limit)                   // the engine's flow at its redline, matched, kg/s
     // (card N2: the charge system against the engine it is on, for the telemetry's warnings: has, wants; see apply)
     float icFlowHas;
     float chargeVolHas;
@@ -473,6 +476,28 @@ module BoostMachine
         const float t2Des = tOut * (1.0f + tauDes / fmaxf(s->compEta, 0.3f));
         const float tCharge = t2Des - s->icEffect * (t2Des - tOut);
         mMatch = fmaxf(vd * nDesign / 120.0f * (prDesign * pOut / (kBoostR * tCharge)) * 0.9f, 0.01f);
+        // (card N2's design, turbine-match-design.md (2): with the engine's own rated state baked into the build (the
+        // turbine's outlet p4, its inlet gas T3), the turbine's inlet pressure at the design point is the rated power
+        // balance's, not 1.247 times the boost: the compressor's power on the design flow at the design ratio, its
+        // efficiency the match's own (compEta), against the turbine's on the same flow from T3 down to p4, the turbine at
+        // its peak efficiency (turbEta: at rated every diesel's turbine sat at its blade-speed ratio's peak, x(2 - x) 0.99
+        // to 1.00, rated-nozzle-q2.md). The flow through the turbine is the air alone: the fuel's 3 to 5 % is left out
+        // (the open area then some 2 % small, judgement). Not baked: the stand-ins, and tel.boost.mismatch 32)
+        float p3Match = p3Design;
+        float tMatch = tDesign;
+        matchBaked = 0;
+        if (s->ratedP4 > 0.0f && s->ratedT3 > 0.0f)
+        {
+            const float work = kBoostCpA * tOut * tauDes / fmaxf(s->compEta, 0.3f);
