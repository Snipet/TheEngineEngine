+            const float ex = fminf(work / fmaxf(avail, 1.0f), 0.9f);
+            const float q = 1.0f - ex;
+            p3Match = s->ratedP4 / (q * q * q * q);
+            tMatch = s->ratedT3;
+            matchBaked = 1;
+        }
+        bothEnds = 1;
+        ratedPhi = 0.0f;
