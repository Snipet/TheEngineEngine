                 mm |= 16;
+            // (card N2's design: the turbine matched on the stand-ins, not on the build's baked rated state; a governed
+            // diesel's compressor that cannot meet both ends, its surge margin at the torque peak and the choke check at
+            // rated: turbine-match-design.md)
+            if (mach.sc == 0 && mach.turbos > 0 && mach.matchBaked == 0)
+                mm |= 32;
+            if (mach.sc == 0 && mach.turbos > 0 && mach.bothEnds == 0)
+                mm |= 64;
         }
         t->mismatch = mm;
         t->coolerHas = on != 0 ? mach.icFlowHas : 0.0f;
diff --git a/sim/boost/machine.fm b/sim/boost/machine.fm
index db2dc83a..3b253807 100644
--- a/sim/boost/machine.fm
+++ b/sim/boost/machine.fm
@@ -130,7 +130,10 @@ module BoostMachine
