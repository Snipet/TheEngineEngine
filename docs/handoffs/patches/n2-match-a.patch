+                // flow and ratio, the speed line through the ratio on the map's laws, the share of that line's choke
+                // flow under 0.96 (the choke flag's 0.98 over the cycle's measured peak over mean, 1.001 to 1.023 on
+                // every diesel, c-margin.md: labelled judgement) and the tip under its 560 m/s. A wheel that fails is
+                // flagged (tel.boost.mismatch 64), not changed: the lead's ruling, no compromise rule)
+                {
+                    float m = 1.0f;
+                    float lo = 0.3f;
+                    float hi = 2.2f;
+                    const float fullC = 0.506f * 1.204f * 343.2f * wide * aAnn;
+                    for (int it = 0; it < 40; ++it)
+                    {
+                        m = 0.5f * (lo + hi);
+                        const float tk = (0.608f - 0.157f * (m - 1.0f)) * 0.4f * m * m;
+                        const float kn = fminf(fmaxf((0.349f + 0.551f * (fmaxf(m, 0.67f) - 1.0f)) * kArS, 0.15f), 0.9f);
+                        const float ph = mt / (fullC * (0.3f + 0.7f * fminf(m / 1.63f, 1.0f)));
+                        float tl = -1.0f;
+                        if (ph <= 1.0f)
+                        {
+                            if (ph < kn)
+                            {
+                                const float x = ph / kn;
+                                tl = 0.88f * tk + 0.12f * tk * x * x * (3.0f - 2.0f * x);
+                            }
+                            else
+                            {
+                                const float y = (ph - kn) / (1.0f - kn);
+                                tl = 0.652f * tk + 0.348f * tk * sqrtf(fmaxf(1.0f - y * y, 1.0e-4f));
+                            }
+                        }
+                        if (tl < tauD)
