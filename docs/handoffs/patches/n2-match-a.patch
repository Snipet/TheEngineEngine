+            const float aGateMatched = mGate * sqrtf(kBoostR * tMatch) / (p3Match * 0.667f);
             const float dg = s->gateDiameter > 0.0f ? s->gateDiameter : sqrtf(aGateMatched / (0.785398f * 0.85f));
             turb[t].aGate = 0.785398f * dg * dg * 0.85f;
             const float vh = s->housingVolume > 0.0f ? s->housingVolume : 4.0f * 3.14159265f * rc * aNoz;
