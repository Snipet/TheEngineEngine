+// The two-stage's switch holds its stage across its hysteresis band (valvetrain/lab.fm: up over 612.6 rad/s, down under
+// 581.2), so a predicted point in the band read the stage of the way the rig came to it: on the tip of 25 Nov the
+// 5740 rpm point, reached from 6827 rpm (or stepped up from 4110 with the absorber's loop carrying it over the switch),
+// read stage B at 181.3 N m between 194.5 and 202.5: P's 13 N m notch. Read as an upward sweep reaches it (the program's
+// FLAG_LATCHED let down), stage A, 192.6 (the stepped dyno, upward: 190.3). Every point under the switch reads A and
+// every one over it B, whatever the order the rigs take them in (card N1)
+TEST_CASE("a two-stage cam's predicted points read the stage an upward sweep reaches them in: none latched in the band",
+          "[engine][sim][predict]")
+{
+    if (!haveSim())
+        SKIP("sim/engine.fm is not there yet");
+    std::string error;
+    const auto sim = compiled(simDir(), {}, error);
+    REQUIRE(sim != nullptr);
+    Build build(sim->fields());
+    std::vector<std::string> warnings;
+    REQUIRE(build.loadFile(std::filesystem::path(TEE_SOURCE_DIR) / "content/builds/archetypes/two-stage-cam-20.json",
+                           BuildPart::Whole, warnings, error));
+    const double up = build.get("valve.stageSpeed");
+    PredictOptions options;
+    options.from = 89.0;      // P's rows' range
+    options.to = 942.5;
+    options.fields = {"tel.valve.stage"};
+    PredictCurve curve;
+    REQUIRE(predictCurve(sim, build, options, curve, error));
+    int band = 0;
+    for (const PredictPoint& p : curve.points)
+    {
+        if (!p.valid || p.limited)
+            continue;
+        REQUIRE(p.fields.size() == 1);
+        CAPTURE(p.speed * 30.0 / 3.14159265358979, p.torque, p.fields[0]);
+        CHECK(p.fields[0] == (p.speed > up ? 1.0 : 0.0));
+        CHECK_FALSE(p.latched);   // FLAG_LATCHED let down: none stays
+        band += p.speed < up && p.speed > up - build.get("valve.stageHyst") ? 1 : 0;
+    }
+    CHECK(band >= 1);   // a point in the band, where the way it came decides
+}
