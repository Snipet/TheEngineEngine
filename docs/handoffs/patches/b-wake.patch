From 48a265163da884b5547f424420c60f1c604db223 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 18:34:19 +0000
Subject: [PATCH] app: the wake's drain runs the engine's frame around the jobs
 (X-066)

A window that does not tick never adopted its simulator and never sent a tool's change to
it. Shown::drainAssistant now runs Engine::frame before the jobs (a simulator compiled
meanwhile is adopted, so predict_curve and run_dyno find it) and after them (what the
host held is sent). Main says what of beforeTick still does not run while minimised, and
why. SimAdapter::compiled(): the worker's compile over, adopted or not.

Cases, no frame ticked: the simulator adopted through drains alone; set_fields reaching
the engine's value; predict_curve not refused. With both frames removed the first two
fail (:243, :275); with the frame before removed the third does (:289, :290).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LFAGgPYzYByoQt6gue8ek5
---
 app/Main.cpp                          |  7 ++-
 app/Offline.cpp                       |  9 +++-
 app/Offline.h                         |  3 +-
 shell/player/SimAdapter.h             |  2 +
 tests/shell/app/AssistantWakeTest.cpp | 78 ++++++++++++++++++++++++++-
 5 files changed, 94 insertions(+), 5 deletions(-)

diff --git a/app/Main.cpp b/app/Main.cpp
index 9064099c..f2c7ff8a 100644
--- a/app/Main.cpp
+++ b/app/Main.cpp
@@ -493,7 +493,12 @@ namespace
             }
             if (assistantWake && assistantWake->take(e))
             {
-                // a tool posted: its job drained here, the window ticking or not; jobs left waiting: again a little later
+                // a tool posted: its job drained here, the window ticking or not; jobs left waiting: again a little later.
+                // The drain runs the engine's frame around the jobs (Shown::drainAssistant, X-066). Of beforeTick, this
+                // still does NOT run while the window does not tick, deliberately: the keys', the gamepad's and the wheel's
+                // input (nobody drives a window they cannot see; the wheel's pump is the frame's), the bake's tick and the
+                // frames clock (shown.frame: the tools' clock stands still, so a job waiting on it waits for its
+                // condition, not its limit), the status line and the script's checks.
                 if (shown.drainAssistant)
                     shown.drainAssistant();
                 if (shown.assistant != nullptr && shown.assistant->waiting() > 0)
diff --git a/app/Offline.cpp b/app/Offline.cpp
index 38aecf0f..c3936492 100644
--- a/app/Offline.cpp
+++ b/app/Offline.cpp
@@ -242,7 +242,14 @@ namespace tee::app
                 kept->assistant.frame(appBusy());
                 kept->frames.store(kept->frames.load() + 1.0);
             };
