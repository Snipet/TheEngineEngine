+// for a frame (Build::flush). Can a whole build, loaded through the tool with no frame, leave writes waiting? Nothing
+// drains the queue here (no audio device): the worst case. After the answer, flush() true means none ever waited.
+TEST_CASE("the assistant's wake: a whole build loaded with no frame leaves no write waiting", "[app][assistant]")
+{
+    Minimised m;
+    Build& build = m.engine.sim->build();
+    SimHost& host = m.engine.sim->host();
+
+    // what a whole build sends: every Spec field (not a rev), its bytes; more than 16 go to the queue's pool
+    std::size_t fields = 0, bytes = 0, pooled = 0;
+    for (const FieldInfo& f : host.fields().all())
+        if (f.block == "spec" && f.kind != FieldKind::Rev)
+        {
+            std::string why;
+            const FieldRef r = host.fields().ref(f.path, why);
+            if (!r.valid())
+                continue;
+            ++fields;
+            bytes += r.size;
+            if (r.size > 16)
+                pooled += r.size;
+        }
+    std::printf("whole build: %zu fields, %zu bytes, %zu of them pooled (the queue: %zu slots, %zu bytes of pool)\n",
+                fields, bytes, pooled, LoadOptions{}.commandSlots, LoadOptions{}.poolBytes);
+
+    auto list = m.call("list_builds", nlohmann::json::object());
+    m.serve(list, 30000);
+    REQUIRE(answered(list));
+    const assistant::Result listed = list.get();
+    REQUIRE_FALSE(listed.isError);
+    std::string other;
+    for (const auto& b : listed.value["builds"])
+        if (b["name"].get<std::string>() != build.name && b["name"].get<std::string>().find("v8") != std::string::npos)
+        {
+            other = b["name"].get<std::string>();
+            break;
+        }
+    REQUIRE_FALSE(other.empty());
+
+    const std::string before = build.name;
+    auto load = m.call("load_build", { { "name", other } });
+    m.serve(load, 30000);
+    REQUIRE(answered(load));
+    const assistant::Result r = load.get();
+    INFO(r.value.dump().substr(0, 400));
+    REQUIRE_FALSE(r.isError);
+    CHECK(build.name != before);
+    CHECK(build.flush());   // nothing was left waiting by the load, with nothing draining the queue
+}
-- 
2.43.0

From a4b2edd564a8b04459f8ec14a259ed7d2292be9e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 18:44:48 +0000
Subject: [PATCH] scripts: run-wake prints its pass line only after the tick
 check; the ctest copy fails on FAILED

The lead's read: shell.window.wake passed on the answered line even when the script then
failed on ticks that moved. The check comes first now, and the test has a
FAIL_REGULAR_EXPRESSION on "run-wake: FAILED". CI's step goes by the exit code.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LFAGgPYzYByoQt6gue8ek5
---
 scripts/run-wake.sh        | 5 +++--
 tests/shell/CMakeLists.txt | 3 ++-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/scripts/run-wake.sh b/scripts/run-wake.sh
index 8bb4c31d..e0b0dbdf 100755
--- a/scripts/run-wake.sh
+++ b/scripts/run-wake.sh
@@ -106,8 +106,7 @@ if grep '"id":2' "$work/mcp.first.out" | grep -q '"isError":true'; then
   echo "run-wake: FAILED: the call answered with an error:"; grep '"id":2' "$work/mcp.first.out" | cut -c1-400
   exit 1
 fi
-printf 'run-wake: answered in %s s; window: %s%s; ticks %s before the call, %s after the answer; simulator %s at the call\n' \
-  "$took" "$flags" "$hidden" "$ticksBefore" "$ticksAfter" "${simulator:-not said}"
+# the property first (Linux: no tick between the call and the answer), then the line that says the run passed
 if [ "$ticksBefore" != "$ticksAfter" ]; then
   if [ "$(uname -s)" = Linux ] && [ -z "$hidden" ]; then
     echo "run-wake: FAILED: the window ticked between the call and the answer ($ticksBefore, then $ticksAfter): minimised for real here, so this run shows nothing of the wake"
@@ -115,6 +114,8 @@ if [ "$ticksBefore" != "$ticksAfter" ]; then
   fi
   echo "run-wake: note: the window ticked meanwhile, so this run does not show a drain without a frame (reported here, not required)"
 fi
+printf 'run-wake: answered in %s s; window: %s%s; ticks %s before the call, %s after the answer; simulator %s at the call\n' \
+  "$took" "$flags" "$hidden" "$ticksBefore" "$ticksAfter" "${simulator:-not said}"
 
 # Reported, not required (X-066): the simulator adopted while the window still does not tick. A minimised window adopts
 # it only in a drain, so the script asks again about once a second until the app's line says simulator=ready, for 15 s
diff --git a/tests/shell/CMakeLists.txt b/tests/shell/CMakeLists.txt
index 231266e4..bebe874e 100644
--- a/tests/shell/CMakeLists.txt
+++ b/tests/shell/CMakeLists.txt
@@ -186,7 +186,8 @@ if(TARGET TheEngineEngine AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
                 $<TARGET_FILE:TheEngineEngine> $<TARGET_FILE:tee-mcp>
         WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}")
       set_tests_properties(shell.window.wake PROPERTIES TIMEOUT 300 LABELS "shell;window" RUN_SERIAL TRUE
-        PASS_REGULAR_EXPRESSION "run-wake: answered in [0-9.]+ s; window: minimised=1")
+        PASS_REGULAR_EXPRESSION "run-wake: answered in [0-9.]+ s; window: minimised=1"
+        FAIL_REGULAR_EXPRESSION "run-wake: FAILED")
     endif()
     # The launch (app/Launch.h): a launch with no settings that names the first build (content/builds/first.json: a
     # scripted run opens none unless named) shows its notes' first line ("Try first: ...") and ends with its name and
