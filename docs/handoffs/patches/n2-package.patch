+                    pipe / 1000.0, r.at("engine.torque"), r.at("boost.blowOffValve"));
+        CHECK(std::isfinite(boost));
+        CHECK(std::isfinite(pipe));
+        CHECK(std::isfinite(r.at("engine.torque")));
+        // (gauge pressures: no vacuum past the air's own, nothing a 4 L Roots on 50 cc could not hold, some 20 bar)
+        CHECK(boost > -101325.0);
+        CHECK(pipe > -101325.0);
