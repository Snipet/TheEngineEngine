From a1b87980f191951de8e95c7b2d436333cf210b60 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 25 Nov 2026 12:48:30 +0000
Subject: [PATCH 03/11] boost: no vane surge guard (the lead's ruling): its
 rescue was the truck fixture's breathing, and it pinned three builds' vanes
 open; its own case goes with it

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LFAGgSxnqsW2XUcFC39ruQ
(cherry picked from commit cff355f91d6eb4e9ca927bf42b010f5332390e7a)
---
 sim/boost/machine.fm           | 29 ++++++-------------------
 tests/sim/boost/LayoutTest.cpp | 39 ----------------------------------
 2 files changed, 6 insertions(+), 62 deletions(-)

diff --git a/sim/boost/machine.fm b/sim/boost/machine.fm
index 4bc4633a..8bdc1e71 100644
--- a/sim/boost/machine.fm
+++ b/sim/boost/machine.fm
@@ -171,7 +171,6 @@ module BoostMachine
     float bovLift;
     float bpLimit;      // a variable nozzle's limit on the pressure before the turbine over the boost (absolute)
     float bpOpen[BOOST_TURBOS];  // the limit's opening of the vanes, each turbo
-    float surgeOpen[BOOST_TURBOS];  // the surge guard's opening of the vanes, each turbo
     float bovAt;        // the blow-off valve's opening the air sees: bovLift followed every sample by two 1 ms stages
     float bovMid;
     float kAt;          // that following's step a sample
@@ -342,7 +341,6 @@ module BoostMachine
             turb[t].vanesAt = 1.0f;
             turb[t].vanesMid = 1.0f;
             bpOpen[t] = 0.0f;
-            surgeOpen[t] = 0.0f;
             gateMass[t] = 0.0f;
             gateTemp[t] = tOut;
         }
@@ -1317,31 +1315,16 @@ module BoostMachine
                     const float r3 = house[hh].p / fmaxf(v2.p, 1000.0f);
                     bpOpen[t] = fminf(fmaxf(bpOpen[t] + d16 * 3.0f * (r3 - bpLimit), 0.0f), 1.0f);
                     v = fmaxf(v, turb[t].vaneMin + bpOpen[t]);
-                    // (the surge guard, gain-reversal protection: vanes shut past the compressor's surge line make
-                    // less boost, not more: it cannot deliver, the engine's air and the diesel's smoke-limited fuel fall
-                    // and the turbine's energy with them, a second steady state below the first: card D2's 15 L truck
-                    // at 1300 rpm stood at 98 kPa and 882 N m with its vanes at 0.47, surging two thirds of the time,
-                    // against 209 kPa and 1945 N m at 0.9. While the compressor surges, an integral opens the vanes at
-                    // 1 a second and gives back a tenth of that while it does not: the vanes settle where it surges
