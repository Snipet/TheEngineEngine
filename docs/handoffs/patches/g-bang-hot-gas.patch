diff --git a/tests/sim/exhaust/BangTest.cpp b/tests/sim/exhaust/BangTest.cpp
index 3cabdae7..d2fb9115 100644
--- a/tests/sim/exhaust/BangTest.cpp
+++ b/tests/sim/exhaust/BangTest.cpp
@@ -458,3 +458,60 @@ TEST_CASE("measure: the rally five's largest output steps against the burns, sam
     typical = all[all.size() * 99 / 100];
     std::printf("99th percentile step %.4f\n", typical);
