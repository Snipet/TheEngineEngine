// harness.fm: the exhaust builder alone, driven by made-up port flows (card G's standalone tests).
//
// XTest holds the builder (sim/exhaust/slots.fm) and the reference's own exhaust (refexhaust.fm), fitted to one of the
// reference's layouts at its own size and the reference's default dials, stopped and warm. A test sets the builder's
// description (spec, the Spec's exhaust section) by path, builds, and runs blocks of samples with the flows it gives each port; both systems run
// their 16-sample control as the reference does, with the gas's temperature and flow held where the test puts them.
#pragma once
#include "../../../sim/exhaust/slots.fm"
#include "refexhaust.fm"

module XTest
{
    XBuild b;
    ExhaustSpec spec;   // the Spec's exhaust section, as the engine holds it
    RefExh r;
    Layout lay;
    float rate;
    int layoutIdx;
    int tick;
    int tickR;
    float tPort;        // the gas the ports let out (K) and its flow (kg/s), held
    float mdot;
    float warm;
    float qs[XS_PORTS];
    int measure;        // 0: runB leaves energy as it was
    // a stand-in turbine on each side (test 10, until card F's is fitted): a housing of volume hVol (m^3) whose gas
    // leaves through a nozzle of linear resistance hR (Pa s / m^3) into the downpipe; solved implicitly with both
    int turbo;
    float hVol;
    float hR;
    float hP[2];
    double hS1;         // the housing's and the downpipe head's pressure, summed and squared (from side 0)
    double hS2;
    double dS1;
    double dS2;
    int nS;
    float energy;       // the waves in flight in the builder's pipes, after the last sample (J, up to a constant)

    void init(float rateIn)
    {
        rate = rateIn;
        b.sp = &spec;
        b.setup(rate);
        r.setup(rate);
        tPort = 1000.0f;
        mdot = 0.02f;
        measure = 1;
        turbo = 0;
        hVol = 0.0005f;
        hR = 60000.0f;
        warm = 1.0f;
    }

    void end()
    {
        b.release();
        r.release();
    }

    // Every field of the builder's description at its default (the reference)
    void defaults()
    {
        spec.model = 1;
        for (int i = 0; i < XS_PORTS; ++i)
        {
            spec.primaryTo[i] = -2;
            spec.primLen[i] = 0.0f;
            spec.primD[i] = 0.0f;
        }
        spec.primSpread = 0.06f;
        spec.primStepAt = 0.0f;
        spec.primStepD = 1.1f;
        for (int c = 0; c < XS_COLL; ++c)
        {
            spec.collectorTo[c] = -1;
            spec.colLen[c] = 0.0f;
            spec.colD[c] = 0.0f;
            spec.colVol[c] = 0.0f;
        }
        spec.sides = 0;
        spec.crossKind = 1;
        spec.crossAt = 0;
        spec.crossD = 0.0f;
        spec.crossLen = 0.25f;
        spec.postLen = 0.4f;
        spec.linkLen = 0.4f;
        spec.bypassD = 0.0f;
        spec.bypassRpm = 3500.0f;
        spec.bypassLoad = 0.5f;
        spec.bypassTime = 0.3f;
        spec.gateLen = 0.3f;
        spec.gateD = 0.038f;
        for (int s = 0; s < XS_SIDES; ++s)
        {
            spec.mainLen[s] = 0.0f;
            spec.mainD[s] = 0.0f;
            spec.converter[s] = 1;
            spec.resonator[s] = 0;
            spec.resHz[s] = 200.0f;
            spec.resD[s] = 0.0f;
            spec.resVol[s] = 0.003f;
            spec.resLen[s] = 0.4f;
            spec.mufKind[s] = 2;
            spec.mufSize[s] = -1.0f;
            spec.mufLen[s] = 0.0f;
            spec.bypass[s] = 0;
            spec.tailLen[s] = 0.0f;
            spec.tailD[s] = 0.0f;
            spec.tips[s] = 1;
            spec.exitAt[s] = -1;
        }
    }

    // The engine: a reference layout at its own size and the reference's default dials (HEADERS, PIPE, MUFFLER 0.5,
    // X-PIPE 0), naturally aspirated, in air at 300 K
    void engine(int layout)
    {
        lay.load(layout);
        layoutIdx = layout;
        XEngine* e = &b.eng;
        e->ports = lay.ports;
        for (int i = 0; i < XS_PORTS; ++i)
            e->bank[i] = 0;
        for (int c = 0; c < lay.n; ++c)
            e->bank[lay.port[c]] = lay.bank[c];
        e->topo = lay.topo;
        e->bore = expf(0.33333333f * logf(1.2732395f * lay.swept));
        e->hdr = lay.hdr;
        e->hdrBank1 = lay.hdrBank1;
        e->mainLen = lay.mainLen;
        e->pipeD = lay.pipeD;
        e->tailD = lay.tailD;
        e->muff = lay.muff;
        e->bike = lay.bike;
        e->smHdr = 0.5f;
        e->smPipe = 0.5f;
        e->smXp = 0.0f;
        e->smMuf = 0.5f;
        e->aspUse = 0;
        e->smTb = 0.5f;
        e->smTs = 1.0f;
        e->tAmb = 300.0f;
        e->vAir = 0.0f;
        e->tPort = tPort;
        e->mdotSlow = mdot;
        e->rpm = 3000.0f;
        e->load = 0.5f;
        e->ecuValve = 0.0f;
        for (int c = 0; c < XS_COLL; ++c)
            e->housing[c] = -1;
        e->gates = 0;
        r.smHdr = 0.5f;
        r.smPipe = 0.5f;
        r.smXp = 0.0f;
        r.smMuf = 0.5f;
        r.aspUse = 0;
        r.smTb = 0.5f;
        r.smTs = 1.0f;
        r.tAmb = 300.0f;
        r.vAir = 0.0f;
        defaults();
    }

    // The dials both systems see (the reference's HEADERS, PIPE, X-PIPE, MUFFLER)
    void dials(float hdr, float pipe, float xp, float muf)
    {
        b.eng.smHdr = hdr;
        b.eng.smPipe = pipe;
        b.eng.smXp = xp;
        b.eng.smMuf = muf;
        r.smHdr = hdr;
        r.smPipe = pipe;
        r.smXp = xp;
        r.smMuf = muf;
    }

    // The noise's strengths, times the reference's (0: none), in both
    void noise(float k)
    {
        b.net.flowK = 0.017f * k;
        b.net.valveK = 0.15f * k;
        b.net.jetK = 0.005f * k;
        r.flowK = 0.017f * k;
        r.valveK = 0.15f * k;
        r.jetK = 0.005f * k;
    }

    // Builds both, at rest, warm
    void configure()
    {
        b.eng.tPort = tPort;
        b.eng.mdotSlow = mdot;
        b.build(1, warm, 1);
        r.configure(layoutIdx, warm, mdot);
        tick = 0;
        tickR = 0;
    }

    // n samples of the builder: q holds n rows of XS_PORTS flows (m^3/s into each port); out n samples a channel
    void runB(float* q, float* outL, float* outR, int n)
    {
        for (int t = 0; t < n; ++t)
        {
            if (tick == 0)
            {
                b.eng.tPort = tPort;
                b.eng.mdotSlow = mdot;
                b.control(16.0f / rate);
            }
            tick = tick + 1 >= 16 ? 0 : tick + 1;
            b.read();
            b.prepare();
            if (turbo != 0)
            {
                for (int s = 0; s < 2; ++s)
                {
                    if (b.jHouse[s] < 0 || b.jDown[s] < 0)
                        continue;
                    // C dp/dt = (drive - admit p) - q; q = (p - 2 a) / (hR + zDown): implicit in p
                    const float cv = hVol / (1.33f * 101325.0f);
                    const float a = b.downWave(s);
                    const float zd = b.downZ(s);
                    const float k = cv * rate;
                    const float p = (k * hP[s] + b.houseDrive(s) + 2.0f * a / (hR + zd))
                                    / (k + b.houseAdmit(s) + 1.0f / (hR + zd));
                    const float qn = (p - 2.0f * a) / (hR + zd);
                    hP[s] = p;
                    b.setHouse(s, p);
                    b.setDown(s, p - hR * qn);
                    if (s == 0)
                    {
                        hS1 += (double)p;
                        hS2 += (double)p * (double)p;
                        const float pd = p - hR * qn;
                        dS1 += (double)pd;
                        dS2 += (double)pd * (double)pd;
                        nS += 1;
                    }
                }
            }
            for (int i = 0; i < XS_PORTS; ++i)
                qs[i] = q[t * XS_PORTS + i];
            b.step(qs);
            outL[t] = b.net.outL;
            outR[t] = b.net.outR;
        }
        if (measure == 0)
            return;
        energy = 0.0f;
        for (int i = 0; i < XN_DUCTS; ++i)
        {
            if (b.net.dUse[i] != 0)
            {
                // what is written and not yet read: the outgoing line back to what has arrived (a steepening pipe's
                // read point), the returning line back to its delay
                const Duct* p = &b.net.d[i];
                float s = 0.0f;
                const int nf = p->steep > 0.0f ? (p->w - p->rF + p->cap) % p->cap : p->di;
                const int nb = p->bdi;
                for (int k = 1; k <= nf; ++k)
                {
                    int j = p->w - k;
                    if (j < 0)
                        j += p->cap;
                    s += p->fw[j] * p->fw[j];
                }
                for (int k = 1; k <= nb; ++k)
                {
                    int j = p->w - k;
                    if (j < 0)
                        j += p->cap;
                    s += p->bw[j] * p->bw[j];
                }
                energy += s / p->z;
            }
        }
        // the stand-in housings' energy, 1/2 C p^2, in the same units (per sample)
        if (turbo != 0)
        {
            const float cv = hVol / (1.33f * 101325.0f);
            energy += 0.5f * cv * (hP[0] * hP[0] + hP[1] * hP[1]) * rate;
        }
    }

    // A new topology while running (the engine's fade around it is the owner's): the pipes' heat kept
    void rebuild()
    {
        b.build(0, warm, 1);
        tick = 0;
    }

    // The stand-in turbines on (one a bank's collector, each side its own), before configure()
    void standIn(float vol, float r)
    {
        turbo = 1;
        hVol = vol;
        hR = r;
        hP[0] = 0.0f;
        hP[1] = 0.0f;
        b.eng.housing[0] = 0;
        b.eng.housing[1] = 1;
        hS1 = 0.0;
        hS2 = 0.0;
        dS1 = 0.0;
        dS2 = 0.0;
        nS = 0;
    }

    // The housing's and the downpipe head's pressure swings (rms about their means) since standIn, side 0
    float swingHouse()
    {
        const double m = hS1 / (double)nS;
        return (float)sqrt(hS2 / (double)nS - m * m);
    }

    float swingDown()
    {
        const double m = dS1 / (double)nS;
        return (float)sqrt(dS2 / (double)nS - m * m);
    }

    // n samples of the builder with the waves' energy in flight after each, into e
    void runE(float* q, float* e, int n)
    {
        // (measured every 16th sample, held between)
        float l = 0.0f;
        float r = 0.0f;
        for (int t = 0; t < n; ++t)
        {
            measure = (t & 15) == 0 ? 1 : 0;
            runB(q + t * XS_PORTS, &l, &r, 1);
            e[t] = energy;
        }
        measure = 1;
    }

    // n samples of the reference's exhaust on the same flows
    void runR(float* q, float* outL, float* outR, int n)
    {
        for (int t = 0; t < n; ++t)
        {
            if (tickR == 0)
                r.control16(16.0f / rate, tPort, mdot);
            tickR = tickR + 1 >= 16 ? 0 : tickR + 1;
            for (int i = 0; i < XS_PORTS; ++i)
                qs[i] = q[t * XS_PORTS + i];
            r.sampleTick(qs);
            outL[t] = r.outL;
            outR[t] = r.outR;
        }
    }

    // The flow summed in at the ports and out at the ends since the last call (m^3/s samples)
    float flowIn()
    {
        const float v = b.net.portIn;
        b.net.portIn = 0.0f;
        return v;
    }

    float flowOut()
    {
        float v = 0.0f;
        for (int e = 0; e < b.net.ne; ++e)
        {
            v += b.net.ends[e].qSum;
            b.net.ends[e].qSum = 0.0f;
        }
        return v;
    }

    int ends()
    {
        return b.net.ne;
    }

    float fireAngle(int c)
    {
        return lay.fire[c];
    }

    int portOf(int c)
    {
        return lay.port[c];
    }

    int cylinders()
    {
        return lay.n;
    }

    float pMuf(int s)
    {
        return b.pMuf[s];
    }

    float pConv(int s)
    {
        return b.pConv[s];
    }

    float valve(int s)
    {
        return b.vPos[s];
    }

    void popAt(int c, float a)
    {
        b.popAt(c, a);
    }
};
